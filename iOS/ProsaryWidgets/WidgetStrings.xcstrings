          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang Ngayon"
          }
        }
      }
    },
    "widget.today.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
