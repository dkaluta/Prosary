    "widget.prayer.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a saved prayer and see your progress."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו תפילה שמורה וצפו בהתקדמות שלכם."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح صلاة محفوظة وتابع تقدمك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывайте сохранённую молитву и следите за своим продвижением."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une prière enregistrée et suivez votre progression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri una preghiera salvata e segui i tuoi progressi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкривайте збережену молитву й стежте за своїм поступом."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang naka-save na panalangin at tingnan ang iyong progreso."
          }
        }
      }
    },
