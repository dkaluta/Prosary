{
  "sourceLanguage": "en",
  "strings": {
    "widget.today.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today’s feast and readings, with a shortcut to pray the Rosary."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החג ומקראות היום, עם קיצור דרך לתפילת המחרוזת."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيد اليوم وقراءاته، مع اختصار لصلاة الوردية."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Праздник и чтения дня, с быстрым переходом к Розарию."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fête et les lectures du jour, avec un raccourci vers le Rosaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La festa e le letture del giorno, con un collegamento al Rosario."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Свято й читання дня зі швидким переходом до Розарію."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapistahan at mga pagbasa ngayon, na may shortcut sa pagdarasal ng Rosaryo."
          }
        }
      }
    },
    "widget.today.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
