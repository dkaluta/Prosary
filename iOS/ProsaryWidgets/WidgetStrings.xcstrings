    "widget.prayer.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This prayer is no longer saved. Edit the widget to choose another."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תפילה זו אינה שמורה עוד. ערכו את הווידג׳ט לבחירת תפילה אחרת."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد هذه الصلاة محفوظة. عدّل الأداة لاختيار صلاة أخرى."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта молитва больше не сохранена. Измените виджет, чтобы выбрать другую."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette prière n’est plus enregistrée. Modifiez le widget pour en choisir une autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa preghiera non è più salvata. Modifica il widget per sceglierne un’altra."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю молитву більше не збережено. Змініть віджет, щоб вибрати іншу."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi na naka-save ang panalanging ito. I-edit ang widget upang pumili ng iba."
          }
        }
      }
    },
    "widget.prayer.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a prayer in Prosary, then edit this widget to choose it."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרו תפילה ב־Prosary, ואז ערכו את הווידג׳ט כדי לבחור בה."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ صلاة في Prosary، ثم عدّل هذه الأداة لاختيارها."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните молитву в Prosary, затем выберите её в настройках виджета."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une prière dans Prosary, puis modifiez ce widget pour la choisir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una preghiera in Prosary, poi modifica questo widget per sceglierla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть молитву в Prosary, а потім виберіть її в налаштуваннях віджета."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-save ng panalangin sa Prosary, pagkatapos ay i-edit ang widget na ito upang piliin ito."
          }
        }
      }
    },
