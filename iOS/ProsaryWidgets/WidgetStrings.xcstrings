          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Сегодня», чтобы посмотреть календарь."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Aujourd’hui pour consulter votre calendrier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Oggi per consultare il calendario."
