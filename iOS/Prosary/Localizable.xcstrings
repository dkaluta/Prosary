          "stringUnit" : {
            "state" : "translated",
            "value" : "הפסוקים מוצגים במלואם ועשויים לכלול טקסט מעבר לטווח המצוין בקריאה."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
