    "about.prayerTexts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Divine Mercy Chaplet in Hebrew is the Latin Patriarchate of Jerusalem’s own text, approved by Patriarch Michel Sabbah in 2003. Some of the prayers in Hebrew and Aramaic are used with the permission of the Patriarchal Exarch of the Aramaic (Syriac) Catholic community."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תפילת רחמי האלוהים בעברית היא נוסח הפטריארכיה הלטינית של ירושלים, שאושר על ידי הפטריארך מישל צבאח בשנת 2003. חלק מן התפילות בעברית ובארמית נלקחו באישור האפוטרוף הפטריארכלי של העדה הארמית (סורית) קתולית."
          }
        }
      }
    },
    "about.scriptureSources": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripture quotations use the Douay-Rheims Bible (English), the Clementine Vulgate (Latin), Franz Delitzsch's Hebrew New Testament translation (sourced from kirjasilta.net/ha-berit) with Hebrew Old Testament passages following the Masoretic text, the Jesuit Arabic Bible (Beirut, 1880, revised 1988), the Russian Synodal Bible (1876), and Ang Dating Biblia (Tagalog, 1905) — all public domain."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ציטוטי המקרא לקוחים מביבליית דואיי־רימס (אנגלית), הוולגאטה הקלמנטית (לטינית), תרגום דליטש לברית החדשה (מתוך kirjasilta.net/ha-berit) עם קטעי התנ״ך על פי נוסח המסורה, תרגום הישועים לביבליה לערבית (ביירות, 1880, נערך 1988), הביבליה הסינודלית ברוסית (1876) ו־Ang Dating Biblia (טאגאלוג, 1905) — כולם בנחלת הכלל."
          }
        }
      }
    },
    "about.sevenSorrowsImage.murilloFlight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Flight into Egypt: Bartolomé Esteban Murillo (c. 1647–50), Detroit Institute of Arts — public domain."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבריחה למצרים: ברטולומה אסטבן מוריו (1647–50 לערך), מכון דטרויט לאמנויות — רשות הציבור."
          }
        }
      }
    },
    "about.sevenSorrowsImage.raphaelSpasimo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Meeting on the Way of the Cross: Raphael, Lo Spasimo (c. 1514–16), Museo del Prado — public domain."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפגישה בדרך הצלב: רפאל, לו ספאזימו (1514–16 לערך), מוזיאון הפראדו — רשות הציבור."
          }
        }
      }
    },
    "about.sevenSorrowsImage.rembrandtSimeon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Prophecy of Simeon: Rembrandt van Rijn, Simeon’s Song of Praise (1631), Mauritshuis — public domain."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נבואת שמעון: רמברנדט ואן ריין, שיר ההלל של שמעון (1631), מאוריצהאוס — רשות הציבור."
          }
        }
      }
    },
    "about.sevenSorrowsImage.rubensDescent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Descent from the Cross: Peter Paul Rubens (c. 1612–14), Cathedral of Our Lady, Antwerp — public domain."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההורדה מהצלב: פטר פאול רובנס (1612–14 לערך), קתדרלת גבירתנו, אנטוורפן — רשות הציבור."
          }
        }
      }
    },
    "about.sevenSorrowsImage.terBrugghenCrucifixion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Crucifixion: Hendrick ter Brugghen, The Crucifixion with the Virgin and Saint John (c. 1625), Metropolitan Museum of Art — CC0."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצליבה: הנדריק טר ברוחן, הצליבה עם הבתולה ויוחנן הקדוש (1625 לערך), מוזיאון המטרופוליטן לאמנות — CC0."
          }
        }
      }
    },
    "about.sevenSorrowsImage.titianEntombment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Burial of Jesus: Titian, The Entombment of Christ (c. 1520), Musée du Louvre — public domain."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבורת ישוע: טיציאן, הטמנת המשיח (1520 לערך), מוזיאון הלובר — רשות הציבור."
          }
        }
      }
    },
    "about.sevenSorrowsImage.veroneseDoctors": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Loss of Jesus in the Temple: Paolo Veronese, Christ Among the Doctors (c. 1560), Museo del Prado — public domain."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אובדן ישוע בבית המקדש: פאולו ורונזה, המשיח בין החכמים (1560 לערך), מוזיאון הפראדו — רשות הציבור."
          }
        }
      }
    },
    "about.stationImages.fugelCycle": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "All 14 stations: Gebhard Fugel (1863–1939), Kreuzweg (1921), St. Antonius, Bad Saulgau — public domain; photographs by Andreas Praefcke, released into the public domain."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל 14 התחנות: גבהרד פוגל (1863–1939), דרך הצלב (Kreuzweg, 1921), כנסיית אנטוניוס הקדוש, באד זאולגאו — רשות הציבור; צילומים מאת אנדראס פרפקה, שהוקדשו לרשות הציבור."
          }
        }
      }
    },
    "about.stationImages.scripturalScenes": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The scriptural (St. John Paul II) form adds: The Kiss of Judas — Giotto (Scrovegni Chapel, c. 1305); Christ before the High Priest — Gerrit van Honthorst (c. 1617), National Gallery, London; The Denial of St Peter — Rembrandt (1660), Rijksmuseum; Le Coup de Lance — Peter Paul Rubens (1620), Royal Museum of Fine Arts Antwerp — all public domain. Its other scenes reuse illustrations listed elsewhere on this page."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנוסח המקראי (של יוחנן פאולוס השני הקדוש) מוסיף: נשיקת יהודה — ג׳וטו די בונדונה (קפלת סקרובני, 1305 לערך); המשיח לפני הכהן הגדול — חרארד ואן הונטהורסט (1617 לערך), הגלריה הלאומית, לונדון; התכחשות פטרוס הקדוש — רמברנדט (1660), הרייקסמוזיאום; דקירת החנית (Le Coup de Lance) — פטר פאול רובנס (1620), המוזיאון המלכותי לאמנויות יפות, אנטוורפן — כולם ברשות הציבור. שאר הסצנות עושות שימוש באיורים המופיעים במקומות אחרים בדף זה."
          }
        }
      }
    },
    "about.tagline": {
