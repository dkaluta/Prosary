    "macStore.incompleteMigration" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تكتمل عملية نقل سابقة للمكتبة. بقيت ملفاتها دون تغيير."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A previous library migration did not finish. Its files have been kept unchanged."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi nakumpleto ang nakaraang paglilipat ng aklatan. Hindi binago ang mga file nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un précédent transfert de la bibliothèque n’a pas abouti. Ses fichiers ont été conservés sans modification."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העברה קודמת של הספרייה לא הושלמה. הקבצים שלה נשמרו ללא שינוי."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un precedente trasferimento della libreria non è stato completato. I suoi file sono rimasti invariati."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предыдущий перенос библиотеки не был завершён. Её файлы оставлены без изменений."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попереднє перенесення бібліотеки не завершилося. Її файли залишено без змін."
          }
        }
      }
    },
    "macStore.migrationFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر نقل مكتبة الصلوات المحفوظة إلى موقعها الجديد. بقيت ملفاتها الأصلية دون تغيير."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The saved prayer library could not be moved to its new location. Its original files have been kept unchanged."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi mailipat ang naka-save na aklatan ng mga panalangin sa bagong lokasyon nito. Hindi binago ang mga orihinal na file nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bibliothèque de prières enregistrée n’a pas pu être déplacée vers son nouvel emplacement. Ses fichiers d’origine ont été conservés sans modification."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה להעביר את ספריית התפילות השמורה למיקומה החדש. הקבצים המקוריים שלה נשמרו ללא שינוי."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile spostare la libreria di preghiere salvata nella nuova posizione. I suoi file originali sono rimasti invariati."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось переместить сохранённую библиотеку молитв в новое расположение. Её исходные файлы оставлены без изменений."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося перемістити збережену бібліотеку молитов до нового розташування. Її початкові файли залишено без змін."
          }
        }
      }
    },
    "macStore.unreadable" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر فتح مكتبة الصلوات المحفوظة. بقيت ملفاتها دون تغيير."
