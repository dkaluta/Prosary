    "settings.languageFallbackOrder.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a prayer is missing, Prosary tries these languages from top to bottom after the chosen language and its own variation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כאשר תפילה חסרה, Prosary מנסה את השפות לפי הסדר, אחרי השפה שנבחרה והנוסח שלה."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما لا تتوفر صلاة، يجرب Prosary هذه اللغات بالترتيب من الأعلى إلى الأسفل، بعد اللغة المختارة وصيغتها الخاصة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если молитва отсутствует, после выбранного языка и его варианта Prosary пробует эти языки сверху вниз."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag kulang ang isang panalangin, sinusubukan ng Prosary ang mga wikang ito mula sa itaas pababa pagkatapos ng napiling wika at ng sarili nitong baryasyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu’une prière manque, Prosary essaie ces langues de haut en bas, après la langue choisie et sa variante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se una preghiera manca, Prosary prova queste lingue dall’alto verso il basso, dopo la lingua scelta e la sua variante."
          }
        }
      }
    },
