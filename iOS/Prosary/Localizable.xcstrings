    "settings.languageFallbackOrder.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When text is missing, Prosary follows this order after the chosen language. Shared Hebrew, including repository prayers, uses the higher of the two Hebrew positions."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשחסר טקסט בשפת התפילה שנבחרה, Prosary מחפש לפי הסדר הזה. עברית משותפת לשני הנוסחים, כולל תפילות מהמאגר, מקבלת את העדיפות של הנוסח העברי הגבוה יותר ברשימה."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند غياب النص باللغة المختارة، يتبع Prosary هذا الترتيب. تستخدم النصوص العبرية المشتركة بين التقليدين، بما فيها صلوات المستودع، الموضع الأعلى بين الموضعين العبريين."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если текста нет на выбранном языке, Prosary следует этому порядку. Общие для обеих традиций тексты на иврите, включая молитвы из репозитория, используют более высокую из двух позиций иврита."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag wala ang teksto sa piniling wika, sinusunod ng Prosary ang ayos na ito. Ang tekstong Hebreo na pareho sa dalawang tradisyon, kasama ang mga panalangin mula sa repositoryo, ay gumagamit ng mas mataas sa dalawang puwesto ng Hebreo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le texte manque dans la langue choisie, Prosary suit cet ordre. Les textes hébreux communs aux deux traditions, y compris les prières du dépôt, utilisent la plus haute des deux positions de l’hébreu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il testo manca nella lingua scelta, Prosary segue questo ordine. I testi ebraici comuni alle due tradizioni, incluse le preghiere del repository, usano la più alta delle due posizioni dell’ebraico."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо тексту немає вибраною мовою, Prosary перевіряє інші мови в цьому порядку. Спільні тексти івритом, зокрема молитви з каталогу, займають вищу з двох позицій івриту."
          }
        }
      }
    },
