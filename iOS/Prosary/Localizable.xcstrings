    "appIntents.todaysMystery.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells you which set of Rosary mysteries is traditionally prayed today."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אומר איזה אוסף רזים נהוג להתפלל היום."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخبرك بمجموعة أسرار الوردية التي تُصلّى تقليديًا اليوم."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает, какие тайны Розария традиционно созерцают сегодня."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita kung aling pangkat ng mga misteryo ng Rosaryo ang tradisyonal na dinarasal ngayon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique la série de mystères du rosaire traditionnellement priée aujourd’hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica la serie di misteri del Rosario che si recita tradizionalmente oggi."
          }
        }
      }
    },
