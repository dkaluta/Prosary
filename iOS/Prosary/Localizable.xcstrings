    "removal.deleteDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف هذه النسخة المحفوظة وتذكيراتها. إذا كانت آخر نسخة من صلاة منزّلة، فستُزال أيضًا من هذا الجهاز."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes this saved copy and its reminders. If it is the last copy of a downloaded prayer, its download is also removed from this device."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buburahin nito ang naka-save na kopyang ito at mga paalala nito. Kung ito ang huling kopya ng isang na-download na panalangin, aalisin din ang download nito sa device na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette copie enregistrée et ses rappels seront supprimés. S’il s’agit de la dernière copie d’une prière téléchargée, son téléchargement sera également retiré de cet appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העותק השמור הזה והתזכורות שלו יימחקו. אם זהו העותק האחרון של תפילה שהורדה, גם ההורדה שלה תוסר מהמכשיר הזה."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa copia salvata e i suoi promemoria verranno eliminati. Se è l’ultima copia di una preghiera scaricata, anche il suo download verrà rimosso da questo dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта сохранённая копия и её напоминания будут удалены. Если это последняя копия загруженной молитвы, её загрузка также будет удалена с этого устройства."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цю збережену копію та її нагадування буде видалено. Якщо це остання копія завантаженої молитви, її завантаження також буде вилучено з цього пристрою."
          }
        }
      }
    },
