        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفيق لصلاة الوردية وغيرها من الصلوات الكاثوليكية."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спутник в молитве Розария и других католических молитвах."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasama sa pagdarasal ng Rosaryo at iba pang debosyong Katoliko."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compagnon pour prier le rosaire et d’autres dévotions catholiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compagno per recitare il Rosario e altre devozioni cattoliche."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помічник у молитві Розарію та інших католицьких молитвах."
          }
        }
      }
    },
