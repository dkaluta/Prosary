    "settings.downloadsFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الصلوات المضمّنة متاحة. تُحفظ التنزيلات التي تستخدمها الصلوات المحفوظة حتى تُحذف آخر نسخة محفوظة منها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built-in prayers remain available. Downloads used by saved prayers are kept until their last saved copy is deleted."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mananatiling magagamit ang mga panalanging kasama sa app. Mananatili ang mga download na ginagamit ng mga naka-save na panalangin hanggang mabura ang kanilang huling naka-save na kopya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les prières intégrées restent disponibles. Les téléchargements utilisés par des prières enregistrées sont conservés jusqu’à la suppression de leur dernière copie enregistrée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תפילות מובנות נשארות זמינות. הורדות המשמשות תפילות שמורות נשמרות עד למחיקת העותק השמור האחרון שלהן."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le preghiere integrate restano disponibili. I download usati dalle preghiere salvate vengono conservati fino all’eliminazione della loro ultima copia salvata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встроенные молитвы остаются доступны. Загрузки, используемые сохранёнными молитвами, сохраняются до удаления их последней сохранённой копии."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вбудовані молитви залишаються доступними. Завантаження, які використовують збережені молитви, зберігаються до видалення їхньої останньої збереженої копії."
          }
        }
      }
    },
