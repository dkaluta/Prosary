    "removal.cleanupFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُذفت الصلاة المحفوظة، لكن تعذّرت إزالة تنزيلها. حاول مجددًا في التنزيلات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The saved prayer was deleted, but its download could not be removed. Try again in Downloads."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabura ang naka-save na panalangin, ngunit hindi maalis ang download nito. Subukang muli sa Mga Download."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
