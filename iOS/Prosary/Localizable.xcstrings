        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התפילה השמורה נמחקה, אך לא ניתן להסיר את ההורדה שלה. נא לנסות שוב בהורדות."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La preghiera salvata è stata eliminata, ma non è stato possibile rimuovere il download. Riprova in Download."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённая молитва удалена, но её загрузку удалить не удалось. Повторите попытку в разделе «Загрузки»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережену молитву видалено, але не вдалося вилучити її завантаження. Спробуйте ще раз у розділі «Завантаження»."
          }
        }
      }
    },
