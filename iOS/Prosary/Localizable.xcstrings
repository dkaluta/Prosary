    "settings.downloadsFooter": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Built-in devotions are never removed. Removing a downloaded devotion also removes its favorite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסלולים מובנים לעולם אינם מוסרים. הסרת מסלול שהורד מסירה גם את המועדף שלו."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُحذف الصلوات المضمّنة أبدًا. إزالة صلاة مُنزّلة تزيلها أيضًا من المفضلة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенные молитвы не удаляются. Удаление загруженной молитвы также удаляет её из избранного."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi inaalis ang mga kasamang debosyon. Kapag inalis ang na-download na debosyon, aalisin din ang paborito nito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dévotions intégrées ne sont jamais supprimées. Supprimer une dévotion téléchargée supprime aussi son favori."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le devozioni integrate non vengono mai rimosse. Rimuovendo una devozione scaricata si elimina anche il relativo preferito."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вбудовані молитви не видаляються. Видалення завантаженої молитви також вилучає її з обраного."
          }
        }
      }
    },
