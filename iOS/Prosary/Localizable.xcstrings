      }
    },
    "about.sevenSorrowsImage.titianEntombment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Burial of Jesus: Titian, The Entombment of Christ (c. 1520), Musée du Louvre — public domain."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבורת ישוע: טיציאן, הטמנת המשיח (1520 לערך), מוזיאון הלובר — רשות הציבור."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دفن يسوع: تيتيان، دفن المسيح (نحو 1520)، متحف اللوفر — ملكية عامة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Погребение Иисуса»: Тициан, «Положение во гроб» (ок. 1520), Лувр — общественное достояние."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Paglilibing kay Hesus: Titian, Ang Paglilibing kay Kristo (bandang 1520), Musée du Louvre — pampublikong dominyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Mise au tombeau de Jésus: Le Titien, La Mise au tombeau du Christ (vers 1520), musée du Louvre — domaine public."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sepoltura di Gesù: Tiziano, Deposizione di Cristo nel sepolcro (circa 1520), Musée du Louvre — pubblico dominio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поховання Ісуса: Тиціан, Покладення Христа до гробу (бл. 1520), Лувр — суспільне надбання."
          }
        }
      }
    },
    "about.sevenSorrowsImage.veroneseDoctors": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Loss of Jesus in the Temple: Paolo Veronese, Christ Among the Doctors (c. 1560), Museo del Prado — public domain."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אובדן ישוע בבית המקדש: פאולו ורונזה, המשיח בין החכמים (1560 לערך), מוזיאון הפראדו — רשות הציבור."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقدان يسوع في الهيكل: باولو فيرونيزي، المسيح بين العلماء (نحو 1560)، متحف برادو — ملكية عامة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Потеря Иисуса во храме»: Паоло Веронезе, «Христос среди учителей» (ок. 1560), музей Прадо — общественное достояние."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Pagkawala ni Hesus sa Templo: Paolo Veronese, Si Kristo sa Gitna ng mga Guro (bandang 1560), Museo del Prado — pampublikong dominyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Perte de Jésus au Temple: Paul Véronèse, Le Christ parmi les docteurs (vers 1560), musée du Prado — domaine public."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo smarrimento di Gesù nel Tempio: Paolo Veronese, Cristo tra i dottori (circa 1560), Museo del Prado — pubblico dominio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Загублення Ісуса в храмі: Паоло Веронезе, Христос серед учителів (бл. 1560), музей Прадо — суспільне надбання."
          }
        }
      }
    },
    "about.stationImages.fugelCycle": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "All 14 stations: Gebhard Fugel (1863–1939), Kreuzweg (1921), St. Antonius, Bad Saulgau — public domain; photographs by Andreas Praefcke, released into the public domain."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל 14 התחנות: גבהרד פוגל (1863–1939), דרך הצלב (Kreuzweg, 1921), כנסיית אנטוניוס הקדוש, באד זאולגאו — רשות הציבור; צילומים מאת אנדראס פרפקה, שהוקדשו לרשות הציבור."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المراحل الأربع عشرة: غيبهارد فوغل (1863–1939)، Kreuzweg (1921)، كنيسة القديس أنطونيوس، باد زاولغاو — ملكية عامة؛ الصور الفوتوغرافية لأندرياس برايفكه، أتاحها للملكية العامة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все 14 стояний: Гебхард Фугель (1863–1939), «Крестный путь» (1921), церковь Святого Антония, Бад-Заульгау — общественное достояние; фотографии Андреаса Прэфке переданы в общественное достояние."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lahat ng 14 na estasyon: Gebhard Fugel (1863–1939), Kreuzweg (1921), St. Antonius, Bad Saulgau — pampublikong dominyo; mga larawan ni Andreas Praefcke, inilabas sa pampublikong dominyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 14 stations : Gebhard Fugel (1863–1939), Kreuzweg (1921), église Saint-Antoine, Bad Saulgau — domaine public ; photographies d’Andreas Praefcke, placées dans le domaine public."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le 14 stazioni: Gebhard Fugel (1863–1939), Kreuzweg (1921), chiesa di Sant’Antonio, Bad Saulgau — pubblico dominio; fotografie di Andreas Praefcke, rilasciate nel pubblico dominio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі 14 стоянь: Ґебгард Фуґель (1863–1939), Хресна дорога (1921), церква святого Антонія, Бад-Заульгау — суспільне надбання; фотографії Андреаса Префке передано до суспільного надбання."
          }
        }
      }
    },
    "about.stationImages.scripturalScenes": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The scriptural (St. John Paul II) form adds: The Kiss of Judas — Giotto (Scrovegni Chapel, c. 1305); Christ before the High Priest — Gerrit van Honthorst (c. 1617), National Gallery, London; The Denial of St Peter — Rembrandt (1660), Rijksmuseum; Le Coup de Lance — Peter Paul Rubens (1620), Royal Museum of Fine Arts Antwerp — all public domain. Its other scenes reuse illustrations listed elsewhere on this page."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנוסח המקראי (של יוחנן פאולוס השני הקדוש) מוסיף: נשיקת יהודה — ג׳וטו די בונדונה (קפלת סקרובני, 1305 לערך); המשיח לפני הכהן הגדול — חרארד ואן הונטהורסט (1617 לערך), הגלריה הלאומית, לונדון; התכחשות פטרוס הקדוש — רמברנדט (1660), הרייקסמוזיאום; דקירת החנית (Le Coup de Lance) — פטר פאול רובנס (1620), המוזיאון המלכותי לאמנויות יפות, אנטוורפן — כולם ברשות הציבור. שאר הסצנות עושות שימוש באיורים המופיעים במקומות אחרים בדף זה."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تضيف الصيغة الكتابية (القديس يوحنا بولس الثاني): قبلة يهوذا — جوتو (كنيسة سكروفيني، نحو 1305)؛ المسيح أمام رئيس الكهنة — خيريت فان هونتهورست (نحو 1617)، المعرض الوطني، لندن؛ إنكار القديس بطرس — رامبرانت (1660)، متحف ريكز؛ الطعن بالحربة — بيتر بول روبنز (1620)، المتحف الملكي للفنون الجميلة في أنتويرب — جميعها ملكية عامة. تستخدم بقية المشاهد صورًا مدرجة في مواضع أخرى من هذه الصفحة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Библейский вариант святого Иоанна Павла II добавляет: «Поцелуй Иуды» — Джотто (капелла Скровеньи, ок. 1305); «Христос перед первосвященником» — Геррит ван Хонтхорст (ок. 1617), Национальная галерея, Лондон; «Отречение святого Петра» — Рембрандт (1660), Рейксмюсеум; «Удар копьём» — Питер Пауль Рубенс (1620), Королевский музей изящных искусств Антверпена — всё в общественном достоянии. Другие сцены используют иллюстрации, перечисленные на этой странице."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Idinadagdag ng anyong batay sa Kasulatan (San Juan Pablo II): Ang Halik ni Hudas — Giotto (Scrovegni Chapel, bandang 1305); Si Kristo sa Harap ng Punong Pari — Gerrit van Honthorst (bandang 1617), National Gallery, London; Ang Pagtatwa ni San Pedro — Rembrandt (1660), Rijksmuseum; Le Coup de Lance — Peter Paul Rubens (1620), Royal Museum of Fine Arts Antwerp — pawang nasa pampublikong dominyo. Ginagamit muli ng ibang tagpo nito ang mga larawang nakalista sa ibang bahagi ng pahinang ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La forme biblique (saint Jean-Paul II) ajoute : Le Baiser de Judas — Giotto (chapelle des Scrovegni, vers 1305) ; Le Christ devant le grand prêtre — Gerrit van Honthorst (vers 1617), National Gallery, Londres ; Le Reniement de saint Pierre — Rembrandt (1660), Rijksmuseum ; Le Coup de Lance — Pierre Paul Rubens (1620), Musée royal des Beaux-Arts d’Anvers — tous dans le domaine public. Les autres scènes réutilisent des illustrations citées ailleurs sur cette page."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma biblica (san Giovanni Paolo II) aggiunge: Il bacio di Giuda — Giotto (Cappella degli Scrovegni, circa 1305); Cristo davanti al sommo sacerdote — Gerrit van Honthorst (circa 1617), National Gallery, Londra; Il rinnegamento di san Pietro — Rembrandt (1660), Rijksmuseum; Il colpo di lancia — Peter Paul Rubens (1620), Museo reale di belle arti di Anversa — tutte opere di pubblico dominio. Le altre scene riutilizzano illustrazioni elencate altrove in questa pagina."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Біблійна форма (святого Йоана Павла II) додає: Поцілунок Юди — Джотто (капела Скровеньї, бл. 1305); Христос перед первосвященником — Герріт ван Гонтгорст (бл. 1617), Національна галерея, Лондон; Зречення святого Петра — Рембрандт (1660), Рейксмузеум; Удар списом — Пітер Пауль Рубенс (1620), Королівський музей витончених мистецтв Антверпена — усе із суспільного надбання. Для інших сцен використано ілюстрації, зазначені в інших частинах цієї сторінки."
          }
        }
      }
    },
    "about.tagline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A companion for praying the Rosary and other Catholic devotions."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עזר לתפילת המחרוזת ולתפילות קתוליות נוספות."
