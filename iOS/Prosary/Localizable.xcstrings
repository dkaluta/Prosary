    "rosaryPicker.anyRosaryDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose mysteries and prayers for this session, and keep it as a preset if you like."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר רזים ותפילות לתפילה זו, ושמור כתבנית אם תרצה."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الأسرار والصلوات لهذه الجلسة، واحفظها كإعداد إن شئت."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите тайны и молитвы на этот раз и при желании сохраните настройки."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng mga misteryo at panalangin para sa pagdarasal na ito, at i-save ang ayos kung nais mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les mystères et les prières de cette séance, puis enregistrez la configuration si vous le souhaitez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli i misteri e le preghiere di questa sessione e, se vuoi, salva la configurazione."
