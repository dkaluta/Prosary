    "macLibrary.defaultAutoAdvanceHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ نسخ الصلاة الجديدة بهذه الوتيرة. وتتذكر كل صلاة التغييرات التي تُجرى في نافذتها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New prayer copies start at this pace. Each prayer remembers changes made in its window."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagsisimula ang mga bagong kopya ng panalangin sa bilis na ito. Natatandaan ng bawat panalangin ang mga pagbabagong ginawa sa window nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles copies de prières commencent à ce rythme. Chaque prière conserve les changements effectués dans sa fenêtre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עותקים חדשים של תפילות מתחילים בקצב זה. כל תפילה שומרת שינויים שנעשו בחלון שלה."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nuove copie delle preghiere iniziano a questo ritmo. Ogni preghiera conserva le modifiche apportate nella propria finestra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые копии молитв начинают с этого темпа. Каждая молитва сохраняет изменения, сделанные в её окне."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
