          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Crucifixion: Hendrick ter Brugghen, La Crucifixion avec la Vierge et saint Jean (vers 1625), Metropolitan Museum of Art — CC0."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Crocifissione: Hendrick ter Brugghen, La Crocifissione con la Vergine e san Giovanni (circa 1625), Metropolitan Museum of Art — CC0."
          }
