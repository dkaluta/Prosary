    "settings.removeAllDownloads.message": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Devotions from the repository can be downloaded again; hand-imported files cannot."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסלולים מהמאגר אפשר להוריד שוב; קבצים שיובאו ידנית — לא."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن تنزيل صلوات المستودع مجددًا، لكن الملفات المستوردة يدويًا لا يمكن استعادتها منه."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Молитвы из каталога можно загрузить заново; файлы, импортированные вручную, — нельзя."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaaring i-download muli ang mga debosyon mula sa imbakan; hindi ang mga file na mano-manong in-import."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dévotions du répertoire peuvent être téléchargées à nouveau ; les fichiers importés manuellement ne le peuvent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le devozioni della raccolta possono essere scaricate di nuovo; i file importati manualmente no."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Молитви з каталогу можна завантажити знову; вручну імпортовані файли — ні."
          }
        }
      }
    },
