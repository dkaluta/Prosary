    "settings.removeAllDownloads.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُزال من هذا الجهاز فقط التنزيلات التي ليس لها نسخ محفوظة. احتفظ بالملفات الأصلية لاستيرادها مجددًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only downloads with no saved copies will be removed from this device. Keep your original files to import them again."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga download na walang naka-save na kopya lamang ang aalisin sa device na ito. Itago ang iyong mga orihinal na file upang ma-import muli ang mga ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les téléchargements sans copie enregistrée seront retirés de cet appareil. Conservez vos fichiers d’origine pour pouvoir les importer à nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק הורדות ללא עותקים שמורים יוסרו מהמכשיר הזה. יש לשמור את הקבצים המקוריים כדי לייבא אותם שוב."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno rimossi da questo dispositivo solo i download senza copie salvate. Conserva i file originali per poterli importare di nuovo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С этого устройства будут удалены только загрузки без сохранённых копий. Сохраните исходные файлы, чтобы импортировать их снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Із цього пристрою буде вилучено лише завантаження без збережених копій. Зберігайте вихідні файли, щоб імпортувати їх знову."
          }
        }
      }
    },
