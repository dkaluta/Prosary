    "about.peshittaSources": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Peshitta New Testament (BFBS, 1905): Digital Syriac Corpus; Syriac transcription by George A. Kiraz, TEI edition © James E. Walters, CC BY 4.0. Hebrew script conversion using Erez’s rules; verse selection and text formatting by Prosary."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הברית החדשה בפשיטתא (BFBS, 1905): Digital Syriac Corpus; תעתיק הטקסט הסורי מאת George A. Kiraz, מהדורת TEI © James E. Walters, ברישיון CC BY 4.0. המרה לכתב עברי לפי הכללים של ארז; בחירת הפסוקים ועיצוב הטקסט בידי Prosary."
          }
