    "favoriteEditor.presenterModeFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجمع السلامات المريمية والمجد من كل بيت في شاشة واحدة، لتسهيل قيادة صلاة جماعية عن ظهر قلب."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combine each decade's Hail Marys and Glory Be onto one screen — useful when leading a group aloud from memory."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagsamahin sa iisang screen ang mga Aba Ginoong Maria at Luwalhati ng bawat dekada — kapaki-pakinabang kapag nangunguna sa sama-samang pagdarasal mula sa memorya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réunit les Je vous salue Marie et le Gloire au Père de chaque dizaine sur un seul écran — utile pour guider un groupe à voix haute, de mémoire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "איחוד עשר ה“שמחי מרים” וה“כבוד לאב” של כל רז למסך אחד — שימושי למי שמוביל תפילה בציבור בעל־פה."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riunisce le Ave Maria e il Gloria al Padre di ogni decina in un’unica schermata: utile per guidare un gruppo recitando a memoria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объединить «Радуйся, Мария» и «Слава Отцу» каждого десятка на одном экране — удобно, когда ведёте общую молитву наизусть."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати «Радуйся, Маріє» та «Слава Отцю» кожного десятка на одному екрані — зручно для ведення спільної молитви напам’ять."
          }
        }
      }
    },
