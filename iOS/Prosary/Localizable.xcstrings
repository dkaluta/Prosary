    "settings.easternPaschaStyleFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغيّر الأعياد البيزنطية المتنقلة وقراءاتها المقررة معًا. تحتفظ الأعياد الثابتة بتواريخها الغريغورية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes the Byzantine movable feasts and their appointed readings together. Fixed feasts keep their Gregorian dates."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabay na binabago ang mga kapistahang Bizantino na nag-iiba ang petsa at ang mga itinakdang pagbasa. Pinananatili ng mga nakapirming kapistahan ang kanilang mga petsang Gregoriano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifie ensemble les fêtes mobiles byzantines et leurs lectures prescrites. Les fêtes fixes gardent leurs dates grégoriennes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הבחירה משנה יחד את החגים הניידים הביזנטיים ואת המקראות המיועדים להם. חגים קבועים שומרים על תאריכיהם הגרגוריאניים."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica insieme le feste mobili bizantine e le letture prescritte. Le feste fisse mantengono le date gregoriane."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменяет византийские переходящие праздники вместе с положенными чтениями. Непереходящие праздники сохраняют григорианские даты."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змінює рухомі свята візантійського обряду разом із призначеними для них читаннями. Нерухомі свята зберігають григоріанські дати."
          }
        }
      }
    },
