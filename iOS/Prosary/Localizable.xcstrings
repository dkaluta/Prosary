    "prayerFlow.continue.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have an unfinished prayer. Continue where you left off or begin again?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש תפילה שלא הושלמה. להמשיך מהמקום שבו הפסקת או להתחיל מחדש?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك صلاة غير مكتملة. هل تتابع من حيث توقفت أم تبدأ من جديد؟"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас есть незавершённая молитва. Продолжить с места остановки или начать заново?"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayroon kang hindi natapos na panalangin. Magpatuloy kung saan ka huminto o magsimulang muli?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez une prière inachevée. Reprendre où vous en étiez ou recommencer ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai una preghiera non conclusa. Vuoi riprendere da dove eri rimasto o ricominciare?"
          }
        }
      }
    },
