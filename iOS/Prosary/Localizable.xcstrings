    "about.scriptureSources" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم الاقتباسات الكتابية ترجمة دواي–ريمس (الإنجليزية)، والفولغاتا الكليمنتية (اللاتينية)، وترجمة فرانتس دليتش للعهد الجديد بالعبرية (من kirjasilta.net/ha-berit; delitz.fr/12, 1901)، مع نصوص العهد القديم العبرية وفق النص الماسوري، والترجمة اليسوعية القديمة للكتاب المقدس (1897)، والترجمة السينودسية الروسية (1876)، وAng Dating Biblia (التاغالوغ، 1905)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripture quotations use the Douay-Rheims Bible (English), the Clementine Vulgate (Latin), Franz Delitzsch's Hebrew New Testament translation (sourced from kirjasilta.net/ha-berit; delitz.fr/12, 1901) with Hebrew Old Testament passages following the Masoretic text, the Old Jesuit Arabic Bible (1897), the Russian Synodal Bible (1876), and Ang Dating Biblia (Tagalog, 1905)."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga sipi ng Banal na Kasulatan ay mula sa Bibliyang Douay-Rheims (Ingles), Clementine Vulgate (Latin), salin ni Franz Delitzsch ng Bagong Tipan sa Hebreo (mula sa kirjasilta.net/ha-berit; delitz.fr/12, 1901) at mga talata sa Lumang Tipan sa Hebreo na sumusunod sa tekstong Masoretiko, lumang Bibliyang Arabe ng mga Heswita (1897), Bibliyang Sinodal sa Ruso (1876), at Ang Dating Biblia (Tagalog, 1905)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les citations bibliques proviennent de la Bible Douay-Rheims (anglais), de la Vulgate clémentine (latin), de la traduction hébraïque du Nouveau Testament de Franz Delitzsch (kirjasilta.net/ha-berit; delitz.fr/12, 1901), les passages hébreux de l’Ancien Testament suivant le texte massorétique, de l’ancienne Bible arabe des jésuites (1897), de la Bible synodale russe (1876) et d’Ang Dating Biblia (tagalog, 1905)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ציטוטי המקרא לקוחים מביבליית דואיי־רימס (אנגלית), הוולגאטה הקלמנטית (לטינית), תרגום דליטש לברית החדשה (מתוך kirjasilta.net/ha-berit; delitz.fr/12, 1901) עם קטעי התנ״ך על פי נוסח המסורה, תרגום הישועים הישן לביבליה לערבית (1897), הביבליה הסינודלית ברוסית (1876) ו־Ang Dating Biblia (טאגאלוג, 1905)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le citazioni bibliche provengono dalla Bibbia Douay-Rheims (inglese), dalla Vulgata Clementina (latino), dalla traduzione ebraica del Nuovo Testamento di Franz Delitzsch (kirjasilta.net/ha-berit; delitz.fr/12, 1901), con i brani ebraici dell’Antico Testamento tratti dal testo masoretico, dall’antica Bibbia araba dei gesuiti (1897), dalla Bibbia sinodale russa (1876) e da Ang Dating Biblia (tagalog, 1905)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Библейские цитаты взяты из Библии Дуэ — Реймса (английский), Климентинской Вульгаты (латынь), перевода Нового Завета на иврит Франца Делича (источник: kirjasilta.net/ha-berit; delitz.fr/12, 1901), а ветхозаветные отрывки на иврите следуют масоретскому тексту; также используются старый арабский иезуитский перевод Библии (1897), русский Синодальный перевод (1876) и Ang Dating Biblia (тагалог, 1905)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цитати зі Святого Письма взято з Біблії Дуе—Реймса (англійська), Климентинської Вульгати (латина), перекладу Нового Завіту івритом Франца Деліча (джерело: kirjasilta.net/ha-berit; delitz.fr/12, 1901), а старозавітні уривки івритом відповідають масоретському тексту. Також використано старий арабський єзуїтський переклад Біблії (1897), російський Синодальний переклад (1876) та Ang Dating Biblia (тагалог, 1905)."
          }
        }
      }
    },
