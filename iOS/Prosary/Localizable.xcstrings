    "rosaryPicker.anyRosaryDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose mysteries and prayers for this session, and keep it as a preset if you like."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר רזים ותפילות לתפילה זו, ושמור כתבנית אם תרצה."
