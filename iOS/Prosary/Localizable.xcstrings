    "about.typefaces.systemSerifNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer typography can use the platform’s system serif or sans-serif design."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להציג את התפילות בגופן המערכת עם תגים או ללא תגים."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن عرض نصوص الصلوات بخط النظام ذي الزوائد أو من دون زوائد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для молитв можно использовать системный шрифт с засечками или без засечек."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaaring gamitin sa mga panalangin ang sistemang font na serif o sans serif."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prières peuvent utiliser la police système avec ou sans empattement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le preghiere possono usare il carattere di sistema con o senza grazie."
