    "settings.interfaceLanguage.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم للواجهة وللاختيار التلقائي لطبعة الكتاب المقدس. وتتبعها الصلوات ما لم تُحدَّد لغة للصلاة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used for the interface and automatic Bible edition. Prayers follow it unless a prayer language is selected."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginagamit sa interface at awtomatikong pagpili ng edisyon ng Bibliya. Sinusunod ito ng mga panalangin maliban kung may piniling wika ng panalangin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisée pour l’interface et le choix automatique de l’édition biblique. Les prières la suivent sauf si une langue de prière est sélectionnée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משמשת לממשק ולבחירה האוטומטית של מהדורת המקרא. התפילות משתמשות בה אלא אם נבחרה שפת תפילה אחרת."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usata per l’interfaccia e la scelta automatica dell’edizione biblica. Le preghiere la seguono salvo quando viene selezionata una lingua di preghiera."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для интерфейса и автоматического выбора издания Библии. Молитвы следуют ей, если не выбран отдельный язык молитв."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовується для інтерфейсу й автоматичного вибору видання Біблії. Молитви використовують її, якщо не вибрано окрему мову молитов."
          }
        }
      }
    },
