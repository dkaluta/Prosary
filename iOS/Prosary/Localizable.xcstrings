    "about.mysteryImages.easternIcons": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The collection of illustrations of the Mysteries in the Eastern style is used with approval from the Mission of St. Gamaliel for Hebrew Catholics in the Aramaic (Syriac) Catholic Church."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אוסף איורי הרזים בסגנון המזרחי מובא באישור שליחות גמליאל הקדוש לקתולים עבריים של העדה הארמית (סורית) קתולית."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم مجموعة صور الأسرار بالأسلوب الشرقي بموافقة إرسالية القديس غملائيل للكاثوليك الناطقين بالعبرية في الكنيسة الكاثوليكية الآرامية (السريانية)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собрание иллюстраций тайн в восточном стиле используется с разрешения Миссии святого Гамалиила для ивритоязычных католиков Арамейской (Сирийской) католической церкви."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang koleksiyon ng mga larawang Silanganin ng mga Misteryo ay ginagamit nang may pahintulot ng Misyon ni San Gamaliel para sa mga Katolikong Hebreo sa Simbahang Katolikong Aramaiko (Siriako)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La collection d’illustrations des mystères de style oriental est utilisée avec l’autorisation de la Mission de saint Gamaliel pour les catholiques hébréophones de l’Église catholique araméenne (syriaque)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La raccolta di illustrazioni dei misteri in stile orientale è utilizzata con l’autorizzazione della Missione di san Gamaliele per i cattolici di lingua ebraica della Chiesa cattolica aramaica (siriaca)."
          }
        }
      }
    },
    "about.mysteryImages.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All 20 mystery images are classical paintings in the public domain (artist deceased over 100 years), sourced from Wikimedia Commons."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל 20 תמונות הרזים הן ציורים קלאסיים ברשות הציבור (האמן נפטר לפני יותר מ־100 שנים), מתוך ויקישיתוף."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صور الأسرار العشرين كلها لوحات كلاسيكية ضمن الملكية العامة (توفي فنانوها منذ أكثر من 100 عام)، ومصدرها ويكيميديا كومنز."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все 20 изображений тайн — классические картины в общественном достоянии (художники умерли более 100 лет назад), взятые из Викисклада."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang lahat ng 20 larawan ng mga misteryo ay mga klasikong pinta sa pampublikong dominyo (mahigit 100 taon nang yumao ang pintor), mula sa Wikimedia Commons."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 20 illustrations des mystères sont des peintures classiques du domaine public (artiste décédé depuis plus de 100 ans), provenant de Wikimedia Commons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le 20 immagini dei misteri sono dipinti classici di pubblico dominio (artista deceduto da oltre 100 anni), tratti da Wikimedia Commons."
          }
        }
      }
    },
