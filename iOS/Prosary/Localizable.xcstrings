    "about.additionalPrayerSources": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional prayer sources: Vatican News, the Sanctuary of Fatima, Notre-Dame de Paris, AELF and the Italian Episcopal Conference (CEI)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקורות נוספים לתפילות: חדשות הוותיקן, מקדש פטימה, קתדרלת נוטרדאם בפריז, AELF וועידת ההגמונים האיטלקית (CEI)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصادر إضافية للصلوات: أخبار الفاتيكان، ومزار فاطمة، وكاتدرائية نوتردام في باريس، وAELF، ومجلس الأساقفة الإيطالي (CEI)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнительные источники молитв: Vatican News, святилище Фатимы, собор Парижской Богоматери, AELF и Итальянская епископская конференция (CEI)."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iba pang pinagmulan ng mga panalangin: Vatican News, Dambana ng Fatima, Notre-Dame de Paris, AELF at Kapulungan ng mga Obispong Italyano (CEI)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autres sources des prières : Vatican News, sanctuaire de Fatima, Notre-Dame de Paris, AELF et Conférence épiscopale italienne (CEI)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altre fonti delle preghiere: Vatican News, Santuario di Fatima, Notre-Dame de Paris, AELF e Conferenza Episcopale Italiana (CEI)."
          }
        }
      }
    },
