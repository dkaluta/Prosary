# Pushes App Store metadata/screenshots: cd iOS && fastlane deliver
# The ASC API key lives outside the repo (~/.local/share/keystore), like the Play credentials.
app_identifier "com.dkaluta.prosary"
api_key_path "./fastlane/asc_api_key.json"
force true                    # skip the HTML preview prompt — this runs unattended
skip_binary_upload true       # builds ship via Xcode/TestFlight; deliver owns the listing
precheck_include_in_app_purchases false
