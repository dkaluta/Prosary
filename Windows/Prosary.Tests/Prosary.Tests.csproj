<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64;arm64</Platforms>
    <RootNamespace>Prosary.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The test host is an unpackaged process: deploy the Windows App SDK runtime next to it
         (registration-free WinRT) instead of expecting an installed framework package —
         without this, loading any type from Prosary.dll dies in the module initializer with
         REGDB_E_CLASSNOTREG on machines (like CI runners) that lack the runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Self-contained means registration-free activation from the output folder — the
         bootstrap and MSIX DeploymentManager auto-initializers must not run (the latter is
         what threw REGDB_E_CLASSNOTREG from the module initializer on CI). -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250916002" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prosary\Prosary.csproj" />
  </ItemGroup>

  <!-- Copied into this project's own output too (not just Prosary.csproj's) so
       PrayerPackLoaderTests can open the real bundled .prosaryprayer files via
       AppContext.BaseDirectory exactly like App.xaml.cs does at runtime. -->
  <ItemGroup>
    <Content Include="..\Prosary\PrayerPacks\*.prosaryprayer" LinkBase="PrayerPacks">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Prosary\Data\*.json" LinkBase="Data">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
