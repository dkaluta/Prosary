<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Prosary.Controls.PrayerStepFlowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Prosary.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
    Shared chrome for a linear prayer flow with no bead-style progress accessory — used by
    JesusPrayerFlowPage. RosaryPrayerPage does NOT use this control: iOS's own
    equivalent (PrayerStepFlowView.swift) supports the bead track via an `accessory` closure
    parameter, but doing the same here would need a DataTemplate-based accessory slot (see
    RosaryViewModel.TopBeadRows/GroupColumns/BottomBeads, which need genuinely different visual
    representations for narrow vs. wide) — not worth the added fragility with no compiler in this
    environment to verify it against, so RosaryPrayerPage keeps its own full bespoke layout instead
    (matching irosary's own precedent, which never factored this chrome out either). Ported from
    iOS's shared PrayerStepFlowView.swift, minus the accessory slot.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="0" Height="6" Fill="{x:Bind ViewModel.SeasonColor, Mode=OneWay, Converter={StaticResource ColorToBrush}}" />

        <StackPanel Grid.Row="1" Spacing="8" Padding="20,12,20,0">
            <ProgressBar Minimum="0" Maximum="1"
                         Value="{x:Bind ViewModel.Progress, Mode=OneWay, Converter={StaticResource NullableDoubleToValue}}"
                         Visibility="{x:Bind ViewModel.Progress, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
            <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource MutedCaptionTextStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Padding="20"
                      FlowDirection="{x:Bind ViewModel.IsRightToLeft, Mode=OneWay, Converter={StaticResource BoolToFlowDirection}}">
            <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Center">
                <Border Height="240" MaxWidth="240" CornerRadius="16" HorizontalAlignment="Center">
                    <Image Source="{x:Bind ViewModel.MysteryImageFile, Mode=OneWay}" Stretch="UniformToFill" />
                </Border>

                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.HasSubtitle, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource MutedSubtitleTextStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.Header, Mode=OneWay}" Style="{StaticResource SubHeadlineTextStyle}" HorizontalAlignment="Center" />
                </StackPanel>

                <TextBlock controls:BoldMarkdownText.Text="{x:Bind ViewModel.Body, Mode=OneWay}"
                           FontFamily="{x:Bind ViewModel.BodyFontFamily, Mode=OneWay}"
                           FontSize="{x:Bind ViewModel.BodyFontSize, Mode=OneWay}"
                           TextWrapping="Wrap" TextAlignment="Center" />

                <Button Content="{x:Bind CentralActionLabel, Mode=OneWay}"
                        Visibility="{x:Bind VisibleWhenSet(CentralActionLabel), Mode=OneWay}"
                        Command="{x:Bind ViewModel.NextCommand, Mode=OneWay}"
                        Width="104" Height="104" CornerRadius="52" Margin="0,12,0,0"
                        HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Padding="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Back" Command="{x:Bind ViewModel.BackCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" Background="Transparent" />
            <Button Grid.Column="2" Content="{x:Bind ViewModel.NextButtonText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.NextCommand, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" MinWidth="120"
                    Visibility="{x:Bind CollapsedWhenSet(CentralActionLabel), Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
