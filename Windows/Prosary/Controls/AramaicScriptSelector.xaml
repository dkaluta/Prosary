<UserControl
    x:Class="Prosary.Controls.AramaicScriptSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Spacing="4">
        <ToggleButton x:Name="SyriacButton" Click="OnSyriac" MinWidth="48" MinHeight="44" Padding="12,4">
            <TextBlock Text="ܐ" FontFamily="/Assets/Fonts/NotoSansSyriac-Variable.ttf#Noto Sans Syriac" FontSize="24" />
        </ToggleButton>
        <ToggleButton x:Name="HebrewButton" Click="OnHebrew" MinWidth="48" MinHeight="44" Padding="12,4">
            <TextBlock Text="א" FontFamily="/Assets/Fonts/NotoSansHebrew-Variable.ttf#Noto Sans Hebrew" FontSize="24" />
        </ToggleButton>
    </StackPanel>
</UserControl>
