<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Prosary.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Prosary.Converters"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Provides every Fluent Design resource key used throughout this app's XAML
                     (CardBackgroundFillColorDefaultBrush, DividerStrokeColorDefaultBrush,
                     AccentButtonStyle, etc.) — the standard WinUI3 template always merges this
                     first; omitting it (as this project originally did) throws
                     "Cannot find a Resource with the Name/Key ..." at runtime for every one of
                     those keys, not just the first one hit. -->
                <controls:XamlControlsResources />
                <ResourceDictionary Source="ms-appx:///Microsoft.UI.Xaml/DensityStyles/Compact.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Brand colors — ported from iOS's Assets.xcassets / Android's ui/theme/Color.kt,
                 including their light/dark variants: BrandHeadline in particular is a dark maroon
                 that reads fine on a light background but is nearly illegible against a dark one,
                 so both platforms swap it for near-white (and BrandPrimary for a pale, desaturated
                 pink) in dark mode rather than keeping one flat color across both themes. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="BrandPrimaryColor">#7A1F3D</Color>
                    <Color x:Key="BrandHeadlineColor">#4A0E23</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="BrandPrimaryColor">#D8A8B5</Color>
                    <Color x:Key="BrandHeadlineColor">#FFFFFF</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{ThemeResource BrandPrimaryColor}" />
            <!-- Translucent brand wash for chip/tag backgrounds whose text is BrandPrimaryBrush —
                 a solid brand background with white text is unreadable in dark mode, where
                 BrandPrimary is a pale rose. Mirrors iOS's accentColor.opacity(0.15) capsules. -->
            <SolidColorBrush x:Key="BrandPrimaryFaintBrush" Color="{ThemeResource BrandPrimaryColor}" Opacity="0.15" />
            <SolidColorBrush x:Key="BrandHeadlineBrush" Color="{ThemeResource BrandHeadlineColor}" />

            <conv:ColorToBrushConverter x:Key="ColorToBrush" />
            <conv:BoolToFlowDirectionConverter x:Key="BoolToFlowDirection" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:NullableDoubleToValueConverter x:Key="NullableDoubleToValue" />
            <conv:JesusPrayerSetupOptionLabelConverter x:Key="SetupOptionLabel" />
            <conv:EnumDisplayNameConverter x:Key="EnumDisplayName" />
            <conv:LanguageCodeLabelConverter x:Key="LanguageCodeLabel" />
            <conv:JesusPrayerTargetLabelConverter x:Key="JesusPrayerTargetLabel" />
            <conv:PrayerKindIconGlyphConverter x:Key="PrayerKindIconGlyph" />
            <conv:BoolToStarGlyphConverter x:Key="BoolToStarGlyph" />
            <conv:MysteryTitleConverter x:Key="MysteryTitle" />

            <!-- Shared text styles, matching irosary's Styles.xaml naming/intent. -->
            <Style x:Key="HeadlineTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource BrandHeadlineBrush}" />
            </Style>
            <Style x:Key="SubHeadlineTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource BrandHeadlineBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
            <Style x:Key="MutedCaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="MutedSubtitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
