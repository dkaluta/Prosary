<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Prosary.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Prosary.Converters"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Provides every Fluent Design resource key used throughout this app's XAML
                     (CardBackgroundFillColorDefaultBrush, DividerStrokeColorDefaultBrush,
                     AccentButtonStyle, etc.) — the standard WinUI3 template always merges this
                     first; omitting it (as this project originally did) throws
                     "Cannot find a Resource with the Name/Key ..." at runtime for every one of
                     those keys, not just the first one hit. -->
                <controls:XamlControlsResources />
                <ResourceDictionary Source="ms-appx:///Microsoft.UI.Xaml/DensityStyles/Compact.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Blue is the default. AppAppearance updates light/dark palette values while
                 Windows owns contrast colors and the native control interaction states. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="BrandPrimaryColor">#1768AC</Color>
                    <Color x:Key="BrandHeadlineColor">#1768AC</Color>
                    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
                    <SolidColorBrush x:Key="BrandPrimaryFaintBrush" Color="{StaticResource BrandPrimaryColor}" Opacity="0.15" />
                    <SolidColorBrush x:Key="BrandHeadlineBrush" Color="{StaticResource BrandHeadlineColor}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="BrandPrimaryColor">#8DC8FF</Color>
                    <Color x:Key="BrandHeadlineColor">#8DC8FF</Color>
                    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
                    <SolidColorBrush x:Key="BrandPrimaryFaintBrush" Color="{StaticResource BrandPrimaryColor}" Opacity="0.15" />
                    <SolidColorBrush x:Key="BrandHeadlineBrush" Color="{StaticResource BrandHeadlineColor}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="BrandPrimaryFaintBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="BrandHeadlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Keep WinUI's Fluent menu template, focus visuals, and contrast themes.
                 The native template does not consume MenuBar.Padding, so use an outer
                 inset and a minimum height that still grows with the menu content. -->
            <Style x:Key="DesktopMenuBarStyle" TargetType="controls:MenuBar"
                   BasedOn="{StaticResource DefaultMenuBarStyle}">
                <Setter Property="Background" Value="{ThemeResource MenuBarBackground}" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Margin" Value="8,0,8,4" />
            </Style>

            <!-- Native acrylic keeps the date controls translucent, with WinUI's
                 solid fallback for contrast themes and disabled transparency. -->
            <Style x:Key="TodayDateButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="TodayDateFlyoutPresenterStyle" TargetType="FlyoutPresenter"
                   BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
            </Style>

            <conv:ColorToBrushConverter x:Key="ColorToBrush" />
            <conv:BoolToFlowDirectionConverter x:Key="BoolToFlowDirection" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:NullableDoubleToValueConverter x:Key="NullableDoubleToValue" />
            <conv:JesusPrayerSetupOptionLabelConverter x:Key="SetupOptionLabel" />
            <conv:EnumDisplayNameConverter x:Key="EnumDisplayName" />
            <conv:LanguageCodeLabelConverter x:Key="LanguageCodeLabel" />
            <conv:CategoryLabelConverter x:Key="CategoryLabel" />
            <conv:JesusPrayerTargetLabelConverter x:Key="JesusPrayerTargetLabel" />
            <conv:MysteryTitleConverter x:Key="MysteryTitle" />

            <!-- Shared text styles, matching irosary's Styles.xaml naming/intent. -->
            <Style x:Key="HeadlineTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource BrandHeadlineBrush}" />
            </Style>
            <Style x:Key="SubHeadlineTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource BrandHeadlineBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
            <Style x:Key="MutedCaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="MutedSubtitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
            <Style x:Key="PrayerTextColumnStyle" TargetType="StackPanel">
                <Setter Property="MaxWidth" Value="640" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="PrayerBodyTextStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="TextAlignment" Value="Start" />
                <Setter Property="TextReadingOrder" Value="UseFlowDirection" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
