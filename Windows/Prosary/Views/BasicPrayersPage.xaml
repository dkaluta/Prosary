<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Prosary.Views.BasicPrayersPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Prosary.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="4" MaxWidth="640" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,8">
                <TextBlock x:Uid="BasicPrayersTitle" Text="Basic Prayers" Style="{StaticResource SubHeadlineTextStyle}" VerticalAlignment="Center" />
                <!-- Reorderable per Erez (2026-08-08) — the approved Home reorder-dialog pattern. -->
                <Button x:Uid="BasicPrayersEditOrder" Content="Edit order…" HorizontalAlignment="Right"
                        Click="OnEditOrder" />
            </Grid>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BasicPrayerRow">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="8,10"
                                    Command="{Binding ElementName=Root, Path=ViewModel.OpenCommand}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.AutomationId="{x:Bind Id}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="44" Height="44" CornerRadius="8">
                                        <Image Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw">
                                            <Image.Source><BitmapImage UriSource="{x:Bind ImageFile}" /></Image.Source>
                                        </Image>
                                    </Border>
                                    <TextBlock Text="{x:Bind Title}" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Content="{x:Bind FavoriteGlyph}" FontSize="22"
                                    Background="Transparent" BorderThickness="0"
                                    Command="{Binding ElementName=Root, Path=ViewModel.ToggleFavoriteCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
