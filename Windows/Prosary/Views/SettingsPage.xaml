<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Prosary.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Command="{x:Bind ViewModel.BackCommand}" Background="Transparent" Padding="8">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource SubHeadlineTextStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Top">
                <ComboBox Header="Default Prayer Language" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.LanguageOptions}" DisplayMemberPath="NativeName"
                          SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />

                <TextBlock Text="Praying" Style="{StaticResource BaseTextBlockStyle}" Margin="0,8,0,0" />

                <ComboBox Header="Auto-advance" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.AutoAdvanceOptions}" DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.SelectedAutoAdvance, Mode=TwoWay}" />

                <Button Content="Reset Home Order" HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.ResetHomeOrderCommand}" />

                <TextBlock Text="Downloads" Style="{StaticResource BaseTextBlockStyle}" Margin="0,8,0,0" />

                <TextBlock Text="{x:Bind ViewModel.InstalledCountLabel, Mode=OneWay}" />

                <Button Content="{x:Bind ViewModel.AudioCacheLabel, Mode=OneWay}" HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.ClearAudioCacheCommand}" />

                <Button Content="Remove All Downloaded Devotions…" HorizontalAlignment="Stretch"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Command="{x:Bind ViewModel.RequestRemoveAllDownloadsCommand}" />

                <TextBlock Text="Built-in devotions are never removed. Removing a downloaded devotion also removes its favorite."
                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBlock Text="Links" Style="{StaticResource BaseTextBlockStyle}" Margin="0,8,0,0" />

                <HyperlinkButton Content="Community repository"
                                 Command="{x:Bind ViewModel.OpenLinkCommand}" CommandParameter="https://prayers.prosary.app" />
                <HyperlinkButton Content="Compose a devotion"
                                 Command="{x:Bind ViewModel.OpenLinkCommand}" CommandParameter="https://compose.prosary.app" />
                <HyperlinkButton Content="Privacy policy"
                                 Command="{x:Bind ViewModel.OpenLinkCommand}" CommandParameter="https://prosary.app/privacy" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
