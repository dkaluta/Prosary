<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Prosary.Views.SettingsPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Prosary.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Command="{x:Bind ViewModel.BackCommand}" Background="Transparent" Padding="8">
                <FontIcon Glyph="&#xE72B;" MirroredWhenRightToLeft="True" />
            </Button>
            <TextBlock x:Uid="SetTitle" Grid.Column="1" Text="Settings" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource SubHeadlineTextStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Top">
                <ComboBox x:Uid="SetLanguageCombo" Header="Default Prayer Language" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.LanguageOptions}" DisplayMemberPath="NativeName"
                          SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />

                <Button x:Uid="SetLanguageFallbackOrder" Content="Language fallback order…"
                        HorizontalAlignment="Stretch" Click="OnEditLanguageFallbackOrder" />

                <!-- Whose use of that language — shown only where there is more than one. -->
                <ComboBox x:Uid="SetRiteCombo" Header="Prayer tradition" HorizontalAlignment="Stretch"
                          Visibility="{x:Bind ViewModel.ShowsRitePicker, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                          ItemsSource="{x:Bind ViewModel.RiteOptions, Mode=OneWay}" DisplayMemberPath="NativeName"
                          SelectedItem="{x:Bind ViewModel.SelectedRite, Mode=TwoWay}" />

                <ComboBox x:Uid="SetAramaicSignOfCrossCombo" Header="Aramaic Sign of the Cross"
                          HorizontalAlignment="Stretch"
                          Visibility="{x:Bind ViewModel.ShowsAramaicSignOfCrossPicker, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                          ItemsSource="{x:Bind ViewModel.AramaicSignOfCrossOptions}"
                          DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.SelectedAramaicSignOfCross, Mode=TwoWay}" />

                <ComboBox x:Uid="SetAppLanguageCombo" Header="App language" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.AppLanguageOptions}" DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.SelectedAppLanguage, Mode=TwoWay}" />
                <TextBlock x:Uid="SetAppLanguageFooter" Text="Takes effect after the app restarts."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBlock x:Uid="SetPrayingHeader" Text="Praying" Style="{StaticResource BaseTextBlockStyle}" Margin="0,8,0,0" />

                <ComboBox x:Uid="SetAutoAdvanceCombo" Header="Auto-advance" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.AutoAdvanceOptions}" DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.SelectedAutoAdvance, Mode=TwoWay}" />

                <Button x:Uid="SetResetHomeOrder" Content="Reset Home Order" HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.ResetHomeOrderCommand}" />

                <TextBlock x:Uid="SetTypographyHeader" Text="Typography" Style="{StaticResource BaseTextBlockStyle}" Margin="0,8,0,0" />
                <ComboBox x:Uid="SetAramaicDefaultScript" Header="Default Aramaic script" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.AramaicScriptOptions}" DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.SelectedAramaicScript, Mode=TwoWay}" />
                <ComboBox x:Uid="SetSyriacTypeface" Header="Aramaic font" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.SyriacTypefaceOptions}" DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.SelectedSyriacTypeface, Mode=TwoWay}" />
                <ComboBox x:Uid="SetHebrewPrayerTypeface" Header="Hebrew font" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.HebrewPrayerTypefaceOptions}" DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.SelectedHebrewPrayerTypeface, Mode=TwoWay}" />
                <ComboBox x:Uid="SetHebrewScriptureTypeface" Header="Hebrew Scripture font" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.HebrewScriptureTypefaceOptions}" DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.SelectedHebrewScriptureTypeface, Mode=TwoWay}" />
                <ComboBox x:Uid="SetLatinPrayerTypeface" Header="Latin-script prayers" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.SystemPrayerTypefaceOptions}" DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.SelectedLatinPrayerTypeface, Mode=TwoWay}" />
                <ComboBox x:Uid="SetCyrillicPrayerTypeface" Header="Cyrillic prayers" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.SystemPrayerTypefaceOptions}" DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.SelectedCyrillicPrayerTypeface, Mode=TwoWay}" />

                <ToggleSwitch x:Uid="SetPrayerNameLanguage" Header="Show prayer names in the prayer language"
                              IsOn="{x:Bind ViewModel.ShowPrayerNameInPrayerLanguage, Mode=TwoWay}"
                              AutomationProperties.AutomationId="showPrayerNameInPrayerLanguage" />
                <TextBlock x:Uid="SetPrayerNameLanguageHint" Text="Also show the interface-language name when it differs."
                           TextWrapping="Wrap" Style="{StaticResource MutedCaptionTextStyle}" />

                <!-- The Home "Today" section: which of its rows show at all, and which
                     calendar's feasts the feast row prays. The calendar choices come from the
                     bundled calendars.json registry (labels included, so no resw entries per
                     calendar); the picker hides entirely if the registry ever ships a single
                     calendar. -->
                <TextBlock x:Uid="SetTodayHeader" Text="Today" Style="{StaticResource BaseTextBlockStyle}" Margin="0,8,0,0" />

                <ToggleSwitch x:Uid="SetShowTodayFeast" Header="Show the day's feast"
                              IsOn="{x:Bind ViewModel.ShowTodayFeast, Mode=TwoWay}" />
                <ToggleSwitch x:Uid="SetShowTodayIntention" Header="Show the Pope's intention"
                              IsOn="{x:Bind ViewModel.ShowTodayIntention, Mode=TwoWay}" />
                <ToggleSwitch x:Uid="SetShowTodayTorahPortion" Header="Show the weekly Torah portion"
                              IsOn="{x:Bind ViewModel.ShowTodayTorahPortion, Mode=TwoWay}"
                              AutomationProperties.AutomationId="showTodayTorahPortion" />
                <TextBlock x:Uid="SetTorahPortionHint" Text="The coming Sabbath’s reading in Eretz Israel, including festival readings."
                           Visibility="{x:Bind ViewModel.ShowTodayTorahPortion, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                           TextWrapping="Wrap" Style="{StaticResource MutedCaptionTextStyle}" />

                <ComboBox x:Uid="SetFeastCalendar" Header="Liturgical calendar" HorizontalAlignment="Stretch"
                          Visibility="{x:Bind ViewModel.ShowsFeastCalendarPicker, Converter={StaticResource BoolToVisibility}}"
                          ItemsSource="{x:Bind ViewModel.FeastCalendarOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedFeastCalendar, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Uid="SetFeastCalendarHint" Text="Which calendar the Today section's feasts and readings follow."
                           Visibility="{x:Bind ViewModel.ShowsFeastCalendarPicker, Converter={StaticResource BoolToVisibility}}"
                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Uid="SetEasternPascha" Header="Byzantine Easter calculation" HorizontalAlignment="Stretch"
                          Visibility="{x:Bind ViewModel.ShowsEasternPaschaPicker, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                          ItemsSource="{x:Bind ViewModel.EasternPaschaOptions}" DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.SelectedEasternPascha, Mode=TwoWay}"
                          AutomationProperties.AutomationId="easternPaschaStyle" />

                <TextBlock x:Uid="SetDownloadsHeader" Text="Downloads" Style="{StaticResource BaseTextBlockStyle}" Margin="0,8,0,0" />

                <TextBlock Text="{x:Bind ViewModel.InstalledCountLabel, Mode=OneWay}" />

                <!-- Importing, exporting and removing a devotion moved here when the Favorites
                     screen was retired: Downloads is where the Mac keeps them too. -->
                <Button x:Uid="SetImportBundle" Content="Import Devotion Bundle…" HorizontalAlignment="Stretch"
                        Click="OnImportBundle" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.InstalledDevotions, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.HasInstalledDevotions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:InstalledDevotionRow">
                            <Grid ColumnSpacing="8" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Grid.Column="1" x:Uid="SetExportBundle" Background="Transparent" Padding="8"
                                        ToolTipService.ToolTip="Export for editing"
                                        Click="OnExportBundle" Tag="{x:Bind BundleId}">
                                    <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                                </Button>
                                <Button Grid.Column="2" x:Uid="SetRemoveBundle" Background="Transparent" Padding="8"
                                        ToolTipService.ToolTip="Remove"
                                        Command="{Binding ElementName=Root, Path=ViewModel.RemoveInstalledCommand}"
                                        CommandParameter="{Binding}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="{x:Bind ViewModel.AudioCacheLabel, Mode=OneWay}" HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.ClearAudioCacheCommand}" />

                <Button x:Uid="SetRemoveAll" Content="Remove All Downloaded Devotions…" HorizontalAlignment="Stretch"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Command="{x:Bind ViewModel.RequestRemoveAllDownloadsCommand}" />

                <TextBlock x:Uid="SetDownloadsFooter" Text="Built-in devotions are never removed. Removing a downloaded devotion also removes its favorite."
                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBlock x:Uid="SetLinksHeader" Text="Links" Style="{StaticResource BaseTextBlockStyle}" Margin="0,8,0,0" />

                <HyperlinkButton x:Uid="SetRepoLink" Content="Community repository"
                                 Command="{x:Bind ViewModel.OpenLinkCommand}" CommandParameter="https://prayers.prosary.app" />
                <HyperlinkButton x:Uid="SetComposeLink" Content="Compose a devotion"
                                 Command="{x:Bind ViewModel.OpenLinkCommand}" CommandParameter="https://compose.prosary.app" />
                <HyperlinkButton x:Uid="SetPrivacyLink" Content="Privacy policy"
                                 Command="{x:Bind ViewModel.OpenLinkCommand}" CommandParameter="https://prosary.app/privacy" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
