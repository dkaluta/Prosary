<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Prosary.Views.RosaryPresetPickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Prosary.Models"
    x:Name="Root"
    mc:Ignorable="d">

    <!-- Home → Rosary preset picker: default preset up top, "Pray any Rosary" (ad-hoc mystery
         selection inheriting the rest from the default preset — see the ViewModel's doc
         comment), then the remaining presets. Mirrors iOS's RosaryPresetPickerView. -->
    <Page.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
        </Style>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <DataTemplate x:Key="PresetCardTemplate" x:DataType="models:Prayer">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="14" Margin="0,4">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="{Binding FavoriteSubtitle}" Style="{StaticResource MutedCaptionTextStyle}" />
                    <Button x:Uid="BtnPray" Content="Pray" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding ElementName=Root, Path=ViewModel.PrayPresetCommand}" CommandParameter="{Binding}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Background="Transparent" Command="{x:Bind ViewModel.BackCommand}">
                <FontIcon Glyph="&#xE72B;" MirroredWhenRightToLeft="True" />
            </Button>
            <TextBlock x:Uid="PickerTitle" Grid.Column="1" Text="The Holy Rosary" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource SubHeadlineTextStyle}" />
            <Button Grid.Column="2" Content="Manage" Background="Transparent" Command="{x:Bind ViewModel.ManagePresetsCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12" MaxWidth="480" HorizontalAlignment="Center" Padding="16">

                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasDefaultPreset, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock x:Uid="PickerDefaultHeader" Text="DEFAULT PRESET" Style="{StaticResource SectionHeaderStyle}" />
                    <ContentControl Content="{x:Bind ViewModel.DefaultPreset, Mode=OneWay}" ContentTemplate="{StaticResource PresetCardTemplate}" HorizontalContentAlignment="Stretch" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock x:Uid="PickerCustomHeader" Text="CUSTOM" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="PickerPrayAny" Text="Pray any Rosary" FontWeight="SemiBold" FontSize="16" />
                            <ComboBox HorizontalAlignment="Stretch" Header="Mysteries" ItemsSource="{x:Bind ViewModel.SelectionModes}"
                                      SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplayName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox HorizontalAlignment="Stretch" Header="Specific set" ItemsSource="{x:Bind ViewModel.Groups}"
                                      SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}"
                                      Visibility="{x:Bind ViewModel.ShowsGroupPicker, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplayName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox HorizontalAlignment="Stretch" Header="Which mystery (1–5)" ItemsSource="{x:Bind ViewModel.Ordinals}"
                                      SelectedItem="{x:Bind ViewModel.SelectedOrdinal, Mode=TwoWay}"
                                      Visibility="{x:Bind ViewModel.ShowsOrdinalPicker, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock x:Uid="PickerAnyDetail" Text="Every other option follows your default preset — full customization lives in presets."
                                       Style="{StaticResource MutedCaptionTextStyle}" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Uid="BtnPray" Grid.Column="0" Content="Pray" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.PrayAdHocCommand}" />
                                <Button x:Uid="PickerSaveAsPreset" Grid.Column="1" Content="Save as Preset" HorizontalAlignment="Stretch" Click="OnSaveAsPreset" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasOtherPresets, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock x:Uid="PickerPresetsHeader" Text="PRESETS" Style="{StaticResource SectionHeaderStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.OtherPresets, Mode=OneWay}" ItemTemplate="{StaticResource PresetCardTemplate}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
