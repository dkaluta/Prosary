<UserControl x:Class="Prosary.Views.ScriptureOfDayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12" Padding="0,0,0,12">
        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
        <ComboBox Header="{x:Bind Readings.EditionLabel}" ItemsSource="{x:Bind Readings.Editions}" DisplayMemberPath="Label"
                  SelectedItem="{x:Bind Readings.SelectedEdition, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        <TextBlock x:Name="DateHeading" TextWrapping="Wrap" Style="{StaticResource MutedCaptionTextStyle}" />
        <TextBlock x:Name="EmptyMessage" Text="{x:Bind EmptyLabel}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{x:Bind Readings.ScriptureOfDay, Mode=OneWay}" ItemTemplate="{StaticResource ReadingPassageTemplate}" />
    </StackPanel>
</UserControl>
