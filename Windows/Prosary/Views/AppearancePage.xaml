<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Prosary.Views.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Prosary.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Command="{x:Bind ViewModel.BackCommand}" Background="Transparent" Padding="8"
                    AutomationProperties.Name="{x:Bind ViewModel.BackLabel}"
                    AutomationProperties.AutomationId="appearanceBack"
                    ToolTipService.ToolTip="{x:Bind ViewModel.BackLabel}">
                <FontIcon Glyph="&#xE72B;" MirroredWhenRightToLeft="True" />
            </Button>
            <TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{x:Bind ViewModel.Title}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Style="{StaticResource SubHeadlineTextStyle}" />
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalContentAlignment="Stretch"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <Grid HorizontalAlignment="Stretch">
                <StackPanel Padding="24" HorizontalAlignment="Stretch" Spacing="12">
                    <TextBlock TextWrapping="Wrap" Text="{x:Bind ViewModel.ColorLabel}" Style="{StaticResource BaseTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <ListView ItemsSource="{x:Bind ViewModel.AppColorOptions}" SelectionMode="Single"
                                  SelectedItem="{x:Bind ViewModel.SelectedAppColor, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind ViewModel.ColorLabel}"
                                  AutomationProperties.AutomationId="appColor">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="12,0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppColorChoiceViewModel">
                                    <Grid ColumnSpacing="16" AutomationProperties.Name="{x:Bind Label}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="24" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Image Source="{x:Bind IconSource}" Width="64" Height="64" Margin="0,12"
                                               AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Label}" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="18"
                                                  Foreground="{ThemeResource BrandPrimaryBrush}"
                                                  AutomationProperties.AccessibilityView="Raw"
                                                  Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="1"
                                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                Visibility="{x:Bind HasSeparator, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
