<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Prosary.Views.RemindersOnlyEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d">

    <!-- Lightweight reminders-only editor for the 5 non-configurable devotion kinds — reachable
         from FavoritesListPage's star row bell button. Ported from iOS's
         RemindersOnlyEditorView/Android's RemindersOnlyEditorScreen.kt. Mirrors
         FavoriteEditorPage's Reminders section exactly (same ReminderRowTemplate shape), since
         both bind through the shared RemindersEditorViewModel. -->
    <Page.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
        </Style>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <DataTemplate x:Key="ReminderRowTemplate">
            <Grid ColumnSpacing="8" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TimePicker Grid.Column="0" HorizontalAlignment="Left" Time="{Binding AsTimeSpan}"
                            TimeChanged="OnReminderTimeChanged" />
                <Button Grid.Column="1" Background="Transparent" Padding="6"
                        Command="{Binding ElementName=Root, Path=ViewModel.RemindersEditor.RemoveReminderCommand}" CommandParameter="{Binding}">
                    <FontIcon Glyph="&#xE74D;" Foreground="Red" />
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel" Background="Transparent" Command="{x:Bind ViewModel.CancelCommand}" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Title, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource SubHeadlineTextStyle}" />
            <Button Grid.Column="2" Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20" MaxWidth="480" HorizontalAlignment="Center" Padding="16">

                <StackPanel Spacing="8">
                    <TextBlock Text="REMINDERS" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="8">
                            <!-- Traditional fixed prayer times from the bundle manifest's
                                 reminderPresetHours (the Angelus's 6am/noon/6pm bells) — quick
                                 toggles, one per preset hour. -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.RemindersEditor.HasPresetHours, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Grid Visibility="{x:Bind ViewModel.RemindersEditor.Shows6AmPreset, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="6:00 AM" VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.RemindersEditor.Is6AmEnabled, Mode=OneWay}" Toggled="OnPreset6AmToggled" />
                                </Grid>
                                <Grid Visibility="{x:Bind ViewModel.RemindersEditor.ShowsNoonPreset, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="12:00 PM" VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.RemindersEditor.IsNoonEnabled, Mode=OneWay}" Toggled="OnPresetNoonToggled" />
                                </Grid>
                                <Grid Visibility="{x:Bind ViewModel.RemindersEditor.Shows6PmPreset, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="6:00 PM" VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.RemindersEditor.Is6PmEnabled, Mode=OneWay}" Toggled="OnPreset6PmToggled" />
                                </Grid>
                            </StackPanel>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.RemindersEditor.CustomReminders, Mode=OneWay}" ItemTemplate="{StaticResource ReminderRowTemplate}" />

                            <Button Command="{x:Bind ViewModel.RemindersEditor.AddReminderCommand}" Background="Transparent">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Add Reminder" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{x:Bind ViewModel.RemindersEditor.PresetFooter, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.RemindersEditor.ShowsPresetFooter, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource MutedCaptionTextStyle}" TextWrapping="Wrap" Margin="4,0" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
