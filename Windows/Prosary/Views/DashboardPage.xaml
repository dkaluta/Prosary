<Page x:Class="Prosary.Views.DashboardPage" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Prosary.ViewModels"
    xmlns:controls="using:Prosary.Controls"
    xmlns:svc="using:Prosary.Services"
    FlowDirection="{x:Bind ContentDirection}">
    <Page.Resources>
        <DataTemplate x:Key="SelectedWidgetTemplate" x:DataType="vm:HomeWidgetCard">
            <Grid Padding="0,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Click="OnMoveUp" AutomationProperties.Name="{x:Bind MoveUpLabel}" ToolTipService.ToolTip="{x:Bind MoveUpLabel}"><FontIcon Glyph="&#xE70E;" /></Button>
                <Button Grid.Column="2" Click="OnMoveDown" AutomationProperties.Name="{x:Bind MoveDownLabel}" ToolTipService.ToolTip="{x:Bind MoveDownLabel}"><FontIcon Glyph="&#xE70D;" /></Button>
                <Button Grid.Column="3" Click="OnRemoveWidget" AutomationProperties.Name="{x:Bind RemoveLabel}" ToolTipService.ToolTip="{x:Bind RemoveLabel}"><FontIcon Glyph="&#xE74D;" /></Button>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AvailableWidgetTemplate" x:DataType="vm:HomeWidgetCard">
            <Button Click="OnAddWidget" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE710;" /><TextBlock Grid.Column="1" Text="{x:Bind Title}" TextWrapping="Wrap" />
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource HeadlineTextStyle}" />
            <Button Grid.Column="1" Content="{x:Bind ViewModel.CustomizeLabel}" Click="OnCustomize" />
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="840" HorizontalAlignment="Stretch" Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.EmptyLabel}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HomeWidgetCard">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <controls:PapalKeysIcon Foreground="{ThemeResource BrandPrimaryBrush}" Visibility="{x:Bind IsPopeIntention, Converter={StaticResource BoolToVisibility}}" />
                                        <FontIcon Glyph="{x:Bind Glyph}" Foreground="{ThemeResource BrandPrimaryBrush}" Visibility="{x:Bind IsPopeIntention, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubHeadlineTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Body, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind HasBody, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Visibility="{x:Bind IsPhoto, Converter={StaticResource BoolToVisibility}}" Spacing="12">
                                        <Image Source="{x:Bind PhotoSource, Mode=OneWay}" Stretch="Uniform" MaxHeight="420" HorizontalAlignment="Center" ImageFailed="OnPhotoFailed" AutomationProperties.Name="{x:Bind PhotoDescription}" Visibility="{x:Bind HasPhoto, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{x:Bind ChoosePhotoLabel}" Click="OnChoosePhoto" />
                                            <Button Content="{x:Bind RemovePhotoLabel}" Click="OnRemovePhoto" Visibility="{x:Bind HasPhoto, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{x:Bind Reminders, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:HomeReminderRow">
                                            <Button Click="OnEditReminder" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" /><TextBlock Grid.Column="1" Text="{x:Bind Time}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Expander Header="{x:Bind DetailsLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind IsFeast, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="{x:Bind NoDescriptionLabel}" TextWrapping="Wrap" Visibility="{x:Bind HasNoDescriptions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            <ItemsControl ItemsSource="{x:Bind Descriptions, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate><DataTemplate x:DataType="svc:SaintDescription">
                                                    <StackPanel Spacing="8" Margin="0,0,0,12">
                                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                                   Visibility="{x:Bind ShowsTitle, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                                   Visibility="{x:Bind ShowsUnsectionedText, Converter={StaticResource BoolToVisibility}}" />
                                                        <ItemsControl ItemsSource="{x:Bind Sections}"
                                                                      Visibility="{x:Bind ShowsSections, Converter={StaticResource BoolToVisibility}}">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="16" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="svc:LocalizedCalendarTextSection">
                                                                <StackPanel Spacing="8">
                                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                                               AutomationProperties.HeadingLevel="Level3" />
                                                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                                </StackPanel>
                                                            </DataTemplate></ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{x:Bind Credit}" TextWrapping="Wrap" Style="{StaticResource MutedCaptionTextStyle}" Visibility="{x:Bind HasCredit, Converter={StaticResource BoolToVisibility}}" />
                                                        <HyperlinkButton NavigateUri="{x:Bind SourceUri}" Content="{x:Bind SourceLabel}" HorizontalAlignment="Left" Visibility="{x:Bind HasSource, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                    <ItemsControl ItemsSource="{x:Bind Descriptions, Mode=OneWay}" Visibility="{x:Bind IsReflection, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="svc:SaintDescription">
                                            <StackPanel Spacing="8" Margin="0,0,0,12">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Text="{x:Bind Credit}" TextWrapping="Wrap" Style="{StaticResource MutedCaptionTextStyle}" Visibility="{x:Bind HasCredit, Converter={StaticResource BoolToVisibility}}" />
                                                <HyperlinkButton NavigateUri="{x:Bind SourceUri}" Content="{x:Bind SourceLabel}" HorizontalAlignment="Left" Visibility="{x:Bind HasSource, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="{x:Bind ActionTitle}" Click="OnCardAction" HorizontalAlignment="Left" Visibility="{x:Bind HasAction, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
