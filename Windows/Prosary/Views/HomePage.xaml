<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Prosary.Views.HomePage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Prosary.Controls"
    xmlns:vm="using:Prosary.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="960" HorizontalAlignment="Center" Padding="20">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="HomeTitle" Grid.Column="0" Text="Pray" Style="{StaticResource HeadlineTextStyle}" VerticalAlignment="Center" />
                <!-- Puts a devotion back on Pray; hidden once everything installed is here. -->
                <!-- The same menu the Mac's + opens: an ad-hoc Rosary, a new preset of either
                     configurable kind, and then anything currently off the Pray list. -->
                <Button x:Uid="HomeAddDevotionButton" Grid.Column="1" Background="Transparent" Padding="8" ToolTipService.ToolTip="Add a prayer">
                    <FontIcon Glyph="&#xE710;" />
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="4" MinWidth="240">
                                <HyperlinkButton x:Uid="HomePrayAnyRosary" Content="Pray any Rosary" HorizontalAlignment="Stretch"
                                                 Command="{x:Bind ViewModel.PrayAnyRosaryCommand}" />
                                <HyperlinkButton x:Uid="HomeAddRosary" Content="Add Rosary" HorizontalAlignment="Stretch"
                                                 Command="{x:Bind ViewModel.AddRosaryPresetCommand}" />
                                <HyperlinkButton x:Uid="HomeAddJesusPrayer" Content="Add Jesus Prayer" HorizontalAlignment="Stretch"
                                                 Command="{x:Bind ViewModel.AddJesusPrayerPresetCommand}" />
                                <StackPanel Spacing="4"
                                            Visibility="{x:Bind ViewModel.HasUnpinnedCards, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock x:Uid="HomeAddToPrayHeader" Text="Add to Pray" Margin="12,8,0,0"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.UnpinnedCards, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DevotionCardModel">
                                                <HyperlinkButton Content="{x:Bind Title}" HorizontalAlignment="Stretch"
                                                                 Command="{Binding ElementName=Root, Path=ViewModel.PinCardCommand}"
                                                                 CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <!-- Reordering is a header button here too, not only a card's menu. -->
                <Button x:Uid="HomeEditOrderButton" Grid.Column="2" Background="Transparent" Padding="8" ToolTipService.ToolTip="Edit order…"
                        Click="OnEditOrder">
                    <FontIcon Glyph="&#xE8CB;" />
                </Button>
                <Button x:Uid="HomeSettingsButton" Grid.Column="3" Background="Transparent" Padding="8" ToolTipService.ToolTip="Settings"
                        Command="{x:Bind ViewModel.OpenSettingsCommand}">
                    <FontIcon Glyph="&#xE713;" />
                </Button>
                <Button x:Uid="HomeAboutButton" Grid.Column="4" Background="Transparent" Padding="8" ToolTipService.ToolTip="About"
                        Command="{x:Bind ViewModel.OpenAboutCommand}">
                    <FontIcon Glyph="&#xE946;" />
                </Button>
            </Grid>

            <!-- "Today" — the day's feast and readings from the selected calendar, plus the
                 Pope's monthly prayer intention. Rows hide when the bundled datasets have no
                 entry (ferial days; dates past the generated years). -->
            <Border Style="{StaticResource SectionCardStyle}"
                    Visibility="{x:Bind ViewModel.ShowsTodaySection, Converter={StaticResource BoolToVisibility}}"
                    FlowDirection="{x:Bind ViewModel.TodayInHebrew, Mode=OneWay, Converter={StaticResource BoolToFlowDirection}}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE787;" Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TodayDayText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                                   TextAlignment="{x:Bind ViewModel.TodayTextAlignment, Mode=OneWay}" />
                        <HyperlinkButton Grid.Column="2" Content="{x:Bind ViewModel.TodayLanguageButtonText, Mode=OneWay}"
                                         Command="{x:Bind ViewModel.ToggleTodayLanguageCommand}" />
                    </Grid>
                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.ShowsTodayFeast, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE787;" Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.TodayFeastTitle, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       TextAlignment="{x:Bind ViewModel.TodayTextAlignment, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.TodayFeastRank, Mode=OneWay}" Style="{StaticResource MutedCaptionTextStyle}"
                                       TextAlignment="{x:Bind ViewModel.TodayTextAlignment, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.ShowsMonthIntention, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xEB51;" Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.MonthIntentionTitle, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       TextAlignment="{x:Bind ViewModel.TodayTextAlignment, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.MonthIntentionText, Mode=OneWay}" Style="{StaticResource MutedCaptionTextStyle}" TextWrapping="Wrap"
                                       TextAlignment="{x:Bind ViewModel.TodayTextAlignment, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.ShowsTodayReadings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8A9;" Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.TodayReadingsTitle, Mode=OneWay}" FontWeight="SemiBold"
                                       TextAlignment="{x:Bind ViewModel.TodayTextAlignment, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.ReadingsText, Mode=OneWay}" Style="{StaticResource MutedCaptionTextStyle}" TextWrapping="Wrap"
                                       TextAlignment="{x:Bind ViewModel.TodayTextAlignment, Mode=OneWay}" />
                            <HyperlinkButton Content="{x:Bind ViewModel.CitationButtonText, Mode=OneWay}"
                                             Command="{x:Bind ViewModel.ToggleCitationsCommand}"
                                             HorizontalAlignment="{x:Bind ViewModel.TodayContentAlignment, Mode=OneWay}" Padding="0,4" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{x:Bind ViewModel.DevotionCards}" MaxWidth="560" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DevotionCardModel">
                        <controls:PrayerCard Title="{x:Bind Title}"
                                              Subtitle="{x:Bind Subtitle, Mode=OneWay}"
                                              AccentColor="{x:Bind AccentColor, Mode=OneWay}"
                                              IconGlyph="{x:Bind IconGlyph}"
                                              Command="{x:Bind Command}">
                            <controls:PrayerCard.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="HomeReminders" Text="Reminders…"
                                                    Command="{Binding ElementName=Root, Path=ViewModel.OpenRemindersCommand}"
                                                    CommandParameter="{Binding}" />
                                    <MenuFlyoutItem x:Uid="HomeMoveToTop" Text="Move to top"
                                                    Command="{Binding ElementName=Root, Path=ViewModel.MoveCardToTopCommand}"
                                                    CommandParameter="{Binding}" />
                                    <MenuFlyoutItem x:Uid="HomeEditOrder" Text="Edit order…" Click="OnEditOrder" />
                                    <MenuFlyoutItem x:Uid="HomeRemoveFromPray" Text="Remove from Pray"
                                                    Command="{Binding ElementName=Root, Path=ViewModel.UnpinCardCommand}"
                                                    CommandParameter="{Binding}" />
                                </MenuFlyout>
                            </controls:PrayerCard.ContextFlyout>
                        </controls:PrayerCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The basic prayers on their own (Erez, 2026-08-07) — a fixed quiet row below the
                 cards, not a pinnable card: a reference shelf, not a devotion, so it neither
                 reorders nor unpins. Always present, which is the point of the ask. -->
            <Button Click="OnOpenBasicPrayers" HorizontalAlignment="Stretch" MaxWidth="560"
                    HorizontalContentAlignment="Stretch" Padding="16,12"
                    AutomationProperties.AutomationId="basicPrayersRow">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE8F1;" />
                    <TextBlock x:Uid="BasicPrayersTitle" Grid.Column="1" Text="Basic Prayers" VerticalAlignment="Center" />
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" MirroredWhenRightToLeft="True" FontSize="12" />
                </Grid>
            </Button>

        </StackPanel>
    </ScrollViewer>
</Page>
