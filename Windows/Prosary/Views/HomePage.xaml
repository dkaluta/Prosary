<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Prosary.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Prosary.Controls"
    xmlns:vm="using:Prosary.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="960" HorizontalAlignment="Center" Padding="20">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Pray" Style="{StaticResource HeadlineTextStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Background="Transparent" Padding="8" ToolTipService.ToolTip="My Favorites"
                        Command="{x:Bind ViewModel.OpenFavoritesCommand}">
                    <FontIcon Glyph="&#xE734;" />
                </Button>
                <Button Grid.Column="2" Background="Transparent" Padding="8" ToolTipService.ToolTip="Settings"
                        Command="{x:Bind ViewModel.OpenSettingsCommand}">
                    <FontIcon Glyph="&#xE713;" />
                </Button>
                <Button Grid.Column="3" Background="Transparent" Padding="8" ToolTipService.ToolTip="About"
                        Command="{x:Bind ViewModel.OpenAboutCommand}">
                    <FontIcon Glyph="&#xE946;" />
                </Button>
            </Grid>

            <!-- "Today" — the day's feast per the Holy Land (Latin Patriarchate of Jerusalem)
                 calendar and the Pope's monthly prayer intention. Rows hide when the bundled
                 datasets have no entry (ferial days; dates past the generated years). -->
            <Border Style="{StaticResource SectionCardStyle}"
                    Visibility="{x:Bind ViewModel.ShowsTodaySection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.ShowsTodayFeast, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE787;" Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.TodayFeastTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.TodayFeastRank}" Style="{StaticResource MutedCaptionTextStyle}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.ShowsMonthIntention, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xEB51;" Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.MonthIntentionTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.MonthIntentionText}" Style="{StaticResource MutedCaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{x:Bind ViewModel.DevotionCards}" MaxWidth="560" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DevotionCardModel">
                        <controls:PrayerCard Title="{x:Bind Title}"
                                              Subtitle="{x:Bind Subtitle, Mode=OneWay}"
                                              AccentColor="{x:Bind AccentColor, Mode=OneWay}"
                                              IconGlyph="{x:Bind IconGlyph}"
                                              Command="{x:Bind Command}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
