<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Prosary.Views.FavoritesListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d">

    <!-- Card-layout list of saved prayer favorites grouped by kind — ported from Android's
         FavoritesListScreen.kt. Item-level command bindings use classic {Binding ElementName=Root}
         rather than {x:Bind} since the DataTemplate's own DataContext is the Prayer item, not this
         page, and {x:Bind} inside a DataTemplate can't reach an ancestor page property directly. -->
    <Page.Resources>
        <DataTemplate x:Key="FavoriteCardTemplate">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14" Padding="14" Margin="0,4">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <FontIcon Grid.Column="1" Glyph="&#xE735;" Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Center"
                                  Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}" />
                        <Button Grid.Column="2" Background="Transparent" Padding="6"
                                Command="{Binding ElementName=Root, Path=ViewModel.EditCommand}" CommandParameter="{Binding}">
                            <FontIcon Glyph="&#xE70F;" />
                        </Button>
                        <Button Grid.Column="3" Background="Transparent" Padding="6"
                                Command="{Binding ElementName=Root, Path=ViewModel.DeleteCommand}" CommandParameter="{Binding}">
                            <FontIcon Glyph="&#xE74D;" Foreground="Red" />
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding FavoriteSubtitle}" Style="{StaticResource MutedCaptionTextStyle}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="BtnPray" Content="Pray" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding ElementName=Root, Path=ViewModel.PrayCommand}" CommandParameter="{Binding}" />
                        <Button x:Uid="FavSetDefault" Content="Set Default"
                                Visibility="{Binding IsNotDefault, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding ElementName=Root, Path=ViewModel.MakeDefaultCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One row per non-configurable devotion kind — a star toggle and, once favorited, a
             reminders button. No name/language editing and no "+ Add another" (see
             FavoritesViewModel/SimpleFavoriteRow). -->
        <DataTemplate x:Key="SimpleFavoriteRowTemplate">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14" Padding="10,8" Margin="0,4">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Background="Transparent" Padding="6"
                            Command="{Binding ElementName=Root, Path=ViewModel.ToggleSimpleFavoriteCommand}" CommandParameter="{Binding}">
                        <FontIcon Glyph="{Binding IsFavorited, Converter={StaticResource BoolToStarGlyph}}" Foreground="{StaticResource BrandPrimaryBrush}" />
                    </Button>
                    <FontIcon Grid.Column="1" Glyph="{Binding IconGlyph}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                        <!-- "Repository" tag for bundles installed from prayers.prosary.app (repo.* ids).
                             Faint brand wash + brand text, readable in both themes (white on the
                             dark theme's pale-rose brand was not). -->
                        <Border Background="{StaticResource BrandPrimaryFaintBrush}" CornerRadius="8" Padding="6,1"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsFromRepository, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock x:Uid="FavRepoBadge" Text="Repository" FontSize="11" Foreground="{StaticResource BrandPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="3" Background="Transparent" Padding="6"
                            Visibility="{Binding IsFavorited, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding ElementName=Root, Path=ViewModel.EditRemindersCommand}" CommandParameter="{Binding}">
                        <FontIcon Glyph="&#xEA8F;" />
                    </Button>
                    <Button Grid.Column="4" Background="Transparent" Padding="6"
                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding ElementName=Root, Path=ViewModel.ExportInstalledCommand}" CommandParameter="{Binding}"
                            x:Uid="FavExportButton" ToolTipService.ToolTip="Export for editing (compose.prosary.app)">
                        <FontIcon Glyph="&#xE72D;" />
                    </Button>
                    <Button Grid.Column="5" Background="Transparent" Padding="6"
                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding ElementName=Root, Path=ViewModel.RemoveInstalledCommand}" CommandParameter="{Binding}"
                            x:Uid="FavRemoveImportedButton" ToolTipService.ToolTip="Remove imported devotion">
                        <FontIcon Glyph="&#xE74D;" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Command="{x:Bind ViewModel.BackCommand}" Background="Transparent" Padding="8">
                <FontIcon Glyph="&#xE72B;" MirroredWhenRightToLeft="True" />
            </Button>
            <TextBlock x:Uid="FavTitle" Grid.Column="1" Text="Favorites" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource SubHeadlineTextStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20" MaxWidth="560" HorizontalAlignment="Center" Padding="16">

                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEA3A;" Foreground="{StaticResource BrandPrimaryBrush}" />
                        <TextBlock x:Uid="FavRosaryHeader" Text="Rosary" FontWeight="SemiBold" FontSize="16" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.RosaryFavorites, Mode=OneWay}" ItemTemplate="{StaticResource FavoriteCardTemplate}" />
                    <Button x:Uid="FavAddRosary" Content="+ Add Rosary" Background="Transparent" Foreground="{StaticResource BrandPrimaryBrush}"
                            Command="{x:Bind ViewModel.AddNewRosaryCommand}" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEB51;" />
                        <TextBlock x:Uid="FavJesusHeader" Text="Jesus Prayer" FontWeight="SemiBold" FontSize="16" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.JesusPrayerFavorites, Mode=OneWay}" ItemTemplate="{StaticResource FavoriteCardTemplate}" />
                    <Button x:Uid="FavAddJesus" Content="+ Add Jesus Prayer" Background="Transparent"
                            Command="{x:Bind ViewModel.AddNewJesusPrayerCommand}" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE734;" />
                        <TextBlock x:Uid="FavMoreHeader" Text="More Devotions" FontWeight="SemiBold" FontSize="16" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SimpleFavorites, Mode=OneWay}" ItemTemplate="{StaticResource SimpleFavoriteRowTemplate}" />

                    <!-- Anyone can author a .prosaryprayer bundle (see Shared/ARCHITECTURE.md) —
                         imported devotions get the same star row as the shipped ones. -->
                    <Button Background="Transparent" Click="OnImportBundle" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock x:Uid="FavImport" Text="Import Devotion Bundle…" />
                        </StackPanel>
                    </Button>

                    <!-- The other half of importing: browse prayers.prosary.app's catalog in
                         place and install with one tap — same InstallPack pipeline. -->
                    <Button Background="Transparent" Click="OnBrowseRepository" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE774;" FontSize="14" />
                            <TextBlock x:Uid="FavGetCommunity" Text="Get Community Devotions…" />
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
