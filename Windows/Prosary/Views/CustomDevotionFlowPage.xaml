<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Prosary.Views.CustomDevotionFlowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Prosary.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- The single flow page for every PrayerKind.Custom devotion. Bespoke layout combining the
         3-column header (back / data-bound title / favorite star) with RosaryPrayerPage's bead
         track (narrow/wide layouts, bead templates) — absorbed from the deleted
         FranciscanCrownFlowPage; the bead sections are Visibility-bound to
         ViewModel.ShowsBeadTrack so flat ("steps" type) devotions render without them while
         decade/bead ("rosary" type) devotions get the same track as the Rosary. -->
    <Page.Resources>
        <DataTemplate x:Key="BeadTemplate">
            <Grid Width="20" Height="20">
                <Ellipse Fill="{Binding Color, Converter={StaticResource ColorToBrush}}"
                         Width="{Binding CircleSize}" Height="{Binding CircleSize}"
                         Visibility="{Binding IsCircle, Converter={StaticResource BoolToVisibility}}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Uid="BeadAntiphonLabel" Text="M" Foreground="White" FontSize="10" FontWeight="Bold"
                           Visibility="{Binding IsAntiphon, Converter={StaticResource BoolToVisibility}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Grid Width="13" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="{Binding IsCross, Converter={StaticResource BoolToVisibility}}">
                    <Rectangle Width="4.42" Fill="{Binding Color, Converter={StaticResource ColorToBrush}}"
                               HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                    <Rectangle Height="4.42" Fill="{Binding Color, Converter={StaticResource ColorToBrush}}"
                               HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,3.74,0,0" />
                </Grid>
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HorizontalBeadPanelTemplate">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="VerticalBeadPanelTemplate">
            <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Center" />
        </ItemsPanelTemplate>
    </Page.Resources>

    <Grid Padding="20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="0,0,0,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="OnNavigateUp" Background="Transparent" Padding="8">
                <FontIcon Glyph="&#xE72B;" MirroredWhenRightToLeft="True" />
            </Button>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DevotionTitle, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource SubHeadlineTextStyle}" />
            <Button x:Name="LanguageMenuButton" Grid.Column="2" Background="Transparent" Padding="8"
                    Visibility="{x:Bind ViewModel.ShowsLanguageMenu, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="&#xE774;" /> <!-- Globe — the prayer-language picker -->
                <Button.Flyout>
                    <MenuFlyout x:Name="LanguageFlyout" />
                </Button.Flyout>
            </Button>
            <Button x:Name="VariantMenuButton" Grid.Column="3" Background="Transparent" Padding="8"
                    Visibility="{x:Bind ViewModel.ShowsVariantMenu, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="&#xE8F1;" /> <!-- Library (book shelf) — the variant/form picker -->
                <Button.Flyout>
                    <MenuFlyout x:Name="VariantFlyout" />
                </Button.Flyout>
            </Button>
            <Button x:Name="DayMenuButton" Grid.Column="4" Background="Transparent" Padding="8"
                    Visibility="{x:Bind ViewModel.ShowsDayMenu, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="&#xE787;" /> <!-- Calendar — the multi-day day picker -->
                <Button.Flyout>
                    <MenuFlyout x:Name="DayFlyout" />
                </Button.Flyout>
            </Button>
            <Button Grid.Column="5" Background="Transparent" Padding="8">
                <FontIcon Glyph="&#xE916;" /> <!-- Stopwatch — hands-free auto-advance -->
                <Button.Flyout>
                    <MenuFlyout x:Name="AutoAdvanceFlyout" />
                </Button.Flyout>
            </Button>
            <Button Grid.Column="6" Command="{x:Bind ViewModel.ToggleFavoriteCommand, Mode=OneWay}" Background="Transparent" Padding="8">
                <Grid>
                    <FontIcon Glyph="&#xE735;" Foreground="{StaticResource BrandPrimaryBrush}"
                              Visibility="{x:Bind ViewModel.IsPinned, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <FontIcon Glyph="&#xE734;"
                              Visibility="{x:Bind ViewModel.IsPinned, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </Button>
        </Grid>

        <Rectangle Grid.Row="1" Height="6" Fill="{x:Bind ViewModel.SeasonColor, Mode=OneWay, Converter={StaticResource ColorToBrush}}" />

        <StackPanel Grid.Row="2" Spacing="8">
            <ProgressBar Minimum="0" Maximum="1" Value="{x:Bind ViewModel.Progress, Mode=OneWay, Converter={StaticResource NullableDoubleToValue}}" />
            <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource MutedCaptionTextStyle}" />

            <!-- The parting suggestion a finished series makes, when its bundle names a
                 devotion this device actually has. -->
            <InfoBar IsOpen="{x:Bind ViewModel.ShowsCompletionSuggestion, Mode=OneWay}"
                     IsClosable="False" Severity="Success"
                     Title="{x:Bind ViewModel.CompletionTitleText, Mode=OneWay}">
                <InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <Button Content="{x:Bind ViewModel.PrayNextText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PraySuggestedNextCommand}" />
                        <Button x:Uid="MultiDayNotNowButton" Content="Not now"
                                Command="{x:Bind ViewModel.DismissCompletionSuggestionCommand}" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <!-- A missed day of a series is a real choice, not an error: pray the day that
                 should have happened, stay with the calendar, or start the run over. -->
            <InfoBar x:Uid="MultiDayMissedBar" IsOpen="{x:Bind ViewModel.ShowsMissedDayChoice, Mode=OneWay}"
                     IsClosable="False" Severity="Informational" Title="You missed a day"
                     Message="Pray the day you missed, stay with today, or start the whole devotion over.">
                <InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <Button Content="{x:Bind ViewModel.MissedDayPrayMissedText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PrayMissedDayCommand}" />
                        <Button Content="{x:Bind ViewModel.MissedDayPrayTodayText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PrayCalendarDayCommand}" />
                        <Button x:Uid="MultiDayStartOverButton" Content="Start over"
                                Command="{x:Bind ViewModel.StartRunOverCommand}" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>
        </StackPanel>

        <Grid x:Name="NarrowLayout" Grid.Row="3" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="6"
                        Visibility="{x:Bind ViewModel.ShowsBeadTrack, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.TopBeadRows, Mode=OneWay}" ItemsPanel="{StaticResource VerticalBeadPanelTemplate}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource BeadTemplate}"
                                          ItemsPanel="{StaticResource HorizontalBeadPanelTemplate}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{x:Bind ViewModel.BottomBeads, Mode=OneWay}" ItemTemplate="{StaticResource BeadTemplate}"
                              ItemsPanel="{StaticResource HorizontalBeadPanelTemplate}"
                              Visibility="{x:Bind ViewModel.ShowBottomBeads, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" FlowDirection="{x:Bind ViewModel.IsRightToLeft, Mode=OneWay, Converter={StaticResource BoolToFlowDirection}}">
                <StackPanel Spacing="16">
                    <Border Height="260" MaxWidth="260" CornerRadius="16" HorizontalAlignment="Center">
                        <Image Source="{x:Bind ViewModel.MysteryImageFile, Mode=OneWay}" Stretch="UniformToFill"
                               AutomationProperties.AccessibilityView="Raw" />
                    </Border>

                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasSubtitle, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                   Style="{StaticResource MutedSubtitleTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Header, Mode=OneWay}" Style="{StaticResource SubHeadlineTextStyle}" />
                    </StackPanel>

                    <TextBlock controls:BoldMarkdownText.Text="{x:Bind ViewModel.Acclamation, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.HasAcclamation, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
           FontFamily="{x:Bind ViewModel.AcclamationFontFamily, Mode=OneWay}"
                               FontSize="{x:Bind ViewModel.BodyFontSize, Mode=OneWay}"
                               TextWrapping="Wrap" Margin="0,0,0,12" />
                    <!-- v0.7 reading aid: swap the body for its transliteration. -->
                    <Button Background="Transparent" Padding="6" HorizontalAlignment="Right"
                            Visibility="{x:Bind ViewModel.HasTransliteration, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Command="{x:Bind ViewModel.ToggleTransliterationCommand}"
                            x:Uid="FlowTransliterationButton" ToolTipService.ToolTip="Show transliteration">
                        <FontIcon Glyph="&#xE8C1;" FontSize="14" />
                    </Button>
                    <TextBlock controls:BoldMarkdownText.Text="{x:Bind ViewModel.Body, Mode=OneWay}"
                               FontFamily="{x:Bind ViewModel.BodyFontFamily, Mode=OneWay}"
                               FontSize="{x:Bind ViewModel.BodyFontSize, Mode=OneWay}"
                               TextWrapping="Wrap" TextAlignment="Center" IsTextSelectionEnabled="True" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="WideLayout" Grid.Row="3" ColumnSpacing="24" Visibility="Collapsed" SizeChanged="WideLayout_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="320" Height="320" CornerRadius="16" VerticalAlignment="Center">
                <Image Source="{x:Bind ViewModel.MysteryImageFile, Mode=OneWay}" Stretch="UniformToFill"
                       AutomationProperties.AccessibilityView="Raw" />
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.ShowsBeadTrack, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Center">
                    <ContentControl Content="{x:Bind ViewModel.OpeningCross, Mode=OneWay}" ContentTemplate="{StaticResource BeadTemplate}"
                                     Visibility="{x:Bind ViewModel.OpeningCross, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.GroupColumns, Mode=OneWay}" ItemsPanel="{StaticResource HorizontalBeadPanelTemplate}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Beads}" ItemTemplate="{StaticResource BeadTemplate}"
                                              ItemsPanel="{StaticResource VerticalBeadPanelTemplate}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ContentControl Content="{x:Bind ViewModel.AntiphonBead, Mode=OneWay}" ContentTemplate="{StaticResource BeadTemplate}"
                                     Visibility="{x:Bind ViewModel.AntiphonBead, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                    <ContentControl Content="{x:Bind ViewModel.ClosingCross, Mode=OneWay}" ContentTemplate="{StaticResource BeadTemplate}"
                                     Visibility="{x:Bind ViewModel.ClosingCross, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.ShowBottomBeads, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Rectangle Width="1" Fill="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0" VerticalAlignment="Stretch" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.BottomBeads, Mode=OneWay}" ItemTemplate="{StaticResource BeadTemplate}"
                                  ItemsPanel="{StaticResource VerticalBeadPanelTemplate}"
                                  Visibility="{x:Bind ViewModel.HasRoomForSingleMinorColumn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Orientation="Horizontal" Spacing="6"
                                Visibility="{x:Bind ViewModel.HasRoomForSingleMinorColumn, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.BottomBeadsColumn1, Mode=OneWay}" ItemTemplate="{StaticResource BeadTemplate}"
                                      ItemsPanel="{StaticResource VerticalBeadPanelTemplate}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.BottomBeadsColumn2, Mode=OneWay}" ItemTemplate="{StaticResource BeadTemplate}"
                                      ItemsPanel="{StaticResource VerticalBeadPanelTemplate}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Column="2" FlowDirection="{x:Bind ViewModel.IsRightToLeft, Mode=OneWay, Converter={StaticResource BoolToFlowDirection}}">
                <StackPanel Spacing="16" VerticalAlignment="Center">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasSubtitle, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                   Style="{StaticResource MutedSubtitleTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Header, Mode=OneWay}" Style="{StaticResource SubHeadlineTextStyle}" />
                    </StackPanel>

                    <TextBlock controls:BoldMarkdownText.Text="{x:Bind ViewModel.Acclamation, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.HasAcclamation, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
           FontFamily="{x:Bind ViewModel.AcclamationFontFamily, Mode=OneWay}"
                               FontSize="{x:Bind ViewModel.BodyFontSize, Mode=OneWay}"
                               TextWrapping="Wrap" Margin="0,0,0,12" />
                    <!-- v0.7 reading aid: swap the body for its transliteration. -->
                    <Button Background="Transparent" Padding="6" HorizontalAlignment="Right"
                            Visibility="{x:Bind ViewModel.HasTransliteration, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Command="{x:Bind ViewModel.ToggleTransliterationCommand}"
                            x:Uid="FlowTransliterationButton" ToolTipService.ToolTip="Show transliteration">
                        <FontIcon Glyph="&#xE8C1;" FontSize="14" />
                    </Button>
                    <TextBlock controls:BoldMarkdownText.Text="{x:Bind ViewModel.Body, Mode=OneWay}"
                               FontFamily="{x:Bind ViewModel.BodyFontFamily, Mode=OneWay}"
                               FontSize="{x:Bind ViewModel.BodyFontSize, Mode=OneWay}"
                               TextWrapping="Wrap" TextAlignment="Center" IsTextSelectionEnabled="True" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- The audio transport strip — shown only when the session's devotion+language(+variant)
             has a narrated recording (ViewModel.HasAudio); chapter skip / play-pause controls,
             the current chapter's title, and a seekable timeline. Mirrors iOS/Android's
             AudioPlaybackBar. -->
        <Border Grid.Row="4" CornerRadius="12" Padding="8,4"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                Visibility="{x:Bind ViewModel.HasAudio, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                        Command="{x:Bind ViewModel.AudioPreviousChapterCommand}"
                        IsEnabled="{x:Bind ViewModel.CanSkipAudioChapter, Mode=OneWay}"
                        AutomationProperties.Name="Previous chapter" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE892;" FontSize="14" />
                </Button>
                <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
                        Command="{x:Bind ViewModel.AudioPlayPauseCommand}"
                        AutomationProperties.Name="Play or pause" VerticalAlignment="Center">
                    <FontIcon Glyph="{x:Bind PlayPauseGlyph(ViewModel.IsAudioPlaying), Mode=OneWay}" FontSize="22"
                              Foreground="{x:Bind ViewModel.SeasonColor, Mode=OneWay, Converter={StaticResource ColorToBrush}}" />
                </Button>
                <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                        Command="{x:Bind ViewModel.AudioNextChapterCommand}"
                        IsEnabled="{x:Bind ViewModel.CanSkipAudioChapter, Mode=OneWay}"
                        AutomationProperties.Name="Next chapter" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE893;" FontSize="14" />
                </Button>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.AudioChapterTitle, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                               TextTrimming="CharacterEllipsis" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0" StepFrequency="0.1" IsThumbToolTipEnabled="False"
                                Maximum="{x:Bind ViewModel.AudioDuration, Mode=OneWay}"
                                Value="{x:Bind ViewModel.AudioPosition, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AudioTimeText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                                   FontFamily="Consolas" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Back" Command="{x:Bind ViewModel.BackCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" Background="Transparent" />
            <Button Grid.Column="2" Content="{x:Bind ViewModel.NextButtonText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.NextCommand}" Style="{StaticResource AccentButtonStyle}" MinWidth="120" />
        </Grid>
    </Grid>
</Page>
