<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Prosary.Views.BasicPrayerFlowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Prosary.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="20,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="NavigateUpButton" Grid.Column="0" Click="OnNavigateUp" Style="{StaticResource PrayerIconButtonStyle}">
                <FontIcon Style="{StaticResource PrayerControlIconStyle}" Glyph="&#xE72B;" MirroredWhenRightToLeft="True" />
            </Button>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Header, Mode=OneWay}" FontFamily="{x:Bind ViewModel.HeaderFontFamily, Mode=OneWay}" VerticalAlignment="Center"
                       HorizontalAlignment="Center" Style="{StaticResource SubHeadlineTextStyle}"
                       FlowDirection="{x:Bind ViewModel.IsRightToLeft, Mode=OneWay, Converter={StaticResource BoolToFlowDirection}}" />
            <Button x:Name="LanguageMenuButton" Grid.Column="2" Style="{StaticResource PrayerIconButtonStyle}">
                <FontIcon Style="{StaticResource PrayerControlIconStyle}" Glyph="&#xE774;" />
                <Button.Flyout>
                    <MenuFlyout x:Name="LanguageFlyout" />
                </Button.Flyout>
            </Button>
        </Grid>

        <controls:PrayerStepFlowControl Grid.Row="1" ViewModel="{x:Bind ViewModel}" />
    </Grid>
</Page>
