<UserControl x:Class="Prosary.Views.LiturgicalCalendarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Prosary.ViewModels">
    <Grid RowSpacing="12" Padding="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid RowSpacing="8" ColumnSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="&#x2039;" Command="{x:Bind ViewModel.PreviousMonthCommand}" AutomationProperties.Name="{x:Bind ViewModel.PreviousLabel}" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MonthLabel, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="2" Content="&#x203A;" Command="{x:Bind ViewModel.NextMonthCommand}" AutomationProperties.Name="{x:Bind ViewModel.NextLabel}" />
            <Button Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Left" Content="{x:Bind ViewModel.TodayLabel}" Command="{x:Bind ViewModel.TodayCommand}" />
        </Grid>
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.CalendarName, Mode=OneWay}" TextWrapping="Wrap" />
        <Grid Grid.Row="2">
            <TextBlock Text="{x:Bind ViewModel.EmptyLabel}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" TextWrapping="Wrap" />
            <ListView ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" IsItemClickEnabled="True" ItemClick="OnItemClick" SelectionMode="None">
                <ListView.ItemTemplate><DataTemplate x:DataType="vm:LiturgicalCalendarRow">
                    <StackPanel Spacing="4" Padding="8,12">
                        <TextBlock Text="{x:Bind DateLabel}" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Rank}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
