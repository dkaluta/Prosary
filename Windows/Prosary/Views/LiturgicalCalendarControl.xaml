<UserControl x:Class="Prosary.Views.LiturgicalCalendarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Prosary.ViewModels">
    <Grid RowSpacing="12" Padding="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ToggleSwitch Header="{x:Bind ViewModel.ViewLabel}" OffContent="{x:Bind ViewModel.ListLabel}" OnContent="{x:Bind ViewModel.MonthLabel}"
            IsOn="{x:Bind ViewModel.IsMonthView, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.ViewLabel}" />
        <StackPanel Grid.Row="1" Spacing="8">
            <Button HorizontalAlignment="Left" Content="{x:Bind ViewModel.TodayLabel}" Click="OnToday" />
            <TextBlock Text="{x:Bind ViewModel.CalendarName, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>
        <CalendarView x:Name="MonthPicker" Grid.Row="2" MaxHeight="320" SelectionMode="Single"
            SelectedDatesChanged="OnSelectedDatesChanged" HorizontalAlignment="Stretch"
            Visibility="{x:Bind ViewModel.IsMonthView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            AutomationProperties.Name="{x:Bind ViewModel.MonthLabel}" />
        <Grid Grid.Row="3">
            <TextBlock Text="{x:Bind ViewModel.EmptyLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" />
            <ListView x:Name="FeastList" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" IsItemClickEnabled="True" ItemClick="OnItemClick" SelectionMode="None">
                <ListView.ItemTemplate><DataTemplate x:DataType="vm:LiturgicalCalendarRow">
                    <StackPanel Spacing="4" Padding="8,12">
                        <TextBlock Text="{x:Bind DateLabel}" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Rank}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
