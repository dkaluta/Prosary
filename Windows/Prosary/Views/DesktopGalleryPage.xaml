<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Prosary.Views.DesktopGalleryPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Prosary.Models">
    <Grid Padding="20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.GalleryTitle}" Style="{ThemeResource TitleTextBlockStyle}"
                       AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="{x:Bind ViewModel.GalleryDetail}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right">
            <AppBarButton x:Name="AddButton" Label="{x:Bind ViewModel.AddLabel}" Icon="Add"
                          Command="{x:Bind ViewModel.AddCommand}" CommandParameter="{x:Bind ViewModel.SelectedTemplate, Mode=OneWay}" />
            <AppBarButton x:Name="LibraryButton" Label="{x:Bind ViewModel.LibraryTitle}" Icon="Library" Click="OnShowLibrary" />
        </CommandBar>
        <TextBox Grid.Row="2" x:Name="SearchBox" PlaceholderText="{x:Bind ViewModel.SearchGalleryLabel}"
                 AutomationProperties.Name="{x:Bind ViewModel.SearchGalleryLabel}"
                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Grid Grid.Row="3">
            <GridView x:Name="GalleryGrid" ItemsSource="{x:Bind ViewModel.Gallery}" SelectionMode="Single"
                      SelectedItem="{x:Bind ViewModel.SelectedTemplate, Mode=TwoWay}" IsItemClickEnabled="False"
                      AutomationProperties.Name="{x:Bind ViewModel.GalleryTitle}" KeyDown="OnGalleryKeyDown" ContextRequested="OnCollectionContextRequested">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:DesktopGalleryItem">
                        <Grid Width="220" Padding="10" RowSpacing="10" Background="Transparent" ContextRequested="OnItemContextRequested">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="148" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Image Source="{x:Bind ImageUri}" Stretch="UniformToFill" ImageFailed="OnArtworkFailed"
                                       AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                            <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                            <TextBlock Grid.Row="2" Text="{x:Bind Subtitle}" FontSize="12" TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Grid.Row="3" HorizontalAlignment="Stretch" Click="OnAddTemplate" Loaded="OnAddButtonLoaded" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <StackPanel x:Name="NoMatchesPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.NoMatchesTitle}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.NoMatchesDetail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <ProgressBar IsIndeterminate="True" VerticalAlignment="Top"
                         Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="4" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
