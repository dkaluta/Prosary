<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Actual theming happens in Compose (ui/theme); this XML theme
         only needs to cover the brief window before Compose content is set. -->
    <style name="Theme.Prosary" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary_light</item>
        <item name="android:statusBarColor">@color/brand_primary_light</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>