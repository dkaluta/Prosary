<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Prosary.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Prosary.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Microsoft.UI.Xaml/DensityStyles/Compact.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Brand colors — ported from iOS's Assets.xcassets / Android's ui/theme/Color.kt. -->
            <Color x:Key="BrandPrimaryColor">#7A1F3D</Color>
            <Color x:Key="BrandHeadlineColor">#4A0E23</Color>
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
            <SolidColorBrush x:Key="BrandHeadlineBrush" Color="{StaticResource BrandHeadlineColor}" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#6E6E6E" />

            <conv:ColorToBrushConverter x:Key="ColorToBrush" />
            <conv:BoolToFlowDirectionConverter x:Key="BoolToFlowDirection" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:NullableDoubleToValueConverter x:Key="NullableDoubleToValue" />
            <conv:JesusPrayerSetupOptionLabelConverter x:Key="SetupOptionLabel" />
            <conv:EnumDisplayNameConverter x:Key="EnumDisplayName" />
            <conv:LanguageCodeLabelConverter x:Key="LanguageCodeLabel" />
            <conv:JesusPrayerTargetLabelConverter x:Key="JesusPrayerTargetLabel" />

            <!-- Shared text styles, matching irosary's Styles.xaml naming/intent. -->
            <Style x:Key="HeadlineTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource BrandHeadlineBrush}" />
            </Style>
            <Style x:Key="SubHeadlineTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource BrandHeadlineBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
            <Style x:Key="MutedCaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            </Style>
            <Style x:Key="MutedSubtitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
