<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Prosary.Views.JesusPrayerFlowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Prosary.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="OnNavigateUp" Background="Transparent" Padding="8">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <TextBlock Grid.Column="1" Text="The Jesus Prayer" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource SubHeadlineTextStyle}" />

            <!-- The footer's Next button never turns into "Finish" for an unbounded session (see
                 JesusPrayerProgress.IsLastRep) — this is the only way to end that session. -->
            <Button Grid.Column="2" Content="Finish" Command="{x:Bind ViewModel.FinishCommand, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsUnbounded, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <Button Grid.Column="3" Command="{x:Bind ViewModel.ToggleFavoriteCommand, Mode=OneWay}" Background="Transparent" Padding="8">
                <Grid>
                    <FontIcon Glyph="&#xE735;" Foreground="{StaticResource BrandPrimaryBrush}"
                              Visibility="{x:Bind ViewModel.IsFavorited, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <FontIcon Glyph="&#xE734;"
                              Visibility="{x:Bind ViewModel.IsFavorited, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </Button>
        </Grid>

        <controls:PrayerStepFlowControl Grid.Row="1" ViewModel="{x:Bind ViewModel}" />
    </Grid>
</Page>
