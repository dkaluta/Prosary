<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Prosary.Views.RosaryPrayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Bespoke layout (not using Controls/PrayerStepFlowControl — see that control's own doc
         comment for why): season bar, progress header, then two mutually-exclusive layouts
         toggled by RosaryPrayerPage.xaml.cs based on window width (see WideLayoutBreakpoint),
         same breakpoint idea as irosary's RosaryPrayerPage.xaml.cs. Ported from that file, plus
         iOS's PrayerStepFlowView.swift for the wide-layout structure. -->
    <Page.Resources>
        <DataTemplate x:Key="BeadTemplate">
            <Grid Width="24" Height="24" Margin="{Binding Margin}">
                <Ellipse Fill="{Binding Color, Converter={StaticResource ColorToBrush}}"
                         Width="{Binding CircleSize}" Height="{Binding CircleSize}"
                         Visibility="{Binding IsCircle, Converter={StaticResource BoolToVisibility}}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Text="M" Foreground="White" FontSize="10" FontWeight="Bold"
                           Visibility="{Binding IsAntiphon, Converter={StaticResource BoolToVisibility}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Text="&#x271D;" Foreground="{Binding Color, Converter={StaticResource ColorToBrush}}" FontSize="18"
                           Visibility="{Binding IsCross, Converter={StaticResource BoolToVisibility}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HorizontalStackPanelTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
        </ItemsPanelTemplate>
    </Page.Resources>

    <Grid Padding="20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="0" Height="6" Fill="{x:Bind ViewModel.SeasonColor, Mode=OneWay, Converter={StaticResource ColorToBrush}}" />

        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar Minimum="0" Maximum="1" Value="{x:Bind ViewModel.Progress, Mode=OneWay, Converter={StaticResource NullableDoubleToValue}}" />
            <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource MutedCaptionTextStyle}" />
        </StackPanel>

        <!-- Narrow layout: beads as horizontal rows above a vertically-scrolling image/text column. -->
        <Grid x:Name="NarrowLayout" Grid.Row="2" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="6">
                <ItemsControl ItemsSource="{x:Bind ViewModel.TopBeadRows, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource BeadTemplate}"
                                          ItemsPanel="{StaticResource HorizontalStackPanelTemplate}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{x:Bind ViewModel.BottomBeads, Mode=OneWay}" ItemTemplate="{StaticResource BeadTemplate}"
                              ItemsPanel="{StaticResource HorizontalStackPanelTemplate}"
                              Visibility="{x:Bind ViewModel.ShowBottomBeads, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" FlowDirection="{x:Bind ViewModel.IsRightToLeft, Mode=OneWay, Converter={StaticResource BoolToFlowDirection}}">
                <StackPanel Spacing="16">
                    <Border Height="260" MaxWidth="260" CornerRadius="16" HorizontalAlignment="Center">
                        <Image Source="{x:Bind ViewModel.MysteryImageFile, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasSubtitle, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                   Style="{StaticResource MutedSubtitleTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Header, Mode=OneWay}" Style="{StaticResource SubHeadlineTextStyle}" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.Body, Mode=OneWay}"
                               FontFamily="{x:Bind ViewModel.BodyFontFamily, Mode=OneWay}"
                               FontSize="{x:Bind ViewModel.BodyFontSize, Mode=OneWay}"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Wide layout: image left, vertical bead track as a divider column, prayer text right. -->
        <Grid x:Name="WideLayout" Grid.Row="2" ColumnSpacing="24" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="320" Height="320" CornerRadius="16" VerticalAlignment="Center">
                <Image Source="{x:Bind ViewModel.MysteryImageFile, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>

            <ScrollViewer Grid.Column="1" VerticalAlignment="Stretch">
                <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.VerticalBeadRows, Mode=OneWay}" HorizontalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Beads}" ItemTemplate="{StaticResource BeadTemplate}"
                                              HorizontalAlignment="{Binding Alignment}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Rectangle Height="1" Width="24" HorizontalAlignment="Center" Fill="{StaticResource MutedTextBrush}"
                               Visibility="{x:Bind ViewModel.ShowBottomBeads, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.BottomBeads, Mode=OneWay}" ItemTemplate="{StaticResource BeadTemplate}"
                                  HorizontalAlignment="Center"
                                  Visibility="{x:Bind ViewModel.ShowBottomBeads, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" FlowDirection="{x:Bind ViewModel.IsRightToLeft, Mode=OneWay, Converter={StaticResource BoolToFlowDirection}}">
                <StackPanel Spacing="16" VerticalAlignment="Center">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasSubtitle, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                   Style="{StaticResource MutedSubtitleTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Header, Mode=OneWay}" Style="{StaticResource SubHeadlineTextStyle}" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.Body, Mode=OneWay}"
                               FontFamily="{x:Bind ViewModel.BodyFontFamily, Mode=OneWay}"
                               FontSize="{x:Bind ViewModel.BodyFontSize, Mode=OneWay}"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Back" Command="{x:Bind ViewModel.BackCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" Background="Transparent" />
            <Button Grid.Column="2" Content="{x:Bind ViewModel.NextButtonText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.NextCommand}" Style="{StaticResource AccentButtonStyle}" MinWidth="120" />
        </Grid>
    </Grid>
</Page>
