{
  "editionId": "jesuit-arabic-1897",
  "sourcePDFSHA256": "2bca3535b75532044bdc2889b497b16b59e0337ee775f42de8aedc4e2809c09d",
  "verses": {
    "Psalm": {
      "22": {
        "1": "مزمور لداود. الرب راعي فلا يعوزني شيء.",
        "2": "في مروج خصيبة يقيلني ومياه الراحة يوردني.",
        "3": "يرد نفسي. ويهديني إلى سبل البر من أجل اسمه.",
        "4": "إني ولو سلكت في وادي ظلال الموت لا أخاف سوءا لأنك معي. عصاك وعكازك هما يعزياني.",
        "5": "تهيئ أمامي مائدة تجاه مضايقي وقد مسحت رأسي بالدهن وكأسي مروية.",
        "6": "الجودة والرحمة تتبعاني جميع أيام حياتي وسكناي في بيت الرب طول الأيام."
      },
      "23": {
        "1": "لداود. مزمور. للرب الأرض وملؤها المسكونة والساكنون فيها.",
        "2": "لأنه على البحار أسسها وعلى الأنهار مكنها.",
        "3": "من يصعد إلى جبل الرب ومن يقوم في موضع قدسه.",
        "4": "النقي الكفين والطاهر القلب الذي لم يحمل نفسه إلى الباطل ولم يحلف بالمكر.",
        "5": "إنه ينال بركة من عند الرب وبرا من إله خلاصه.",
        "6": "هذا هو جيل طالبيه ملتمسي وجهك يا إله يعقوب. سلاه.",
        "7": "ارفعن رؤوسكن أيتها الأبواب وارتفعن أيتها المداخل الأبدية فيدخل ملك المجد.",
        "8": "من هذا ملك المجد. هو الرب العزيز الجبار الرب الجبار في القتال.",
        "9": "ارفعن رؤوسكن أيتها الأبواب وارتفعن أيتها المداخل الأبدية فيدخل ملك المجد.",
        "10": "من هذا ملك المجد. رب الجنود هو ملك المجد. سلاه."
      },
      "94": {
        "1": "هلموا نرنم للرب نهتف لصخرة خلاصنا.",
        "2": "نبادر إلى وجهه بالاعتراف ونبهج له بالنشائد.",
        "3": "فإن الرب إله عظيم وملك عظيم على جميع الآلهة.",
        "4": "هو الذي بيده أعماق الأرض وله قمم الجبال.",
        "5": "له البحر وهو صنعه ويداه جبلتا اليبس.",
        "6": "هلموا اسجدوا واركعوا نجثو أمام الرب صانعنا.",
        "7": "فإنه هو إلهنا ونحن شعب مرعاه وغنم يده.",
        "8": "اليوم إذا سمعتم صوته فلا تقسوا قلوبكم.",
        "9": "كما عند الخصومة يوم الامتحان في البرية حيث امتحنني آباؤكم واختبروني وعاينوا أعمالي.",
        "10": "أربعين سنة مللت من ذلك الجيل وقلت إنما هم شعب قلوبهم في ضلال ولم يعرفوا سبلي.",
        "11": "حتى أقسمت في غضبي أن لن يدخلوا في راحتي."
      },
      "95": {
        "1": "رنموا للرب ترنما جديدا رنموا للرب يا جميع الأرض.",
        "2": "رنموا للرب باركوا اسمه. بشروا من يوم إلى يوم بخلاصه.",
        "3": "حدثوا في الأمم بمجده في جميع الشعوب بعجائبه.",
        "4": "لأن الرب عظيم وكثير الحمد مرهوب فوق جميع الآلهة.",
        "5": "لأن جميع آلهة الشعوب أصنام والرب هو صنع السماوات.",
        "6": "الجلال والبهاء أمامه العزة والمجد في مقدسه.",
        "7": "قدموا للرب يا قبائل الشعوب قدموا للرب مجدا وعزة.",
        "8": "قدموا للرب مجد اسمه. احملوا تقدمة وتعالوا إلى دياره.",
        "9": "اسجدوا للرب بزينة مقدسة. ارتعدوا من وجهه يا جميع الأرض.",
        "10": "نادوا في الأمم الرب قد ملك. لقد ثبتت المسكونة فلن تتزعزع. يدين الشعوب بالاستقامة.",
        "11": "لتفرح السماوات وتبتهج الأرض. ليعج البحر وملؤه.",
        "12": "لتبتهج الصحراء وكل ما فيها. حينئذ ترنم جميع شجر الغاب.",
        "13": "لدى وجه الرب لأنه آت ليدين الأرض. يدين المسكونة بالعدل والشعوب بالأمانة."
      },
      "96": {
        "1": "الرب قد ملك فلتبتهج الأرض ولتتهلل الجزائر الكثيرة.",
        "2": "الغمام والضباب من حوله. العدل والقضاء قاعدة عرشه.",
        "3": "النار تنطلق أمامه وتحرق من حوله أضداده.",
        "4": "أضاءت بروقه المسكونة. نظرت الأرض فارتعدت.",
        "5": "ذابت الجبال كالشمع من وجه الرب من وجه سيد الأرض كلها.",
        "6": "أخبرت السماوات بعدله وعاينت جميع الشعوب مجده.",
        "7": "ليخز جميع عابدي المنحوت المفتخرين بالأوثان. اسجدوا له يا جميع الملائكة.",
        "8": "سمعت صهيون ففرحت وابتهجت بنات يهوذا من أجل أحكامك يا رب.",
        "9": "لأنك أنت يا رب علي على كل الأرض متعال جدا على جميع الملائكة.",
        "10": "يا محبي الرب أبغضوا الشر. الرب يحفظ نفوس أصفيائه. من أيدي المنافقين ينقذهم.",
        "11": "أشرق النور على الصديق والفرح على المستقيمي القلوب.",
        "12": "افرحوا أيها الصديقون بالرب واعترفوا لذكر قدسه."
      },
      "97": {
        "1": "مزمور. رنموا للرب ترنما جديدا فإنه صنع المعجزات. صنعت له يمينه وذراعه المقدسة.",
        "2": "أعلن الرب خلاصه. لعيون الأمم كشف بره.",
        "3": "تذكر رحمته وأمانته لآل إسرائيل فرأت جميع أقاصي الأرض خلاص إلهنا.",
        "4": "اهتفوا للرب يا جميع الأرض أنغموا بمجده ورنموا وأنشدوا.",
        "5": "أنشدوا للرب بالكنارة بالكنارة وصوت النشيد.",
        "6": "اهتفوا بالأبواق وصوت الصور أمام الرب الملك.",
        "7": "ليعج البحر وملؤه والمسكونة وسكانها.",
        "8": "لتصفق الأنهار ولترنم الجبال جميعا.",
        "9": "أمام الرب فإنه قد أقبل ليدين الأرض. يدين المسكونة بالعدل والشعوب بالاستقامة."
      },
      "99": {
        "1": "مزمور للاعتراف.",
        "2": "اهتفوا للرب يا جميع الأرض. اعبدوا الرب بالفرح. ادخلوا إلى أمامه بالترنيم.",
        "3": "اعلموا أن الرب هو الإله. هو صنعنا ونحن له. نحن شعبه وغنم مرعاه.",
        "4": "ادخلوا أبوابه بالاعتراف. دياره بالتسبيح. اعترفوا له وباركوا اسمه.",
        "5": "فإن الرب صالح وإلى الأبد رحمته وإلى جيل فجيل أمانته."
      },
      "102": {
        "1": "لداود. باركي يا نفسي الرب ويا جميع ما في داخلي اسمه القدوس.",
        "2": "باركي يا نفسي الرب ولا تنسي جميع مكافآته.",
        "3": "هو الذي يغفر جميع آثامك ويشفي جميع أمراضك.",
        "4": "يفتدي من الفساد حياتك ويكللك بالرحمة والرأفة.",
        "5": "يشبع شيبتك خيرا فيتجدد كالنسر صباك.",
        "6": "الرب يجري العدل والقضاء لجميع المظلومين.",
        "7": "عرف موسى طرقه وبني إسرائيل أفعاله.",
        "8": "الرب رؤوف رحيم طويل الأناة وكثير الرحمة.",
        "9": "ليس على الدوام يسخط ولا إلى الأبد يحقد.",
        "10": "لا على حسب خطايانا عاملنا ولا على حسب آثامنا كافأنا.",
        "11": "بل بمقدار ارتفاع السماء عن الأرض عظمت رحمته على الذين يتقونه.",
        "12": "بمقدار بعد المشرق عن المغرب أبعد عنا معاصينا.",
        "13": "كرأفة أب ببنيه رأف الرب بالذين يتقونه.",
        "14": "لأنه عالم بجبلتنا وذاكر أنا تراب.",
        "15": "الإنسان أيامه كالعشب وإنما يزهر كزهر الحقل.",
        "16": "هبت عليه ريح فلم يكن ولم يعرفه موضعه من بعد.",
        "17": "ورحمة الرب منذ الأزل وإلى الأبد على الذين يتقونه وعدله لبني البنين.",
        "18": "الحافظين عهده الذاكرين أوامره ليعملوا بها.",
        "19": "الرب أقر عرشه في السماء وملكوته يسود على الجميع.",
        "20": "باركوا الرب يا ملائكته المقتدرين قوة العاملين بكلمته عند سماع صوت كلامه.",
        "21": "باركوا الرب يا جميع جنوده يا خدامه العاملين مرضاته.",
        "22": "باركي الرب يا جميع مصنوعاته في كل مواضع سلطانه. باركي يا نفسي الرب."
      },
      "110": {
        "1": "هللويا. أعترف للرب بكل قلبي في مجلس المستقيمين وفي الجماعة.",
        "2": "أعمال الرب عظيمة مدبرة طبقا لكل مراديها.",
        "3": "صنعه ذو جلال وبهاء وعدله دائم إلى الأبد.",
        "4": "جعل لمعجزاته ذكرا. الرب رؤوف رحيم.",
        "5": "أعطى الذين يتقونه غذاء. ذكر إلى الأبد ميثاقه.",
        "6": "أبدى لشعبه قوة أفعاله إذ أعطاهم ميراث الأمم.",
        "7": "أعمال يديه حق وحكم.",
        "8": "أوامره كلها أمينة ثابتة مدى الدهر وإلى الأبد. مقضية بالحق والاستقامة.",
        "9": "أرسل الفداء لشعبه. أوصى إلى الأبد بميثاقه. اسمه قدوس مرهوب.",
        "10": "رأس الحكمة مخافة الرب. حسن الفطنة لكل الذين يعملون بها. تسبحته دائمة إلى الأبد."
      },
      "111": {
        "1": "هللويا. طوبى للرجل الذي يتقي الرب ويهوى وصاياه جدا.",
        "2": "تكون ذريته في الأرض مقتدرة. جيل المستقيمين يبارك.",
        "3": "يكون المال والغنى في بيته وبره يدوم إلى الأبد.",
        "4": "أشرق النور في الظلمة للمستقيمين. الرب رؤوف رحيم وصديق.",
        "5": "ما أسعد الرجل الذي يرأف ويقرض ويدبر كلامه برشد.",
        "6": "إنه لن يتزعزع إلى الأبد.",
        "7": "الصديق يكون ذكره إلى الأبد. لا يخشى خبر السوء. ثابت قلبه متكل على الرب.",
        "8": "قلبه مسند فلا يخشى إلى أن يرى خيبة مضايقيه.",
        "9": "بذل وأعطى المساكين بره يدوم إلى الأبد وقرنه يرتفع بالمجد.",
        "10": "والمنافق يبصر فيغضب. يحرق أسنانه ويذوب. بغية المنافقين تهلك."
      },
      "112": {
        "1": "هللويا. سبحوا يا عباد الرب سبحوا اسم الرب.",
        "2": "ليكن اسم الرب مباركا من الآن وإلى الأبد.",
        "3": "من مشرق الشمس إلى مغربها اسم الرب مسبح.",
        "4": "الرب متعال على كل الأمم وفوق السماوات مجده.",
        "5": "من مثل الرب إلهنا ساكن الأعالي.",
        "6": "ناظر الأسافل في السماوات وفي الأرض.",
        "7": "الذي ينهض المسكين عن التراب. يقيم البائس من المزبلة.",
        "8": "ليجلسه مع العظماء عظماء شعبه.",
        "9": "الذي يجعل عاقر البيت أم بنين مسرورة. هللويا."
      },
      "116": {
        "1": "سبحوا الرب يا جميع الأمم امدحوه يا جميع الشعوب.",
        "2": "لأن رحمته قد عظمت علينا وصدق الرب يدوم إلى الأبد. هللويا."
      },
      "121": {
        "1": "نشيد المراقي. لداود. فرحت بالقائلين لي إلى بيت الرب ننطلق.",
        "2": "قد وقفت أقدامنا في أبوابك يا أورشليم.",
        "3": "أورشليم المبنية كمدينة متصلة ذات اتحاد.",
        "4": "إلى هناك صعدت الأسباط أسباط الرب على حسب شهادة لإسرائيل لكي يعترفوا لاسم الرب.",
        "5": "هناك نصبت عروش للحكم عروش آل داود.",
        "6": "اسألوا السلام لأورشليم. ليسعد الذين يحبونك.",
        "7": "ليكن السلام في أسوارك والسعادة في قصورك.",
        "8": "لأجل إخوتي وأخلائي أقول لك بالسلام.",
        "9": "لأجل بيت الرب إلهنا ألتمس لك الخير."
      },
      "127": {
        "1": "نشيد المراقي. طوبى لكل من يتقي الرب السالك في طرقه.",
        "2": "إنك تأكل من تعب يديك لك الطوبى والخير.",
        "3": "امرأتك مثل جفنة مثمرة في جوانب بيتك. بنوك كفروع زيتون حول مائدتك.",
        "4": "هكذا يبارك الرجل الذي يتقي الرب.",
        "5": "ليباركك الرب من صهيون حتى تنظر خير أورشليم جميع أيام حياتك.",
        "6": "وتنظر بني بنيك. سلام على إسرائيل."
      },
      "137": {
        "1": "لداود. أعترف لك بكل قلبي. أمام الملائكة أنشد لك.",
        "2": "أسجد نحو هيكل قدسك وأعترف لاسمك لأجل رحمتك وحقك لأنك عظمت كلمتك فوق كل اسم لك.",
        "3": "قد استجبت لي يوم دعوتك. ورحبت لي فأضحت نفسي ذات قوة.",
        "4": "يعترف لك يا رب كل ملوك الأرض حين يسمعون أقوال فيك.",
        "5": "ويرنمون في طرق الرب لأن مجد الرب عظيم.",
        "6": "لأن الرب عال ونظر إلى المتواضع أما المتكبر فيعرفه من بعيد.",
        "7": "إذا سلكت فيما بين المضايق فإنك تحييني. على غضب أعدائي تمد يدك وتخلصني يمينك.",
        "8": "الرب يتمم عني. يا رب رحمتك إلى الأبد فلا تهمل أعمال يديك."
      },
      "144": {
        "1": "تسبحة لداود. أعظمك يا إلهي الملك وأبارك اسمك مدى الدهر وإلى الأبد.",
        "2": "أباركك في كل يوم وأسبح اسمك مدى الدهر وإلى الأبد.",
        "3": "إن الرب عظيم ومسبح جدا وليس لعظمته استقصاء.",
        "4": "يسبح أعمالك جيل فجيل ويخبرون بجبروتك.",
        "5": "أنوه ببهاء مجد جلالك وبكلام معجزاتك.",
        "6": "بعزة مخاوفك يتكلمون وبعظائمك أحدث.",
        "7": "يفيضون بذكر كثرة صلاحك وبعدلك يرنمون.",
        "8": "الرب رحيم رؤوف طويل الأناة وعظيم الرحمة.",
        "9": "الرب صالح للجميع ومراحمه على كل صنائعه.",
        "10": "يعترف لك يا رب جميع صنائعك وليباركك أصفياؤك.",
        "11": "ليتكلموا بمجد ملكوتك وليتحدثوا بجبروتك.",
        "12": "لكي يعرفوا بني البشر جبروتك ومجد بهاء ملكوتك.",
        "13": "إن ملكوتك ملكوت جميع الدهور وسلطانك في كل جيل فجيل. الرب أمين في كل أقواله وبار في جميع أعماله.",
        "14": "الرب يعضد كل الساقطين ويقوم كل المنحنين.",
        "15": "إليك تنظر عيون الجميع فإنك أنت الذي ترزقهم طعامهم في حينه.",
        "16": "تبسط يدك فتشبع كل حي رضاته.",
        "17": "الرب صديق في كل طرقه وبار في جميع أعماله.",
        "18": "الرب قريب من جميع دعاته من جميع الذين يدعونه بالحق.",
        "19": "يعمل مرضاة الذين يتقونه ويسمع استغاثتهم ويخلصهم.",
        "20": "يحفظ الرب جميع محبيه ويستأصل جميع المنافقين.",
        "21": "بتسبيح الرب ينطق فمي وكل بشر يبارك اسمه القدوس مدى الدهر وإلى الأبد."
      },
      "145": {
        "1": "هللويا.",
        "2": "سبحي يا نفسي الرب. أسبح الرب مدة حياتي أنشد لإلهي ما دمت. لا تتكلوا على العظماء.",
        "3": "ولا على ابن آدم الذي ليس عنده خلاص.",
        "4": "الذي يخرج روحه فيعود إلى ترابه. يومئذ تهلك عنه تدابيره.",
        "5": "طوبى لمن إله يعقوب ناصره ورجاؤه في الرب إلهه.",
        "6": "صانع السماوات والأرض والبحر وجميع ما فيها.",
        "7": "حافظ الحق إلى الأبد يجري الحكم للمظلومين رازق الطعام للجياع. الرب يحل الأسرى.",
        "8": "الرب يفتح عيون العميان. الرب يقوم المنحنين. الرب يحب الصديقين.",
        "9": "الرب يحفظ الغرباء وينعش اليتيم والأرملة ويهبط طرق المنافقين.",
        "10": "يملك الرب إلى الأبد. إلهك يا صهيون إلى جيل فجيل. هللويا."
      },
      "146": {
        "1": "سبحوا الرب فإن الإشادة لإلهنا صالحة والتسبيح لذيذ وجميل.",
        "2": "الرب يبني أورشليم ويجمع المنفيين من إسرائيل.",
        "3": "فإنه يشفي المنكسري القلوب ويضمد جراحهم.",
        "4": "يحصي عدد الكواكب ويدعو كلها بأسمائها.",
        "5": "إلهنا عظيم وقوته كثيرة ولا إحصاء لفهمه.",
        "6": "الرب ينعش الودعاء ويسقط المنافقين إلى الأرض.",
        "7": "غنوا للرب بالاعتراف. أنشدوا لإلهنا بالكنارة.",
        "8": "فإنه يجلل السماء بالسحب ويهيئ المطر للأرض وينبت العشب في الجبال.",
        "9": "يرزق البهائم طعامها وفراخ الغربان حين تصرخ.",
        "10": "ليس في قوة الفرس هواه ولا في ساقي الرجل رضاه.",
        "11": "إنما يرضى الرب عن الذين يتقونه عن الراجين رحمته."
      },
      "147": {
        "12": "امدحي يا أورشليم الرب. سبحي إلهك يا صهيون.",
        "13": "فإنه حصن مغاليق أبوابك وبارك بنيك في داخلك.",
        "14": "جعل تخومك سلاما ومن شحم الحنطة أشبعك.",
        "15": "يرسل أمره إلى الأرض فتسرع كلمته جدا.",
        "16": "يعطي الثلج كالجزة ويذر الصقيع كالرماد.",
        "17": "يلقي جمده كفتات. من يقوم تجاه برده.",
        "18": "يرسل كلمته فيذيبهن. يهب ريحه فتسيل المياه.",
        "19": "يبدي كلمته ليعقوب رسومه وأحكامه لإسرائيل.",
        "20": "لم يصنع هكذا إلى أمة من الأمم ولم يعرفوا أحكامه. هللويا."
      },
      "148": {
        "1": "هللويا. سبحوا الرب من السماوات. سبحوه في الأعالي.",
        "2": "سبحوه يا جميع ملائكته. سبحوه يا جميع جنوده.",
        "3": "سبحيه أيتها الشمس والقمر. سبحيه يا جميع كواكب النور.",
        "4": "سبحيه يا سماء السماوات ويا أيتها المياه التي فوق السماوات.",
        "5": "ليسبح هؤلاء اسم الرب فإنه هو أمر فخلقت.",
        "6": "وأقامها إلى الدهر والأبد. جعل لها رسما فلا تتعداه.",
        "7": "سبحي الرب من الأرض أيتها التنانين وجميع الغمار.",
        "8": "النار والبرد. الثلج والضباب. الريح العاصفة المنفذة كلمته.",
        "9": "الجبال وجميع التلال. الشجر المثمر وجميع الأرز.",
        "10": "الوحوش وجميع البهائم. الدبابات والطيور ذوات الأجنحة.",
        "11": "ملوك الأرض وجميع الشعوب. الرؤساء وجميع قضاة الأرض.",
        "12": "الأحداث والعذارى. الشيوخ مع الصبيان.",
        "13": "ليسبح هؤلاء اسم الرب. فإن اسمه وحده تعال.",
        "14": "وجلاله فوق الأرض والسماوات وقد أعلى قرنا لشعبه. ليكن التسبيح في أفواه جميع أصفيائه بني إسرائيل الشعب المقرب إليه. هللويا."
      },
      "149": {
        "1": "هللويا. رنموا للرب ترنما جديدا أقيموا تسبحته في مجمع الأصفياء.",
        "2": "ليفرح إسرائيل بصانعه. ليبتهج بنو صهيون بملكهم.",
        "3": "ليسبحوا اسمه بالرقص. لينشدوا له بالدف والكنارة.",
        "4": "فإن الرب يرضى عن شعبه. يجمل الودعاء بخلاصه.",
        "5": "ليبتهج الأصفياء في المجد. يرنمون على أسرتهم.",
        "6": "تعظيم الله في أفواههم وبأيديهم سيف ذو حدين.",
        "7": "لإجراء الانتقام على الأمم. التأديب على الشعوب.",
        "8": "ليوثق الملوك بالقيود وشرفاءهم بكبول من حديد.",
        "9": "ليجروا عليهم القضاء المكتوب. هذا فخر يكون لجميع أصفيائه. هللويا."
      },
      "150": {
        "1": "هللويا. سبحوا الله في قدسه. سبحوه في جلد عزه.",
        "2": "سبحوه لأجل جبروته. سبحوه بحسب كثرة عظمته.",
        "3": "سبحوه بصوت البوق. سبحوه بالعود والكنارة.",
        "4": "سبحوه بالدف والرقص. سبحوه بالأوتار والمزمار.",
        "5": "سبحوه بصنوج السماع. سبحوه بصنوج الهتاف.",
        "6": "كل نسمة فلتسبح الرب. هللويا."
      }
    }
  },
