{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prosary.app/schema/reading-texts.json",
  "title": "Prosary offline Bible passages",
  "description": "Canonical build-time-resolved Bible passages. readings-texts.json includes passages; readings-editions.json omits them for lightweight metadata loading. Exact licensed Mass text is not represented by this format.",
  "type": "object",
  "required": ["schemaVersion", "editions"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "editions": {
      "type": "array",
      "items": {"$ref": "#/$defs/edition"}
    },
    "wholeVersePassages": {
      "description": "Exact passage keys whose partial-verse appointments are shown using their enclosing whole verses. Missing means empty. Clients retain the original citation and show a localized full-verse notice for these keys. Only keys present in passages are listed.",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(daily|torah)\\|.+$"}
    },
    "passages": {
      "type": "object",
      "propertyNames": {"pattern": "^(daily|torah)\\|.+$"},
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/verse"}
        }
      }
    }
  },
  "$defs": {
    "edition": {
      "type": "object",
      "required": ["id", "languageCode", "name", "attribution", "sourceURL"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "languageCode": {"type": "string", "minLength": 2},
        "name": {"type": "string", "minLength": 1},
        "attribution": {"type": "string", "minLength": 1},
        "sourceURL": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "verse": {
      "type": "object",
      "required": ["chapter", "verse", "text"],
      "additionalProperties": false,
      "properties": {
        "chapter": {"type": "integer", "minimum": 1},
        "verse": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1}
      }
    }
  }
}
