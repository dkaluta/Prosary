        <body>

            <div type="chapter" n="1" xml:lang="syr">
                <head xml:lang="en">Chapter 1</head>
                <milestone unit="SyrChapter" n="1" />
                <ab type="verse" n="26">ܒ݁ܝܰܪܚܳܐ ܕ݁ܶܝܢ ܕ݁ܶܫܬ݁ܳܐ ܆ ܐܶܫܬ݁ܠܰܚ ܓ݁ܰܒ݂ܪܺܝܐܝܶܠ ܡܰܠܰܐܟ݂ܳܐ
                    ܡܶܢ ܠܘܳܬ݂ ܐܰܠܳܗܳܐ ܠܰܓ݂ܠܺܝܠܳܐ ܇ ܠܰܡܕ݂ܺܝܢ̱ܬ݁ܳܐ ܕ݁ܰܫܡܳܗ ܢܳܨܪܰܬ݂ .</ab>
                <ab type="verse" n="27">ܠܘܳܬ݂ ܒ݁ܬ݂ܽܘܠܬ݁ܳܐ ܕ݁ܰܡܟ݂ܺܝܪܳܐ ܠܓ݂ܰܒ݂ܪܳܐ ܕ݁ܰܫܡܶܗ ܝܰܘܣܶܦ݂ .
                    ܡܶܢ ܒ݁ܰܝܬ݁ܶܗ ܕ݁ܕ݂ܰܘܺܝܕ݂ . ܘܰܫܡܳܗ ܠܰܒ݂ܬ݂ܽܘܠܬ݁ܳܐ ܂ ܡܰܪܝܰܡ .</ab>
                <ab type="verse" n="28">ܘܥܰܠ ܠܘܳܬ݂ܳܗ ܡܰܠܰܐܟ݂ܳܐ ܂ ܘܶܐܡܰܪ ܠܳܗ . ܫܠܳܡ ܠܶܟ݂ܝ ܡܰܠܝܰܬ݂
                    ܛܰܝܒ݁ܽܘܬ݂ܳܐ ܅ ܡܳܪܰܢ ܥܰܡܶܟ݂ܝ ܁ ܒ݁ܪܺܝܟ݂ܰܬ݂ ܒ݁ܢܶܫܶܐ̈ .</ab>
                <milestone unit="SyrChapter" n="2" />
                </div>
            </body>
