{
  "$comment": "Sourced Bible book-name metadata for Today citations in Arabic, Russian, Tagalog, French and Italian. Each map addresses the same canonical English book identity; only the displayed name changes. The original lectionary, dates, reading order and chapter/verse ranges remain authoritative. Sources and editorial shortening are recorded per language.",
  "sources": {
    "ar": {
      "name": "Dar el-Machreq — Arabic Catholic Bible",
      "urls": [
        "https://arabiccatholicbible.com/project/sir/"
      ],
      "note": "Bible book names relayed from the publisher navigation index. Display names omit descriptive prefixes and vowel marks; short labels are editorial abbreviations. No Scripture text is copied."
    },
    "ru": {
      "name": "Russian Synodal Bible — Azbyka Bible index",
      "urls": [
        "https://azbyka.ru/biblia/"
      ],
      "note": "Names relay the Synodal index with stress marks omitted and numbered letters made explicit. English 1/2 Samuel and 1/2 Kings correspond to Synodal 1/2/3/4 Царств; Ezra corresponds to 1 Ездры. Underlying citations and chapter/verse numbers are unchanged. Short labels are editorial abbreviations. No Scripture text is copied."
    },
    "tl": {
      "name": "Philippine Bible Society — Magandang Balita Biblia (with Deuterocanon), Bible Gateway",
      "urls": [
        "https://www.biblegateway.com/versions/Magandang-Balita-Biblia-Deuterocanon-MBBTAG-DC/",
        "https://www.biblegateway.com/passage/?search=Ecclesiastico+50&version=MBBTAG-DC"
      ],
      "note": "Names relay the publisher-supplied book index, with Sirach identified by its published descriptive title. Short labels are editorial abbreviations. No Scripture text from this copyrighted edition is copied."
    },
    "fr": {
      "name": "AELF — Bible index",
      "urls": [
        "https://www.aelf.org/bible"
      ],
      "note": "Conventional book names relay the episcopal liturgical index, omitting long descriptive prefixes. Short labels are editorial abbreviations. No Scripture or liturgical text is copied. Habacuc uses the conventional spelling instead of the index typo Habaquc."
    },
    "it": {
      "name": "ParolaViva — Italian Bible index",
      "urls": [
        "https://parolaviva.art/api/v1/bibbia/indice.json"
      ],
      "note": "Short and full labels are the source index m and n fields. The index is shared by the hosted Italian editions, including Antonio Martini. No Scripture text is copied. The source ASCII apostrophe in Giosue' is normalized to the Italian accent in Giosuè."
    }
  },
