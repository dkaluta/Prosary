UID:2026-07-03-e2fb37eb-1bc7-437b-b24a-2a7517ff2d60@urtotho
DTSTAMP:20260925T204617Z
DTSTART;VALUE=DATE:20260703
DTEND;VALUE=DATE:20260704
TRANSP:TRANSPARENT
RRULE:FREQ=YEARLY
SUMMARY:חג הקדוש תומאס השליח\, דרגה א׳
DESCRIPTION:תומס\, שנקרא התאום\, היה מהגליל כמו
  שאר השליחים. ה' קרא לו\, והוא ענה לקריאה\, 
 נטש הכל\n\nתומס הראה את זיקתו החזקה למורה 
 שלו\, אז הוא אמר לחבריו לתלמידיו: "הבה נלך
  גם נשכב איתו." (יוחנן 16/11)\n\nלאחר תחיית המ
 תים\, אמרו התלמידים לתומס: ראינו את ה'\, וה
 וא אמר להם: "אלא אם כן אראה את סימן הציפור
 ניים בידיו\, ואכניס את אצבעי במקום הציפו
 רניים\, ואשים את ידי בצידו\, לא אאמין". תומ
 ס פקפק\, וספק עשוי להיות סיבה לחשוף את הא
 מת. לאחר שמונה ימים\, בא ישוע ועמד באמצע ו
 אמר: "שלום לך". ואז הוא אמר לתומס: "שים את א
 צבעך כאן וראה את ידי\, והבא את ידך ושם אות
 ה על הצד שלי\, ואל תהיה כופר\, אלא מאמין." ת
 ומאס נפל לרגליו של ישוע ואמר: "אדוני ואלו
 הים שלי." ישוע אמר לו: "מפני שראית אותי\, ת
 ומאס\, האמנת. אשרי אלה שלא ראו והאמינו" (י
 וחנן כ':19-29)\n עם אמונה איתנה זו\, הטיף תומס
  את הבשורה ביהודה\, כמו השליחים. אחר כך הל
 ך למזרח\, כמו שאומרים האבות\, ופגש את החכמ
 ים שהגיעו לבית לחם ועבדו לילד האלוהי. הו
 א הטביל אותם ועזר לו להטיף בארצותיהם. הש
 ליח הגיע לחבש\, שם עשה לבבות לבנים בקרב א
 ותם אנשים עם פנים שחורות עם מי הטבילה\, כ
 פי שאומר יוחנן כריסוסטום הקדוש.\n אחר כך 
 המשיך במסעו אל הפרסים עד להודו\, שם נכנס\,
  כפי שאומר שמעון מיתאריסטי\, הטיף\, הטביל\
 , מינה הגמונים וכהנים והחזיר רבים לאמונה
  במשיח. בעודו מתפלל יום אחד\, תקפו אותו כו
 הני האלילים\, רגמו אותו באבנים ודקרו אות
 ו בצווארו בחנית\, וכך זכה בכתר הקדושים בש
 נת ה-75 למשיח.\n\nמקור: Evangelizo\nhttps://alingilalyawmi.or
 g/SYA/display-saint/e2fb37eb-1bc7-437b-b24a-2a7517ff2d60
URL:https://alingilalyawmi.org/SYA/display-saint/e2fb37eb-1bc7-437b-b24a-
 2a7517ff2d60
END:VEVENT
