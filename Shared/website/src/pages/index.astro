---
import BaseLayout from "../layouts/BaseLayout.astro";
import LineIcon from "../components/LineIcon.astro";
import RosaryArtwork from "../components/RosaryArtwork.astro";
import StoreBadge from "../components/StoreBadge.astro";
import { downloads } from "../data/downloads";
import rosaryLatin from "../../../content/rosary/content/la.json";

const title = "Prosary — Make room for prayer";
const description = "A Catholic prayer companion for Apple devices, Android, and Windows. Familiar devotions, daily readings, and a prayer book of your own. Find your beta download.";
const prayerExcerpt = rosaryLatin.prayers.subTuumPraesidium.split("\n").slice(0, 2).join("\n");
const devotions = [
  "Holy Rosary", "Angelus", "Jesus Prayer", "Stations of the Cross", "Via Lucis",
  "Franciscan Crown", "Seven Sorrows", "Divine Mercy Chaplet", "Trisagion", "O Antiphons",
];
const languages = ["English", "Latin", "Hebrew", "Arabic", "Syriac", "and more"];
---

<BaseLayout {title} {description} heading="Make room for prayer." currentPath="/">
  <header slot="hero" class="home-hero page-width">
    <div class="hero-copy">
      <p class="eyebrow">A Catholic prayer companion</p>
      <h1>Make room<br />for <em>prayer.</em></h1>
      <p class="hero-description">
        The prayers you know. A rhythm for the day. A prayer book that goes with you,
        on your phone, tablet, or desktop.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#download">Get the beta <LineIcon kind="arrow" /></a>
        <a class="button button-text" href="#prayer-book">Explore the prayer book</a>
      </div>
      <p class="hero-platforms">iPhone · iPad · Mac · Vision Pro · Android · Windows</p>
    </div>
    <figure class="rosary-figure">
      <div class="rosary-visual">
        <RosaryArtwork />
        <div class="rosary-prayer">
          <p class="prayer-example-label">From the prayer book</p>
          <blockquote lang="la">{prayerExcerpt}</blockquote>
          <p class="prayer-example-title">Sub tuum praesidium · Latin</p>
        </div>
      </div>
      <figcaption class="rosary-caption">A familiar prayer. A moment of your own.</figcaption>
    </figure>
  </header>

  <ul class="app-principles page-width" aria-label="About the apps">
    <li>Native apps</li>
    <li>Prayers offline</li>
    <li>No ads or analytics</li>
  </ul>

  <div class="page-sections">
    <section id="prayer-book" class="prayer-section" aria-labelledby="prayer-heading">
      <div class="section-heading">
        <p class="section-kicker">The prayer book</p>
        <h2 id="prayer-heading">Familiar prayers,<br />at your pace.</h2>
        <p>Devotions to follow, prayers to repeat, and room to make them part of your day.</p>
      </div>
      <div class="prayer-book-layout">
        <div class="prayer-features">
          <article class="prayer-feature">
            <LineIcon kind="prayer" />
            <div><h3>The Rosary, bead by bead</h3><p>Follow the mysteries and prayers at your own pace. Choose your language and the prayers you include.</p></div>
          </article>
          <article class="prayer-feature">
            <LineIcon kind="book" />
            <div><h3>A devotion for the moment</h3><p>Walk through the Stations of the Cross, pray the Angelus, or return to a familiar chaplet.</p></div>
          </article>
          <article class="prayer-feature">
            <LineIcon kind="saved" />
            <div><h3>A simple way to keep count</h3><p>Keep the Jesus Prayer close with a quiet counter for repeated prayer.</p></div>
          </article>
        </div>
        <aside class="devotion-index" aria-labelledby="devotion-index-heading">
          <p class="index-label">In Prosary</p>
          <h3 id="devotion-index-heading">The built-in prayer book</h3>
          <ul class="devotion-list">{devotions.map((devotion) => <li>{devotion}</li>)}</ul>
        </aside>
      </div>
    </section>

    <section class="daily-section" aria-labelledby="daily-heading">
      <div class="daily-layout">
        <div class="daily-copy">
          <p class="section-kicker">Feasts & readings</p>
          <h2 id="daily-heading">Read with the day.</h2>
          <p>Find the day's feasts and their appointed readings, with calendars from different traditions.</p>
          <div class="reading-detail">
            <LineIcon kind="book" />
            <div><h3>Read, wherever you are</h3><p>Download a Bible edition for offline reading. Sources, citations, and available text stay clearly identified.</p></div>
          </div>
        </div>
        <div class="language-panel">
          <p class="section-kicker">Words that feel like home</p>
          <h3>Prayer in many languages.</h3>
          <p>Choose readable type, follow right-to-left text naturally, and switch between Syriac and Hebrew letters for Aramaic prayers.</p>
          <ul class="language-list" aria-label="Prayer languages">{languages.map((language) => <li>{language}</li>)}</ul>
          <p class="fine-print">Languages and prayer forms vary by devotion. Source credits stay with the texts.</p>
        </div>
      </div>
    </section>

    <section class="library-section" aria-labelledby="library-heading">
      <div class="library-layout">
        <div class="section-heading">
          <p class="section-kicker">A prayer book of your own</p>
          <h2 id="library-heading">Keep it close.<br />Let it keep growing.</h2>
          <p>Save the prayers you return to, adjust their options, and set reminders. Write a devotion with Prosary Compose, bring it into the app, or share it with the community.</p>
        </div>
        <div class="community-links">
          <a class="community-link" href="https://compose.prosary.app"><span><strong>Make a prayer</strong><small>Write and export with Prosary Compose</small></span><LineIcon kind="arrow" /></a>
          <a class="community-link" href="https://prayers.prosary.app"><span><strong>Find a shared prayer</strong><small>Explore the community prayer library</small></span><LineIcon kind="arrow" /></a>
        </div>
      </div>
    </section>

    <section id="download" class="download-section" aria-labelledby="download-heading">
      <div class="section-heading">
        <p class="section-kicker">Bring Prosary with you</p>
        <h2 id="download-heading">Choose your app.</h2>
        <p>Prosary is in beta. Here’s how to join on each platform.</p>
      </div>
      <div class="download-grid">
        <article id="apple" class="download-card" aria-labelledby="apple-heading">
          <div class="download-heading"><LineIcon kind="devices" /><span class="availability">TestFlight beta</span></div>
          <h3 id="apple-heading">Apple</h3>
          <p class="platform-detail">iPhone, iPad, Mac & Vision Pro</p>
          <p class="download-note">{downloads.apple.note}</p>
          <StoreBadge platform="apple" href={downloads.apple.href} />
          <p class="download-help">Requires Apple’s TestFlight app</p>
        </article>
        <article id="android" class="download-card" aria-labelledby="android-heading">
          <div class="download-heading"><LineIcon kind="phone" /><span class="availability">Closed test</span></div>
          <h3 id="android-heading">Android</h3>
          <p class="platform-detail">Phones & tablets</p>
          <p class="download-note">{downloads.android.note}</p>
          <StoreBadge platform="android" href={downloads.android.href} />
          <a class="download-help" href={downloads.android.invitation}>Request a test invitation</a>
        </article>
        <article id="windows" class="download-card" aria-labelledby="windows-heading">
          <div class="download-heading"><LineIcon kind="desktop" /><span class="availability">Store beta</span></div>
          <h3 id="windows-heading">Windows</h3>
          <p class="platform-detail">ARM64 & x64 PCs</p>
          <p class="download-note">{downloads.windows.note}</p>
          <StoreBadge platform="windows" href={downloads.windows.href} />
          <a class="download-help" href={downloads.windows.standalone}>Standalone installers and setup guide</a>
        </article>
      </div>
    </section>

    <aside class="open-section" aria-labelledby="open-heading">
      <div><h2 id="open-heading">Open, with care.</h2><p>The code and shared content are yours to explore, with their sources and credits.</p></div>
      <div class="open-links"><a class="button button-secondary" href="https://github.com/dkaluta/Prosary">View the source <LineIcon kind="arrow" /></a><a href="/privacy">Read the privacy policy</a></div>
    </aside>
  </div>
</BaseLayout>
