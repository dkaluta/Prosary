---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Prosary — A Catholic prayer companion for iPhone, Mac, Android, and Windows";
const description =
  "Prosary is a native companion for the Rosary and ten Catholic devotions, with prayer presets, community-made devotions, and nine prayer languages. In testing for iPhone, Mac, and Android; in development for Windows.";

const devotions = [
  "Holy Rosary",
  "Angelus",
  "Jesus Prayer",
  "Stations of the Cross",
  "Via Lucis",
  "Franciscan Crown",
  "Seven Sorrows",
  "Divine Mercy Chaplet",
  "Trisagion",
  "O Antiphons",
];
---

<BaseLayout {title} {description} heading="Prosary" currentPath="/">
  <Fragment slot="hero">
    <p class="tagline">
      A thoughtful, native companion for praying alone or leading others — with ten built-in
      devotions and more shared by the community.
    </p>

    <div class="hero-actions" aria-label="Beta downloads">
      <a class="button button-primary" href="https://testflight.apple.com/join/RJPs8DWS">
        Join on TestFlight
        <span aria-hidden="true">↗</span>
      </a>
      <a
        class="button button-secondary"
        href="https://play.google.com/store/apps/details?id=com.dkaluta.prosary"
      >
        Join the Android test
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <p class="hint">
      Need access to the Android test? <a
        href="https://docs.google.com/forms/d/e/1FAIpQLSe2pFPBmjBL6SOxjh7zktRDzEraxdfNUR-L6vuiPuy-sOunPw/viewform?usp=sharing&ouid=107334041819347937443"
        target="_blank"
        rel="noopener noreferrer"
      >Request an invitation</a><span class="visually-hidden"> (opens in a new tab)</span>.
    </p>

    <ul class="platform-status" aria-label="Platform availability">
      <li>
        <span class="status-dot status-testing" aria-hidden="true"></span>
        <span><strong>iPhone & Mac</strong><small>TestFlight beta</small></span>
      </li>
      <li>
        <span class="status-dot status-testing" aria-hidden="true"></span>
        <span><strong>Android</strong><small>Closed test</small></span>
      </li>
      <li>
        <span class="status-dot status-building" aria-hidden="true"></span>
        <span><strong>Windows</strong><small>In development</small></span>
      </li>
    </ul>
  </Fragment>

  <div class="page-sections">
    <section class="spotlight" aria-labelledby="devotions-heading">
      <div class="section-heading">
        <p class="section-kicker">A complete prayer book</p>
        <h2 id="devotions-heading">Familiar devotions, ready when you are</h2>
      </div>
      <div class="section-body">
        <p>
          Pray today’s Rosary mysteries, a fixed set, all 15 or all 20 mysteries, or one mystery
          at a time. Presenter mode keeps a group together, while traditional and scriptural
          forms let each devotion remain true to its own shape.
        </p>
        <ul class="devotion-list" aria-label="Built-in devotions">
          {devotions.map((devotion) => <li>{devotion}</li>)}
        </ul>
      </div>
    </section>

    <section class="feature-section" aria-labelledby="features-heading">
      <div class="section-heading centered-heading">
        <p class="section-kicker">Made for real prayer</p>
        <h2 id="features-heading">Quietly capable, never in the way</h2>
      </div>

      <div class="feature-grid">
        <article class="feature-card">
          <span class="feature-symbol" aria-hidden="true">✦</span>
          <h3>Make it your own</h3>
          <p>
            Save Rosary presets, choose optional prayers, switch traditional and scriptural
            forms, and let auto-advance carry you from bead to bead at your pace.
          </p>
        </article>

        <article class="feature-card">
          <span class="feature-symbol" aria-hidden="true">Aa</span>
          <h3>Pray in your language</h3>
          <p>
            Latin, English, Arabic, Hebrew, Classical Syriac/Aramaic, Greek, Spanish, Russian,
            and Tagalog — with native right-to-left layout where the language calls for it.
          </p>
        </article>

        <article class="feature-card">
          <span class="feature-symbol" aria-hidden="true">◇</span>
          <h3>Share a devotion</h3>
          <p>
            Every stepped devotion is an open <code>.prosaryprayer</code> bundle. Build one in
            your browser, keep your draft on your device, then share it when it is ready.
          </p>
          <p class="card-links">
            <a href="https://compose.prosary.app">Open Prosary Compose</a>
            <a href="https://prayers.prosary.app">Browse community prayers</a>
          </p>
        </article>
      </div>
    </section>

    <section class="native-section" aria-labelledby="native-heading">
      <div class="native-copy">
        <p class="section-kicker">Native by design</p>
        <h2 id="native-heading">At home on every screen</h2>
        <p>
          Prosary uses SwiftUI on iPhone, iPad, and Mac, Jetpack Compose on Android, and WinUI 3
          on Windows. Each app follows its platform while sharing the same prayer content,
          accessible structure, and feature set.
        </p>
      </div>
      <ul class="native-stack" aria-label="Native app technologies">
        <li><strong>Apple</strong><span>SwiftUI</span></li>
        <li><strong>Android</strong><span>Jetpack Compose</span></li>
        <li><strong>Windows</strong><span>WinUI 3</span></li>
      </ul>
    </section>

    <section class="closing-callout" aria-labelledby="open-heading">
      <div>
        <p class="section-kicker">Open from end to end</p>
        <h2 id="open-heading">Prayer content and code you can inspect</h2>
        <p>
          The apps, web tools, shared data, documentation, and original assets live together in
          one public repository under the BSD 2-Clause License.
        </p>
      </div>
      <a class="button button-secondary" href="https://github.com/dkaluta/Prosary">
        View the source
        <span aria-hidden="true">↗</span>
      </a>
    </section>
  </div>
</BaseLayout>
