---
import "../styles/global.css";

const title = "Prosary — A Catholic prayer companion for iPhone, Mac, Android, and Windows";
const description =
  "Prosary is a companion for the Rosary, Angelus, Stations of the Cross, Via Lucis, Divine Mercy Chaplet, Franciscan Crown, Seven Sorrows, Trisagion, O Antiphons, Jesus Prayer, and community devotions, with a nine-language prayer catalog. In testing for iPhone, Mac, and Android; in development for Windows.";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<div class="hero">
			<h1>Prosary</h1>
			<p class="tagline">
				Ten built-in Catholic devotions, plus prayers shared by the community.
			</p>

			<div class="badges">
				<a class="badge" href="https://testflight.apple.com/join/RJPs8DWS"
					>Join the TestFlight Beta</a
				>
				<a
					class="badge"
					href="https://play.google.com/store/apps/details?id=com.dkaluta.prosary"
					>Join the Android Closed Test</a
				>
			</div>

			<p class="hint">
				Not on the Android tester list yet? <a
					href="https://docs.google.com/forms/d/e/1FAIpQLSe2pFPBmjBL6SOxjh7zktRDzEraxdfNUR-L6vuiPuy-sOunPw/viewform?usp=sharing&ouid=107334041819347937443"
					target="_blank"
					rel="noopener noreferrer"
					>Sign up here to be added</a
				>.
			</p>
		</div>

		<section>
			<h2>Ten built-in devotions</h2>
			<p>
				The Holy Rosary — with today's mysteries, a fixed set, all 15,
				all 20, or a single chosen mystery, and a presenter mode for
				leading a group aloud — plus the Angelus, the Jesus Prayer, the
				Stations of the Cross in both the traditional form and St. John
				Paul II's scriptural form, the Via Lucis (the Way of Light, from
				Easter to Pentecost), the Franciscan Crown, the Seven Sorrows of
				Mary, the Divine Mercy Chaplet, the Trisagion in several
				traditions, and the seven-day O Antiphons devotion.
			</p>
		</section>

		<section>
			<h2>Make it your own</h2>
			<p>
				Save Rosary presets and pray any combination on the spot,
				switch a devotion's traditional and scriptural forms, and turn
				optional prayers on or off — like the Franciscan Crown's
				closing Hail Marys for the 72 years of Our Lady's life. Change
				the prayer language right from the prayer screen, or let
				auto-advance carry you from bead to bead, hands-free, at your
				own pace.
			</p>
		</section>

		<section>
			<h2>Author it, share it</h2>
			<p>
				Every stepped devotion is an open <code>.prosaryprayer</code> bundle,
				and the app imports bundles made by anyone. Build your own —
				no technical knowledge needed — with
				<a href="https://compose.prosary.app">Prosary Compose</a>,
				right in the browser, where nothing you write leaves your
				device. Then share it with the world on
				<a href="https://prayers.prosary.app">Prosary Prayers</a>, the
				community repository: sign in with just a username and a
				passkey, publish under your own name, and download devotions
				others have shared.
			</p>
		</section>

		<section>
			<h2>Pray in your language</h2>
			<p>
				Latin is the default prayer language, with English, Arabic,
				Hebrew, Classical Syriac/Aramaic, Greek, Spanish, Russian, and
				Tagalog available as alternatives. Arabic, Hebrew, and Aramaic
				render right-to-left, and Hebrew includes both the St James
				Vicariate's wording and the Mission of St. Gamaliel's recension.
				Each devotion lists the subset for which sourced text is available;
				most built-ins currently cover Latin, English, Arabic, Hebrew,
				Russian, and Tagalog.
			</p>
		</section>

		<section>
			<h2>Built for iPhone, Mac, Android, and Windows</h2>
			<p>
				A native SwiftUI app with an adaptive layout: a focused
				single-column flow on iPhone, and a roomier multi-column layout
				on Mac and iPad — with a real menu bar on Mac, and saved configurations
				and imported bundles following you across Apple devices through
				iCloud. A native Android app is in closed testing — join above
				to try it early. A native Windows app (WinUI 3) with full
				feature parity is in active development.
			</p>
		</section>

		<!-- TODO: add real screenshots once available -->
		<!-- <section>
			<h2>Screenshots</h2>
			<img src="/screenshot-iphone.png" alt="Prosary on iPhone" />
		</section> -->

		<footer>
			<p>
				&copy; 2026 David Kaluta &middot; <a
					href="https://github.com/dkaluta/Prosary">Source on GitHub</a
				>
				&middot; <a href="/privacy">Privacy</a> &middot;
				<a href="/license">License</a>
			</p>
		</footer>
	</body>
</html>
