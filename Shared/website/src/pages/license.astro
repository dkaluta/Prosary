---
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";

import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Prosary — License";
const description =
	"All original Prosary material is open source under the BSD 2-Clause License in one public monorepo.";
// npm executes Astro with this package as cwd in development and CI. Resolve from there rather
// than import.meta.url: Astro relocates page modules into dist/.prerender before rendering.
const licenseText = await readFile(resolve(process.cwd(), "../../LICENSE"), "utf8");
---

<BaseLayout {title} {description} heading="License" currentPath="/license">
	<Fragment slot="hero">
		<p class="tagline">
			The SwiftUI app for iPhone and Mac, the Jetpack Compose app for
			Android, the WinUI app for Windows, Prosary's web tools, and their
			shared data, documentation, tools, and assets live in
			{" "}
			<a href="https://github.com/dkaluta/Prosary">one open-source monorepo</a>.
		</p>
	</Fragment>

	<section>
		<pre>{licenseText.trim()}</pre>
		<p>
			The text above is read from the repository's
			{" "}
			<a href="https://github.com/dkaluta/Prosary/blob/main/LICENSE"
				>canonical license file</a
			>, so this published copy stays in step with the whole project.
		</p>
	</section>
</BaseLayout>
