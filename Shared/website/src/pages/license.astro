---
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";

import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Prosary — License";
const description =
  "Prosary’s original website text is dedicated under CC0 1.0. Software is open source under BSD 2-Clause. Third-party sources retain their own licenses and credits.";
// npm executes Astro with this package as cwd in development and CI. Resolve from there rather
// than import.meta.url: Astro relocates page modules into dist/.prerender before rendering.
const licenseText = await readFile(resolve(process.cwd(), "../../LICENSE"), "utf8");
---

<BaseLayout {title} {description} heading="Open by design" currentPath="/license">
  <Fragment slot="hero">
    <p class="tagline">
      Original writing shared under CC0. Open code. Sources kept with their credits.
    </p>
  </Fragment>

  <div class="legal-shell license-shell">
    <aside class="page-nav">
      <nav aria-label="On this page">
        <p>On this page</p>
        <ol>
          <li><a href="#coverage">What it covers</a></li>
          <li><a href="#website-content">Website content</a></li>
          <li><a href="#license-text">License and text dedication</a></li>
        </ol>
      </nav>
    </aside>

    <article class="legal-content">
      <section id="coverage" aria-labelledby="coverage-heading">
        <p class="section-kicker">One project, one license</p>
        <h2 id="coverage-heading">What it covers</h2>
        <p>
          The native apps for iPhone, iPad, Mac, and Vision Pro, the Android app, the
          WinUI app for Windows, Prosary’s web tools, and their shared data, documentation, tools,
          and original assets live in <a href="https://github.com/dkaluta/Prosary">one open-source
          monorepo</a>.
        </p>
        <p>
          Third-party material keeps its own license and attribution. Everything original to
          Prosary is covered by the canonical terms below: BSD 2-Clause for software and
          nontextual assets, and CC0 for David Kaluta’s original natural-language text and editorial contributions.
        </p>
      </section>

      <section id="website-content" aria-labelledby="website-content-heading">
        <h2 id="website-content-heading">Original website text is CC0</h2>
        <p>
          David Kaluta’s original writing and editorial content on this website are dedicated
          to the public domain under <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0 Universal</a>.
          You may copy, adapt, and share that text, including for commercial use, without asking permission.
        </p>
        <p>
          Software remains under BSD 2-Clause. Store badges, credited prayer texts, fonts,
          and other third-party material retain their own rights and licenses.
        </p>
      </section>

      <section id="license-text" class="license-card" aria-labelledby="license-heading">
        <div class="license-heading-row">
          <div>
            <p class="section-kicker">Canonical text</p>
            <h2 id="license-heading">License and text dedication</h2>
          </div>
          <a
            class="text-link"
            href="https://github.com/dkaluta/Prosary/blob/main/LICENSE"
          >View on GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <pre aria-label="Canonical Prosary license and CC0 text dedication"><code>{licenseText.trim()}</code></pre>
        <p class="license-note">
          This published copy is read directly from the repository’s root <code>LICENSE</code>
          file during the site build, so it stays in step with the whole project.
        </p>
      </section>
    </article>
  </div>
</BaseLayout>
