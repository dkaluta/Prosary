      },
      {
        "verse": 16,
        "text": "אֲשֶׁר־בְּיָדוֹ גַם־אֲנַחְנוּ וְגַם דְּבָרֵינוּ וְכָל־תְּבוּנָה וְדַעַת כָּל־מְלָאכָה׃",
        "sourcePages": [
          158
        ],
        "textSHA256": "c7dd83701c44c12952216034c888fa58f281e16e7f508264171ded097426c114"
      },
      {
        "verse": 17,
        "text": "כִּי הוּא נָתַן־לִי הַכָּרָה נְכוֹנָה שֶׁל־הַמְּצוּאִים לָדַעַת תְּכוּנַת תֵּבֵל וְכֹחַ הַיְסוֹדוֹת׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "45baceed9533571a47154a8fee37cd41c19887eab6dde6594a5362239ed599fc"
      },
      {
        "verse": 18,
        "text": "רֵאשִׁית הָעִתִּים אַחֲרִיתָן וּמַחֲצִיתָן תְּנוּעוֹת [הַשֶּׁמֶשׁ] לַחֲלִיפוֹתֵיהֶן וּתְמוּרוֹת הַזְּמַנִּים׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "ea37487a0669efeb019ae64756df88a9eb3f16a4930146d9093cd407591738ad"
      },
      {
        "verse": 19,
        "text": "מַחֲזוֹר הַשָּׁנִים וּמִשְׁטַר הַכּוֹכָבִים׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "f80d4a12332464a309b4219daee0e7a486280998f352e18bc4e02a0a18844c87"
      },
      {
        "verse": 20,
        "text": "תְּכוּנוֹת נֶפֶשׁ חַיָּה וַחֲמַת חַיוֹת פֶּרֶא כֹּחַ הָרוּחוֹת וְשִׂיחוֹת אֲנָשִׁים הַצְּמָחִים לְמִינֵיהֶם וּסְגֻלּוֹת הַשָּׁרָשִׁים׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "8c0adc32a7fb95e06401ab878faed660e39d8bd8c7d42ab243ce6f4b7092ad67"
      },
      {
        "verse": 21,
        "text": "הַנִּסְתָּרוֹת וְהַנִּגְלוֹת יָדָעְתִּי כִּי הַחָכְמָה אָמָּנִית הַכֹּל לִמְּדָתְנִי׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "86ae149a5676ae5089c66b9ed3315ba9ec98d420aaac7e41b8e97636d44627be"
      },
      {
        "verse": 22,
        "text": "אֲשֶׁר־בָּהּ רוּחַ מַשְׂכִּיל קָדוֹשׁ יָחִיד בְּמִינוֹ מְרֻבֶּה חֲלָקִים עָדִין קַל הַתְּנוּעָה זַךְ טָהוֹר בָּהִיר שָׁלֵם דּוֹרֵשׁ טוֹב מַעֲמִיק לִרְאוֹת אַמִּיץ פּוֹעֵל חֶסֶד׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "c1a21d56f0ffe931e0e294c4381951f2852b939873d2eaca316615c24b96104d"
      },
      {
        "verse": 23,
        "text": "אוֹהֵב אָדָם אֵיתָן תָּמִים חָפְשִׁי מִדְּאָגָה כֹּל יָכוֹל צוֹפֶה בַכֹּל חוֹדֵר לְכָל־הָרוּחוֹת הַמַּשְׂכִּילִים הַטְּהוֹרִים הָעֲדִינִים׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "43f715e41db98c4b80555b2796a38627de4282dd98960f8087952f42b9e30a3a"
      },
      {
        "verse": 24,
        "text": "כִּי הַחָכְמָה מְמַהֶרֶת לְהִתְנוֹעֵעַ מִכָּל־תְּנוּעָה עוֹבֶרֶת וְחוֹדֶרֶת לַכֹּל בְּטָהֳרָתָהּ׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "ccd3a59c19286be577f2351f2d0aad3aeb268010be8766bc28ed3d16d0eb77ef"
      },
      {
        "verse": 25,
        "text": "כִּי הִיא נְשִׁימָה מִגְּבוּרַת אֱלֹהִים שֶׁפַע זַךְ מִכְּבוֹדוֹ הַמּוֹשֵׁל בַּכֹּל וְלָכֵן כָּל־טֻמְאָה לֹא תִגַּע בָּהּ׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "c2a4f109509672c3b5d84caf0500cf3891c5cdc185f4db8ac57ad09917fb2545"
      },
      {
        "verse": 26,
        "text": "כִּי הִיא נֹגַהּ אוֹר עוֹלָם וּרְאִי טָהוֹר לִפְעֻלַּת אֱלֹהִים וּדְמוּת טוּבוֹ׃",
        "sourcePages": [
          160
        ],
        "textSHA256": "473655c346380c62f438f0f14e4b34f3adb6c67823a8274999c5fd7183de0d20"
      },
      {
        "verse": 27,
        "text": "יְחִידָה הִיא וְתוּכַל הַכֹּל בְּעֵינָהּ תִּשָּׁאֵר וּתְחַדֵּשׁ הַכֹּל וּמִדּוֹר לְדוֹר תַּעֲבֹר וְתָבֹא בִּנְפָשׁוֹת קְדוֹשׁוֹת וְתַעֲשֵׂן לִידִידֵי אֱלֹהִים וְלִנְבִיאִים׃",
        "sourcePages": [
          160
        ],
        "textSHA256": "73a06c542754237bc5c45eaca558fb9236753ee6d6a2805b7b5831b7c35d09be"
      },
      {
        "verse": 28,
        "text": "כִּי אֱלֹהִים לֹא יֶאֱהַב זוּלָתִי אֲשֶׁר־יִשְׁכֹּן בְּמִשְׁכַּן הַחָכְמָה׃",
        "sourcePages": [
          160
        ],
        "textSHA256": "683f6f43a535218d74c50627eb5ccdb2e8c35126da4baea4dee4996fc150de55"
      },
      {
        "verse": 29,
        "text": "הֵן נֶהְדָּרָה הִיא מִן־הַשֶּׁמֶשׁ וְיִתְרוֹן לָהּ מִמַּעֲלַת הַכּוֹכָבִים וּבְעֶרְכָּהּ תַּעֲלֶה עַל [כָּל־]אוֹר׃",
        "sourcePages": [
          160
        ],
        "textSHA256": "df01adb1be141fe1e95f8ffacc69677be74675d922315b3d9897f34cb47e0b74"
      },
      {
        "verse": 30,
        "text": "כִּי אֶת־מְקוֹמוֹ לַיִל יִירָשׁ אוּלָם הָרִשְׁעָה לֹא־תָקוּם בִּפְנֵי הַחָכְמָה׃",
        "sourcePages": [
          160
        ],
        "textSHA256": "03fd78ac2039887707722d7674a740e4033c32ff7ce7cf90a5e48619e84af5d3"
      }
    ]
  },
