  "draft": {
    "number": 11,
    "verses": [
      {
        "verse": 1,
        "text": "הִיא הִצְלִיחָה אֶת־מַעֲשֵׂיהֶם בְּיַד־נָבִיא קָדוֹשׁ׃",
        "sourcePages": [
          166
        ],
        "textSHA256": "d088414e98a97be9a5a45d268d27b721f9dbbb3678ebc75bcee94fbf6960d97c"
      },
      {
        "verse": 2,
        "text": "וַיֵּלְכוּ בַּמִּדְבָּר לֹא־יָשַׁב שָׁם אָדָם וַיִּטְעוּ אֹהָלִים בִּמְקוֹמוֹת לֹא־עָבַר בָּם אִישׁ׃",
        "sourcePages": [
          166
        ],
        "textSHA256": "256a4e2e25fe35adfed1d9f6b2efce079741a6ed96bbc011101b3f7279b72ad2"
      },
      {
        "verse": 3,
        "text": "וַיָּקוּמוּ נֶגֶד אוֹיְבֵיהֶם וַיִּנָּקְמוּ מִצָּרֵיהֶם׃ וַיִּצְמָאוּ וַיִּקְרְאוּ אֵלֶיךָ וַיִּתֵּן לָהֶם מַיִם מִצּוּר חַלָּמִישׁ וּרְוָיָה לִצְמָאָם מִצְּחִיחַ סָלַע׃",
        "sourcePages": [
          166
        ],
        "textSHA256": "288269b824fdca6cc75a23696cfdf5712b540818fb65292422ad51b3bd1432d9",
        "endVerse": 4
      },
      {
        "verse": 5,
        "text": "כִּי־בַדָּבָר אֲשֶׁר נִשְׁפְּטוּ צָרֵיהֶם בּוֹ נוֹשְׁעוּ הֵמָּה בַּצַּר לָהֶם׃",
        "sourcePages": [
          166
        ],
        "textSHA256": "15b5e82a19f8dcf71369257050b63a45c9b132dfa6743c9b20de2729eb578525"
      },
      {
        "verse": 6,
        "text": "[צָרֵיהֶם] נִבְהָלוּ בִּ[רְאוֹתָם] דָּם נִבְאַשׁ תַּחַת שֶׁטֶף מֵי־נָהָר לֹא־יָכוֹזֵב לְהוֹכִיחָם עַל־פְּקֻדַּת רֶצַח יְלָדִים׃",
        "sourcePages": [
          166
        ],
        "textSHA256": "22f6532384a27649ce25d46dbfefd465dccfc4c702a46304e9e040c7f80accfb"
      },
      {
        "verse": 7,
        "text": "וְלָהֶם נָתַתָּ שִׁפְעַת מַיִם אִישׁ לֹא פִלֵּל׃",
        "sourcePages": [
          166
        ],
        "textSHA256": "d972d50126b8dfba2d64d2aa6031b04a81a511a77da9da6cf0fd4d259c29c2ea"
      },
      {
        "verse": 8,
        "text": "וּבַצִּמָּאוֹן אֲשֶׁר צָמָאוּ אָז הֶרְאֵיתָ אֵיךְ תִּנָּקֵם מִשּׂוֹנְאֶיךָ׃ יַעַן כַּאֲשֶׁר נִסִּיתָם וַתְּיַסְּרֵם בְּרַחֲמִים הִכִּירוּ עֹנֶשׁ הָרְשָׁעִים אֲשֶׁר בְּחֶרְוֹן אַף יִשָּׁפֵטוּ׃",
        "sourcePages": [
          166
        ],
        "textSHA256": "95c4104207eb4fe55ed9fb41e94f2535883df2daab54d7d806d494a6cb1cecaa",
        "endVerse": 9
      },
      {
        "verse": 10,
        "text": "כִּי אוֹתָם נִסִּיתָ כְּאָב מוֹכִיחַ וְאֵלֶּה בָחַנְתָּ וְהִרְשַׁעְתָּ כְּמֶלֶךְ עָז׃",
        "sourcePages": [
          166
        ],
        "textSHA256": "1fd8efccc72d56b0ce2e1ef0304be2f6cd997842367a3c991f763db0c42bddec"
      },
      {
        "verse": 11,
        "text": "וְהִנֵּה גַּם־הָרְחוֹקִים וְגַם הַקְּרוֹבִים כְּאַחַת נוֹסָרוּ׃ הֵן מִשְׁנֶה עֶצֶב דִּכָּא אֶת־לִבָּם וַאֲנָחָה לְזֵכֶר הַדְּבָרִים אֲשֶׁר קָרוּ לָמוֹ׃",
        "sourcePages": [
          166
        ],
        "textSHA256": "71e848c0cd91676c601ef50bb6762f26c405698567b2e317c7f8580a60f4c8ed",
        "endVerse": 12
      },
      {
        "verse": 13,
        "text": "וּבְשָׁמְעָם כִּי בַדָּבָר אֲשֶׁר נִשְׁפְּטוּ־בוֹ הֵמָּה נוֹשְׁעוּ אֵלֶּה הִכִּירוּ אֶת־יְיָ׃",
        "sourcePages": [
          167
        ],
        "textSHA256": "2aae75bf77432915f5882e2f166e05ea8feab158eb9a67f19a0120a5c520081a"
      },
      {
        "verse": 14,
        "text": "מִקֵּץ הַמַּעֲשִׂים אַחֲרֵי סָבְלָם צִמָּאוֹן שׁוֹנֶה מִצִּמְּאוֹן הַצַּדִּיקִים הִשְׁתּוֹמְמוּ עַל־הָאִישׁ אֲשֶׁר בָּזוּ וְלָעֲגוּ לוֹ כִּי־עַל־כֵּן נְטָשׁוּהוּ וְהִשְׁלִיכֻהוּ [הַמַּיְמָה] לְפָנִים׃",
        "sourcePages": [
          167
        ],
        "textSHA256": "affc1be77312126a8b66fd9c40b25bbd077e64b5c869c3bdf4faae6ab8196092"
      },
      {
        "verse": 15,
        "text": "חֵלֶף מַחְשְׁבוֹת אִוַּלְתָּם וְרִשְׁעָתָם אֲשֶׁר הֱדִיחוּ אוֹתָם לַעֲבֹד לִשְׁרָצִים אֵין־דַּעַת בָּמוֹ וְלִרְמָשִׂים נִבְזִים שָׁלַחְתָּ עֲלֵיהֶם עֵרֶב עָצוּם אֵין־בּוֹ דַּעַת לְהִנָּקֵם מֵהֶם׃",
        "sourcePages": [
          167
        ],
        "textSHA256": "6a67cb9ea563202f02c3ab4836c652bcfa220d6312debe7612aaddf714a6d359"
      },
      {
        "verse": 16,
        "text": "לְמַעַן יֵדְעוּ כִּי בַדָּבָר אֲשֶׁר זָד אִישׁ בּוֹ יִשָּׁפֵט׃",
        "sourcePages": [
          167
        ],
        "textSHA256": "318e67fdcd3e9bcf74d98c4a10ba4a55eec3c0aff4579390b2d42ba6d9d68fcf"
      },
      {
        "verse": 17,
        "text": "כִּי מִיָּדְךָ הַכֹּל־יְכוֹלָה אֲשֶׁר יָצְרָה אֶת־הָעוֹלָם מֵחֹמֶר נֶעְדַּר צוּרָה לֹא־נִבְצַר לְהַשְׁלִיחַ בָּהֶם הֲמוֹן דֻּבִּים וַאֲרָיוֹת עַזֵּי נָפֶשׁ׃",
        "sourcePages": [
          167
        ],
        "textSHA256": "3d3b4564b04792b0cc08b551430ed91b6fe145d29ad4cceb2615086e4cd9de9a"
      },
      {
        "verse": 18,
        "text": "אוֹ בְּרִיאוֹת חֲדָשׁוֹת חַיוֹת זָרוֹת מְלֵאוֹת חֵמָה אוֹ חַיוֹת מוֹצִיאוֹת אֵשׁ בְּהֶבֶל פִּיהֶן אוֹ מַעֲלוֹת מִקִּרְבָּן צַחֲנַת עָשָׁן אוֹ מַתִּיזוֹת מֵעֵינֵיהֶן נִיצוֹצוֹת אֵימָה׃",
        "sourcePages": [
          167
        ],
        "textSHA256": "f863dae6e914695cdb19242cc0b31db14899afbbd727d0eea2858eec8985100e"
      },
      {
        "verse": 19,
        "text": "יַעַן הוּקַל לָהֶם לְהַשְׁמִידָם בְּפִגְעָם כִּי גַם בְּמַרְאֵיהֶם יְבַעֲתוּם וְיַשְׁחִיתוּם׃",
        "sourcePages": [
          167
        ],
        "textSHA256": "c8e451a3d23b86448054412efe082fc450d635a242b9e9f0624f743a99fab79c"
      },
      {
        "verse": 20,
        "text": "וּמִבַּלְעֲדֵי אֵלֶּה הֲלֹא בִּנְשִׁימָה אַחַת יָכֹלְתָּ לְכַלּוֹתָם בִּרְדֹף אוֹתָם נִקְמָתְךָ וּמֵרוּחַ גְּבוּרָתְךָ יְפוּצוּ אָמְנָם בְּמִדָּה בְּמִסְפָּר וּבְמִשְׁקָל הַכֹּל הֲכִינוֹתָ׃",
        "sourcePages": [
          167
        ],
        "textSHA256": "7f6168a5ac8ac9b7627894ab5708cae1927f64e21fa655bc39eae4d68f7ba448"
      },
      {
        "verse": 21,
        "text": "כִּי בְיָדְךָ תָּמִיד לְהַרְאוֹת כֹּחֲךָ הֶעָצוּם וּמִפְּנֵי זְרוֹעַ עֻזְּךָ מִי יַעֲמֹד׃",
        "sourcePages": [
          167
        ],
        "textSHA256": "673e3df3128feeefa4b90aac4c997cd3b11747e0e4fef30854fb18382a6743d1"
      },
      {
        "verse": 22,
        "text": "הֵן כִּשְׁחַק מֹאזְנִים הָעוֹלָם לְפָנֶיךָ וּכְטִפַּת טַל־בֹּקֶר נוֹפֶלֶת אָרְצָה׃",
        "sourcePages": [
          167,
          168
        ],
        "textSHA256": "4539d5082141407100acc0e1cb52069bcd6beeec9c290086a5739161fbbc3178"
      },
      {
        "verse": 23,
        "text": "אַךְ אַתָּה מְרַחֵם עַל־כֹּל כִּי תוּכַל כֹּל וְתַעֲלִים עַיִן מִפִּשְׁעֵי בְּנֵי אָדָם לְמַעַן יָשׁוּבוּ׃",
        "sourcePages": [
          168
        ],
        "textSHA256": "ebd7a8c47fcd94d021196e59a9af9410d47a0670d08056d5b9324354bc0d49e6"
      },
      {
        "verse": 24,
