  "textUnits": [
    {
      "verse": 1,
      "text": "וַיְהִי אַחֲרֵי הַכּוֹת אֶלֶכְּסַנְדַּר בֶּן־פִילִפּוֹס הַמַּקְדּוֹנִי אֲשֶׁר־יָצָא מֵאֶרֶץ כִּתִּים [אֶת־חֵיל פָּרָס] וַיַּךְ אֶת־דָּרְיָוֶשׁ מֶלֶךְ פָּרָס וּמָדַי וַיִּמְלֹךְ תַּחְתָּיו בָּרִאשׁוֹנָה בְּאֶרֶץ יָוָן׃",
      "sourcePages": [
        97
      ],
      "textSHA256": "099d2e7fcce77b07e84079b7cdedcc40497e58ec785dad99c823f730a18598e8"
    },
    {
      "verse": 2,
      "text": "וַיַּעֲרֹךְ מִלְחָמוֹת רַבּוֹת וַיִּלְכֹּד מִבְצָרִים וַיִּשְׁחַט מַלְכֵי אָרֶץ׃",
      "sourcePages": [
        97
      ],
      "textSHA256": "76f9c97b2af41f015b2a9038e5c86faf380ad49c190c1b1f2ea9bbdd33a009f3"
    },
    {
      "verse": 3,
      "text": "וַיָּבֹא עַד־קְצוֹת־הָאָרֶץ וַיִּקַּח שְׁלַל־גּוֹיִם רַבִּים וַתִּשְׁקֹט הָאָרֶץ לְפָנָיו וַיָּרָם וַיִּגְבַּהּ לִבּוֹ׃",
      "sourcePages": [
        97,
        98
      ],
      "textSHA256": "96ed3528ebd2b5eecde918f75647276c938daa6cc68227c2d4b9f34960b6b4e2"
    },
    {
      "verse": 4,
      "text": "וַיֶּאֱסֹף חַיִל כָּבֵד מְאֹד וַיִּמְלֹךְ עַל־אַרְצוֹת גּוֹיִם וְרוֹזְנִים וַיִּהְיוּ לוֹ לָמַס׃",
      "sourcePages": [
        98
      ],
      "textSHA256": "da9d38cd41f046a709c78ed576b29dc684715c3c1617694a9cfc5a877eecfed1"
    },
    {
      "verse": 5,
      "text": "וַיְהִי אַחַר הַדְּבָרִים הָאֵלֶּה וַיִּפֹּל לְמִשְׁכָּב וַיֵּדַע כִּי־יָמוּת׃",
      "sourcePages": [
        98
      ],
      "textSHA256": "0cd7cb3387bb8eabb77beb14d0a98703512179124c218ff3cc5a4d5d9273031e"
    },
    {
      "verse": 6,
      "text": "וַיִּקְרָא לַעֲבָדָיו הַנִּכְבָּדִים אֲשֶׁר־גָּדְלוּ אִתּוֹ מִנְּעוּרָיו וַיְחַלֵּק לָהֶם אֶת־מַלְכוּתוֹ בְּעוֹדֶנּוּ חָי׃",
      "sourcePages": [
        98
      ],
      "textSHA256": "6a72635499f23ce4172a9bd9fa3c2ce0a2342914b64211ea39c5f4e4c6ccdd05"
    },
    {
      "verse": 7,
      "text": "וַיִּמְלֹךְ אֶלֶכְּסַנְדַּר שְׁתֵּים־עֶשְׂרֵה שָׁנָה וַיָּמֹת׃",
      "sourcePages": [
        98
      ],
      "textSHA256": "436a91764095a234947bae3827fcd766d821c4cd7b78632e32b0fac06ebb7cfc"
    },
    {
      "verse": 8,
      "text": "וַיִּשְׁלְטוּ עֲבָדָיו אִישׁ בִּמְקוֹמוֹ׃ וַיָּשִׂימוּ כֻלָּם כִּתְרֵי מַלְכוּת בְּרָאשֵׁיהֶם אַחֲרֵי מוֹתוֹ וּבְנֵיהֶם אַחֲרֵיהֶם שָׁנִים רַבּוֹת וַיַּרְבּוּ רָעוֹת בָּאָרֶץ׃",
      "sourcePages": [
        98
      ],
      "textSHA256": "8f94ec19e0870991f24bce3ae8b85359780ecc8ed338d7fe2292dacb5f3b0597",
      "endVerse": 9
    }
  ],
