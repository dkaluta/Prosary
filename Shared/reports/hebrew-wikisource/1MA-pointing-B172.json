      "textSHA256": "bced05f77ff915f8199d9592eb37bf015389c59dbff474ff29fe2644e2f21b52"
    },
    {
      "chapter": 15,
      "verse": 4,
      "text": "וָאֶחְפֹּץ לַעֲבֹר בָּאָרֶץ לְמַעַן אֶעֱנֹשׁ אֶת־מַחֲרִיבֵי אַרְצֵנוּ וְהַמְשַׁמִּים עָרִים רַבּוֹת בְּמַלְכוּתִי׃",
      "sourcePages": [
        172
      ],
      "textSHA256": "c888719465e58aaded73a93ea0b82d3533ee082074ff5a2f3d76ba71bb215eb9"
    },
    {
      "chapter": 15,
      "verse": 5,
      "text": "וְעַתָּה קִיֵּמְתִּי לְךָ אֶת־כָּל־הַהֲנָחוֹת אֲשֶׁר־עָשׂוּ לְךָ הַמְּלָכִים אֲשֶׁר הָיוּ לְפָנַי וּשְׁאָר הַמַּתָּנוֹת אֲשֶׁר־הִנִּיחוּ לָךְ׃",
      "sourcePages": [
        172
      ],
      "textSHA256": "b2dfe473bb1b0079b65aaa2e8a39cbf7a0543c76f6817c1e0b5f78fd6f263172"
    },
    {
      "chapter": 15,
      "verse": 6,
      "text": "וּמַנִּיחַ אָנֹכִי לְךָ לַעֲשׂוֹת מַטְבֵּעַ שֶׁלְּךָ מְטֻבָּע בְּאַרְצֶךָ׃",
      "sourcePages": [
        172
      ],
      "textSHA256": "8cc711a0bfc3c56c698917d33c7b81a639e0d8fdc8b1d0d892ffff16af2f1978"
    },
    {
      "chapter": 15,
      "verse": 7,
      "text": "וִירוּשָׁלִַם וְהַמִּקְדָּשׁ יִהְיוּ חָפְשִׁים וְכָל־הַנֶּשֶׁק אֲשֶׁר־הֲכִינוֹתָ וְהַמִּבְצָרִים אֲשֶׁר־בָּנִיתָ אֲשֶׁר תִּמְשֹׁל בָּהֶם יִשָׁאֲרוּ לָךְ׃",
      "sourcePages": [
        172
      ],
      "textSHA256": "91f23beb0b2e1fed8e72882082cba56fd42c2f180e7b24b79b5548f7aaa482d3"
    },
    {
      "chapter": 15,
      "verse": 8,
      "text": "וְכָל־חוֹב הַמֶּלֶךְ וּמִסֵּי הַמֶּלֶךְ מֵעַתָּה לְכָל־הַיָּמִים מוּנָחִים לָךְ׃ וְכַאֲשֶׁר נְקוֹמֵם אֶת־מַלְכוּתֵנוּ נְכַבֵּד אוֹתְךָ וְאֶת־עַמְּךָ וְאֶת־הַמִּקְדָּשׁ בְּכָבוֹד גָּדוֹל לִהְיוֹת כְּבוֹדְכֶם נִרְאֶה בְּכָל־הָאָרֶץ׃",
      "sourcePages": [
        172
      ],
      "textSHA256": "8a825ed0b26e16aa7f65446dce0d7f9bb40cae8cc51c51206eb9baf1a8b752f5",
      "endVerse": 9
    }
  ],
