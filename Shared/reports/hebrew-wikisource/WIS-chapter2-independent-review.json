      {
        "verse": 20,
        "text": "בְּמוֹת נָבָל נַרְשִׁיעֵהוּ וְתִצְמַח לוֹ יְשׁוּעָה כִּדְבָרָיו׃",
        "sourcePages": [
          149
        ],
        "textSHA256": "2cb52621b2602d16421f22661e2449e5ac52f0bdd1b5b8a1176f0bd9a0c1e264"
