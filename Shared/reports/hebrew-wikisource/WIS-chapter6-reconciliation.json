      },
      {
        "verse": 10,
        "text": "כִּי שׁוֹמְרֵי חֻקֵּי קֹדֶשׁ בִּקְדשָּׁה יִקָּדשׁוּ וְלוֹמְדֵיהֶם יִמְצְאוּ מֵלִיץ יֹשֶׁר׃",
        "sourcePages": [
          156
        ],
        "textSHA256": "65ee5cd08ceb8beb1a72d4b10d272d69ef1eb0cd11b2fc813f052733e83176b7",
        "sourceNotes": [
          {
