  "textUnits": [
    {
      "verse": 6,
      "text": "וַיִּכָּנְעוּ הַפּוֹשְׁעִים מִפַּחְדּוֹ וְכָל־עוֹשֵׂי רֶשַׁע זָעוּ\nוַתִּצְלַח תְּשׁוּעָה בְיָדוֹ׃",
      "sourcePages": [
        111
      ],
      "textSHA256": "c59b160662f14b4afe0b5a27e162ec8a9ab7a5957a473651d254ce0e7c59df6a",
      "chapter": 3
    },
    {
      "verse": 7,
      "text": "וַיְמָרֵר מְלָכִים רַבִּים וַיְשַׂמַּח אֶת־יַעֲקֹב בְּמַעֲשָׂיו\nוְעַד־הָעוֹלָם זִכְרוֹ לִבְרָכָה׃",
      "sourcePages": [
        111
      ],
      "textSHA256": "21e4f6fbf88701e7b90c94288e4ee86bf28d9e3385c888f5db791c2ac3387744",
      "chapter": 3
    },
    {
      "verse": 8,
      "text": "וַיַּעֲבֹר בְּעָרֵי יְהוּדָה וַיְאַבֵּד רְשָׁעִים מִמֶּנָּה\nוַיָּשֶׁב חָרוֹן מִיִּשְׂרָאֵל׃",
      "sourcePages": [
        111
      ],
      "textSHA256": "3142b18c72002c2ead203c50884c90e3d4a6231cba183089294808cf5a3714c6",
      "chapter": 3
    },
    {
      "verse": 9,
      "text": "וַיִּקָּרֵא שְׁמוֹ עַד־אַפְסֵי אָרֶץ וַיֶּאֱסֹף אֶת־הָאוֹבְדִים׃",
      "sourcePages": [
        111
      ],
      "textSHA256": "2994c2e8b4ab6e5f6b636f35a2dc60fc168f2f16727da14fa950831ef1fc23b8",
      "chapter": 3
    },
    {
      "verse": 10,
      "text": "וַיֶּאֱסֹף אַפּוֹלוֹנִיוֹס גּוֹיִם וּמִשֹּׁמְרוֹן חַיִל גָּדוֹל לְהִלָּחֵם עִם־יִשְׂרָאֵל׃",
      "sourcePages": [
        111
      ],
      "textSHA256": "0864cb1e435a887f1567773e2764d505544e7b5efbf386af9933e6c67c85753d",
      "chapter": 3
    },
    {
      "verse": 11,
      "text": "וַיֵּדַע יְהוּדָה וַיֵּצֵא לִקְרָאתוֹ וַיַּךְ אוֹתוֹ וַיְמִיתֵהוּ וַיִּפְּלוּ חֲלָלִים רַבִּים וְהַנִּשְׁאָרִים נָסוּ׃",
      "sourcePages": [
        111
      ],
      "textSHA256": "b044534d920d6792c0c635552c759cb87bce4da578b0e657851b6c0a3eb4e10f",
      "chapter": 3
    },
    {
      "verse": 12,
      "text": "וַיִּקַּח אֶת־שְׁלָלָם וְאֶת־חֶרֶב אַפּוֹלוֹנִיוֹס לָקַח יְהוּדָה וַיְהִי נִלְחָם בָּהּ כָּל־הַיָּמִים׃",
      "sourcePages": [
        111
      ],
      "textSHA256": "ab06c4c5abce7a148cfb8dc9a237a738a4ce69236189779d050fe7bf60d8830c",
      "chapter": 3
    },
    {
      "verse": 13,
      "text": "וַיִּשְׁמַע סֵירוֹן שַׂר־צְבָא אֲרָם כִּי־אָסַף יְהוּדָה אֲסֵפָה וּקְהַל־נֶאֱמָנִים אִתּוֹ וְיוֹצְאִים לַמִּלְחָמָה׃",
      "sourcePages": [
        111
      ],
      "textSHA256": "1d3717bbdf0e0767130fbe8e081db9a42dd66746eee89297b50dd9c3a8019bca",
      "chapter": 3
    },
    {
      "verse": 14,
      "text": "וַיֹּאמֶר אֶעֱשֶׂה־לִי שֵׁם וְנִכְבַּדְתִּי בַמַּלְכוּת וְנִלְחַמְתִּי אֶת־יְהוּדָה וְאֵת אֲשֶׁר עִמּוֹ וְעִם־הַבּוֹזִים אֶת־דְּבַר־הַמֶּלֶךְ׃",
      "sourcePages": [
        111
      ],
      "textSHA256": "5443ff337a8e2c7bbc5e4754a39f41629fb2fbd0294831a0fcdd0d103a49b812",
      "chapter": 3
    },
    {
      "verse": 15,
      "text": "וַיּוֹסֶף לַעֲלוֹת וַיַּעַל אִתּוֹ מַחֲנֵה חַטָּאִים כָּבֵד לַעֲזֹר־לוֹ לַעֲשׂוֹת נְקָמָה בִּבְנֵי־יִשְׂרָאֵל׃",
      "sourcePages": [
        111
      ],
      "textSHA256": "946d5d752851026d350eecaff68db7b889079f09fe0997fefed96e21561a52e7",
      "chapter": 3
    },
    {
      "verse": 16,
      "text": "וַיַּגִּיעַ עַד־מַעֲלֵה בֵּית־חוֹרוֹן וַיֵּצֵא יְהוּדָה לִקְרָאתוֹ בִּמְתֵי־מְעָט׃",
      "sourcePages": [
        111
      ],
      "textSHA256": "88d9461c0a39a1fa1e9143aba067f472e0cf32f872945cde1d93c1561df7ab2f",
      "chapter": 3
    },
    {
      "verse": 17,
      "text": "וְכִרְאוֹתָם אֶת־הַמַּחֲנֶה הַבָּא לִקְרָאתָם אָמְרוּ לִיהוּדָה אֵיךְ נוּכַל אֲנַחְנוּ הַמְעַטִּים לְהִלָּחֵם עִם־הֶהָמוֹן הֶחָזָק הַזֶּה וַאֲנַחְנוּ עָיַפְנוּ לֹא־אָכַלְנוּ הַיוֹם׃",
      "sourcePages": [
        111,
        112
      ],
      "textSHA256": "9aac111c29cd1cbdb36f89256ff571fbe38d592ca5396e5e6517153fd7161a50",
      "chapter": 3
    },
    {
      "verse": 18,
      "text": "וַיֹּאמֶר יְהוּדָה נָקֵל כִּי יִסָּגְרוּ רַבִּים בִּידֵי מְעַטִּים וְאֵין מַעְצוֹר לִפְנֵי שָׁמַיִם לְהוֹשִׁיעַ בְּרַבִּים אוֹ בִמְעַטִּים׃",
      "sourcePages": [
        112
      ],
      "textSHA256": "cf8d59b14bd167a6f185e73ca2d48e780d8e5c77d1d30d88a29e239afecb1d3c",
      "chapter": 3
    },
    {
      "verse": 19,
      "text": "כִּי לֹא בְרָב־חַיִל נִצְחוֹן הַמִּלְחָמָה וּמִן־הַשָּׁמַיִם הַגְּבוּרָה׃",
      "sourcePages": [
        112
      ],
      "textSHA256": "4f6194c07c4fc12bcb64ee058e39c49e4a73b1e6581a8d953fdbfa821a38e1a3",
      "chapter": 3
    },
    {
      "verse": 20,
      "text": "הֵם בָּאִים אֵלֵינוּ בְּרֹב גַּאֲוָה וָפֶשַׁע לְהַשְׁמִיד אוֹתָנוּ וְאֶת־נָשֵׁינוּ וְאֶת־בָּנֵינוּ וּלְבֹז אוֹתָנוּ׃",
      "sourcePages": [
        112
      ],
      "textSHA256": "fb4a5764d200901b408b8f77e8b5045b5276d23b25b3aa32e52f11679ea4661a",
      "chapter": 3
    },
    {
      "verse": 21,
      "text": "וַאֲנַחְנוּ נִלְחָמִים עַל־נַפְשׁוֹתֵינוּ וְעַל תּוֹרָתֵנוּ׃",
      "sourcePages": [
        112
      ],
      "textSHA256": "9ffda0f5e8e54e3973e2e0acb53ae902054341b12d037e7e22631124677db2a8",
      "chapter": 3
    },
    {
      "verse": 22,
      "text": "וְהוּא יִגֹּף אוֹתָם לְפָנֵינוּ וְאַתֶּם אַל־תִּירְאוּ מִפְּנֵיהֶם׃ וְכַאֲשֶׁר כִּלָּה לְדַבֵּר נָפַל עֲלֵיהֶם פִּתְאֹם וַיִּנָּגֶף סֵירוֹן וּמַחֲנֵהוּ לְפָנָיו׃",
      "sourcePages": [
        112
      ],
      "textSHA256": "30189da02b1dc50fe726b7c9dc3a6a393c71bdf620061ccbad20163851f9f8a1",
      "endVerse": 23,
      "chapter": 3
    },
    {
      "verse": 24,
      "text": "וַיִּרְדְּפוּם בְּמוֹרַד בֵּית־חוֹרוֹן עַד־הַבִּקְעָה וַיִּפְּלוּ מֵהֶם כִּשְׁמוֹנֶה מֵאוֹת אִישׁ וְהַנִּשְׁאָרִים בָּרְחוּ לְאֶרֶץ פְּלִשְׁתִּים׃",
      "sourcePages": [
        112
      ],
      "textSHA256": "c362e27ab8b5918526f6e8ed71baa2df3212d992491373131c3f44f2689034f2",
      "chapter": 3
    },
    {
      "verse": 25,
      "text": "וַיָּחֶל פַּחַד יְהוּדָה וְאֶחָיו וְהָאֵימָה נָפְלָה עַל־הַגּוֹיִם אֲשֶׁר מִסְּבִיבוֹתֵיהֶם׃",
      "sourcePages": [
        112
      ],
      "textSHA256": "00049a04c9fff9f3f206e4f8afec15c8b5e665652361df29278fc61d27f964fe",
      "chapter": 3
    },
    {
      "verse": 26,
      "text": "נָגַע עַד־הַמֶּלֶךְ שְׁמוֹ וְעַל מִלְחֲמוֹת יְהוּדָה הָיָה מְסַפֵּר כָּל־עָם׃",
      "sourcePages": [
        112
      ],
      "textSHA256": "644e06e288506804e6e845c247baf65b6c81ca4e48caa07a86f5ca1bf23d62c0",
      "chapter": 3
    },
    {
      "verse": 27,
      "text": "וּכְשְׁמֹעַ אַנְטִיוֹכוֹס אֶת־הַדְּבָרִים הָאֵלֶּה חָרָה אַפּוֹ וַיִּשְׁלַח וַיֶּאֱסֹף כָּל־חֵיל־מַלְכוּתוֹ מַחֲנֶה כָּבֵד מְאֹד׃",
      "sourcePages": [
        112
      ],
      "textSHA256": "e21062358c67dca1d0c2acd92c1812b83b86f0355f21e79c2b6ebd66e8d59d52",
      "chapter": 3
    },
    {
      "verse": 28,
      "text": "וַיִּפְתַּח אֶת־גְּנָזָיו וַיִּתֵּן מַשְׂכֹּרֶת לְחֵילוֹ לְשָׁנָה וַיְצַו עֲלֵיהֶם לִהְיוֹת נְכוֹנִים לְכָל־צֹרֶךְ׃",
      "sourcePages": [
        112
      ],
      "textSHA256": "e9628d0d87f8833385f6654827901f6271ea616fd28307deca53d0a16d992b73",
      "chapter": 3
    },
    {
      "verse": 29,
      "text": "וַיַּרְא כִּי־אָפֵס הַכֶּסֶף מִן־הָאֹצָרוֹת וּמִסֵּי הָאָרֶץ מְעַטִּים מִפְּנֵי הַמַּחֲלֹקֶת וְהַמַּכָּה שֶׁהֵבִיא בָּאָרֶץ [וּבַקְּשׁוֹ] לְהָסִיר אֶת־הַחֻקִּים אֲשֶׁר הָיוּ לְמִן־יְמֵי הָרִאשׁוֹנִים׃",
      "sourcePages": [
        112
      ],
      "textSHA256": "d8e106da2ad95cfa6b4d0a13cc5072c800c0275ac237f7581368bbcc6752435d",
      "chapter": 3
    },
    {
      "verse": 30,
      "text": "וַיִּירָא כִּי לֹא־יִהְיֶה פַּעַם בְּפַעַם לְהוֹצָאוֹת וְהַמַּתָּנוֹת שֶׁהָיָה מוֹצִיא לְפָנִים בְּיָד רְחָבָה וּמְפַזֵּר מִן־הַמְּלָכִים הָרִאשׁוֹנִים׃",
      "sourcePages": [
        112
      ],
      "textSHA256": "068dfeb068cf4b78c51121ca8ba3b699525f030a07a7c09f6c00b5cb6da27392",
      "chapter": 3
    },
    {
      "verse": 31,
      "text": "וַיִּדְכָּא רוּחוֹ מְאֹד וַיִּוָּעֵץ לָלֶכֶת לְפָרַס וְלָקַחַת מִסֵּי הָאֲרָצוֹת וְלֶאֱסֹף כֶּסֶף רָב׃",
      "sourcePages": [
        112
      ],
      "textSHA256": "bac619362b178a0c43392eed6bc1c0f4499f68d5f0f5fbb38f4d342431b22a3d",
      "chapter": 3
    },
    {
      "verse": 32,
      "text": "וַיַּשְׁאֵר אֶת־לוּסִיאַס אָדָם נִכְבָּד וּמִזֶּרַע הַמְּלוּכָה עַל־עִנְיְנֵי הַמֶּלֶךְ מִנָּהָר פְּרָת וְעַד־גְּבוּל מִצְרָיִם׃",
      "sourcePages": [
        112,
        113
      ],
      "textSHA256": "b56da60df2e93ff11a9e2f6ddc31782a8a967ad9cb46398a87f51899897f3208",
      "chapter": 3
    },
    {
      "verse": 33,
      "text": "וּלְגַדֵּל אֶת־אַנְטִיוֹכוֹס בְּנוֹ עַד שׁוּבוֹ׃",
      "sourcePages": [
        113
      ],
      "textSHA256": "f4b581f0d98999d070cab244dce74f8241457ccca95b5864cf861956e27fc5fa",
      "chapter": 3
    },
    {
      "verse": 34,
      "text": "וַיִּמְסָר־לוֹ חֲצִי הַצָּבָא וְאֶת־הַפִּילִים וַיְצַוֵּהוּ עַל־אֲשֶׁר חָפֵץ וְעַל־יוֹשְׁבֵי יְהוּדָה וִירוּשָׁלִָם׃",
      "sourcePages": [
        113
      ],
      "textSHA256": "e27aa7dd60b44cb4c648e4a50393e6c4ba452a088b90c44afa049b6766acd4fb",
      "chapter": 3
    },
    {
      "verse": 35,
      "text": "לְשַׁלַּח עֲלֵיהֶם חַיִל לְשָׁרֵשׁ וּלְהַשְׁמִיד עֹז־יִשְׂרָאֵל וּשְׁאֵרִית יְרוּשָׁלִַם וְלִמְחוֹת אֶת־זִכְרָם מִן־הַמָּקוֹם׃",
      "sourcePages": [
        113
      ],
      "textSHA256": "9de695db49c81f94a01bdaabccb97094372ac581aac9b2bb57717d7265831b38",
      "chapter": 3
    },
    {
      "verse": 36,
      "text": "וּלְהוֹשִׁיב בְּנֵי־נֵכָר בְּכָל־גְּבוּלָם וּלְחַלֵּק בְּגוֹרָל אֶת־אַרְצָם׃",
      "sourcePages": [
        113
      ],
      "textSHA256": "0c956d1344e8725604eee80182271456c9cca8b15d99686d378c207bba2eed63",
      "chapter": 3
    },
    {
      "verse": 37,
      "text": "וְהַמֶּלֶךְ לָקַח אֶת־חֲצִי הַצָּבָא הַנִּשְׁאָר וַיִּסַּע מֵאַנְטִיוֹכִיָּה מֵעִיר מַלְכוּתוֹ בִּשְׁנַת שֶׁבַע וְאַרְבָּעִים וּמֵאָה וַיַּעֲבֹר אֶת־נְהַר פְּרָת וַיַּעֲבֹר אֶת־הָאֲרָצוֹת הָעֶלְיוֹנוֹת׃",
      "sourcePages": [
        113
      ],
      "textSHA256": "e0021cf843a2bf688972b9c38da97729831b19567529820a49e41fb751be250e",
      "chapter": 3
    },
    {
      "verse": 38,
      "text": "וַיִּבְחַר לוּסִיאַס אֶת־תַּלְמַי בֶּן־דּוֹרוֹמִינֶס וְאֶת־נִיקָנוֹר וְאֶת־גָּרְגִיאַס אַנְשֵׁי חַיִל מֵאוֹהֲבֵי הַמֶּלֶךְ׃",
      "sourcePages": [
        113
      ],
      "textSHA256": "4effbd9b2e3e5f6d4969846146b4d59397836c76f3c40d8fdf81ac112c77f88c",
      "chapter": 3
    },
    {
      "verse": 39,
      "text": "וַיִּשְׁלַח אִתָּם אַרְבָּעִים אֶלֶף אִישׁ וְשִׁבְעַת אֲלָפִים פָּרָשִׁים לָלֶכֶת לְאֶרֶץ יְהוּדָה וּלְהַשְׁמִיד כִּדְבַר הַמֶּלֶךְ׃",
      "sourcePages": [
        113
      ],
      "textSHA256": "54665eca4fc91fd31c16973ab183013ecbda0cb221186d32b2e65ac4e70fe378",
      "chapter": 3
    },
    {
      "verse": 40,
      "text": "וַיִּסְעוּ עִם־כָּל־חֵילָם וַיָּבֹאוּ וַיַּחֲנוּ מוּל עַמָּאוּס בְּאֶרֶץ הַמִּישׁוֹר׃",
      "sourcePages": [
        113
      ],
      "textSHA256": "43f8f3b783e199c45f04ed96b1b125013b95ba9a9aaf6088051d37c41589ba27",
      "chapter": 3
    },
    {
      "verse": 41,
      "text": "וַיִּשְׁמְעוּ סוֹחֲרֵי הָאָרֶץ אֶת־שִׁמְעָם וַיִּקְחוּ כֶּסֶף וְזָהָב רַב מְאֹד וּכְבָלִים וַיָּבֹאוּ אֶל־הַמַּחֲנֶה לָקַחַת אֶת־בְּנֵי־יִשְׂרָאֵל לַעֲבָדִים וַיִּתְחַבְּרוּ אֲלֵיהֶם חֵיל־אֲרָם וְאֶרֶץ הַפְּלִשְׁתִּים׃",
      "sourcePages": [
        113,
        114
      ],
      "textSHA256": "b2efb1a3600a918576ee7a593a43daeb94686efaf0ac0fe2aaea19ec6fafa5a5",
      "chapter": 3
    },
    {
      "verse": 42,
      "text": "וַיַּרְא יְהוּדָה וְאֶחָיו כִּי־רַבּוּ הָרָעוֹת וְהַצָּבָא חוֹנֶה בִגְבוּלָם וַיֵּדְעוּ דִּבְרֵי הַמֶּלֶךְ אֲשֶׁר־צִוָּה לַעֲשׂוֹת לָעָם לְהַשְׁחִית וּלְהַשְׁמִיד׃",
      "sourcePages": [
        114
      ],
      "textSHA256": "477169bb0ddadccddf4cb9e3881238a8ee797133fdcb21d276b1e45850df5a5a",
      "chapter": 3
    },
    {
      "verse": 43,
      "text": "וַיֹּאמְרוּ אִישׁ אֶל־רֵעֵהוּ נָקִים הֲרִיסוֹת עַמֵּנוּ וְנִלְחַמְנוּ בְּעַד עַמֵּנוּ וְהַמִּקְדָּשׁ׃",
      "sourcePages": [
        114
      ],
      "textSHA256": "5cb81431e721381f5742db48b7aa3def733f5b6f71cc6d971e357f3353f65b75",
      "chapter": 3
    },
    {
      "verse": 44,
      "text": "וַתִּקָּהֵל הָעֵדָה לִהְיוֹת נְכוֹנִים לַמִּלְחָמָה וּלְהִתְפַּלֵּל וּלְבַקֵּשׁ חֶסֶד וְרַחֲמִים׃",
      "sourcePages": [
        114
      ],
      "textSHA256": "c5fd8b8efe9b71e3f5d924ba03ddfe18ef3d8dd7db76a21f387dd4246b47ecc6",
      "chapter": 3
    },
    {
      "verse": 45,
      "text": "וִירוּשָׁלִַם שְׁמָמָה כַמִּדְבָּר הָיְתָה לֹא הָיָה בָא וְיוֹצֵא מִבָּנֶיהָ\nוְהַמִּקְדָּשׁ מִרְמָס [לְרַגְלֵי זָרִים]\nוּבְנֵי־נֵכָר בַּמְּצוּדָה מִשְׁכָּן לַגּוֹיִם\nוַתֵּאָסֶף שִׂמְחָה מִיַּעֲקֹב וַיִּשְׁבַּת חָלִיל וְכִנּוֹר׃",
      "sourcePages": [
        114
      ],
      "textSHA256": "e06834184bc10740bec42d7c7873296cec998a22f672c224a0aba12f0888185f",
      "chapter": 3
    },
    {
      "verse": 46,
      "text": "וַיֵּאָסְפוּ וַיָּבֹאוּ לַמִּצְפָּה מוּל יְרוּשָׁלִָם כִּי מְקוֹם־תְּפִלָּה הָיָה בַּמִּצְפָּה לְפָנִים בְּיִשְׂרָאֵל׃",
      "sourcePages": [
        114
      ],
      "textSHA256": "6aa2eca905f3957380513f953e6287a711372ddfc8d54c8b86f2078b80cc5317",
      "chapter": 3
    },
    {
      "verse": 47,
      "text": "וַיָּצוּמוּ בַּיּוֹם הַהוּא וַיִּלְבְּשׁוּ שַׂק וָאֵפֶר עַל־רָאשֵׁיהֶם וַיִּקְרְעוּ בִגְדֵיהֶם׃",
      "sourcePages": [
        114
      ],
      "textSHA256": "79a9ab13497ad26c0feff798f53241193a6bc1abcb4fda7f83f618e89bbe418f",
      "chapter": 3
    },
    {
      "verse": 48,
      "text": "וַיִּפְרְשׂוּ אֶת־סֵפֶר הַתּוֹרָה מִן־[הַסְּפָרִים] אֲשֶׁר בִּקְשׁוּ הַגּוֹיִם לָחֹק עֲלֵיהֶם אֶת־צַלְמֵי אֱלִילֵיהֶם׃",
      "sourcePages": [
        114
      ],
      "textSHA256": "fb5d2f85bd6cf06a926aa6d0feb4ba30f4965d15932c5b05e30a8db1d82b4dbc",
      "chapter": 3
    },
    {
      "verse": 49,
      "text": "וַיָּבִיאוּ אֶת־בִּגְדֵי הַכְּהֻנָּה וְאֶת הַבִּכּוּרִים וְאֶת הַמַּעַשְׂרוֹת וַיַּעֲמִידוּ אֶת־הַנְּזִירִים אֲשֶׁר מִלְאוּ אֶת־הַיָּמִים׃",
      "sourcePages": [
        114,
        115
      ],
      "textSHA256": "e985ee3b3f7c8ad19aa12dda742f373adbdb491413688557d20a0f4d64001ad3",
      "chapter": 3
    },
    {
      "verse": 50,
      "text": "וַיִּקְרְאוּ בְּקוֹל אֶל־הַשָּׁמַיִם לֵאמֹר מַה־נַּעֲשֶׂה לָאֵלֶּה וְאָנָה נוֹלִיךְ אוֹתָם׃",
      "sourcePages": [
        115
      ],
      "textSHA256": "b73a376df8d05afd08f265336d227d2aab1fa6ed8d4054edd635f704a83671cf",
      "chapter": 3
    },
    {
      "verse": 51,
      "text": "וּמִקְדָּשְׁךָ נִרְמָס וְנִטְמָא וְכֹהֲנֶיךָ בְּאֵבֶל וּבְשָׁפָל׃",
      "sourcePages": [
        115
      ],
      "textSHA256": "fae319927118373e2381cd63f65d3db869ba252b2252998ab9b3e216058ca338",
      "chapter": 3
    },
    {
      "verse": 52,
      "text": "וְהִנֵּה הַגּוֹיִם נֶאֶסְפוּ עָלֵינוּ לְהַשְׁמִידֵנוּ אַתָּה יָדַעְתָּ אֲשֶׁר יַחְשְׁבוּ עָלֵינוּ׃",
      "sourcePages": [
        115
      ],
      "textSHA256": "cea809305185a80ff514d3f636e1042a2d70eb63a9c21480220628493a35b1f8",
      "chapter": 3
    },
    {
      "verse": 53,
      "text": "אֵיךְ נוּכַל לַעֲמֹד בִּפְנֵיהֶם אִם־לֹא אַתָּה תוֹשִׁיעַ לָנוּ׃ וַיִּתְקְעוּ בַחֲצֹצְרוֹת וַיִּקְרְאוּ בְּקוֹל גָּדוֹל׃",
      "sourcePages": [
        115
      ],
      "textSHA256": "416968ce4f941f27ee8b500922517020083384046294c088a5f3ca4c4f1edc86",
      "endVerse": 54,
      "chapter": 3
    },
    {
      "verse": 55,
      "text": "וְאַחֲרֵי־כֵן הֵקִים יְהוּדָה רָאשֵׁי הָעָם שָׂרֵי אֲלָפִים שָׂרֵי מֵאוֹת שָׂרֵי חֲמִשִּׁים וְשָׂרֵי עֲשָׂרוֹת׃",
      "sourcePages": [
        115
      ],
      "textSHA256": "cf2d1072cb229b1936bf9d4882f13a77dea2d69b2c935ae3ddf254650739fa7b",
      "chapter": 3
    },
    {
      "verse": 56,
      "text": "וַיֹּאמֶר לְבוֹנֵי בָתִּים וְלִמְאָרְשֵׂי נָשִׁים וּלְנוֹטְעֵי כְרָמִים וּלְרַכֵּי הַלֵּבָב לָשׁוּב כָּל־אִישׁ לְבֵיתוֹ עַל־פִּי־הַתּוֹרָה׃",
      "sourcePages": [
        115
      ],
      "textSHA256": "0d5165b914c9a8b88d7ae84c3f39b32daf1e52b1ffba307bf9f307df7822bc4a",
      "chapter": 3
    },
    {
      "verse": 57,
      "text": "וַיִּסַּע הַמַּחֲנֶה וַיַּחֲנוּ מִדְּרוֹם לְעַמָּאוּס׃ וַיֹּאמֶר יְהוּדָה הִתְאַזְּרוּ וִהְיוּ לִבְנֵי־חַיִל וִהְיוּ נְכוֹנִים לַבֹּקֶר לְהִלָּחֵם בַּגּוֹיִם אֲשֶׁר נֶאֶסְפוּ עָלֵינוּ לְהַשְׁמִידֵנוּ וְאֶת־מִקְדָּשֵׁנוּ׃",
      "sourcePages": [
        115
      ],
      "textSHA256": "5dc6fb28bd06a22075109f409af85d885189e1000a5e78bed11b4d843f5ec7e5",
      "endVerse": 58,
      "chapter": 3
    },
    {
      "verse": 59,
      "text": "כִּי טוֹב לָנוּ לָמוּת בַּמִּלְחָמָה מֵרְאוֹת בְּרָעוֹת עַמֵּנוּ וּמִקְדָּשֵׁנוּ׃",
      "sourcePages": [
        115
      ],
      "textSHA256": "ea3db81eb481c961fc322dc20b1ab8be1c680948b47090d4a1db681bad4233d7",
      "chapter": 3
    },
    {
      "verse": 60,
      "text": "וְכַאֲשֶׁר יִהְיֶה הָרָצוֹן בַּשָּׁמַיִם כֵּן יֵעָשֶׂה׃",
      "sourcePages": [
        115
      ],
      "textSHA256": "499daa3811973eeee9b3d7228e1ca9f087be6f265b1c32287f96bc930839894a",
      "chapter": 3
    }
  ],
  "productionEligible": false
}
