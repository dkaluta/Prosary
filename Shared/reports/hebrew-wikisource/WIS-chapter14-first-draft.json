  "draft": {
    "number": 14,
    "verses": [
      {
        "verse": 1,
        "text": "וְיֵשׁ אֲשֶׁר יִתְכּוֹנֵן אִישׁ לִנְסֹעַ בַּיָּם וְלַעֲבֹר דֶּרֶךְ גַּלִּים סוֹאֲנִים וִישׁוּעַ לְעֵץ רָקָב מִן־הָאֳנִיָּה אֲשֶׁר תִּשָּׂאֵהוּ׃",
        "sourcePages": [
          172
        ],
        "textSHA256": "adf3e4f07e55f6e72bfe68149752b4a6e39f56612b567e59ab0e2ffc7a50b455"
      },
      {
        "verse": 2,
        "text": "כִּי אוֹתָהּ הִמְצִיאָה חֶמְדַּת רְכוּשׁ וְהֶחָרָשׁ בָּנָה אוֹתָהּ בְּחָכְמָתוֹ׃",
        "sourcePages": [
          172
        ],
        "textSHA256": "d1013d80823ab09ed5f827a6d4f64b380cd4ed3a15fb6606fe11e0c7e3f411f1"
      },
      {
        "verse": 3,
        "text": "אַךְ אַתָּה אָבִינוּ בְּהַשְׁגָּחָתְךָ תּוֹלִיכֶנָּה כִּי־נָתַתָּ בַּיָּם דֶּרֶךְ וּבַגַּלִּים נְתִיבָה בְטוּחָה׃",
        "sourcePages": [
          172
        ],
        "textSHA256": "61acfad588deabe9f4b65a1edbc8419a341f3745360985651538085c22958dae"
      },
      {
        "verse": 4,
        "text": "לְהַרְאוֹת אֲשֶׁר תוּכַל לְהַצִּיל מִכָּל־צָרָה] גַּם אִם־יֵרֵד אִישׁ [בָּאֳנִיָּה] לְלֹא־חָכְמָה׃",
        "sourcePages": [
          172
        ],
        "textSHA256": "7d6250e4522ff304a6889d9b76aca61f2a52fe1f588b6aa916cf9b0e761857f4"
      },
      {
        "verse": 5,
        "text": "וְאַתָּה חָפַצְתָּ כִּי מִפְעֲלֵי חָכְמָתְךָ לֹא יִהְיוּ לָרִיק לָכֵן יַפְקִידוּ בְנֵי־אָדָם לְעֵץ קַל אֶת־נַפְשׁוֹתֵיהֶם וְיַעַבְרוּ בַּתֵּבָה בְּסַעַר הַיָּם וְיִנָּצֵלוּ׃",
        "sourcePages": [
          172
        ],
        "textSHA256": "d0c438dea555211aeb7187078ace23141cf8946b9be65fef041124a1b8a45071"
      },
      {
        "verse": 6,
        "text": "גַּם בְּהִשָּׁמֵד הַנְּפִילִים הַגֵּאִיוֹנִים מִקֶּדֶם תִּקְוַת תֵּבֵל בְּתֵבָה נִמְלָטָה וְהִשְׁאִירָה זֶרַע לְדוֹרוֹת עוֹלָם כִּי יָדְךָ נָהֲגָה אוֹתָהּ׃",
        "sourcePages": [
          172
        ],
        "textSHA256": "46a4d73167e0142e00408a2a190c9a78932cba615fee3f6cd4f6407f2b0d7377"
      },
      {
        "verse": 7,
        "text": "הֵן יְבֹרַךְ הָעֵץ אֲשֶׁר מִמֶּנּוּ יָקוּם צֶדֶק׃",
        "sourcePages": [
          172,
          173
        ],
        "textSHA256": "26ec82c0b2e3efe8cdeb361949d333a5ef027b9e2ca998224ee618f7f0fb02ae"
      },
      {
        "verse": 8,
        "text": "וְאָרוּר [פֶּסֶל עֵץ] מַעֲשֵׂה יְדֵי אָדָם גַּם הוּא וְגַם עוֹשֵׂהוּ זֶה יַעַן עָשָׂהוּ וָזֶה כִּי בֶּן־חֲלוֹף הוּא וּבְשֵׁם אֱלֹהַ יְכֻנֶּה׃",
        "sourcePages": [
          173
        ],
        "textSHA256": "ac13f3299e26253ad1b0221d547bbfa62bddac1413e030ef568c5a26e6df3f16"
      },
      {
        "verse": 9,
        "text": "כִּי הָרָשָׁע וְרִשְׁעָתוֹ תּוֹעֲבַת יָי גַּם שְׁנֵיהֶם׃ עַל־כֵּן הַמַּעֲשֶׂה וְעוֹשֵׂהוּ יַחְדָּו יִשָּׁפֵטוּ׃",
        "sourcePages": [
          173
        ],
        "textSHA256": "b675f2a0f69804410ae13a8ef5d32dc25de5c44c1791812adfac08aba7df11d3",
        "endVerse": 10
      },
      {
        "verse": 11,
        "text": "וְלָכֵן תָּבֹא פְּקֻדָּה גַּם עַל־אֱלִילֵי הַגּוֹיִם כִּי מִפְעַל אֱלֹהִים הָיוּ לְתוֹעֵבָה וּמוֹקֵשׁ לְנַפְשׁוֹת בְּנֵי אָדָם וּפַח לְרַגְלֵי אֱוִילִים׃",
        "sourcePages": [
          173
        ],
        "textSHA256": "ec9583b08206e766bba24f09e3c2b16ffe738a551c2587154174c487980092c5"
      },
      {
        "verse": 12,
        "text": "כִּי רֵאשִׁית זִמָּה מְזִמַּת אֱלִילִים וּמְחוֹלְלָם מַשְׁחִית נֶפֶשׁ׃ כִּי מֵרֵאשִׁית לֹא הָיוּ וּבַל־יִהְיוּ לָעַד׃",
        "sourcePages": [
          173
        ],
        "textSHA256": "91206470b81f58ee2cf03cad327077b4b43558f916cc8120b77aabb72f189a5e",
        "endVerse": 13
      },
      {
        "verse": 14,
        "text": "הֲלֹא בְסִכְלוּת בְּנֵי־אָדָם בָּאוּ לָעוֹלָם וְלָכֵן יַעַץ יָי לְמַהֵר קִצָּם׃",
        "sourcePages": [
          173
        ],
        "textSHA256": "4664d0342d453448b1b5de5bb59841e44935a5f7b0e1efa546672f86343b4db8"
      },
      {
        "verse": 15,
        "text": "הִנֵּה אָב אָכוּל כְּאֵב עַל־בְּנוֹ אֲשֶׁר נֶאֱסַף פִּתְאֹם בְּלֹא־עִתּוֹ עָשָׂה תַּבְנִית אָדָם מֵת מֵאָז וְעַתָּה כְּאֵל יַעֲרִיצֵהוּ וּלְחֲנִיכָיו יַעֲרֹךְ [לִכְבוֹדוֹ] אֲסֵפוֹת סְתָרִים וְעֲצֶרֶת רָזִים׃",
        "sourcePages": [
          173
        ],
        "textSHA256": "38f4fb67bda8d100b7b09c59de5f50c6731241e6d081b8b175288c676168d328"
