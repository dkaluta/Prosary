  "canonicalChapterBeforeReconciliation": {
    "number": 1,
    "verses": [
      {
        "verse": 1,
        "text": "שֹׁפְטֵי הָאָרֶץ אֶהֱבוּ צֶדֶק חִשְׁבוּ עַל־אֱלֹהִים בְּיֹשֶׁר וְדִרְשׁוּהוּ בְּתָם־לֵבָב:",
        "sourcePages": [
          145
        ],
        "textSHA256": "a52bed08e1d0b993f2bef69407d76f48bf68044cee811ed1579ba0375064e73d"
      },
      {
        "verse": 2,
        "text": "כִּי יִמָּצֵא לְלֹא נִסּוּהוּ וְנִרְאֶה לְלֹא כִּחֲשׁוּ בוֹ:",
        "sourcePages": [
          145
        ],
        "textSHA256": "42c0c2d53007d5890f928e206653e2671b016a39c04c245008d4d2eb61662ed2"
      },
      {
        "verse": 3,
        "text": "כִּי מַחֲשָׁבוֹת עֲקַלְקַלּוֹת מְרַחֲקוֹת מֵאֱלֹהִים וֶאֱוִילִים מְנַסִּים גְּבוּרָתוֹ יִשָּׁפֵטוּ:",
        "sourcePages": [
          145
        ],
        "textSHA256": "aabccb5a09f6ef2b2fe133180ec9503cb9dbbdfac3a5281d7bd9199d4a9f6219"
      },
      {
        "verse": 4,
        "text": "הֵן בְּנֶפֶשׁ עִקֶּשֶׁת לֹא תָבֹא חָכְמָה וְלֹא תִשְׁכֹּן בְּגוּף מִתְמַכֵּר לְחֵטְא",
        "sourcePages": [
          145
        ],
        "textSHA256": "80a608d8e8a1cf3d1a9865b526a1a61d58f542a41e9f9a56f61f452c1bde27a7"
      },
      {
        "verse": 5,
        "text": "כִּי רוּחַ מוּסָר קָדוֹשׁ יִרְחַק מִמִּרְמָה וְנָס מִמַּחְשְׁבוֹת נְבָלִים וְיָסוּר בִּקְרֹב הָרֶשַׁע:",
        "sourcePages": [
          145
        ],
        "textSHA256": "02c3c51725216a58dcf0f3149605213d48a2cbd8c9bb134b00e5caa4c97097de"
      },
      {
        "verse": 6,
        "text": "כִּי הַחָכְמָה רוּחַ אוֹהֶבֶת אֲנָשִׁים וְלֹא תְנַקֶּה אֶת־הַמְחָרֵף בִּשְׂפָתָיו כִּי אֱלֹהִים בּוֹחֵן כִּלְיוֹתָיו וְיֵיטִיב לִרְאוֹת לִלְבּוֹ וּלְהַקְשִׁיב לְקוֹלוֹ:",
        "sourcePages": [
          145,
          146
        ],
        "textSHA256": "3a6b63e334cd1f7a85fcf1ed576b774ee790fbee8df7bc5022372cd5505ad1a8"
      },
      {
        "verse": 7,
        "text": "כִּי רוּחַ יְיָ מָלְאָה תֵבֵל וְהַכּוֹלֵל הַכֹּל יַחַד יָבִין כָּל־הֶגֶה:",
        "sourcePages": [
          146
        ],
        "textSHA256": "0b4a7c8e5decf350666230f238736a258ba036ab9948d60799875754862fcef2"
      },
      {
        "verse": 8,
        "text": "לָכֵן לֹא יִסָּתֵר מִמֶּנּוּ כָּל־דּוֹבֵר תַּהְפֻּכוֹת וְלֹא יִמָּלֵט מִתִּגְרַת יַד הַמִּשְׁפָּט:",
        "sourcePages": [
          146
        ],
        "textSHA256": "83802097996e48c1af5516a2ca61492c3553c6e8ce2745159692da7fe4486fa4"
      },
      {
        "verse": 9,
        "text": "כִּי מַעַלְלֵי רֶשַׁע יִבָּחֵנוּ וְקוֹל דְּבָרָיו יָבֹא לִפְנֵי אֱלֹהִים לְהָעִיד עַל־תּוֹעֲבוֹתָיו:",
        "sourcePages": [
          146
        ],
        "textSHA256": "1e6a2f232c81800749c4be25bcd3960d40bd6fe2e5844e1aecc0dbbc7dbec9d3"
      },
      {
        "verse": 10,
        "text": "כִּי אֹזֶן קִנְאָה תִּשְׁמַע הַכֹּל וְלַחַשׁ תְּלֻנוֹת לֹא יִסָּתֵר:",
        "sourcePages": [
          146
        ],
        "textSHA256": "93ae319d51b2d571e7a9ce57c8cb123e34ef8887ab0e0d2146dadfda6d6e491b"
      },
      {
        "verse": 11,
        "text": "לָכֵן הִשָּׁמְרוּ מִתְּלֻנָּה בְּלִי־הוֹעִיל וְתִצְּרוּ לְשׁוֹנְכֶם מִדִּבַּת רָעָה כִּי דְּבַר־סֵתֶר לֹא יָשׁוּב רֵיקָם וּפִי־כָזוֹב יָמִית נָפֶשׁ:",
        "sourcePages": [
          146
        ],
        "textSHA256": "7ef95ca625881f6ff7953fd627ee422bdcfab142d3b4f68d624321fb8e5d4dae"
      },
      {
        "verse": 12,
        "text": "אַל־תְּבַקְשׁוּ מָוֶת בְּעִקְּשׁוּת חַיֵּיכֶם וְאַל־תִּמְשְׁכוּ אֲבַדּוֹן בְּפֹעַל כַּפֵּיכֶם:",
        "sourcePages": [
          146
        ],
        "textSHA256": "4ec2f385e038cf217f80f50029f103bcc4fbe61ebe24f09d1ae3128d99172404"
      },
      {
        "verse": 13,
        "text": "כִּי אֱלֹהִים לֹא עָשָׂה אֶת־הַמָּוֶת וְלֹא יָשִׂישׂ עַל־כִּלְיוֹן הַחַיִּים:",
        "sourcePages": [
          146
        ],
        "textSHA256": "c0cc04b545d2d2fd7121f5f4b94423152937678fb93451c979296dab6550233e"
      },
      {
        "verse": 14,
        "text": "הֵן בָּרָא אָרֶץ וּמְלוֹאָהּ לְמַעַן תָּקוּם וִיצִירֵי הָעוֹלָם שְׁלֵמִים הֵמָּה וְסַם מָוֶת אֵין בָּמוֹ וּשְׁאוֹל אֵין עַל־עָפָר מֶמְשָׁלָה:",
        "sourcePages": [
          146
        ],
        "textSHA256": "5d2a26892056c19bf7f3a98ae3f4913bedac5a69365b39cf1acd7448ef999c01"
      },
      {
        "verse": 15,
        "text": "כִּי הַצֶּדֶק יַעֲמֹד לָעַד וְהָרִשְׁעָה תִּרְדֹּף מוֹתוֹ!",
        "sourcePages": [
          146
        ],
        "textSHA256": "be75098bd1b8525739a81fdecce8a4726e07c132a6bccf92828415a2d18fbea0"
      },
      {
        "verse": 16,
        "text": "וְהָרְשָׁעִים בְּמַעַלְלֵיהֶם וּבְדִבְרֵיהֶם יִקְרָאוּהוּ בְּחָשְׁבָם אוֹתוֹ לְרֵעַ כִּי חָדָה [לוֹ] נַפְשָׁם וַיִּכְרְתוּ אִתּוֹ בְרִית כִּי לָהֶם יָאתָה הֱיוֹת חֶבֶל נַחֲלָתוֹ:",
        "sourcePages": [
          146
        ],
        "textSHA256": "61dbbc8a29f27139a03342dd72c0838afa4e707b6e06dcc6121025bb539ae378"
      }
