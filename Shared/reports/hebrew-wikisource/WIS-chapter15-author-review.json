        "textSHA256": "3e8c170eff84e1ec0b4ed840c983183d529c704597d2d7af32d10600e57c4335"
      },
      {
        "verse": 11,
        "text": "כִּי לֹא־יָדַע אֶת־יוֹצְרוֹ אֲשֶׁר נָשַׁף־בּוֹ נֶפֶשׁ פּוֹעֶלֶת וַיִּפַּח בְּאַפָּיו נִשְׁמַת חַיִּים׃",
        "sourcePages": [
          176
        ],
        "textSHA256": "e449b2bbac9aebdc04a1f8082168bb3ff5a110a0d8d00151c867b02f8ca1377f"
      },
      {
        "verse": 12,
        "text": "אָמְנָם הוּא יַחְשֹׁב אֶת־חַיֵּתֵנוּ לְמִשְׂחָק וְחַיֵּינוּ לְמַרְכֹּלֶת תַּעֲשִׁיר אִישׁ כִּי יֹאמַר לִבְצֹעַ בֶּצַע שׂוּמָה עָלֵינוּ מִכָּל־מָקוֹם גַּם מִ[מָּקוֹם] רָע׃",
        "sourcePages": [
          176
        ],
        "textSHA256": "276ef88a3467c8fbcf6b5eda12536d2cf5e0a3780d34012bff7cbe2241d0f7f7"
      },
      {
        "verse": 13,
        "text": "אִישׁ אֲשֶׁר כָּזֶה יָדַע יוֹתֵר מִכָּל־הָאֲנָשִׁים כִּי פוֹשֵׁעַ הוּא בַּעֲשׂוֹתוֹ מֵחֹמֶר עָפָר כֵּלִים וּפְסִילִים נוֹחִים לְהִשָּׁבֵר׃",
        "sourcePages": [
          176
        ],
        "textSHA256": "9c020f86236079c33863a61732bf2d1a46db49099acb0d6fbb1ac3709c4ab591"
      },
      {
        "verse": 14,
        "text": "וְכֻלָּם נִבְעָרִים מִדַּעַת וְנִקְלִים מִנֶּפֶשׁ עוֹלֵל וְהֵם אוֹיְבֵי עַמְּךָ וּבוֹ יִרְדּוּ׃",
        "sourcePages": [
          176
        ],
        "textSHA256": "9ee17766876bd4c02868bb7cd258c8655ac5599f03760196247289e5c9a70fee"
      },
      {
        "verse": 15,
        "text": "כִּי כָּל־אֱלִילֵי הַגּוֹיִם לֵאלֹהִים יֵחָשֵׁבוּ אֲשֶׁר אֵין לָהֶם עֵינַיִם לִרְאוֹת וְאַף לִשְׁאֹף־רֵיחַ וְאָזְנַיִם לִשְׁמֹעַ וְאֶצְבְּעוֹת יָדַיִם לְמַשֵּׁשׁ וּלְרַגְלֵיהֶם אֵין כֹּחַ לָלֶכֶת׃",
        "sourcePages": [
          176
        ],
        "textSHA256": "4b239e211eb47f308e160b62a17c0f34658cf9da886819c70a3fef64d1a29552"
      },
      {
        "verse": 16,
        "text": "הֲלֹא אָדָם עֲשָׂם וַאֲשֶׁר רוּחַ הָפְקַד אִתּוֹ יְצָרָם וְאֵין בְּכֹחַ אִישׁ לַעֲשׂוֹת אֱלֹהִים אֲשֶׁר יִדְמֶה אֵלָיו׃",
        "sourcePages": [
          176
        ],
        "textSHA256": "4d9a35f04340a04ad9304f655a62eb2fd0f2026e292cac438464fb67709b65fe"
      },
      {
        "verse": 17,
        "text": "בִּהְיוֹתוֹ בֶּן־תְּמוּתָה יַעֲשֶׂה [אֱלִיל] מֵת בְּכֹחַ רֶשַׁע הֲלֹא טוֹב הוּא מֵאֲשֶׁר יַעֲרִיץ כִּי הוּא חַי וְהֵמָּה לֹא [יִחְיוּ] לָעַד׃",
        "sourcePages": [
          176
        ],
        "textSHA256": "022fd302bf86708f4c790e100093f4add0bd8fb0faab5fe4b9e496d8187bf7b3"
      },
      {
        "verse": 18,
        "text": "גַּם־יִשְׁתַּחֲווּ לַחַיּוֹת הַנְּבָזוֹת מִכֻּלָּן וְאֵין בֵּין כָּל־הָאֲחֵרוֹת מָשְׁלָן לְבַעֲרוּת׃",
        "sourcePages": [
          176
        ],
        "textSHA256": "b0cc343c71f13222edabbfc79a70f3a5ac53dfceb9f3d42b59212b06e31e0e5d"
      },
      {
        "verse": 19,
        "text": "גַּם חֲסֵרוֹת יֹפִי הֵן וְאֵין בָּהֶן חֵפֶץ כַּאֲשֶׁר בְּמַרְאֵה הַחַיּוֹת אָכֵן רָחֲקוּ מִתְּהִלַּת יְיָ וּמִבִּרְכָתוֹ׃",
        "sourcePages": [
          176
        ],
        "textSHA256": "baaadb74f4489e7f8d57fac14565f6810b1be8b669201add47dfd71d783e5952"
      }
    ]
