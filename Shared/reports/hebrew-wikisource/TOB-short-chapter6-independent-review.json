    "chapter": {
      "number": 6,
      "lastVerse": 19,
      "verses": [
        {
          "verse": 1,
          "text": "וַיֵּלְכוּ לְדַרְכָּם וַיָּבֹאוּ לְעֵת עֶרֶב אֶל־נְהַר חִדֶּקֶל וַיָּלִינוּ שָׁם׃",
          "sourcePages": [
            326
          ],
          "textSHA256": "2ecf742a6bbaeb729e7e018060649beb9c919172dc43693b7a38bab174b48513"
        },
        {
          "verse": 2,
          "text": "וַיֵּרֶד הַנַּעַר לִרְחֹץ וַיֵּצֵא דָג מִן־הַנָּהָר וַיְבַקֵּשׁ לִבְלוֹעַ אֶת־הַנַּעַר׃",
          "sourcePages": [
            326
          ],
          "textSHA256": "a54844c4114ac712f15bfd95f95efe2fe50a8a4fac85eb9955dd0f6827c11787"
        },
        {
          "verse": 3,
          "text": "וַיֹּאמֶר לוֹ הַמַּלְאָךְ תְּפוֹשׂ אֶת־הַדָּג וַיַּחֲזֵק הַנַּעַר בַּדָּג וַיַּשְׁלֵךְ אוֹתוֹ עַל־הַיַּבָּשָׁה׃",
          "sourcePages": [
            326
          ],
          "textSHA256": "560e4d492091b3e645962cc47e544f2efdde5b7ef3a31fe1e6837775eb9d2023"
        },
        {
          "verse": 4,
          "text": "וַיֹּאמֶר לוֹ הַמַּלְאָךְ נַתַּח אֶת־הַדָּג וְלָקַחְתָּ אֶת־הַלֵּב וְאֶת־הַכָּבֵד וְאֶת־הַמְּרֵרָה וְשִׂים אוֹתָם לְמִשְׁמֶרֶת׃",
          "sourcePages": [
            326,
            327
          ],
          "textSHA256": "eac8fbf8b760074665c607fa631a0c6b9e12bab8c86403b1bd9684d2a290b18e"
        },
        {
          "verse": 5,
          "text": "וַיַּעַשׂ הַנַּעַר כַּאֲשֶׁר אָמַר לוֹ הַמַּלְאָךְ וַיִּצְלוּ אֶת־הַדָּג וַיֹּאכְלֵהוּ׃",
          "sourcePages": [
            327
          ],
          "textSHA256": "52f5c033de0d5108dff5fc545ddace96cedc780dfb32d1574d33a4a92bc1800f"
        },
        {
          "verse": 6,
          "text": "וַיֵּלְכוּ שְׁנֵיהֶם בַּדֶּרֶךְ עַד־אֲשֶׁר קָרְבוּ אֶל־אַחְמְתָא׃",
          "sourcePages": [
            327
          ],
          "textSHA256": "ec1a029e50acacbad1effaf9bfd764767598e6676a016b7877e28daea2958528"
        },
        {
          "verse": 7,
          "text": "וַיֹּאמֶר הַנַּעַר אֶל־הַמַּלְאָךְ עֲזַרְיָה אָחִי מַה־[דְּבַר] הַכָּבֵד וְהַלֵּב וְהַמְּרֵרָה שֶׁל־הַדָּג׃",
          "sourcePages": [
            327
          ],
          "textSHA256": "1e0d318bdd07edb65f4db5287cc65ea3462b3d17bf9906e076371f8f1f1167a7"
        },
        {
          "verse": 8,
          "text": "וַיֹּאמֶר לוֹ הַלֵּב וְהַכָּבֵד כִּי יִפְגַּע שֵׁד אוֹ רוּחַ רַע בָּאָדָם יְקַטְּרוּם לִפְנֵי הָאִישׁ אוֹ הָאִשָּׁה וְלֹא־עוֹד יִפָּגעוּ׃",
          "sourcePages": [
            327
          ],
          "textSHA256": "4132c6e7bb4030b2cfd19ed7d7454bfe8e2cccfa9c12ab0e0d8f0c29fda1e87c",
          "sourceNotes": [
            {
              "id": "tob-6-8-gimel-vowel",
              "kind": "unreadablePoint",
              "anchor": "יִפָּגעוּ",
              "occurrence": 1,
              "letterIndex": 3,
              "mark": "vowel",
              "sourcePages": [
                327
              ],
              "sourceURL": "https://he.wikisource.org/wiki/קובץ:Apocrypha_Kahana_B.pdf#page=327"
            }
          ]
        },
        {
          "verse": 9,
          "text": "וְהַמְּרֵרָה יִמְרְחוּ עַל־אִישׁ אֲשֶׁר־לוֹ תְּבַלּוּלִים בְּעֵינָיו וְנִרְפָּא׃",
          "sourcePages": [
            327
          ],
          "textSHA256": "6a4e4a98831b68f51071ed373209c25bd58edb58d5928d533e62c527ff3b66f3"
        },
        {
          "verse": 10,
          "text": "וַיְהִי כַּאֲשֶׁר קָרְבוּ לָבֹא אֶל־רָגָא׃ וַיֹּאמֶר הַמַּלְאָךְ אֶל־הַנַּעַר אָחִי הַיּוֹם נָלִין אֵצֶל רְעוּאֵל וְהוּא קְרוֹבְךָ וְלוֹ בַת יְחִידָה וּשְׁמָהּ שָׂרָה׃",
          "sourcePages": [
            327
          ],
          "textSHA256": "56634422949da49f35e86be932cd73fee84c3438d20b5decd0b450912e60589a",
          "endVerse": 11
        },
        {
          "verse": 12,
          "text": "וַאֲנִי אֲדַבֵּר־בָּהּ כִּי תִנָּתֶן־לְךָ לְאִשָּׁה כִּי לְךָ מִשְׁפַּט יְרֻשָּׁתָהּ וְאַתָּה הַיָּחִיד מִמִּשְׁפַּחְתָּהּ וְהַנַּעֲרָה יָפָה וְטוֹבַת שֵׂכֶל׃",
          "sourcePages": [
            327,
            328
          ],
          "textSHA256": "d2c1fa75c9d57293d76b7deb90aa52c12724165e3e1270e347af3a500418288d"
        },
        {
          "verse": 13,
          "text": "וְעַתָּה שְׁמַע־לִי וְאָנֹכִי אֲדַבֵּר אֶל־אָבִיהָ וְכִי נָשׁוּב מֵרָגָא נַעֲרֹךְ אֶת־הַחֲתֻנָּה כִּי יוֹדֵעַ אָנֹכִי בִרְעוּאֵל כִּי לְפִי תּוֹרַת מֹשֶׁה לֹא יִתֵּן אוֹתָהּ לְאִישׁ אַחֵר כִּי חֵטְא מָוֶת הוּא כִּי לְךָ מִשְׁפַּט הַיְּרוּשָׁה מִכָּל־בְּנֵי אָדָם׃",
          "sourcePages": [
            328
          ],
          "textSHA256": "f11cd6b81a030379b513d97aa6ae5db3c758e45975eb15a8e4202e31ead336db"
        },
        {
          "verse": 14,
          "text": "וַיֹּאמֶר הַנַּעַר אֶל־הַמַּלְאָךְ עֲזַרְיָה אָחִי שָׁמַעְתִּי כִּי נִתְּנָה הַנַּעֲרָה לְשִׁבְעָה וְכֻלָּם מֵתוּ בַּחֲדַר הַחֻפָּה׃",
          "sourcePages": [
            328
          ],
          "textSHA256": "0c21b5a518e696776bf3f853c98aaf568e07159e315f13871bb18166c6828d0a"
        },
        {
          "verse": 15,
          "text": "וַאֲנִי יָחִיד לְאָבִי וְיָרֵאתִי פֶּן־אָבֹא וְאָמוּת כָּרִאשׁוֹנִים כִּי שֵׁד אוֹהֵב אוֹתָהּ אֲשֶׁר לֹא יָרַע לָאִשָּׁה כִּי אִם־לְכָל־הַקָּרֵב אֵלֶיהָ וְעַתָּה יָרֵאתִי פֶּן־אָמוּת וְהוֹרַדְתִּי אֶת־חַיֵּי אָבִי וְאִמִּי בִּיגוֹנָם עֲלֵי אֶל־קִבְרָם וּבֵן אַחֵר אֵין לָהֶם אֲשֶׁר יִקְבֹּר אוֹתָם׃",
          "sourcePages": [
            328
          ],
          "textSHA256": "c06624ec0c74e6327afa534e4499165755923abb6f94d19848f7c5c0642ae9d8"
        },
        {
          "verse": 16,
          "text": "וַיֹּאמֶר לוֹ הַמַּלְאָךְ הֲלֹא תִזְכֹּר אֶת־הַדְּבָרִים אֲשֶׁר צִוְּךָ אָבִיךָ לָקַחַת אִשָּׁה מִמִּשְׁפַּחְתְּךָ וְעַתָּה שְׁמַע־לִי אָחִי כִּי לְךָ תִּהְיֶה לְאִשָּׁה אַל־תַּשֵּׂת אֶל־דְּאָגָה כִּי בַּלַּיְלָה הַזֶּה תִּנָּתֵן הִיא לְךָ לְאִשָּׁה׃",
          "sourcePages": [
            328,
            329
          ],
          "textSHA256": "6c2f180ad8de35482d02521c10533395cefdd6036d9b640f973bf25fff4be78a"
        },
        {
          "verse": 17,
          "text": "וְכִי תָבֹא אֶל־חֲדַר הַחֻפָּה וְלָקַחְתָּ גַּחֶלֶת קְטֹרֶת וְשַׂמְתָּ עָלֶיהָ מִלֵּב הַדָּג וּמִכְּבֵדוֹ וְהַעֲלִיתָ אֶת־עֲשָׁנָם וְהֵרִיחַ בּוֹ הַשֵּׁד וּבָרַח וְלֹא יוֹסִיף עוֹד לָבֹא עַד־עוֹלָם׃",
          "sourcePages": [
            329
          ],
          "textSHA256": "4a24b0268fa701cb80b9714a465f96d3d65a8b175341500fa73d268c17e75638"
        },
        {
          "verse": 18,
          "text": "וְכִי תָבֹא אֵלֶיהָ הִתְעוֹרְרוּ שְׁנֵיכֶם וְקִרְאוּ אֶל־אֵל רַחוּם וְיַצִּיל אֶתְכֶם וִירַחֶמְכֶם אַל־תִּירָא כִּי־לְךָ הִיא יְעוּדָה מֵעוֹלָם וְאַתָּה תַּצִּיל אוֹתָהּ וְהִיא תֵלֵךְ עִמָּךְ וַאֲקַוֶּה כִּי יִהְיוּ לְךָ מִמֶּנָּה בָּנִים׃",
          "sourcePages": [
            329
          ],
          "textSHA256": "59da3c1b7083af14dddfff9dd705a6269793e32fcfd54f8e7940d3f187892800"
        },
        {
          "verse": 19,
          "text": "וְכַאֲשֶׁר שָׁמַע טוֹבִיָּה אֶת־הַדְּבָרִים הָאֵלֶּה וַיֶּאֱהָבֶהָ וְנַפְשׁוֹ נִקְשְׁרָה־בָהּ מְאֹד׃",
          "sourcePages": [
            329
          ],
          "textSHA256": "e8fd4988e5ea04edf5f781b9953631ea13ecbad2b8dfc8722e5630d5ea904702"
        }
      ]
