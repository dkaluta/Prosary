  "draft": {
    "number": 9,
    "verses": [
      {
        "verse": 1,
        "text": "אֱלֹהֵי אֲבוֹתֵינוּ וַאֲדוֹן הָרַחֲמִים אֲשֶׁר עָשִׂיתָ הַכֹּל בִּדְבָרֶךָ׃",
        "sourcePages": [
          162
        ],
        "textSHA256": "d7809bd1fc16009f76b01513fdd0020db8bfb8c13f954347c2fdffa71b906be6"
      },
      {
        "verse": 2,
        "text": "וּבְחָכְמָתְךָ כּוֹנַנְתָּ אֱנוֹשׁ לִמְשֹׁל בִּיצוּרִים אֲשֶׁר בָּרָאתָ׃",
        "sourcePages": [
          162
        ],
        "textSHA256": "ab727ac1553d962476a38aafd1e43f74287c5a4e2082c82dd3f3ad177c7d0dce"
      },
      {
        "verse": 3,
        "text": "לְכַלְכֵּל תֵּבֵל בִּקְדֻשָּׁה וּבְצֶדֶק וּלְהוֹצִיא מִשְׁפָּט בְּיִשְׁרַת נֶפֶשׁ׃",
        "sourcePages": [
          162
        ],
        "textSHA256": "27fed990793f9da0b6db4bdd99369223dc2640bc83a58158bc65c1f869eec209"
      },
      {
        "verse": 4,
        "text": "תֶּן־לִי חָכְמָה הַיּוֹשֶׁבֶת עַל־יַד כִּסְאֶךָ וְאַל־תְּגָרְשֵׁנִי מִקֶּרֶב בָּנֶיךָ׃",
        "sourcePages": [
          162
        ],
        "textSHA256": "b2c495687ad952042b22a23396fef4d46c4526f08dd7728daa37aff5e6fc3153"
      },
      {
        "verse": 5,
        "text": "כִּי אֲנִי עַבְדְּךָ וּבֶן־אֲמָתֶךָ אִישׁ חֲדַל אוֹנִים וּקְצַר יָמִים וְזָעִיר מִדַּעַת מִשְׁפָּט וְחֻקִּים׃",
        "sourcePages": [
          162
        ],
        "textSHA256": "9c6f74de1d6896a4764cdefeb2bc2892da9f340f65164781f56f6bbfa01ac402"
      },
      {
        "verse": 6,
        "text": "הֵן אִם־יִמָּצֵא אִישׁ תָּמִים בֵּין בְּנֵי־אָדָם לְאֶפֶס יֵחָשֵׁב בְּהֵעָדֵר מִמֶּנּוּ חָכְמָתֶךָ׃",
        "sourcePages": [
          162
        ],
        "textSHA256": "eb822c456fd75f2ec8f167537121fd38b94a0ceb7f02841f7cfb79ee10d2e93e"
      },
      {
        "verse": 7,
        "text": "אַתָּה בְּחַרְתַּנִי לְמֶלֶךְ עַל־עַמֶּךָ וְלִשְׁפֹּט בָּנֶיךָ וּבְנוֹתֶיךָ׃",
        "sourcePages": [
          162
        ],
        "textSHA256": "577e37bc60286c4931406370a5422c653ab753cb8e95ebe482688129130349c9"
      },
      {
        "verse": 8,
        "text": "וַתִּפְקֹד לִבְנוֹת מִקְדָּשׁ בְּהַר־קָדְשֶׁךָ וּמִזְבֵּחַ בְּעִיר שִׁבְתֶּךָ תַּבְנִית מִשְׁכַּן קָדְשֶׁךָ אֲשֶׁר מֵרֹאשׁ הֲכִינוֹתָ׃",
        "sourcePages": [
          162
        ],
        "textSHA256": "a6737d3c43c3c90734f0ea403f73f8cd84270b1fa9f084fc74e7e6b7463e3d96"
      },
      {
        "verse": 9,
        "text": "וְעִמְּךָ הַחָכְמָה הַיּוֹדַעַת מַעֲשֶׂיךָ כִּי [עִמְּךָ] הָיְתָה בְּבָרְאָךְ אֶת־הָעוֹלָם וַתֵּדַע אֶת־הַיָּשָׁר בְּעֵינֶיךָ וְאֶת־הַטּוֹב לְפִי מִצְוֹתֶיךָ׃",
        "sourcePages": [
          162
        ],
        "textSHA256": "8f3f66bd043a75061d542ed833e8828c8f073e1af9bc3ff782e25c2ea55d6da8"
      },
      {
        "verse": 10,
        "text": "שְׁלַח אוֹתָהּ מִשְּׁמֵי קָדְשֶׁךָ וּמִפְּנֵי כִּסֵּא כְבוֹדֶךָ תִּפְקְדֶנָּה לְמַעַן תִּשְׁכֹּן עִמִּי בַּעֲמָלִי וְאֵדַע אֶת־הַיָּשָׁר לְפָנֶיךָ׃",
        "sourcePages": [
          163
        ],
        "textSHA256": "a9c8fd92827319bcb83b3f109174d1320b3ed28fcce4509cb63d6a1fafe35e70"
      },
      {
        "verse": 11,
        "text": "כִּי־הִיא יוֹדַעַת וּמְבִינָה הַכֹּל וְתַנְחֵנִי בְּכָל־מִפְעֲלוֹתַי בְּהַשְׂכֵּל וְתִנְצְרֵנִי בִּכְבוֹדָהּ׃",
        "sourcePages": [
          163
        ],
        "textSHA256": "29dfb373f55a3f5e97489d1dcad2209cd9e94bad6f4a8b646d367ff5b3eb61ff"
      },
      {
        "verse": 12,
        "text": "וּמַעֲשַׂי יִהְיוּ לְרָצוֹן וְאֶשְׁפֹּט בְּצֶדֶק אֶת־עַמֶּךָ וְאִיקַר לָשֶׁבֶת עַל־כִּסֵּא אָבִי׃",
        "sourcePages": [
          163
        ],
        "textSHA256": "bb787e302e142d1d1f4a82abdb4faf555e154af8c8e85289e67e2b00fbda06ba"
      },
      {
        "verse": 13,
        "text": "כִּי מִי הָאִישׁ אֲשֶׁר־יֵדַע עֲצַת אֱלֹהִים וּמִי יָבִין חֵפֶץ יְיָ׃",
        "sourcePages": [
          163
        ],
        "textSHA256": "5768f18d9684792b11b518aa38a4d5af2a0bf9847ca1505ee774a33ff3250ec3"
      },
      {
        "verse": 14,
        "text": "הֲלֹא מַחְשְׁבוֹת בְּנֵי־תְמוּתָה אָפֶס וּמְזִמּוֹתֵינוּ תֹּהוּ׃",
        "sourcePages": [
          163
        ],
        "textSHA256": "b45a0334b111f1d684c84f942c79cdfa215c79d33442a9d5522e3ade37d5a3c5"
      },
      {
        "verse": 15,
        "text": "כִּי גוּף בֶּן־חֲלוֹף יִכְבַּד עַל־הַנֶּפֶשׁ וּמִשְׁכַּן חֹמֶר יְדַכֵּא שֵׂכֶל רַב־עֶשְׁתּוֹנוֹת׃",
        "sourcePages": [
          163
        ],
        "textSHA256": "c4cba18a29602b4c3432dcad9a5c8b401fda28373f8580cbce914ba1df8ce9df"
      },
      {
        "verse": 16,
        "text": "הֵן בִּלְבַד נַשִּׂיג אֲשֶׁר בָּאָרֶץ וּבְעָמָל נִמְצָא אֲשֶׁר בְּכַפֵּנוּ אוּלָם אֲשֶׁר בַּשָּׁמַיִם מִי יַחְקֹר׃",
        "sourcePages": [
          163
        ],
        "textSHA256": "464eeac4153d502aedd490dfeff60a15b0fab48eaec34d781d0c20d1bad09745"
      },
      {
        "verse": 17,
        "text": "וּמִי הֵבִין עֲצָתְךָ בְּמָנְעֲךָ חָכְמָה וְאֶת־רוּחַ קָדְשֶׁךָ לֹא תִשְׁלַח מִמְּרוֹמִים׃",
        "sourcePages": [
          163
        ],
        "textSHA256": "239f929d6c98f86cdff19b14e235c7dfd98337f87c93cfd304be99828c199164"
      },
      {
        "verse": 18,
        "text": "אַךְ אָז יִפָּנוּ אָרְחוֹת [הָאֲנָשִׁים] עֲלֵי־אֲדָמוֹת וְיִלְמְדוּ בְּנֵי־אָדָם אֶת־הַיָּשָׁר לְפָנֶיךָ׃",
        "sourcePages": [
          163
        ],
        "textSHA256": "c0eb81c3c51c3a46a511f9f5152b28f1422d3cebb73bf13f7b5b68b2e70f28be"
      },
      {
        "verse": 19,
        "text": "וּבְחָכְמָה יִוָּשֵׁעוּ׃",
        "sourcePages": [
          163
        ],
        "textSHA256": "59a6126baec25008b47634d01e29612c59856ca3c6bf32c17d2cc7d8903513a8"
      }
    ]
  },
