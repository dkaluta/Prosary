  "onlineScaffoldBefore": [
    {
      "verse": 19,
      "text": "וישלח את הילדים ואת מאת כיכר וישקור ולא שילח את יונתן:",
      "sourcePages": [],
      "textSHA256": "e09851494277e52f4693b959f2b0846622ee5e48271c35cc96013eea0d210c61"
    },
    {
      "verse": 20,
      "text": "ואחרי כן בא טריפון לנחול בארץ ולהשמידה ויסב את הדרך לאדוריים ושמעון ומחנהו על ידו הלכו בכל אשר הלך:",
      "sourcePages": [],
      "textSHA256": "53771de8165bf92df846e255316ff403f1a62b14a5b4caf5a21eba535a6173b8"
    },
    {
      "verse": 21,
      "text": "והאנשים מן המצודה שלחו אל טריפון מלאכים ויאיצו בו לבוא אליהם דרך המדבר ולשלוח להם אוכל:",
      "sourcePages": [],
      "textSHA256": "40312738385abb685662eeb180f03b0ec691b5200b4a0d97f729b994c4deb9cd"
    },
    {
      "verse": 22,
      "text": "ויכן טריפון את כל פרשיו ללכת ובלילה ההוא היה שלג גדול מאוד ולא הלך מפני השלג ויסע ויבוא לגלעד:",
      "sourcePages": [],
      "textSHA256": "d13fde6b4809a2950c768c1fc3bebc2b05bb81f6593a7458f69fce72118edd11"
    },
    {
      "verse": 23,
      "text": "וכאשר קרב לבית שקמה המית את יונתן וייקבר שם:",
      "sourcePages": [],
      "textSHA256": "d3b167e4628ef0f14c90de60c8ec751438982258a407a44e1554737fcb43b37f"
    },
    {
      "verse": 24,
      "text": "וישב טריפון וילך לארצו:",
      "sourcePages": [],
      "textSHA256": "ba27e8bb957afcb04c23ed20a972e4b01b23ba1f4a2e930c22e396e55c531996"
    },
    {
      "verse": 25,
      "text": "וישלח שמעון ויקח את עצמות יונתן אחיו ויקברוהו במודיעים עיר אבותיו:",
      "sourcePages": [],
      "textSHA256": "b1b6c2ce4cc5f2c5cda18ba5837d48564f982e1f9578c9eb70a6ec8f199c664b"
    },
    {
      "verse": 26,
      "text": "ויספדו לו כל ישראל מספד גדול ויבכו אותו ימים רבים:",
      "sourcePages": [],
      "textSHA256": "8ccc372eb658aeaefc355b218a382e13b1b872b8e7ef6fff158dc3cecd578283"
    },
    {
      "verse": 27,
      "text": "ויבן שמעון על קבר אביו ואחיו יגביהו למראה באבן גזית מפנים ומאחור:",
      "sourcePages": [],
      "textSHA256": "d8c905c386e05750b0e775a96d37abdccdc6b263bfdac482dba509c91f8cc7b2"
    },
    {
      "verse": 28,
      "text": "ויעמד שבע פירמות אשה לעומת אחותה לאב ולאם ולארבעת האחים:",
      "sourcePages": [],
      "textSHA256": "b680ddb9cef6343a3276b89ea9de1bcffcb0ab500b539bd817d30a2b179f64cd"
    }
  ],
