            167
          ],
          "sourceURL": "https://upload.wikimedia.org/wikisource/he/2/25/Apocrypha_Kahana_B.pdf#page=167"
        }
      ]
    },
    {
      "chapter": 13,
      "verse": 52,
      "text": "וַיָּקֶם לַעֲשׂוֹת שָׁנָה שָׁנָה אֶת־הַיּוֹם הַהוּא בְּשִׂמְחָה׃",
      "sourcePages": [
        167
      ],
      "textSHA256": "c78d838425970a84b598fc2990d21a9bc9d20bd81a61f0bb3298173ed7af09b1"
    },
    {
      "chapter": 13,
      "verse": 53,
      "text": "וַיְבַצֵּר הַר־הַמִּקְדָּשׁ אֲשֶׁר עַל־יַד־הַמְּצוּדָה וַיֵּשֶׁב שָׁם הוּא וַאֲשֶׁר אִתּוֹ׃",
      "sourcePages": [
        167,
        168
      ],
      "textSHA256": "2ca5495eb82f6d46fbb7940fab01672d7c9adc7c9db3e4fbd5f12d83a211cce7"
    }
  ],
