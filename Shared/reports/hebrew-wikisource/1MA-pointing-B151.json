  "onlineScaffoldBefore": [
    {
      "verse": 66,
      "text": "וישב יונתן ירושלים בשלום ובשמחה:",
      "sourcePages": [],
      "textSHA256": "67de2c8f95a86fc7bcaa7d04f3f55dc9dbee89a8b4fa68df27375c30d3ee8acf"
    },
    {
      "verse": 67,
      "text": "ובשנת חמש וששים ומאה בא דמיטריוס בן דמיטריוס מכרתים לארץ אבותיו:",
      "sourcePages": [],
      "textSHA256": "bd816497c5e3b97b50ff6bba31a84343d05c92f740a8f50341083bb9522eedcc"
    },
    {
      "verse": 68,
      "text": "וישמע אלכסנדר המלך ויתעצב מאוד וישב לאנטיוכיה:",
      "sourcePages": [],
      "textSHA256": "11a4b5eb22d511725b715d618bea3c2327777f3ac0bc4a9e35e1f2d58dc13ada"
    },
    {
      "verse": 69,
      "text": "ויעמד דמיטריוס את אפולוניוס אשר היה על שדה ארם ויאסוף חיל רב ויחן על יבנה וישלח אל יונתן הכהן הגדול לאמור:",
      "sourcePages": [],
      "textSHA256": "6e451013cbf3821f23093f9308c91837215cab0f2fbbfda3d96691ef6d2ceb4e"
    },
    {
      "verse": 70,
      "text": "אתה לבדך התקוממת נגדנו ואני הייתי ללעג ולקלס בגללך ולה תראה תקפך נגדנו על ההרים:",
      "sourcePages": [],
      "textSHA256": "9593786939eb924604f72ca2a2e4853cb7fc3d76bc4d7541c7254fafd1417b00"
    },
    {
      "verse": 71,
      "text": "ועתה אם תבטח בחילך רד אלינו אל העמק ונשפטה שם כי אתו חיל הערים:",
      "sourcePages": [],
      "textSHA256": "42bfaaf06f35fe42c63d279a9b319fa68b95571c147d49cd6a9ef2d1fa0021fa"
    },
    {
      "verse": 72,
      "text": "שאל ולמד מי אני והנשארים העוזרים לנו ואמרו אין לכם מעמד רגל בפנינו כי פעמיים נגפו אבותיך בארצם:",
      "sourcePages": [],
      "textSHA256": "b1c2c2a46bea1f1e9449010c927dcd1e78a2cee3b1ebded24529171912912a44"
    },
    {
      "verse": 73,
      "text": "ועתה לא תוכל לעמוד כנגד סוס וחיל זה בעמק אשר אין שם אבן ולא צור ולא מקום לנוס:",
      "sourcePages": [],
      "textSHA256": "5d586bb0c1c19f938720dbb245c0fbd1a62e712ac63ef8921b5366cadd17c5fd"
    }
  ],
  "firstPointedDraftRows": [
    {
      "row": 1,
      "text": "וַיָּשָׁב יוֹנָתָן יְרוּשָׁלִַם בְּשָׁלוֹם וּבְשִׂמְחָה׃ וּבִשְׁנַת חָמֵשׁ וְשִׁשִּׁים וּמֵאָה"
    },
    {
      "row": 2,
      "text": "בָּא דְמֵטְרִיוֹס בֶּן־דְּמֵטְרִיוֹס מִכְּרֵתִים לְאֶרֶץ אֲבוֹתָיו׃ וַיִּשְׁמַע אֶלֶכְסַנְדַּר"
    },
    {
      "row": 3,
      "text": "הַמֶּלֶךְ וַיִּתְעַצֵּב מְאֹד וַיָּשָׁב לְאַנְטִיוֹכִיָּה׃ וַיַּעֲמֵד דְמֵטְרִיוֹס אֶת־"
    },
    {
      "row": 4,
      "text": "אַפּוֹלוֹנִיוֹס אֲשֶׁר הָיָה עַל־שָׂדֵה־אֲרָם וַיֶּאֱסֹף חַיִל רָב וַיִּחַן עַל־יַבְנֶה"
    },
    {
      "row": 5,
      "text": "וַיִּשְׁלַח אֶל־יוֹנָתָן הַכֹּהֵן הַגָּדוֹל לֵאמֹר׃"
    },
    {
      "row": 6,
      "text": "אַתָּה לְבַדְּךָ הִתְקוֹמַמְתָּ נֶגְדֵּנוּ וַאֲנִי הָיִיתִי לְלַעַג וּלְקֶלֶס בִּגְלָלֶךָ"
    },
    {
      "row": 7,
      "text": "וְלָמָּה תִרְאֶה תָקְפְּךָ נֶגְדֵּנוּ עַל־הֶהָרִים׃ וְעַתָּה אִם־תִּבְטַח בְּחֵילְךָ רֵד"
    },
    {
      "row": 8,
      "text": "אֵלֵינוּ אֶל־הָעֵמֶק וְנִשָּׁפְטָה שָׁם כִּי־אִתִּי חֵיל־הֶעָרִים׃ שְׁאַל וּלְמַד"
    },
    {
      "row": 9,
      "text": "מִי אֲנִי וְהַנִּשְׁאָרִים הָעוֹזְרִים לָנוּ וְאָמְרוּ אֵין־לָכֶם מַעֲמַד רֶגֶל בְּפָנֵינוּ"
    },
    {
      "row": 10,
      "text": "כִּי־פְעָמִים נֻגְּפוּ אֲבוֹתֶיךָ בְּאַרְצָם׃ וְעַתָּה לֹא תוּכַל לַעֲמֹד כְּנֶגֶד סוּס"
    },
    {
      "row": 11,
      "text": "וְחַיִל זֶה בָּעֵמֶק אֲשֶׁר אֵין־שָׁם אֶבֶן וְלֹא־צוּר וְלֹא מָקוֹם לָנוּס׃"
    }
  ],
