  "firstDraftUnits": [
    {
      "chapter": 9,
      "verse": 21,
      "text": "אֵיךְ־נָפַל רַב מוֹשִׁיעַ יִשְׂרָאֵל׃ וְיֶתֶר דִּבְרֵי יְהוּדָה וְהַמִּלְחָמוֹת וְהַגְּבוּרוֹת אֲשֶׁר עָשָׂה וּגְדֻלָּתוֹ לֹא־נִכְתְּבוּ כִּי־רַבִּים הָיוּ מְאֹד׃",
      "sourcePages": [
        142
      ],
      "textSHA256": "860b511c018baf1835f65f713163c170a72c04bb1fd04088447993a09b813c04",
      "endVerse": 22
    },
    {
      "chapter": 9,
      "verse": 23,
      "text": "וַיְהִי אַחֲרֵי מוֹת־יְהוּדָה וַיָּצִיצוּ פּוֹעֲלֵי אָוֶן בְּכָל־גְּבוּל יִשְׂרָאֵל וַיִּצְמְחוּ כָּל־עוֹשֵׂי רִשְׁעָה׃",
      "sourcePages": [
        142
      ],
      "textSHA256": "91902565ade7bd09d0edbb07283da5e4f58aa251e9d2a71e75c5387002d69f6f"
    },
    {
      "chapter": 9,
      "verse": 24,
      "text": "בַּיָּמִים הָהֵם הָיָה רָעָב גָּדוֹל מְאֹד וַתִּשְׁלַם הָאָרֶץ אִתָּם׃",
      "sourcePages": [
        142
      ],
      "textSHA256": "d2aa0c72d6145c69da0c580e7e22fecf5b1de2fa86283b8b3a35c755e42e632e"
    },
    {
      "chapter": 9,
      "verse": 25,
      "text": "וַיִּבְחַר בַּקְחִידֵס אֶת־הָאֲנָשִׁים הָרְשָׁעִים וַיְשִׂימֵם לְמוֹשְׁלֵי הָאָרֶץ׃",
      "sourcePages": [
        142
      ],
      "textSHA256": "8d31f6a2602c97fac4e8cca3bf38a58ecf434957c74b6a16624426eff41c1393"
    },
    {
      "chapter": 9,
      "verse": 26,
      "text": "וַיְבַקְשׁוּ וַיְחַפְּשׂוּ וַיַּשְׁמִידוּ אֶת־אוֹהֲבֵי יְהוּדָה וַיְבִיאוּם אֶל־בַּקְחִידֵס וַיִּנָּקֵם אוֹתָם וַיִּתְעַלְּלוּ בָהֶם׃",
      "sourcePages": [
        142
      ],
      "textSHA256": "d0f9f54b1746713180664820f2765569dd5c5d042a0d792ba225432a6cd6736d"
    },
    {
      "chapter": 9,
      "verse": 27,
      "text": "וַתְּהִי צָרָה גְּדוֹלָה בְּיִשְׂרָאֵל אֲשֶׁר לֹא הָיְתָה כָּמֹהָ לְמִיוֹם לֹא נִרְאָה נָבִיא לָהֶם׃",
      "sourcePages": [
        142
      ],
      "textSHA256": "b97363a4ddaa93a2b86d7b9c5cb0bcc9ec75a86f2446ebb402caf32eb94ac265"
    },
    {
      "chapter": 9,
      "verse": 28,
      "text": "וַיִּוָּעֲדוּ כָּל־אוֹהֲבֵי יְהוּדָה וַיֹּאמְרוּ לְיוֹנָתָן׃",
      "sourcePages": [
        142
      ],
      "textSHA256": "4974e3303922f4b44d0f7736ad386179268eb85e2c10b41c17145ee2a6c1230f"
    },
    {
      "chapter": 9,
      "verse": 29,
      "text": "אַחֲרֵי אֲשֶׁר מֵת יְהוּדָה אָחִיךָ וְאָדָם כָּמֹהוּ אֵין לָצֵאת נֶגֶד הָאוֹיְבִים וּבַקְחִידֵס וְהַצּוֹרְרִים מֵעַמֵּנוּ׃",
      "sourcePages": [
        142
      ],
      "textSHA256": "90f56645a46b51efd55e55ebc247cf4145de715d88f1783ce85233843564df48"
    },
    {
      "chapter": 9,
      "verse": 30,
      "text": "וְעַתָּה בָּחַרְנוּ בְךָ הַיּוֹם לִהְיוֹת לָנוּ לְשַׂר וּלְרֹאשׁ לְהִלָּחֵם מִלְחַמְתֵּנוּ׃",
      "sourcePages": [
        142
      ],
      "textSHA256": "1926f8d67241c306213dc0bee1d5964a9afd03cebb02916018b2200af9f5a98f"
    },
    {
      "chapter": 9,
      "verse": 31,
      "text": "וַיְקַבֵּל יוֹנָתָן בָּעֵת הַהִיא אֶת־הַשְּׂרָרָה וַיָּקָם תַּחַת יְהוּדָה אָחִיו׃",
      "sourcePages": [
        142
      ],
      "textSHA256": "0091c7bbad06ebe0b9f4ceba939b74782d6b8b7e174ef4848cb8c4286f7731cf"
    },
    {
      "chapter": 9,
      "verse": 32,
      "text": "וַיֵּדַע בַּקְחִידֵס וַיְבַקֵּשׁ לַהֲמִיתוֹ׃ וַיֵּדַע יוֹנָתָן וְשִׁמְעוֹן אָחִיו וְכָל אֲשֶׁר אִתּוֹ וַיָּנוּסוּ לְמִדְבַּר תְּקוֹעַ וַיַּחֲנוּ עַל־מֵי בְּאֵר אַסְפָּר׃",
      "sourcePages": [
        142
      ],
      "textSHA256": "01487a4c97d3879b363054b5ad120cc3472c34d4263919ae729c8850b3fa04e9",
      "endVerse": 33
    },
    {
      "chapter": 9,
      "verse": 34,
      "text": "וַיֵּדַע בַּקְחִידֵס בְּיוֹם הַשַּׁבָּת וַיֵּלֶךְ הוּא וְכָל־צְבָאוֹ לְעֵבֶר הַיַּרְדֵּן׃",
      "sourcePages": [
        142
      ],
      "textSHA256": "c2e03c920ff609a823e625b58f821a4f3c2445a0e3d809822e6e9de6d40140e7"
    },
    {
      "chapter": 9,
      "verse": 35,
      "text": "וַיִּשְׁלַח [יוֹנָתָן] אֶת־[יוֹחָנָן] אָחִיו רֹאשׁ הַחַיִל וַיְבַקֵּשׁ מֵאֵת בְּנֵי־נְבָיוֹת אוֹהֲבָיו לְהָנִיחַ אֶצְלָם אֶת־רְכוּשָׁם הָרָב׃",
      "sourcePages": [
        142,
        143
      ],
      "textSHA256": "45a36323e8ec7133ecdeeaa964f287d1da1abcb81329521c96f5ff070ecf43ad"
    }
  ],
