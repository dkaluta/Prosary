  "draft": {
    "number": 12,
    "verses": [
      {
        "verse": 1,
        "text": "כִּי רוּחֲךָ הַקַּיָּם לָעַד בַּכֹּל הוּא׃",
        "sourcePages": [
          168
        ],
        "textSHA256": "fc1455da33c4da5ab39890090ed6168c2bf14b85a0700e599d8de0aac6776968"
      },
      {
        "verse": 2,
        "text": "וְלָכֵן לְמִצְעַר תּוֹכִיחַ אֶת־הַפּוֹשְׁעִים וּבַאֲשֶׁר חָטְאוּ תְּיַסְּרֵם לְהַזְכִּירָם כִּי יָסוּרוּ מֵרִשְׁעָתָם וְיַאֲמִינוּ בְךָ יָי׃",
        "sourcePages": [
          168
        ],
        "textSHA256": "54b660d8a7140bab0cb99a79ee1a67f7b8133247e56d44b4958cc2ed06810f19"
      },
      {
        "verse": 3,
        "text": "וְגַם אֶת־יוֹשְׁבֵי אֶרֶץ קָדְשְׁךָ הַקַּדְמוֹנִים שָׂנֵאתָ׃ כִּי הִתְעִיבוּ בְּמַעֲשֵׂי כְשָׁפִים וַעֲצָרוֹת אָוֶן׃",
        "sourcePages": [
          168
        ],
        "textSHA256": "b6047f0c3f51d732e917495a2d5e64db4c19af8229db9704f149ab46de42a880",
        "endVerse": 4
      },
      {
        "verse": 5,
        "text": "וַיָּמִיתוּ בְּנֵיהֶם בְּאַכְזָרִיּוּת וַיֹּאכְלוּ קְרָבִים [וְיַעַרְכוּ] כֵּרָה מִפִּגְרֵי אָדָם וּמִדָּמוֹ בְּחֶבְרֵי לַהֲקַת נָהוּזִים׃",
        "sourcePages": [
          168
        ],
        "textSHA256": "1a04279752852169b63c9cfeed621dd47da3fd0d41ee154751bb5b6919425eb9"
      },
      {
        "verse": 6,
        "text": "וְאָבוֹת טוֹרְפִים בְּכַפָּם נַפְשׁוֹת [יְלָדִים] אֵין־אֵיל אָמַרְתָּ לְהַשְׁמִיד בִּידֵי אֲבוֹתֵינוּ׃",
        "sourcePages": [
          168,
          169
        ],
        "textSHA256": "1b9d9ef83d274bad07d0663e320aa604890e322038dd8c18724245633c4c68ba"
      },
      {
        "verse": 7,
        "text": "לְמַעַן כִּי הָאָרֶץ אֲשֶׁר הִיא סְגֻלָּה לְךָ מִכָּל־הָאֲרָצוֹת תִּהְיֶה נַחֲלַת צְבִי לִבְנֵי אֱלֹהִים׃",
        "sourcePages": [
          169
        ],
        "textSHA256": "804029641987aeb90f920af784f8bb2a4989cb5916d4a16131a661dac61c2ce8"
      },
      {
        "verse": 8,
        "text": "אָמְנָם גַּם־עֲלֵיהֶם חַסְתָּ כְּעַל־בְּנֵי אָדָם וַתִּשְׁלַח אֶת־הַצִּרְעָה בְּשָׁלְחֲךָ צִים לִפְנֵי הַמַּחֲנֶה לְכַלּוֹתָם מְעַט מְעָט׃",
        "sourcePages": [
          169
        ],
        "textSHA256": "a3d9087bf8fb7623e4e52dcdb48c847e74fdde5fed2626dd0b80e83c20ba2889"
      },
      {
        "verse": 9,
        "text": "וְהֵן לֹא־נִבְצַר מִמְּךָ לָתֵת אֶת־הַפּוֹשְׁעִים בִּידֵי הַצַּדִּיקִים בְּמַעֲרֶכֶת מִלְחָמָה אוֹ לְהַשְׁמִידָם בְּחַיּוֹת טוֹרְפוֹת אוֹ בְּמַאֲמָר נִמְרָץ בְּפַעַם אַחַת׃",
        "sourcePages": [
          169
        ],
        "textSHA256": "c7f066ce20e811054eda8a7d70de909c54366a1faad8ea5c362de49bf15bf697"
      },
      {
        "verse": 10,
        "text": "אַךְ בְּשָׁפְטְךָ [אוֹתָם] מְעַט מְעַט נָתַתָּ מָקוֹם לִתְשׁוּבָה אַף כִּי־לֹא נֶעֱלַם מִמְּךָ אֲשֶׁר זֶרַע מְרֵעִים הֵם וְהָרִשְׁעָה נְטוּעָה בְּלִבָּם וּמַחְשַׁבְתָּם לָעַד לֹא תֵהָפֵךְ׃",
        "sourcePages": [
          169
        ],
        "textSHA256": "d9f4d4654e8abf71c9354611f0865a81b8e2f3e859e93d340c1f6c6070d8c4ae"
      },
      {
        "verse": 11,
        "text": "כִּי אָרוּר זַרְעָם מֵאָז׃ וְלֹא מִיִּרְאָתְךָ מִפְּנֵי אִישׁ נָתַתָּ לָהֶם לַחֲטֹא לְלֹא עֹנֶשׁ׃",
        "sourcePages": [
          169
        ],
        "textSHA256": "e3d32ba3ed367fd8e75be7ea7466c526816a802277b4b014eed67afdbbc2ec8c"
      },
      {
        "verse": 12,
        "text": "כִּי מִי־יֹאמַר מַה־תַּעֲשֶׂה אוֹ מִי יָקוּם נֶגֶד מִשְׁפָּטֶךָ אוֹ מִי יַרְשִׁיעֲךָ בְּהַשְׁמִידְךָ גוֹיִם אֲשֶׁר אַתָּה יְצַרְתָּם אוֹ מִי יַעֲמֹד אִתְּךָ לַמִּשְׁפָּט כְּמֵלִיץ יֹשֶׁר לַאֲנָשִׁים לֹא־יְשָׁרִים׃",
        "sourcePages": [
          169
        ],
        "textSHA256": "89a33f40aa109a470b6428a35485722b1618d1c8f4b0a3c17a4fd7ec854560f1"
      },
      {
        "verse": 13,
        "text": "הֲלֹא אֵין אֱלֹהִים מִבַּלְעָדֶיךָ מַשְׁגִּיחַ עַל־כֹּל אֲשֶׁר לְפָנָיו תּוֹכִיחַ כִּי־לֹא הוֹצֵאתָ מִשְׁפַּט שֶׁקֶר׃",
        "sourcePages": [
          169
        ],
        "textSHA256": "d8cf0a867c10ccc37f88d9fdd8698c5edcedc66be6d59deed8a87c953b350740"
      },
      {
        "verse": 14,
        "text": "וְאֵין מֶלֶךְ וְאֵין מוֹשֵׁל יוּכַל לְהָרִים רֹאשׁ נֶגְדְּךָ בִּדְבַר הָאֲנָשִׁים אֲשֶׁר הִשְׁמַדְתָּ׃",
        "sourcePages": [
          169
        ],
        "textSHA256": "1117f61f3bd4a604e164f72f3d05de8e2414ad859fc4bf455123e40f2278f75f"
      },
      {
        "verse": 15,
        "text": "בִּהְיוֹתְךָ צַדִּיק תְּכַלְכֵּל הַכֹּל בְּצֶדֶק עַל־דַּעְתְּךָ [וְ]חָלִילָה לִגְבוּרָתְךָ מֵהַרְשִׁיעַ אֶת־הַחַף מִפֶּשַׁע׃",
        "sourcePages": [
          169
        ],
        "textSHA256": "e934e01311ccd91736b666d2b302b7f5021d829f03311dfe410de64bda27dac8"
      },
      {
        "verse": 16,
        "text": "הֵן גְּבוּרָתְךָ רֵאשִׁית צִדְקָתְךָ וְיַעַן כִּי תִמְשֹׁל בַּכֹּל תָּחוּס עַל־כֹּל׃",
        "sourcePages": [
          169
        ],
        "textSHA256": "dec4b3b40fa34db3a77ec159948d6e6eff5bbe37d4cb37f0a0b8b51e79c89722"
      },
      {
        "verse": 17,
        "text": "כִּי אֶת־עֻזְּךָ תַרְאֶה לַאֲשֶׁר לֹא־יַאֲמִינוּ בְּעֶצֶם גְּבוּרָתְךָ וּבְקֶרֶב יוֹדְעֶיךָ תּוֹכִיחֵם עַל־גַּאֲוָתָם׃",
        "sourcePages": [
          169
        ],
        "textSHA256": "3e9ab6654a969da19323a5ab7133f8522c0a980ed27eab5ee27f11478eb9922e"
      },
      {
        "verse": 18,
        "text": "וְאַתָּה אַף כִּי־הַכֹּחַ בְּיָדְךָ תִשְׁפֹּט בְּמֵישָׁרִים וּבְרַחֲמִים רַבִּים תַּנְחֵנוּ כִּי [הַכֹּל] בִּיכָלְתְּךָ אִם אַךְ תַּחְפֹּץ׃",
        "sourcePages": [
          169
        ],
        "textSHA256": "75ac24ec2d3a2c54b7699a90e6df5d14713c0a9cb39f5c53f4449c0456e2ab09"
      },
      {
        "verse": 19,
        "text": "וְאֶת־עַמְּךָ הוֹרִיתָ בְּפָעֳלֶיךָ אֵלֶּה כִּי נָאוָה לְצַדִּיק הֱיוֹת אוֹהֵב אֲנָשִׁים וְאֶת־בָּנֶיךָ מִלֵּאתָ תִּקְוֹת טוֹבוֹת אֲשֶׁר תִּתֵּן לָשׁוּב מִפִּשְׁעֵיהֶם׃",
        "sourcePages": [
          169,
          170
        ],
        "textSHA256": "f877030543e4c3e188e6c59a7657433e0ce6fd9aa1195101536e93d1023d77f4"
      },
      {
        "verse": 20,
        "text": "כִּי אִם־שׂוֹנְאֵי בָנֶיךָ אֲשֶׁר לָהֶם מִשְׁפַּט מָוֶת יִסַּרְתָּ בְּחֶסֶד וּבְחֶמְלָה כָזֹאת בְּתִתְּךָ לָהֶם מוֹעֵד וּמָקוֹם לְמַעַן יָשׁוּבוּ בָהֶם מֵרִשְׁעָתָם׃",
        "sourcePages": [
          170
        ],
        "textSHA256": "15107584067d6d67f7cbf6ed9a0685363d5f0267d999fd405763b12bd6ac275f"
      },
      {
        "verse": 21,
