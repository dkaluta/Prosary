  "onlineScaffoldBefore": [
    {
      "verse": 29,
      "text": "ולהן עשה מלאכת מחשבת ויעמד מסביב עמודים גדולים ויעש על העמודים חליצות לשם עולם ועל יד החליצות פיתוחי אניות להראות לכל יורד הים:",
      "sourcePages": [],
      "textSHA256": "87f15f403084211bad4b49e4c08c31705b1571d9d1bf87112cd11410cbe98a7a"
    },
    {
      "verse": 30,
      "text": "זה הקבר אשר עשה במודיעים עד היום הזה:",
      "sourcePages": [],
      "textSHA256": "8da183490a11b0172e3a1c1b8e9df33d6d41ecda8517a86223caaf7af2527f15"
    },
    {
      "verse": 31,
      "text": "וטריפון הלך במרמה עם אנטיוכוס המלך הצעיר וימיתהו:",
      "sourcePages": [],
      "textSHA256": "172c89568221e3adb564dbf0d8b1bad4beb0a02062ad16913ca0a541fc44f364"
    },
    {
      "verse": 32,
      "text": "וימלוך תחתיו וישם על ראשו כתר אסיה ויעש רעה גדולה בארץ:",
      "sourcePages": [],
      "textSHA256": "2eb3d514250c09f8e01451c88108109d11ac088f6e75c57c46a8ed45a2e04c75"
    },
    {
      "verse": 33,
      "text": "וייבן שמעון את מבצרי יהודה ויקיפם במגדלים גבוהים ובחומות גדולות ובשערים ובבריחים וישם אוכל במבצרים:",
      "sourcePages": [],
      "textSHA256": "d5227bb26f318c18417a9e4e6e0c74f7c3f522a2fcbec2310a4d36d87f5686ef"
    },
    {
      "verse": 34,
      "text": "ויבחר שמעון אנשים וישלח אל דמיטריוס המלך לעשות הנחה לארץ כי כל מעשי טריפון היו חמס:",
      "sourcePages": [],
      "textSHA256": "6b2d87b1f981f054d832de32d9bd6ad995431869838c6f89b8dea46546945dfe"
    }
  ],
  "firstPointedDraftRows": [
    {
      "row": 1,
      "text": "וְלָהֶן עָשָׂה מְלֶאכֶת מַחֲשֶׁבֶת וַיַּעֲמֵד מִסָּבִיב עַמּוּדִים גְּדוֹלִים וַיַּעַשׂ עַל־"
    },
    {
      "row": 2,
      "text": "הָעַמּוּדִים חֲלִיצוֹת לְשֵׁם־עוֹלָם וְעַל־יַד־הַחֲלִיצוֹת פִּתּוּחֵי אֳנִיּוֹת לְהֵרָאוֹת"
    },
    {
      "row": 3,
      "text": "לְכָל־יוֹרְדֵי הַיָּם׃ זֶה הַקֶּבֶר אֲשֶׁר עָשָׂה בְּמוֹדִיעִים עַד־הַיּוֹם הַזֶּה׃"
    },
    {
      "row": 4,
      "text": "וּטְרִיפוֹן הָלַךְ בְּמִרְמָה עִם־אַנְטְיוֹכוֹס הַמֶּלֶךְ הַצָּעִיר וַיְמִיתֵהוּ׃"
    },
    {
      "row": 5,
      "text": "וַיִּמְלֹךְ תַּחְתָּיו וַיָּשֶׂם עַל־רֹאשׁוֹ כֶּתֶר אַסְיָה וַיַּעַשׂ רָעָה גְדוֹלָה בָּאָרֶץ׃"
    },
    {
      "row": 6,
      "text": "וַיִּבֶן שִׁמְעוֹן אֶת־מִבְצְרֵי יְהוּדָה וַיַּקֵּפֵם בְּמִגְדָּלִים גְּבוֹהִים וּבְחוֹמוֹת"
    },
    {
      "row": 7,
      "text": "גְּדֹלוֹת וּבִשְׁעָרִים וּבִבְרִיחִים וַיָּשֶׂם אֹכֶל בַּמִּבְצָרִים׃ וַיִּבְחַר שִׁמְעוֹן"
    },
    {
      "row": 8,
      "text": "אֲנָשִׁים וַיִּשְׁלַח אֶל־דְּמֵטְרִיוֹס הַמֶּלֶךְ לַעֲשׂוֹת הֲנָחָה לָאָרֶץ כִּי כָל־"
    }
  ],
