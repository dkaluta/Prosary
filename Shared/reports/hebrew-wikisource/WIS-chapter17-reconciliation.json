            "sourceURL": "https://upload.wikimedia.org/wikisource/he/e/ed/Apocrypha_Kahana_A2.pdf#page=180"
          },
          {
            "id": "wis-17-17-pe-2-vowel",
            "kind": "unreadablePoint",
            "anchor": "נפגָּעוּ",
