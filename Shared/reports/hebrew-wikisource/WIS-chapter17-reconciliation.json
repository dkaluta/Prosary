          }
        ]
      },
      {
        "verse": 12,
        "text": "הֲלֹא אֵין הַפַּחַד כִּי אִם־הֵאָשׁ מִתַּחְבּוּלוֹת הַמַּחְשָׁבָה׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "85ba5cbf225220b89c64982935c3f1ff8bfbd83b297e627aa9eaed1b04a67117"
      },
      {
        "verse": 13,
        "text": "וְאִם יִקְטַן הַבִּטָּחוֹן בְּלֵב הָאָדָם מְבוּכָתוֹ תֵּחָשֵׁב לְרָעָה גְּדוֹלָה מִן־הַסִּבָּה אֲשֶׁר הִיא שֹׁרֶשׁ הַצָּרָה׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "ebb992b04527018a2b624d28190c167e9f56628d1554062fa63999d7e6c4bb55"
      },
      {
        "verse": 14,
        "text": "וְכָל־הָאֲנָשִׁים יָשְׁנוּ אֶת־שְׁנָתָם בַּלַּיְלָה חדַל־אוֹנִים מֵאֵין כָּמוֹהוּ אֲשֶׁר יָצָא מִיַּרְכְּתֵי שְׁאוֹל אֵין־אוֹנִים׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "a27124c78f9e50014409fd5d7709f41ac700413fe181acdb5b3e16ff92a05795",
        "sourceNotes": [
          {
            "id": "wis-17-14-het-1-vowel",
            "kind": "unreadablePoint",
            "anchor": "חדַל־אוֹנִים",
            "occurrence": 1,
            "letterIndex": 1,
            "mark": "vowel",
            "sourcePages": [
              180
            ],
            "sourceURL": "https://upload.wikimedia.org/wikisource/he/e/ed/Apocrypha_Kahana_A2.pdf#page=180"
          }
        ]
      },
      {
        "verse": 15,
        "text": "אֵלֶּה שׁוֹטְטוּ אָנָה וָאָנָה מֵאֵימַת הַבַּלָּהוֹת וְאֵלֶּה חַתּוּ בְּהֵאָשׁ נַפְשָׁם מִתִּקְוָה כִּי פַחַד פִּתְאֹם וְשׁוֹאָה בָּאוּ עֲלֵיהֶם׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "3caf9551222da34ccb682f92fc869deb008cef96b87400f273b2e4272fc5f731"
      },
      {
        "verse": 16,
        "text": "אַחֲרֵי־כֵן נָפַל כָּל־אִישׁ וָאִישׁ אַרְצָה בַּאֲשֶׁר הוּא־שָׁם וְנֶעֱצַר כֶּאָסוּר בְּמַאֲסַר אֵין־בַּרְזֶל׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "0d3a543c03fa951a5a74ca9c6803c089b1d1f0029880c0ed6336a752e32395bc"
      },
      {
        "verse": 17,
        "text": "כְּעוֹבֵד הָאֲדָמָה כְּרוֹעֶה כְּפוֹעֵל הַיָּגֵעַ בָּדָד בַּעֲמָלוֹ כֻּלָּם נפגָּעוּ וַיִּסְבְּלוּ צָרָה קָשָׁה אֵין מָנוֹס מִמֶּנָּה׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "4baba94e23e8eb054367b5fc604453a153d3f0d98d268f5f21dd30fafe84bfc2",
        "sourceNotes": [
          {
            "id": "wis-17-17-nun-1-vowel",
            "kind": "unreadablePoint",
            "anchor": "נפגָּעוּ",
            "occurrence": 1,
            "letterIndex": 1,
            "mark": "vowel",
            "sourcePages": [
              180
