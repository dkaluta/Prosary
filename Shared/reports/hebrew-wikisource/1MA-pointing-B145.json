  "onlineScaffoldBefore": [
    {
      "chapter": 9,
      "verse": 58,
      "text": "וייוועצו כל הפושעים לאמור היה יונתן ואשר אתו במנוחה יושבים לבטח עתה נביא את בקחידס ותפשם כולם בלילה אחד:",
      "sourcePages": [],
      "textSHA256": "aa11afbc5e02d44553d3b38f8923f7c94f51e498bccaae9a419c323cad90ddb5"
    },
    {
      "chapter": 9,
      "verse": 59,
      "text": "ויכלו ויועצו אתו:",
      "sourcePages": [],
      "textSHA256": "42a9836d1d5fbb3df8778de1c830f0602f1e9bc5ca5aabcf129f31a19ccf43a6"
    },
    {
      "chapter": 9,
      "verse": 60,
      "text": "וייסע לבוא בחיל גדול וישלח מכתבי סתר לכל בני בריתו אשר ביהודה כי יתפשו את יונתן ואשר אתו ולא יכולו כי נודעה עצתם:",
      "sourcePages": [],
      "textSHA256": "a8943705b94c342a8159ffb3c1959e6345016a1e5bcc11e95f9fe64c10dca1e4"
    },
    {
      "chapter": 9,
      "verse": 61,
      "text": "ויתפשו מאנשי הארץ מראשי הרשעה כחמישים איש וימיתום:",
      "sourcePages": [],
      "textSHA256": "cf855fc2adf79b6d108ee0bf7e715e2be632a50db2b46b227c05d006bce032d5"
    },
    {
      "chapter": 9,
      "verse": 62,
      "text": "ויצא יונתן ושמעון ואשר אתם לבית בצי אשר במדבר ויבנו את חרבותיה ויבצרוה:",
      "sourcePages": [],
      "textSHA256": "71500a843d6875441b65212e530d304b522fc08c8eb74f0babcb0f19be5460f1"
    },
    {
      "chapter": 9,
      "verse": 63,
      "text": "וידע בקחידס ויאסוף את כל המונו אל אשר מיהודה שלח:",
      "sourcePages": [],
      "textSHA256": "d623af74474292af526f8ef5bf1260d9ce44b28c10061113e67919245a0ee041"
    },
    {
      "chapter": 9,
      "verse": 64,
      "text": "ויבוא וייחן על בית בצי וילחם אותה ימים רבים ויעש מכונות:",
      "sourcePages": [],
      "textSHA256": "f7c4c6ea487ec6e085ba6f8e0506c0f6d8e24357e3813c9ed42ba1fec6eaa352"
    },
    {
      "chapter": 9,
      "verse": 65,
      "text": "וישאר יונתן את שמעון אחיו בעיר ויצא לארץ ויבוא במתי מספר:",
      "sourcePages": [],
      "textSHA256": "778683401eb8cdbca3c0139ea189c02e019a0c9cdc6d844589e68cb0fccdc3df"
    },
    {
      "chapter": 9,
      "verse": 66,
      "text": "ויך את עֲדומֵירה ואת אחיו ואת בני פשׁירוֹן במושבם ויחל להכות ולעלות בחיל:",
      "sourcePages": [],
      "textSHA256": "dd7f441bf05f0d3e6c6a81ade90e7744bf5ca8224b76bc7f320e6504388f0154"
    },
    {
      "chapter": 9,
      "verse": 67,
      "text": "ושמעון ואשר אתו יצאו מן העיר וישרפו את המכונות:",
      "sourcePages": [],
      "textSHA256": "30f93adaf6fc2026e79fd458c0a6bb2af5282df670271d204314ba2a8f428d54"
    },
    {
      "chapter": 9,
      "verse": 68,
      "text": "וילחמו את בקחידס ויינגף על ידם וילחצוהו מאוד כי היו עצתו ומצורו לשווא:",
      "sourcePages": [],
      "textSHA256": "eff8c8a9a28beb550c6da78f5a3580bd3957e5f2c613dd57ac1e4d52c713a697"
    },
    {
      "chapter": 9,
      "verse": 69,
      "text": "ויחר אפו באנשים הפושעים אשר יעצוהו לבוא לארץ ויהרוג מהם רבים וייוועץ לשוב לארצו:",
      "sourcePages": [],
      "textSHA256": "94610a91164daa97e8aa30fe84964c0e0bdadce7457ca38c8ce868e36cc420a5"
    },
    {
      "chapter": 9,
      "verse": 70,
      "text": "וידע יונתן וישלח אליו מלאכים לעשות אתו שלום ולהשיב להם את השבי:",
      "sourcePages": [],
      "textSHA256": "bea3cf2b9991c0370ffcd054d099bbea4c14c38e278a66e214e533e5fca400cf"
    },
    {
      "chapter": 9,
      "verse": 71,
      "text": "ויאות ויעש כדבריו וישבע לו לבלתי בקש לו רעה כל ימי חייו:",
      "sourcePages": [],
      "textSHA256": "d2f13f5f02e1733f804cff8ff2258e3156c08ff704e6184fb9989547ce60cf2c"
    },
    {
      "chapter": 9,
      "verse": 72,
      "text": "וישב לו את השבי אשר שבה לפני מזה מארץ יהודה וישב וילך לארצו ולא יסף עוד לבוא בגבולם:",
      "sourcePages": [],
      "textSHA256": "e09e18bf00f07ab443c019ab5631a2fd244e69dde73cd67810890ffdc2b010f6"
    },
    {
      "chapter": 9,
      "verse": 73,
      "text": "ותחדל חרב מישראל וישב יונתן במכמש ויחל יונתן לשפוט את העם ויבער את הרשעים מישראל:",
      "sourcePages": [],
      "textSHA256": "57e5b27d025a95d3ded4cc9b523b8b4844ed9dc546ce750060b3f94495189807"
    },
    {
      "chapter": 10,
      "verse": 1,
      "text": "ובשנת שישים ומאה עלה אלכסנדר בן אנטיוכוס אפיפנס וילכוד את עכו ויקבלוהו וימלך שם:",
      "sourcePages": [],
      "textSHA256": "0fb939b790eb0fb1991dddca51c86f79bf304cb6f5af210e1f36a5952552a9d9"
    }
  ],
  "checkedUnits": [
    {
      "chapter": 9,
      "verse": 58,
      "text": "וַיִּוָּעֲצוּ כָּל־הַפּוֹשְׁעִים לֵאמֹר הִנֵּה יוֹנָתָן וַאֲשֶׁר אִתּוֹ בִּמְנוּחָה יוֹשְׁבִים לָבֶטַח עַתָּה נָבִיא אֶת־בַּקְחִידֵס וְתָפְשָׂם כֻּלָּם בְּלַיְלָה אֶחָד׃",
      "sourcePages": [
        145
      ],
      "textSHA256": "3aa1b305c37c9772735c2b2db3e1d129d1bdf4b388f4d492f1bbfa3c60ff39b4"
    },
    {
      "chapter": 9,
      "verse": 59,
      "text": "וַיֵּלְכוּ וַיִּוָּעֲצוּ אִתּוֹ׃ וַיִּסַּע לָבוֹא בְּחַיִל גָּדוֹל וַיִּשְׁלַח מִכְתְּבֵי סֵתֶר לְכָל־בְּנֵי־בְרִיתוֹ אֲשֶׁר בִּיהוּדָה כִּי־יִתְפְּשׂוּ אֶת־יוֹנָתָן וַאֲשֶׁר אִתּוֹ וְלֹא יָכְלוּ כִּי־נוֹדְעָה עֲצָתָם׃",
      "sourcePages": [
        145
      ],
      "textSHA256": "4b3138718dbefc1f819c6124d5f56406d29bf8d300df09a44060776d4aa67aca",
      "endVerse": 60
    },
    {
      "chapter": 9,
      "verse": 61,
      "text": "וַיִּתְפְּשׂוּ מֵאַנְשֵׁי הָאָרֶץ מֵרָאשֵׁי הָרִשְׁעָה כַּחֲמִשִּׁים אִישׁ וַיְמִיתוּם׃",
      "sourcePages": [
        145
      ],
      "textSHA256": "dc9023645db40dec673a2c4231387c04cd94e70438c08c68acb476307de4cc28"
    },
    {
      "chapter": 9,
      "verse": 62,
      "text": "וַיֵּצֵא יוֹנָתָן וְשִׁמְעוֹן וַאֲשֶׁר אִתָּם לְבֵית־בַּצִּי אֲשֶׁר בַּמִּדְבָּר וַיִּבְנוּ אֶת־חָרְבוֹתֶיהָ וַיְבַצְּרוּהָ׃",
      "sourcePages": [
        145
      ],
      "textSHA256": "89cf27a1d6fde384d3bef64dce4bfa27438d33660eda546d21ecf5a3e09fc02b"
    },
    {
      "chapter": 9,
      "verse": 63,
      "text": "וַיֵּדַע בַּקְחִידֵס וַיֶּאֱסֹף אֶת־כָּל־הֲמוֹנוֹ וְאֶל־אֲשֶׁר מִיהוּדָה שָׁלָח׃",
      "sourcePages": [
        145
      ],
      "textSHA256": "6f730ef6b738a12b5390f8f3e709f428f27f7790d5ea39881b6421e0c9009dc1"
    },
    {
      "chapter": 9,
      "verse": 64,
      "text": "וַיָּבֹא וַיִּחַן עַל־בֵּית־בַּצִּי וַיִּלָּחֶם אֹתָהּ יָמִים רַבִּים וַיַּעַשׂ מְכוֹנוֹת׃",
      "sourcePages": [
        145
      ],
      "textSHA256": "e34685c6664c395e61d78920de0839f72c7eebe006fdabf31175d8a8bfcfed25"
    },
    {
      "chapter": 9,
      "verse": 65,
      "text": "וַיַּשְׁאֵר יוֹנָתָן אֶת שִׁמְעוֹן אָחִיו בָּעִיר וַיֵּצֵא לָאָרֶץ וַיָּבֹא בְ[מְתֵי] מִסְפָּר׃",
      "sourcePages": [
        145
      ],
      "textSHA256": "81ce6dcf9121d82b2993b1068fff8da9e3cee57f584d128f91e523ea27f04507"
    },
    {
      "chapter": 9,
      "verse": 66,
      "text": "וַיַּךְ אֶת־עֲדֹמֵירָה וְאֶת־אֶחָיו וְאֶת־בְּנֵי פַשִּׁירוֹן בְּמוֹשְׁבָם וַיָּחֶל לְהַכּוֹת וְלַעֲלוֹת בְּחָיִל׃",
      "sourcePages": [
        145
      ],
      "textSHA256": "b609e52634ef0d1dfad029eddb3e2075bb2f23cdc32c14b570c6ae3bc1176c83"
    },
    {
      "chapter": 9,
      "verse": 67,
      "text": "וְשִׁמְעוֹן וַאֲשֶׁר אִתּוֹ יָצְאוּ מִן־הָעִיר וַיִּשְׂרְפוּ אֶת הַמְּכוֹנוֹת׃",
      "sourcePages": [
        145
      ],
      "textSHA256": "56f55269d3b61deab6ca53e5d7cd497d73edddbdd8451fccd13b2ee69deae898"
    },
    {
      "chapter": 9,
      "verse": 68,
      "text": "וַיִּלָּחֲמוּ אֶת־בַּקְחִידֵס וַיִּנָּגֶף עַל־יָדָם וַיִּלְחָצוּהוּ מְאֹד כִּי־הָיוּ עֲצָתוֹ וּמְצוּרוֹ לַשָּׁוְא׃",
      "sourcePages": [
        145
      ],
      "textSHA256": "fc2366e0134d5abba2f36d06ef8715cddee9e9ab607c8844079c1ca99c76e1ca"
    },
    {
      "chapter": 9,
      "verse": 69,
      "text": "וַיִּחַר אַפּוֹ בָּאֲנָשִׁים הַפּוֹשְׁעִים אֲשֶׁר־יְעָצוּהוּ לָבוֹא לָאָרֶץ וַיַּהֲרֹג מֵהֶם רַבִּים וַיִּוָּעֵץ לָשׁוּב לְאַרְצוֹ׃",
      "sourcePages": [
        145
      ],
      "textSHA256": "f174ca2de3159e85d4b2b80b9e07e17f9e8d2f8ba8f1aec371ababcbe3132529"
    },
    {
      "chapter": 9,
      "verse": 70,
      "text": "וַיֵּדַע יוֹנָתָן וַיִּשְׁלַח אֵלָיו מַלְאָכִים לַעֲשׂוֹת אִתּוֹ שָׁלוֹם וּלְהָשִׁיב לָהֶם אֶת־הַשְּׁבִי׃",
      "sourcePages": [
        145
      ],
      "textSHA256": "753b54c18d9b01c523d3d3540a01429ab4d6c9dcbb6a27013ea02466418cb738"
    },
    {
      "chapter": 9,
      "verse": 71,
      "text": "וַיֵּאוֹת וַיַּעַשׂ כִדְבָרָיו וַיִּשָּׁבַע לוֹ לְבִלְתִּי בַקֵּשׁ לוֹ רָעָה כָּל־יְמֵי חַיָּיו׃",
      "sourcePages": [
        145
      ],
      "textSHA256": "f1a5bbb71d2a5913e92e5db90bc09d5add9bec924e12bb334c10856e7ca66973"
    },
    {
      "chapter": 9,
      "verse": 72,
      "text": "וַיָּשֶׁב־לוֹ אֶת־הַשְּׁבִי אֲשֶׁר שָׁבָה לִפְנֵי מִזֶּה מֵאֶרֶץ יְהוּדָה וַיָּשָׁב וַיֵּלֶךְ לְאַרְצוֹ וְלֹא יָסַף עוֹד לָבוֹא בִּגְבוּלָם׃",
      "sourcePages": [
        145
      ],
      "textSHA256": "9de93743509af1f367994c4446f0f09d4e6aeb0bf2f53d2254362191eb61c989"
    },
    {
      "chapter": 9,
      "verse": 73,
      "text": "וַתֶּחְדַּל חֶרֶב מִיִּשְׂרָאֵל וַיֵּשֶׁב יוֹנָתָן בְּמִכְמָשׂ וַיָּחֶל יוֹנָתָן לִשְׁפֹט אֶת־הָעָם וַיְבַעֵר אֶת־הָרְשָׁעִים מִיִּשְׂרָאֵל׃",
      "sourcePages": [
        145
      ],
      "textSHA256": "d6e042da5d3b6aba90b80d025ca5a5edfc87ed17e8b264f417399c761afd1652"
    },
    {
      "chapter": 10,
      "verse": 1,
      "text": "וּבִשְׁנַת שִׁשִּׁים וּמֵאָה עָלָה אֶלֶכְּסַנְדַּר בֶּן־אַנְטִיוֹכוֹס אֶפִּיפָנֶס וַיִּלְכֹּד אֶת־עַכּוֹ וַיְקַבְּלוּהוּ וַיִּמְלָךְ־שָׁם׃",
      "sourcePages": [
        145,
