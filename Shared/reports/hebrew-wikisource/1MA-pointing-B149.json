  "status": "B149 completely first/second-compared; only 47 continuation on 150 checked; book remains draft",
  "method": "Every scripture word, printed point, punctuation mark and margin boundary compared directly against both scans. Enlarged actual pixels resolved local forms. Independent peer checked only the named 42/46/47 local marks, not the whole page. No grammar-based point completion or spelling normalization.",
  "onlineScaffoldBefore": [
    {
      "verse": 38,
      "text": "ושלושת הגלילות אשר חוברו ליהודה מארץ שומרון מחבר אנוכי ליהודה אשר יחשבו להיות לאחד ולא ישמעו לשלטון אחר כי אם לכהן הגדול:",
      "sourcePages": [],
      "textSHA256": "e3470c7ea5717f9d2dafa242749b86580f9ad01fd8d24d0889264684c1b1ad47"
    },
    {
      "verse": 39,
      "text": "ואת עכו ואת הארץ הבאה אלי נתתי מתנה לבית המקדש אשר בירושלים להוצאה הנחוצה במקדש:",
      "sourcePages": [],
      "textSHA256": "27299e4a141ed91191441f662d91ff96de4177726443556c9f703f55946b23d4"
    },
    {
      "verse": 40,
      "text": "ואנוכי נותן שנה שנה חמישה עשר אלף שקל כסף מתבואת המלך מן המקומות הבאים:",
      "sourcePages": [],
      "textSHA256": "fa531439d797556cfae63cc53832412926bf1e159c90dc6a3d128f5036a285fd"
    },
    {
      "verse": 41,
      "text": "וכל העודף אשר לא נתנו הפקידים כבשנים הראשונות יתנו מעתה למלאכת הבית:",
      "sourcePages": [],
      "textSHA256": "67f270bbf66060410001f45c4b7dd5805804ae25810baa9692dc3c5473e3c39e"
    },
    {
      "verse": 42,
      "text": "ומלבד אלה חמשת אלפי שקל כסף אשר היו לוקחים כבשנים הראשונים מצרכי המקדש דבר שנה בשנה גם אלה הונחו כי לכהנים העובדים הם:",
      "sourcePages": [],
      "textSHA256": "c65e06ea4efd121d45b2608d8cc94497727278431b56dc26af96ac86a15bd821"
    },
    {
      "verse": 43,
      "text": "וכל אשר ינוס למקדש אשר בירושלים ולכל גבולו הרחיב למלך וכל דבר ינקה הוא וכל אשר לו במלכותי:",
      "sourcePages": [],
      "textSHA256": "79fd71e980c7d6717ed9771ef3e78cecf4df9b04f0eff7fd7714d28f8edd5022"
    },
    {
      "verse": 44,
      "text": "ולהבנות ולהתחדש מלאכת המקדש וההוצאה תינתן מתבואת המלך:",
      "sourcePages": [],
      "textSHA256": "2dcf848d8e88f9eb7ce92d8009a96c1d8752db4882f6a9e60e64122e4f0acb39"
    },
    {
      "verse": 45,
      "text": "ולהבנות חומות ירושלים ולבצר מסביב וההוצאה תינתן מתבואת המלך ולבנות החומות ביהודה:",
      "sourcePages": [],
      "textSHA256": "a55995bc5456d7787c84234b08a9aec49b2ad28b24ed5a86dc4cc3ac6bd5afe9"
    },
    {
      "verse": 46,
      "text": "וכשמוע יונתן והעם את הדברים האלה לא האמינו להם ולא קיבלו כי זכרו את הרעות הגדולות אשר עשה בישראל ועינה אותם מאוד:",
      "sourcePages": [],
      "textSHA256": "e84daedf0f63359823a239e2a0de20d5af396e0765b3131c5f355b8ef307faaf"
    },
    {
      "verse": 47,
      "text": "וירצו באלכסנדר כי הוא היה להם ראשון לדברי שלום ויעזרו לו כל הימים:",
      "sourcePages": [],
      "textSHA256": "b0c5b5ae3fdbe44be322ad6bc5e72012ef22fc84a78be705b16b2882044df438"
    }
  ],
  "checkedUnits": [
    {
      "chapter": 10,
      "verse": 38,
      "text": "וּשְׁלֹשֶׁת הַגְּלִילוֹת אֲשֶׁר חֻבְּרוּ לִיהוּדָה מֵאֶרֶץ שֹׁמְרוֹן מְחַבֵּר אָנֹכִי לִיהוּדָה אֲשֶׁר־יִחָשְׁבוּ לִהְיוֹת לְאֶחָד וְלֹא יִשְׁמְעוּ לְשִׁלְטוֹן אַחֵר כִּי אִם־לַכֹּהֵן הַגָּדוֹל׃",
      "sourcePages": [
        149
      ],
      "textSHA256": "e9e646347ba97aa9b04e6283e52d75ef2c2f88e8b579cbc85dcb5dc897defdce"
    },
    {
      "chapter": 10,
      "verse": 39,
      "text": "וְאֶת־עַכּוֹ וְאֶת־[הָאָרֶץ] הַבָּאָה אֵלֶיהָ נָתַתִּי מַתָּנָה לְבֵית־הַמִּקְדָּשׁ אֲשֶׁר בִּירוּשָׁלִָם לְהוֹצָאָה הַנְּחוּצָה בַּמִּקְדָּשׁ׃",
      "sourcePages": [
        149
      ],
      "textSHA256": "511cf38420fbd925834a95eff3bf4539f3dac1ba7a9fcd8608e474e62035a901"
    },
    {
      "chapter": 10,
      "verse": 40,
      "text": "וְאָנֹכִי נוֹתֵן שָׁנָה שָׁנָה חֲמִשָּׁה עָשָׂר אֶלֶף שֶׁקֶל כֶּסֶף מִתְּבוּאַת הַמֶּלֶךְ מִן־הַמְּקוֹמוֹת הַבָּאִים׃",
      "sourcePages": [
        149
      ],
      "textSHA256": "85fde6ad062bb9feaa03fec84468c1b24778725cfe99fafcecf3544a4787cf95"
    },
    {
      "chapter": 10,
      "verse": 41,
      "text": "וְכָל־הָעוֹדֵף אֲשֶׁר לֹא־נָתְנוּ הַפְּקִידִים כְּבַשָּׁנִים הָרִאשֹׁנוֹת יִתְּנוּ מֵעַתָּה לִמְלֶאכֶת הַבַּיִת׃",
      "sourcePages": [
        149
      ],
      "textSHA256": "97665b35395bb8932e94a29c71919e10db20a90d9e605855d0a7e91558ad68c1"
    },
    {
      "chapter": 10,
      "verse": 42,
      "text": "וּמִלְּבַד אֵלֶּה חֲמֵשֶׁת אַלְפֵי שֶׁקֶל כֶּסֶף אֲשֶׁר הָיוּ לוֹקְחִים כְּבַשָּׁנִים הָרִאשֹׁנוֹת מִצָּרְכֵי הַמִּקְדָּשׁ דְּבַר שָׁנָה בְּשָׁנָה גַּם־אֵלֶּה הוּנָחוּ כִּי לַכֹּהֲנִים הָעוֹבְדִים הֵם׃",
      "sourcePages": [
        149
      ],
      "textSHA256": "7596277e626db6f6b35b1c2e2406f2352a3ab77a95aa2add083b5e5381c5f38c"
    },
    {
      "chapter": 10,
      "verse": 43,
      "text": "וְכָל אֲשֶׁר־יָנוּס לְמִקְדָּשׁ אֲשֶׁר בִּירוּשָׁלִַם וּלְכָל־גְּבוּלוֹ הַחַיָּב לַמֶּלֶךְ וּלְכָל־דָּבָר יְנֻקֶּה [הוּא] וְכָל אֲשֶׁר לוֹ בְּמַלְכוּתִי׃",
      "sourcePages": [
        149
      ],
      "textSHA256": "e83cae363dbfe6e8df2edac76544b7379fad88221a2304486dcc7ccdc631b685"
    },
    {
      "chapter": 10,
      "verse": 44,
      "text": "וּלְהִבָּנוֹת וּלְהִתְחַדֵּשׁ מְלֶאכֶת הַמִּקְדָּשׁ וְהַהוֹצָאָה תִּנָּתֵן מִתְּבוּאַת הַמֶּלֶךְ׃",
      "sourcePages": [
        149
      ],
      "textSHA256": "8ac69b0d095e21e4ee181d19d662ecc9f6635810ab4dfe3f9e109bfa35657d1c"
    },
    {
      "chapter": 10,
      "verse": 45,
      "text": "וּלְהִבָּנוֹת חֹמוֹת יְרוּשָׁלִַם וּלְבַצֵּר מִסָּבִיב וְהַהוֹצָאָה תִּנָּתֵן מִתְּבוּאַת הַמֶּלֶךְ וְלִבְנוֹת הַחוֹמוֹת בִּיהוּדָה׃",
      "sourcePages": [
        149
      ],
      "textSHA256": "782e51cfb7eb51ae78304e6640fb729537a343f9c5363d0faf2320f8e09ba938"
    },
    {
      "chapter": 10,
      "verse": 46,
      "text": "וכִשְׁמֹעַ יוֹנָתָן וְהָעָם אֶת־הַדְּבָרִים הָאֵלֶּה לֹא הֶאֱמִינוּ לָהֶם וְלֹא קִבְּלוּ כִּי זָכְרוּ אֶת־הָרָעוֹת הַגְּדֹלוֹת אֲשֶׁר עָשָׂה בְיִשְׂרָאֵל וְעִנָּה אוֹתָם מְאֹד׃",
      "sourcePages": [
        149
      ],
      "textSHA256": "d8c01b6f4b5c4508cdd75ef57ae5fe9d6ea22b99ea5663d22d2926b0063efcc2",
