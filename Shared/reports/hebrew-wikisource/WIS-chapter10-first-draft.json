  "draft": {
    "number": 10,
    "verses": [
      {
        "verse": 1,
        "text": "הִיא שָׁמְרָה אֶת־אָדָם הָרִאשׁוֹן אֲבִי תֵבֵל אֲשֶׁר נוֹצַר לְבַדּוֹ וַתְּקִימֵהוּ מִכִּשְׁלוֹנוֹ׃",
        "sourcePages": [
          163
        ],
        "textSHA256": "39c11b7e359593bfa7652d4c82c7bec0d57c8c4a2a8bf0a1a6b39a8a94a88cb3"
      },
      {
        "verse": 2,
        "text": "וַתִּתֶּן־לוֹ כֹּחַ לִמְשֹׁל בַּכֹּל׃",
        "sourcePages": [
          163
        ],
        "textSHA256": "61fb21263db9a59951af0589de3bde26a60da0eaa0a0e8c32416c194808fa30b"
      },
      {
        "verse": 3,
        "text": "וְהַחַטָּא אֲשֶׁר־סָר מִמֶּנָּה בְּאַפּוֹ אָבַד בְּזַעְמוֹ כְּרוֹצֵחַ אָח׃",
        "sourcePages": [
          164
        ],
        "textSHA256": "a27a377542de6c03037a624776cf5301f7d316094c2aa818ef521e8d5f485e4c"
      },
      {
        "verse": 4,
        "text": "וְהָאָרֶץ אֲשֶׁר הֵצִיפוּ הַמַּיִם בִּגְלָלוֹ שָׁבָה הַחָכְמָה לְהַצִּילָהּ וַתִּנְהַג אֶת־הַצַּדִּיק עֲלֵי־עֵץ נִקְלֶה׃",
        "sourcePages": [
          164
        ],
        "textSHA256": "c9dd1b779f3ed76f93d1cf7536662587d2619c7c785d3b8302ec13c3314bd674"
      },
      {
        "verse": 5,
        "text": "הִיא מָצְאָה אֶת־הַצַּדִּיק גַּם בְּהִבָּלֵל הָעַמִּים אֲשֶׁר הֵרֵעוּ לַעֲשׂוֹת לֵב אֶחָד וַתַּעֲמִידֵהוּ תָמִים לִפְנֵי יְיָ וַתִּשְׁמְרֵהוּ וַתְּחַזְּקֵהוּ כַּאֲשֶׁר הָמוּ מֵעָיו לִבְנוֹ׃",
        "sourcePages": [
          164
        ],
        "textSHA256": "897492d48c19d4be14fd5af975cc2fd8f5499bca6f7560b2c5b853fd27ebfb39"
      },
      {
        "verse": 6,
        "text": "הִיא הִמְלִיטָה אֶת־הַצַּדִּיק בַּאֲבֹד הָרְשָׁעִים בְּנוּסוֹ מִפְּנֵי הָאֵשׁ הַיּוֹקֶדֶת עַל־חֲמֵשׁ הֶעָרִים׃",
        "sourcePages": [
          164
        ],
        "textSHA256": "1db1d6b69c74f35c22a8bfe68813156888ced8ccf9c1664edf126f8f8eae40b8"
      },
      {
        "verse": 7,
        "text": "וְהָאָרֶץ הַחֳרָבָה הַמַּעֲלָה עָשָׁן תָּקוּם לְעֵדָה עַל־רִשְׁעַת הָאֲנָשִׁים וּנְטָעִים נוֹשְׂאִים פֵּרוֹת לְלֹא עֵת וּנְצִיב מֶלַח יַעֲמֹד לְזֵכֶר נֶפֶשׁ חַדְלַת אֱמוּנָה׃",
        "sourcePages": [
          164
        ],
        "textSHA256": "4af47fc066bcccc6d2a1d80a7059739d554ff509d29630a92e7b3715c9333e39"
      },
      {
        "verse": 8,
        "text": "בְּעָזְבָם אֶת דֶּרֶךְ הַחָכְמָה לֹא בִּלְבַד לָקוּ מֵחֹסֶר דַּעַת אֶת־הַטּוֹב אוּלָם הִשְׁאִירוּ גַם מַזְכֶּרֶת סִכְלוּתָם לַחַיִּים בַּל־תִּסָּתֵר סִבַּת כִּשְׁלוֹנָם׃",
        "sourcePages": [
          164
        ],
        "textSHA256": "03204396ea109f3e4470b6ec80e263ee977fd0ee9c60333c04951ed823f3b739"
      },
      {
        "verse": 9,
        "text": "וְהַחָכְמָה תִּשְׂגֹּב אֶת־מְכַבְּדֶיהָ מֵעֹנִי׃",
        "sourcePages": [
          165
        ],
        "textSHA256": "88487b96502932e8fa42447213b992115ad1754704b8585618f23185e87a05ff"
      },
      {
        "verse": 10,
        "text": "הִיא הוֹלִיכָה בְּדֶרֶךְ יָשָׁר אֶת־הַצַּדִּיק בְּבָרְחוֹ מִפְּנֵי חֲמַת אָחִיו וַתַּרְאֵהוּ מַמְלֶכֶת יְיָ וַתִּתֶּן־לוֹ דַּעַת קֹדֶשׁ וַתּוֹשַׁע לוֹ בְּתַלְאוֹתָיו וַתֶּרֶב אֶת־פְּרִי עֲמָלוֹ׃",
        "sourcePages": [
          165
        ],
        "textSHA256": "da39d6cf1a579061d7b75360be38b06bda8d0ecb007ccf56cfcbc381d2a4ff93"
      },
      {
        "verse": 11,
        "text": "הִיא עָמְדָה לִימִינוֹ מִפְּנֵי נוֹגְשָׂיו בּוֹצְעֵי בָצַע וַתַּעֲשִׁירֵהוּ׃",
        "sourcePages": [
          165
        ],
        "textSHA256": "e944317a39558840532d5062991808de19585abd43ccd82c498239321de5265e"
      },
      {
        "verse": 12,
        "text": "וַתִּשְׁמְרֵהוּ מִפְּנֵי אוֹיְבָיו וַתִּצְּרֵהוּ מִפְּנֵי הָאוֹרְבִים לְנַפְשׁוֹ וַתַּעֲמָד־לוֹ בִּקְרַב עָצוּם לְמַעַן יֵדַע כִּי־יִרְאַת יְיָ תַּעֹז מִכֹּל׃",
        "sourcePages": [
          165
        ],
        "textSHA256": "a4eac10318bb4d683880a4cfa5a60ecfa9ebc5a4deea2708773c3a8023c86f88"
      },
      {
        "verse": 13,
        "text": "הִיא לֹא עָזְבָה צַדִּיק נִמְכָּר וַתַּחְשֹׂךְ אוֹתוֹ מֵחֵטְא׃",
        "sourcePages": [
          165
        ],
        "textSHA256": "5314b0c8e1e3c40a99f622067751d75bb701a33d02be61249cba4a4760810ad7"
      },
      {
        "verse": 14,
        "text": "וַתֵּרֶד עִמּוֹ אֶל־הַבּוֹר וּבְמַאֲסָר לֹא תִטְּשֵׁהוּ עַד־תָּבִיא לוֹ שֵׁבֶט מַלְכוּת וּמֶמְשָׁל בְּלוֹחֲצָיו וַתְּגַל שֶׁקֶר מַלְשִׁינָיו וַתִּתֶּן־לוֹ שֵׁם עוֹלָם׃",
        "sourcePages": [
          165
        ],
        "textSHA256": "8145f88ae9ae72d0a9dd05c98723b741f05f2d810ccb846e0d407def86711cba"
      },
      {
        "verse": 15,
        "text": "הִיא הוֹצִיאָה עַם קָדוֹשׁ וְזֶרַע תָּמִים מִקֶּרֶב גּוֹי צוֹרְרִים׃",
        "sourcePages": [
          165
        ],
        "textSHA256": "5ef0647529ed04545e3fb19f201e084bc9a4eaa130195170b99ac97cfa6ed9a8"
      },
      {
        "verse": 16,
        "text": "וַתָּבֹא בְּנֶפֶשׁ עֶבֶד יְיָ וַיִּתְיַצֵּב לִפְנֵי מְלָכִים אַדִּירִים בְּאוֹתוֹת וּבְמוֹפְתִים׃",
        "sourcePages": [
          165
        ],
        "textSHA256": "f65aa55e42bd4ef1da22f2f55bddfb397307a0899775d227c76de3f758b74e3b"
      },
      {
        "verse": 17,
        "text": "[הִיא] נָתְנָה לַקְּדוֹשִׁים שְׂכַר עֲמָלָם וַתַּנְחֵם דֶּרֶךְ פְּלָאִים וַתְּהִי לָמוֹ לְמַחְסֶה יוֹמָם וּלְאוֹר כּוֹכָבִים לָיְלָה׃",
        "sourcePages": [
          165
        ],
        "textSHA256": "293e5fdbb0265db008b03dc551329ffd60fd99aaaf0fa7f06b171b4013391609"
      },
      {
        "verse": 18,
        "text": "וַתַּעֲבִירֵם בְּיַם־סוּף וַתְּנַהֲלֵם בְּמַיִם רַבִּים׃",
        "sourcePages": [
          165
        ],
        "textSHA256": "9ad8bf123acb8424c62aeb5d672c0ab355d212d895fabd99ee953d5868bd03bc"
      },
      {
        "verse": 19,
        "text": "אֶת־שׂוֹנְאֵיהֶם טִבְּעָה וּמֵעֹמֶק תְּהוֹם הֶעֱלָתַם׃",
        "sourcePages": [
          165
        ],
        "textSHA256": "d3ba1dfc6781ec1aee7963eee4a22beb8fbb22d755261d5af04dea39b936689c"
      },
      {
        "verse": 20,
        "text": "עַל־כֵּן פָּשְׁטוּ הַצַּדִּיקִים הַנֶּשֶׁק מֵעַל־הָרְשָׁעִים וַיְּזַמְּרוּ לְשִׁמְךָ הַקָּדוֹשׁ יְיָ וַיְהַלְלוּ יַחְדָּו אֶת־יָדְךָ הַטּוֹבָה׃",
        "sourcePages": [
          166
        ],
        "textSHA256": "12dfced7cd6ffa328cc29e567412afc08e1dd6975cbff1708628d3dc4750d976"
      },
