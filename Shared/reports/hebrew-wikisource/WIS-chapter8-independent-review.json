    "chapter": {
      "number": 8,
      "verses": [
        {
          "verse": 1,
          "text": "מִן־הַקָּצֶה עַד־הַקָּצֶה תִּשְׂתָּרַע בְּעֹז וּתְכַלְכֵּל הַכֹּל בְּמִשְׁפָּט׃",
          "sourcePages": [
            160
          ],
          "textSHA256": "376fbfbd856298a6a4c2e227d1b0b7825ac3bff55fe1f128a20a61f08a10dc75"
        },
        {
          "verse": 2,
          "text": "אוֹתָהּ אָהַבְתִּי וּדְרַשְׁתִּי מִנְּעוּרָי וְקַחְתָּהּ לִי לְכַלָּה חָפַצְתִּי וְאֶת יָפְיָהּ חִבַּבְתִּי׃",
          "sourcePages": [
            160
          ],
          "textSHA256": "deb8a8d5de8089967cf17b63dbe14917310948e80be7c7053848e0de82cb5711"
        },
        {
          "verse": 3,
          "text": "אֶת־רוּם יַחְשָׂהּ תַּרְאֶה בִּחְיוֹתָהּ חַיֵּי שֻׁתָּפוּת עִם־יְיָ וַאֲדוֹן הַכֹּל אֲהֵבָהּ׃",
          "sourcePages": [
            160
          ],
          "textSHA256": "96a13c355b8344830d889ab87ce209796b068125d72efbc5dedd4839f8da01be"
        },
        {
          "verse": 4,
          "text": "תַּעֲלוּמוֹת דַּעַת אֱלֹהִים לְפָנֶיהָ נִגְלוּ וְהִיא בּוֹרֶרֶת מַעֲשָׂיו׃",
          "sourcePages": [
            160
          ],
          "textSHA256": "2cee5d09b2fdc8c7145f8a41af1816992b39e5ab5fc8edad2bc61c497399b0bd"
        },
        {
          "verse": 5,
          "text": "וְאִם־הָעֹשֶׁר קִנְיָן נֶחְמָד בַּחַיִּים מִי יֶעֱשַׁר מִן־הַחָכְמָה הַמְחוֹלֶלֶת הַכֹּל׃",
          "sourcePages": [
            160
          ],
          "textSHA256": "a53b2d7fb6ca68c17b2140718c1f5bc8c61075fe8ed285a246af5c42a77c3b26"
        },
        {
          "verse": 6,
          "text": "וְאִם [כְּבָר] הַתְּבוּנָה מְחוֹלֶלֶת מַעֲשִׂים מִי יוֹתֵר מִמֶּנָּה יוֹצֵר הַנִּמְצָאִים׃",
          "sourcePages": [
            160
          ],
          "textSHA256": "51516b0f5e1c43aabd1f6475e8c65bd084e2f0e70588c62db9597767be739eea"
        },
        {
          "verse": 7,
          "text": "וְאִם־יֶשׁ אִישׁ אוֹהֵב יֹשֶׁר הִנֵּה כָל־מַעֲשֶׂיהָ מֵישָׁרִים כִּי הִיא תְּלַמֵּד עֲנָוָה וּבִינָה יֹשֶׁר וּגְבוּרָה וּמֵהֶם אֵין־דָּבָר מוֹעִיל בַּחַיִּים לִבְנֵי אָדָם׃",
          "sourcePages": [
            160,
            161
          ],
          "textSHA256": "fff544ddf7e6c224be840635ea69f5ad6712ef7727ce828da18f8e808b81754e"
        },
        {
          "verse": 8,
          "text": "וְאִם־לְהוֹסִיף דַּעַת יִשְׁאַף אִישׁ הִנֵּה הִיא תָבִין קַדְמוֹנִיּוֹת וּפֵשֶׁר הֶעָתִיד וְתֵדַע מַאֲמָרֵי מְלִיצוֹת וּפִתְרוֹן חִידוֹת אֹתוֹת וּמוֹפְתִים תֶּחֱזֶה מֵרֹאשׁ וְקֹרוֹת הַיָּמִים הַבָּאִים לִתְקוּפוֹתֵיהֶם׃",
          "sourcePages": [
            161
          ],
          "textSHA256": "570ec650cc29c61e4e8b8b7101bad30b0cd962d8f23321fba89ea6420cb16d03"
        },
        {
          "verse": 9,
          "text": "וְלָכֵן גָּמַרְתִּי לְקַחְתָּהּ וְלִחְיוֹת עִמָּהּ בְּדַעְתִּי כִּי תִּהְיֶה־לִי יוֹעֲצָה טוֹבָה וְנֶחָמָה בְּדָאָגָה וָעֶצֶב׃",
          "sourcePages": [
            161
          ],
          "textSHA256": "2698fd8f3d12e2a5851743a31b72f4f1a3203162c6f72be8db37ac3e5aa38ed0"
        },
        {
          "verse": 10,
          "text": "בַּעֲבוּרָהּ יִגְדַּל שְׁמִי בָעַמִּים וּכְבוֹד הַצָּעִיר בֵּין יְשִׁישִׁים׃",
          "sourcePages": [
            161
          ],
          "textSHA256": "44039f74b9041d51f206f78ab887dc63283c593c0f79c1ad7ef24f6d1046aeb8"
        },
        {
          "verse": 11,
          "text": "חָרוּץ אֶמָּצֵא בְּמִשְׁפָּט וּבְעֵינֵי נְדִיבִים אֶנָּשֵׂא׃",
          "sourcePages": [
            161
          ],
          "textSHA256": "7a4b02d025329d4f5002c0f35a2c5b82d45427b711ae0443f22921373c170657"
        },
        {
          "verse": 12,
          "text": "בְּהַחֲרִישִׁי יְחַכּוּ לִי וּבִדְבָרַי יַטּוּ אֹזֶן קַשֶּׁבֶת וְאִם אוֹסִיף לְדַבֵּר כַּף לַפֶּה יָשִׂימוּ׃",
          "sourcePages": [
            161
          ],
          "textSHA256": "6381d0004726620f5ac3fe73ebbc4eca5ec575bbb2e9263f2146b43e4159cac5"
        },
        {
          "verse": 13,
          "text": "בִּגְלָלָהּ אִירַשׁ אַל־מָוֶת וְזֵכֶר נֵצַח אַשְׁאִיר לַבָּאִים אַחֲרָי׃",
          "sourcePages": [
            161
          ],
          "textSHA256": "5fdd3c40c3ad3c63e8dd3e3306d43ab39492d7940d83414076d5c2a2af2f1289"
        },
        {
          "verse": 14,
          "text": "אַדְבִּיר עַמִּים תַּחְתִּי וּלְאֻמִּים יִכָּנְעוּ לְפָנָי׃",
          "sourcePages": [
            161
          ],
          "textSHA256": "d11fb2ecdff3ef0009532f4ffd172ece299a9055b258724bd20803109b7fc9f0"
        },
        {
          "verse": 15,
          "text": "עָרִיצִים נוֹרָאִים יִשְׁמְעוּ וְיִרְגְּזוּ מִפָּנָי בִּקְהַל עָם כְּעוֹשֵׂה חֶסֶד אוֹפִיעַ וּבְמִלְחָמָה כְּבַעַל גְּבוּרָה׃",
          "sourcePages": [
            161
          ],
          "textSHA256": "b9a0853499306260cc4f145ab67cf7148b7cd08cef1cb366a32b7acac260373e"
        },
        {
          "verse": 16,
          "text": "בְּבוֹאִי הַבַּיְתָה בָּהּ אֶמְצָא מְנוּחָתִי כִּי בְחֶבְרָתָהּ אֵין יָגוֹן וּבְרֵעוּתָהּ אֵין עַצֶּבֶת אַךְ שָׂשׂוֹן וְשִׂמְחָה׃",
          "sourcePages": [
            161
          ],
          "textSHA256": "2f71bd0e5e11018a1f2c35e1abc117f172052d8c9b032c2bf4f6867c8b9686cc"
        },
        {
          "verse": 17,
          "text": "זֹאת הִתְבּוֹנַנְתִּי בְנַפְשִׁי וְחָשַׁבְתִּי בִּלְבָבִי כִּי יֵשׁ אַל־מָוֶת בְּקִרְבַת הַחָכְמָה׃",
          "sourcePages": [
            161
          ],
          "textSHA256": "517515b640f25112dfce19ed96896890bd938187c7d4424b3af7f0fb89cd8f38"
        },
        {
          "verse": 18,
          "text": "וּבִידִידוּתָהּ מַרְגֵּעָה נְעִימָה וּבְמַעֲשֵׂי יָדֶיהָ הוֹן עָתֵק שְׁגוֹת בָּהּ תָּמִיד תְּבוּנָה וְהַרְבּוֹת עִמָּהּ שִׂיחָה שֵׁם טוֹב וְהִנֵּה שׁוֹמֵמְתִּי וְחִפַּשְׂתִּיהָ לְקַחְתָּהּ אֵלָי׃",
          "sourcePages": [
            161
          ],
          "textSHA256": "54694c3f1905407ba5bd44da31768a70c48faef84527c8c34f6018614a9ce85d"
        },
        {
          "verse": 19,
          "text": "נַעַר יְפֵה מַרְאֶה הָיִיתִי וְנֶפֶשׁ טוֹבָה נָפְלָה בְּגוֹרָלִי׃",
          "sourcePages": [
            162
          ],
          "textSHA256": "6a4ac3f4f141b5c8b39635d8262c4d327a05b7f0c3bce9300a91a691f46da3d2"
        },
        {
          "verse": 20,
          "text": "יוֹתֵר נָכוֹן בִּהְיוֹתִי טוֹב בָּאתִי לְתוֹךְ גּוּף טָהוֹר׃ בְּדַעְתִּי כִּי לֹא אֶקְנֶה אוֹתָהּ בְּלִי עֶזְרַת אֱלֹהִים וּבִינָתִי עָמְדָה לִי לָדַעַת אֶת מְקוֹר הַחֶסֶד הַזֶּה דָּרַשְׁתִּי אֶת־יְיָ וָאֶתְפַּלְּלָה לְפָנָיו בְּכָל־לְבָבִי וָאֹמַר׃",
          "sourcePages": [
            162
          ],
          "textSHA256": "b01cadc5b819aca3ae7f64fa3a11f20fdf109147dfae2df55587d607f7334b12",
          "verseEnd": 21
        }
      ]
    }
  },
  "proposedChapterAfterIntegration": {
    "number": 8,
    "verses": [
      {
        "verse": 1,
        "text": "מִן־הַקָּצֶה עַד־הַקָּצֶה תִּשְׂתָּרַע בְּעֹז וּתְכלְכֵּל הַכֹּל בְּמִשְׁפָּט׃",
        "sourcePages": [
          160
        ],
        "textSHA256": "fadcda3004172c96d45bbc50b8ebebe8c6ba41fc500f1870ff8064beb4032ca3",
        "sourceNotes": [
          {
            "id": "wis-8-1-first-kaf",
            "kind": "unreadablePoint",
            "anchor": "וּתְכלְכֵּל",
            "occurrence": 1,
            "letterIndex": 3,
            "mark": "vowel",
            "sourcePages": [
              160
            ],
            "sourceURL": "https://upload.wikimedia.org/wikisource/he/e/ed/Apocrypha_Kahana_A2.pdf#page=160"
          }
        ]
      },
      {
        "verse": 2,
        "text": "אוֹתָהּ אָהַבְתִּי וּדְרַשְׁתִּי מִנְּעוּרָי וְקַחְתָּהּ לִי לְכַלָּה חָפַצְתִּי וְאֶת יָפְיָהּ חִבַּבְתִּי׃",
        "sourcePages": [
          160
        ],
        "textSHA256": "deb8a8d5de8089967cf17b63dbe14917310948e80be7c7053848e0de82cb5711"
      },
      {
        "verse": 3,
        "text": "אֶת־רוּם יַחשָׂהּ תַּרְאֶה בִּחְיוֹתָהּ חַיֵי שֻׁתָּפוּת עִם־יְיָ וַאֲדוֹן הַכֹּל אֲהֵבָהּ׃",
        "sourcePages": [
          160
        ],
        "textSHA256": "20b7ffded3fd0c697579e831543ee0a09b859aa53733e2f6a23f5e2481bb367e",
        "sourceNotes": [
          {
            "id": "wis-8-3-het",
            "kind": "unreadablePoint",
            "anchor": "יַחשָׂהּ",
            "occurrence": 1,
            "letterIndex": 2,
            "mark": "vowel",
            "sourcePages": [
              160
            ],
            "sourceURL": "https://upload.wikimedia.org/wikisource/he/e/ed/Apocrypha_Kahana_A2.pdf#page=160"
          },
          {
            "id": "wis-8-3-first-yod-dagesh",
            "kind": "unreadablePoint",
            "anchor": "חַיֵי",
            "occurrence": 1,
            "letterIndex": 2,
            "mark": "dagesh",
            "sourcePages": [
              160
            ],
            "sourceURL": "https://upload.wikimedia.org/wikisource/he/e/ed/Apocrypha_Kahana_A2.pdf#page=160"
          }
        ]
      },
      {
        "verse": 4,
        "text": "תַּעֲלוּמוֹת דַּעַת אֱלֹהִים לְפָנֶיהָ נִגְלוּ וְהִיא בּוֹרֶרֶת מַעֲשָׂיו׃",
        "sourcePages": [
          160
        ],
        "textSHA256": "2cee5d09b2fdc8c7145f8a41af1816992b39e5ab5fc8edad2bc61c497399b0bd"
      },
      {
        "verse": 5,
        "text": "וְאִם־הָעֹשֶׁר קִנְיָן נֶחְמָד בַּחַיִּים מִי יֶעֱשַׁר מִן־הַחָכְמָה הַמְחוֹלֶלֶת הַכֹּל׃",
        "sourcePages": [
          160
        ],
        "textSHA256": "a53b2d7fb6ca68c17b2140718c1f5bc8c61075fe8ed285a246af5c42a77c3b26"
      },
      {
        "verse": 6,
        "text": "וְאִם [כְּבָר] הַתְּבוּנָה מְחוֹלֶלֶת מַעֲשִׂים מִי יוֹתֵר מִמֶּנָּה יוֹצר הַנִּמְצָאִים׃",
        "sourcePages": [
          160
        ],
        "textSHA256": "d48eed33bd3c2b0d426fc469bcac4396e52714135ee2e1dabd7595c304717ef4",
        "sourceNotes": [
          {
            "id": "wis-8-6-tsadi",
            "kind": "unreadablePoint",
            "anchor": "יוֹצר",
            "occurrence": 1,
            "letterIndex": 3,
            "mark": "vowel",
            "sourcePages": [
              160
            ],
            "sourceURL": "https://upload.wikimedia.org/wikisource/he/e/ed/Apocrypha_Kahana_A2.pdf#page=160"
          }
        ]
      },
      {
        "verse": 7,
        "text": "וְאִם־יֶשׁ אִישׁ אוֹהֵב יֹשֶׁר הִנֵּה כָל־מַעֲשֶׂיהָ מֵישָׁרִים כִּי הִיא תְּלַמֵּד עֲנָוָה וּבִינָה יֹשֶׁר וּגְבוּרָה וּמֵהֶם אֵין־דָּבָר מוֹעִיל בַּחַיִּים לִבְנֵי אָדָם׃",
        "sourcePages": [
          160,
          161
        ],
        "textSHA256": "fff544ddf7e6c224be840635ea69f5ad6712ef7727ce828da18f8e808b81754e"
      },
      {
        "verse": 8,
        "text": "וְאִם־לְהוֹסִיף דַּעַת יִשְׁאַף אִישׁ הִנֵּה הִיא תָבִין קַדְמוֹנִיּוֹת וּפֵשֶׁר הֶעָתִיד וְתֵדַע מַאֲמָרֵי מְלִיצוֹת וּפִתְרוֹן חִידוֹת אֹתוֹת וּמוֹפְתִים תֶּחֱזֶה מֵרֹאשׁ וְקֹרוֹת הַיָּמִים הַבָּאִים לִתְקוּפוֹתֵיהֶם׃",
        "sourcePages": [
          161
        ],
        "textSHA256": "570ec650cc29c61e4e8b8b7101bad30b0cd962d8f23321fba89ea6420cb16d03"
      },
      {
        "verse": 9,
        "text": "וְלָכֵן גָּמַרְתִּי לְקַחְתָּהּ וְלִחְיוֹת עִמָּהּ בְּדַעְתִּי כִּי תִּהְיֶה־לִי יוֹעֲצָה טוֹבָה וְנֶחָמָה בְּדָאָגָה וָעֶצֶב׃",
        "sourcePages": [
          161
        ],
        "textSHA256": "2698fd8f3d12e2a5851743a31b72f4f1a3203162c6f72be8db37ac3e5aa38ed0"
      },
      {
        "verse": 10,
        "text": "בַּעֲבוּרָהּ יִגְדַּל שְׁמִי בָעַמִּים וּכְבוֹד הַצָּעִיר בֵּין יְשִׁישִׁים׃",
        "sourcePages": [
          161
        ],
        "textSHA256": "44039f74b9041d51f206f78ab887dc63283c593c0f79c1ad7ef24f6d1046aeb8"
      },
      {
        "verse": 11,
        "text": "חָרוּץ אֶמָּצֵא בְּמִשְׁפָּט וּבְעֵינֵי נְדִיבִים אֶנָּשֵׂא׃",
        "sourcePages": [
          161
        ],
        "textSHA256": "7a4b02d025329d4f5002c0f35a2c5b82d45427b711ae0443f22921373c170657"
      },
      {
        "verse": 12,
        "text": "בְּהַחֲרִישִׁי יְחַכּוּ לִי וּבִדְבָרַי יַטּוּ אֹזֶן קַשֶּׁבֶת וְאִם אוֹסִיף לְדַבֵּר כַּף לַפֶּה יָשִׂימוּ׃",
        "sourcePages": [
          161
        ],
        "textSHA256": "6381d0004726620f5ac3fe73ebbc4eca5ec575bbb2e9263f2146b43e4159cac5"
      },
      {
        "verse": 13,
        "text": "בִּגְלָלָהּ אִירַשׁ אַל־מָוֶת וְזֵכֶר נֵצַח אַשְׁאִיר לַבָּאִים אַחֲרָי׃",
        "sourcePages": [
          161
        ],
        "textSHA256": "5fdd3c40c3ad3c63e8dd3e3306d43ab39492d7940d83414076d5c2a2af2f1289"
      },
      {
        "verse": 14,
        "text": "אַדְבִּיר עַמִּים תַּחְתִּי וּלְאֻמִּים יִכָּנְעוּ לְפָנָי׃",
        "sourcePages": [
          161
        ],
        "textSHA256": "d11fb2ecdff3ef0009532f4ffd172ece299a9055b258724bd20803109b7fc9f0"
      },
      {
        "verse": 15,
        "text": "עָרִיצִים נוֹרָאִים יִשְׁמְעוּ וְיִרְגְּזוּ מִפָּנָי בִּקְהַל עָם כְּעוֹשֵׂה חֶסֶד אוֹפִיעַ וּבְמִלְחָמָה כְּבַעַל גְּבוּרָה׃",
