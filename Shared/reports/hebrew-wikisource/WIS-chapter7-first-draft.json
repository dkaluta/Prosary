  "draft": {
    "number": 7,
    "verses": [
      {
        "verse": 1,
        "text": "גַּם אָנֹכִי אֱנוֹשׁ בֶּן־תְּמוּתָה כְּכָל־הָאֲנָשִׁים מִצֶּאֱצָאֵי אָדָם הָרִאשׁוֹן יְצוּר הָאֲדָמָה וּבְרֶחֶם אִמִּי לְבָשָׂר עֻצַּבְתִּי׃",
        "sourcePages": [
          157
        ],
        "textSHA256": "fecbd3312d83ee2598bfcb319b854faf3c13f1fc8de88486c2d0dca23d6fd833"
      },
      {
        "verse": 2,
        "text": "בַּעֲשָׂרָה יְרָחִים בְּדָם הָקְפֵּאתִי מִזֶּרַע גֶּבֶר וּמֵחֶמְדַּת הַמִּשְׁכָּב גַּם יַחַד׃",
        "sourcePages": [
          157
        ],
        "textSHA256": "d914a737595f2886c40656b2475ee27b64b5d4437529fa0ed5d366bbde98c078"
      },
      {
        "verse": 3,
        "text": "גַּם אָנֹכִי אַחֲרֵי הוּלְדִי שָׁאַפְתִּי רוּחַ מְשֻׁתָּף [לַכֹּל] וְצָנַחְתִּי לָאָרֶץ קְרוּבַת הָרֶגֶשׁ וְאֶת־קוֹלִי נָשָׂאתִי בִּבְכִי לָרִאשׁוֹנָה כְּדֶרֶךְ כָּל־הַיִּלּוֹדִים]׃",
        "sourcePages": [
          157
        ],
        "textSHA256": "297efc297ca1685a5e224a37eac6a544d082c798dfaf4467ada3a55aae08a216"
      },
      {
        "verse": 4,
        "text": "בְּחִתּוּלִים גָּדַלְתִּי וּבִדְאָגוֹת׃",
        "sourcePages": [
          157
        ],
        "textSHA256": "bed3f0cba363df5ad55f42b7d7cc0d868d2d0ca60c0229bc1559a5d4f04c3c6f"
      },
      {
        "verse": 5,
        "text": "כִּי אֵין כָּל־מֶלֶךְ אֲשֶׁר רֵאשִׁית מוֹצָאוֹ אַחֶרֶת הָיְתָה׃",
        "sourcePages": [
          158
        ],
        "textSHA256": "a4efe2ddeae2e09c6a00c469eda6f8e48b3152db9354044526861df044580cbd"
      },
      {
        "verse": 6,
        "text": "לַכֹּל דֶּרֶךְ אַחַת אֶל־הַחַיִּים וְגַם צֵאתָם [מִן־הַחַיִּים] דּוֹמָה׃",
        "sourcePages": [
          158
        ],
        "textSHA256": "67889558b635f350bbf1f9bc095b166f1e9cdfa01be4273f4e35db7ddfc4adc0"
      },
      {
        "verse": 7,
        "text": "לָכֵן הִתְפַּלַּלְתִּי וְנִתְּנָה־לִי בִינָה קָרָאתִי וְרוּחַ חָכְמָה בָּאָה עָלָי׃",
        "sourcePages": [
          158
        ],
        "textSHA256": "1a04073e71dd89b3800175e86e675c198ef34302e9bfb9b0b5e742c425f9b549"
      },
      {
        "verse": 8,
        "text": "מִשֶּׁבֶט וְכִסֵּא יָקְרָה לִי וְעֹשֶׁר לְאָפֶס חָשַׁבְתִּי לְעֻמָּתָהּ׃",
        "sourcePages": [
          158
        ],
        "textSHA256": "9a5444ff78653fabb83a590156beef56bc31b11cd450de100c6af2b54d8444a4"
      },
      {
        "verse": 9,
        "text": "וְלֹא דִמִּיתִי אֵלֶיהָ אֶבֶן יְקָרָה אֲשֶׁר לֹא תְסֻלֶּה כִּי כָל־זָהָב גַּרְגַּר חוֹל לְנֶגְדָּהּ וְכֶסֶף כְּדֹמֶן יֵחָשֵׁב לְנִכְחָהּ׃",
        "sourcePages": [
          158
        ],
        "textSHA256": "9fb0175913ff9cda2265144bd759361f21d2355af983ca605f33595662441903"
      },
      {
        "verse": 10,
        "text": "מִבְּרִיאוּת וְיֹפִי אֲהַבְתִּיהָ וּלְנֵרִי אֶבְחָרֶהָ כִּי אוֹרָהּ לֹא יִכְבֶּה׃",
        "sourcePages": [
          158
        ],
        "textSHA256": "80a03a822719344127cc008a3aab085b3124e108fe8e0ccc2170bde5d44a9672"
      },
      {
        "verse": 11,
        "text": "אָכֵן כָּל־טוּב בָּא אֵלַי בִּכְנָפֶיהָ וְעֹשֶׁר לֹא יְסֻפַּר בְּיָדֶיהָ׃",
        "sourcePages": [
          158
        ],
        "textSHA256": "e931671a47317ef9859101935c0cab46809dc45a7cff09dcd4e0c465b577e9e8"
      },
      {
        "verse": 12,
        "text": "[בְּכָל־אֵלֶּה] שָׂמַחְתִּי כִּי הַחָכְמָה תַּנְחֵם בְּלִי דַעַת כִּי הִיא [גַּם] מְחוֹלַּלְתָּם׃",
        "sourcePages": [
          158
        ],
        "textSHA256": "743798290fa7c65fb35dc4f914b1bc938b70848f2e73734ce4fc993be5329835"
      },
      {
        "verse": 13,
        "text": "לְלֹא עָרְמָה לָמַדְתִּי אוֹתָהּ וּבְלִי קִנְאָה אֲלַמְּדֶנָּה אֶת־עָשְׁרָהּ לֹא אַעְלִים׃",
        "sourcePages": [
          158
        ],
        "textSHA256": "a288d142bda861c10539631281f5bc9b0ab6d305a2cc8dd823741f92d395b78c"
      },
      {
        "verse": 14,
        "text": "עַד־כִּי הוֹן עָתֵק הִיא לִבְנֵי אָדָם וְכָל־הַמִּתְעַנְּגִים עָלֶיהָ יְדִידוּת יְיָ יַשִּׂיגוּ כִּי בְשִׁי מוּסָר יֵרָצוּ לוֹ׃",
        "sourcePages": [
          158
        ],
        "textSHA256": "c7d491ab6aba8673c7813973faa5c961698b22544844aa1911af8cea65ddcb69"
      },
      {
        "verse": 15,
        "text": "וְלִי יִתֵּן יְיָ לְדַבֵּר כְּהָגוּת לִבִּי וּלְהָבִין כְּיָאוּת אֶת אֲשֶׁר חָנַנִי בוֹ כִּי הוּא גַם מַנְהִיג הַחָכְמָה וְגַם מַדְרִיךְ הַחֲכָמִים׃",
        "sourcePages": [
          158
        ],
        "textSHA256": "07ac4b458eca5cd7b744fbbf8dc09eed67fb988f96c5edf0d65f519ea58d1dd7"
      },
      {
        "verse": 16,
        "text": "אֲשֶׁר־בָּיָדוֹ גַם־אֲנַחְנוּ וְגַם דְּבָרֵינוּ וְכָל־תְּבוּנָה וְדַעַת כָּל־מְלָאכָה׃",
        "sourcePages": [
          158
        ],
        "textSHA256": "35d1f9fbdd1c50390e0b10736d769d445785a81b921be91b47d5caa5385fe09d"
      },
      {
        "verse": 17,
        "text": "כִּי הוּא נָתַן־לִי הַכָּרָה נְכוֹנָה שֶׁל־הַמְּצוּאִים לָדַעַת תְּכוּנַת תֵּבֵל וְכֹחַ הַיְסוֹדוֹת׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "45baceed9533571a47154a8fee37cd41c19887eab6dde6594a5362239ed599fc"
      },
      {
        "verse": 18,
        "text": "רֵאשִׁית הָעִתִּים אַחֲרִיתָן וּמַחֲצִיתָן תְּנוּעוֹת [הַשֶּׁמֶשׁ] לַחֲלִיפוֹתֵיהֶן וּתְמוּרוֹת הַזְּמַנִּים׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "ea37487a0669efeb019ae64756df88a9eb3f16a4930146d9093cd407591738ad"
      },
      {
        "verse": 19,
        "text": "מַחֲזוֹר הַשָּׁנִים וּמִשְׁטַר הַכּוֹכָבִים׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "f80d4a12332464a309b4219daee0e7a486280998f352e18bc4e02a0a18844c87"
      },
      {
        "verse": 20,
        "text": "תְּכוּנוֹת נֶפֶשׁ חַיָּה וַחֲמַת חַיוֹת פֶּרֶא כֹּחַ הָרוּחוֹת וְשִׂיחוֹת אֲנָשִׁים הַצְּמָחִים לְמִינֵיהֶם וּסְגֻלּוֹת הַשָּׁרָשִׁים׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "8c0adc32a7fb95e06401ab878faed660e39d8bd8c7d42ab243ce6f4b7092ad67"
      },
      {
        "verse": 21,
        "text": "הַנִּסְתָּרוֹת וְהַנִּגְלוֹת יָדָעְתִּי כִּי הַחָכְמָה אָמָּנִית הַכֹּל לִמְּדָתְנִי׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "86ae149a5676ae5089c66b9ed3315ba9ec98d420aaac7e41b8e97636d44627be"
      },
      {
        "verse": 22,
        "text": "אֲשֶׁר־בָּהּ רוּחַ מַשְׂכִּיל קָדוֹשׁ יָחִיד בְּמִינוֹ מְרֻבֶּה חֲלָקִים עָדִין קַל הַתְּנוּעָה זַךְ טָהוֹר בָּהִיר שָׁלֵם דּוֹרֵשׁ טוֹב מַעֲמִיק לִרְאוֹת אַמִּיץ פּוֹעֵל חֶסֶד׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "c1a21d56f0ffe931e0e294c4381951f2852b939873d2eaca316615c24b96104d"
      },
      {
        "verse": 23,
        "text": "אוֹהֵב אָדָם אֵיתָן תָּמִים חָפְשִׁי מִדְּאָגָה כֹּל יָכוֹל צוֹפֶה בַכֹּל חוֹדֵר לְכָל־הָרוּחוֹת הַמַּשְׂכִּילִים הַטְּהוֹרִים הָעֲדִינִים׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "43f715e41db98c4b80555b2796a38627de4282dd98960f8087952f42b9e30a3a"
      },
      {
        "verse": 24,
        "text": "כִּי הַחָכְמָה מְמַהֶרֶת לְהִתְנוֹעֵעַ מִכָּל־תְּנוּעָה עוֹבֶרֶת וְחוֹדֶרֶת לַכֹּל בְּטָהֳרָתָהּ׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "ccd3a59c19286be577f2351f2d0aad3aeb268010be8766bc28ed3d16d0eb77ef"
      },
      {
        "verse": 25,
        "text": "כִּי הִיא נְשִׁימָה מִגְּבוּרַת אֱלֹהִים שֶׁפַע זַךְ מִכְּבוֹדוֹ הַמּוֹשֵׁל בַּכֹּל וְלָכֵן כָּל־טֻמְאָה לֹא תִגַּע בָּהּ׃",
        "sourcePages": [
          159
        ],
        "textSHA256": "c2a4f109509672c3b5d84caf0500cf3891c5cdc185f4db8ac57ad09917fb2545"
      },
      {
        "verse": 26,
        "text": "כִּי הִיא נֹגַהּ אוֹר עוֹלָם וּרְאִי טָהוֹר לִפְעֻלַּת אֱלֹהִים וּדְמוּת טוּבוֹ׃",
        "sourcePages": [
          160
        ],
        "textSHA256": "473655c346380c62f438f0f14e4b34f3adb6c67823a8274999c5fd7183de0d20"
      },
      {
        "verse": 27,
        "text": "יְחִידָה הִיא וְתוּכַל הַכֹּל בְּעֵינָהּ תִּשָּׁאֵר וּתְחַדֵּשׁ הַכֹּל וּמִדּוֹר לְדוֹר תַּעֲבֹר וְתָבֹא בִּנְפָשׁוֹת קְדוֹשׁוֹת וְתַעֲשֵׂן לִידִידֵי אֱלֹהִים וְלִנְבִיאִים׃",
        "sourcePages": [
          160
        ],
        "textSHA256": "73a06c542754237bc5c45eaca558fb9236753ee6d6a2805b7b5831b7c35d09be"
      },
      {
        "verse": 28,
        "text": "כִּי אֱלֹהִים לֹא יֶאֱהַב זוּלָתִי אֲשֶׁר־יִשְׁכֹּן בְּמִשְׁכַּן הַחָכְמָה׃",
        "sourcePages": [
          160
        ],
        "textSHA256": "683f6f43a535218d74c50627eb5ccdb2e8c35126da4baea4dee4996fc150de55"
      },
      {
        "verse": 29,
        "text": "הֵן נֶהְדָּרָה הִיא מִן־הַשֶּׁמֶשׁ וְיִתְרוֹן לָהּ מִמַּעֲלַת הַכּוֹכָבִים וּבְעֶרְכָּהּ תַּעֲלֶה עַל [כָּל־]אוֹר׃",
        "sourcePages": [
          160
        ],
        "textSHA256": "df01adb1be141fe1e95f8ffacc69677be74675d922315b3d9897f34cb47e0b74"
      },
      {
        "verse": 30,
        "text": "כִּי אֶת־מְקוֹמוֹ לַיִל יִירַשׁ אוּלָם הָרִשְׁעָה לֹא־תָקוּם בִּפְנֵי הַחָכְמָה׃",
        "sourcePages": [
          160
        ],
        "textSHA256": "b7da30c2c25a67d3e60d2b7150c8f67d4206635e7f85b0b19574c68fa111bc87"
      }
