  "draft": {
    "number": 17,
    "verses": [
      {
        "verse": 1,
        "text": "הֵן גְּדוֹלִים מִשְׁפָּטֶיךָ וְאֵין חֵקֶר לָמוֹ עַל־כֵּן תִּתְעֶינָה נְפָשׁוֹת נִבְעָרוֹת׃",
        "sourcePages": [
          179
        ],
        "textSHA256": "a163134fb0a5385358c9f93ed59d82af1b82e52978bf5a4238e7e416acf516e4"
      },
      {
        "verse": 2,
        "text": "כִּי־רְשָׁעִים חָשְׁבוּ לִרְדּוֹת בְּגוֹי קָדוֹשׁ וַאֲסִירֵי חֹשֶׁךְ וּכְלִיאֵי לַיְלָה אָרֹךְ בְּבָתֵּיהֶם יִשְׁכְּבוּ אֲשֶׁר נִדְּחוּ מֵאֵת הַשְׁגָּחַת נֶצַח׃",
        "sourcePages": [
          179
        ],
        "textSHA256": "72c103ac615d711c92d881c7064e131cee4cc1fafaef4fa4915e44a04f38f479"
      },
      {
        "verse": 3,
        "text": "הֵם אָמְרוּ לְהִסָּתֵר בְּמַחְשְׁכֵּי פִּשְׁעֵיהֶם בְּחֶבְיוֹן הַנְּשִׁיָּה לְלֹא אוֹר וְהִנֵּה נָפֹזְרוּ כִּי־נִבְהָלוּ מְאֹד וּמֵחֲזוֹן שָׁוְא הָחֳרָדוּ׃",
        "sourcePages": [
          179
        ],
        "textSHA256": "3920014591440a12d21f3953a4ea5d86da7bef7fb5214ed483e338985825c8db"
      },
      {
        "verse": 4,
        "text": "גַּם הַמַּחֲבֹא אֲשֶׁר בּוֹ נֶעְצְרוּ לֹא נְצָרָם לָבֶטַח וְקוֹלוֹת מַבְהִילִים הָמוּ סְבִיבָם וּמַחֲזוֹת בַּלָּהוֹת נוֹגִים נִרְאוּ לָמוֹ וּפְנֵיהֶם אֵימָה׃",
        "sourcePages": [
          179
        ],
        "textSHA256": "e5afd8b5c74f4a49412340ce983cef6756bbe7291aba48153c1dca8db2fa5128"
      },
      {
        "verse": 5,
        "text": "וְכָל־אֵשׁ לֹא עָצְרָה כֹחַ לְהָאִיר וְלַהֲבוֹת כּוֹכְבֵי־אוֹר רָפוּ מֵהָגִיהַּ חֶשְׁכַת לֵיל־פְּחָדִים זֶה׃",
        "sourcePages": [
          179,
          180
        ],
        "textSHA256": "150dd6acbdfa3aa3e9f907690fe3ddee0cdfbe93b29e573f78bacc4b95506d1d"
      },
      {
        "verse": 6,
        "text": "אַךְ נִרְאָה לָהֶם מוֹקֵד מְלֹא־אֵימָה אִישׁ לֹא הֶעֱלֵהוּ וְנִבְעֲתוּ מִפְּנֵי הַמַּחֲזֶה הַהוּא מֵעוֹדָם לֹא רָאוּהוּ וַיַּחְשְׁבוּ אֶת־הַמַּרְאֶה לְרָעָה גְדוֹלָה׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "83329f02faba5182c951836e2aaaaf52af2b7d6bd11a62ac133d3059f96afc51"
      },
      {
        "verse": 7,
        "text": "תַּעֲלוּלֵי קְסָמֵיהֶם חָדֵלוּ וּגְאוּת חָכְמָתָם נִגְלְתָה חֶרְפָּתָהּ׃ כִּי הָאֲנָשִׁים אֲשֶׁר הִבְטִיחוּ לְגָרֵשׁ מִנֶּפֶשׁ חוֹלָה בֶּעָתָה וּבֶהָלָה גַּם הֵמָּה חָלוּ מֵאֵימָה נִלְעָגָה׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "b466d29fe434cda3c3b78687951806349ad8d9c0d57088b499ccdf04c470a30d",
        "endVerse": 8
      },
      {
        "verse": 9,
        "text": "גַּם בְּאֵין־מַחֲזֵה אֵימִים מַבְעִיתָם מֵזוֹחֵל רְמָשִׂים וּמִלַּחַשׁ נְחָשִׁים חָרְדוּ׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "daa64cd657b392d19b547b0f76ffc60066a5e4e8a2d105def12d47974a4cd28c"
      },
      {
        "verse": 10,
        "text": "וַיִּגְוְעוּ מִפַּחַד וַיְמָאֲנוּ לְהַבִּיט בְּחֹשֶׁךְ אֵין מִפְלָט מִמֶּנּוּ׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "b1f69b7956838353ee9fd499a2d113c05f45ccd08fd69868fccc106d6d94857d"
      },
      {
        "verse": 11,
        "text": "כִּי־הָרִשְׁעָה מוּגַת לֵב מִתְּכוּנָתָהּ וּפִיהָ יָעִיד עָלֶיהָ לְהַרְשִׁיעָהּ וְיַעַן אֲשֶׁר מוּסַר כִּלְיוֹתֶיהָ יְצִיקֶנָּה צָרוֹתֶיהָ תָּמִיד מֵרֹאשׁ תֶּחֱזֶה׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "294ced200948dcca439178f9da64c1494a56dcd5e2b6eec5f369658599e5f27d"
      },
      {
        "verse": 12,
        "text": "הֲלֹא אֵין הַפַּחַד כִּי אִם־הֵאָשׁ מִתַּחְבּוּלוֹת הַמַּחְשָׁבָה׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "85ba5cbf225220b89c64982935c3f1ff8bfbd83b297e627aa9eaed1b04a67117"
      },
      {
        "verse": 13,
        "text": "וְאִם יִקְטַן הַבִּטָּחוֹן בְּלֵב הָאָדָם מְבוּכָתוֹ תֵּחָשֵׁב לְרָעָה גְּדוֹלָה מִן־הַסִּבָּה אֲשֶׁר הִיא שֹׁרֶשׁ הַצָּרָה׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "ebb992b04527018a2b624d28190c167e9f56628d1554062fa63999d7e6c4bb55"
      },
      {
        "verse": 14,
        "text": "וְכָל־הָאֲנָשִׁים יָשְׁנוּ אֶת־שְׁנָתָם בַּלַּיְלָה חֲדַל־אוֹנִים מֵאֵין כָּמוֹהוּ אֲשֶׁר יָצָא מִיַּרְכְּתֵי שְׁאוֹל אֵין־אוֹנִים׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "1a08b78c59a451e411778d572c59dda1eda763256f5c54d78db72802bcfefc22"
      },
      {
        "verse": 15,
        "text": "אֵלֶּה שׁוֹטְטוּ אָנָה וָאָנָה מֵאֵימַת הַבַּלָּהוֹת וְאֵלֶּה חַתּוּ בְּהֵאָשׁ נַפְשָׁם מִתִּקְוָה כִּי פַחַד פִּתְאֹם וְשׁוֹאָה בָּאוּ עֲלֵיהֶם׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "3caf9551222da34ccb682f92fc869deb008cef96b87400f273b2e4272fc5f731"
      },
      {
        "verse": 16,
        "text": "אַחֲרֵי־כֵן נָפַל כָּל־אִישׁ וָאִישׁ אַרְצָה בַּאֲשֶׁר הוּא־שָׁם וְנֶעֱצַר כֶּאָסוּר בְּמַאֲסַר אֵין־בַּרְזֶל׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "0d3a543c03fa951a5a74ca9c6803c089b1d1f0029880c0ed6336a752e32395bc"
      },
      {
        "verse": 17,
        "text": "כְּעוֹבֵד הָאֲדָמָה כְּרוֹעֶה כְּפוֹעֵל הַיָּגֵעַ בָּדָד בַּעֲמָלוֹ כֻּלָּם נִפְגָּעוּ וַיִּסְבְּלוּ צָרָה קָשָׁה אֵין מָנוֹס מִמֶּנָּה׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "7fbeb9320356e1354024fb28790ab4b00b644e86671fb974d59165246cf956a0"
      },
      {
        "verse": 18,
        "text": "כִּי כֻּלָּם כְּאֶחָד בְּחַבְלֵי חֹשֶׁךְ נֶאֱסָרוּ וְרוּחַ שׁוֹרֵק אוֹ־קוֹל צִפֳּרִים עָרֵב סְבִיבוֹת עֲפָאִים עֲבֻתִּים אוֹ הֶמְיַת מַיִם שׁוֹטְפִים בֶּלַע אוֹ־שָׁאוֹן אָיֹם בְּהַעְתֵּק צוּרִים מִמְּקוֹמָם׃",
        "sourcePages": [
          180
        ],
        "textSHA256": "3ebdd6a40933e4b0b0d699b1974e8ff363e6a3c23b350fec0e18dbc6686d2c8a"
      },
      {
        "verse": 19,
        "text": "אוֹ מְרוּצַת חַיוֹת מְדַלְּגוֹת נֶעֱלָמָה מֵעַיִן אוֹ־קוֹל נַהֲמַת חַיּוֹת נוֹרָאוֹת אוֹ־הֵד הָרִים פּוֹרֵץ מִמַּעֲמַקִּים הַפְחִידוּם וְהֶחֱרִידוּם׃",
        "sourcePages": [
          180,
          181
        ],
        "textSHA256": "57c49b880871b32773fbbe2b99cd66d8bdc38721c39b19fa8857b19120c5920c"
      },
      {
        "verse": 20,
        "text": "כִּי עַל־כָּל־כָּל־הָעוֹלָם זָרַח אוֹר זָרוּעַ וַיִּשְׁקֹד [אִישׁ] עַל־מַעֲשָׂיו וְאֵין מַפְרִיעַ׃",
        "sourcePages": [
          181
        ],
        "textSHA256": "69413a9436d30d2b937133d35cc137f5dd5a720413e85e26223dfc514c401e77"
      },
