        "textSHA256": "4d9a35f04340a04ad9304f655a62eb2fd0f2026e292cac438464fb67709b65fe"
      },
      {
        "verse": 17,
        "text": "בִּהְיוֹתוֹ בֶּן־תְּמוּתָה יַעֲשֶׂה [אֱלִיל] מֵת בְּכֹחַ רֶשַׁע הֲלֹא טוֹב הוּא מֵאֲשֶׁר יַעֲרִיץ כִּי הוּא חַי וְהֵמָּה לֹא [יִחְיוּ] לָעַד׃",
        "sourcePages": [
          176
        ],
        "textSHA256": "022fd302bf86708f4c790e100093f4add0bd8fb0faab5fe4b9e496d8187bf7b3"
      },
      {
        "verse": 18,
        "text": "גַּם־יִשְׁתַּחֲווּ לַחַיּוֹת הַנְּבָזוֹת מִכֻּלָּן וְאֵין בֵּין כָּל־הָאֲחֵרוֹת משְׁלָן לְבַעֲרוּת׃",
        "sourcePages": [
          176
        ],
        "textSHA256": "4ffe531beaa1eedcb0b98ef80a1ca6f5fca7cb78a939dc0d1bca216ccaaab0d1",
        "sourceNotes": [
          {
            "id": "wis-15-18-mem-1-vowel",
            "kind": "unreadablePoint",
            "anchor": "משְׁלָן",
            "occurrence": 1,
            "letterIndex": 1,
            "mark": "vowel",
            "sourcePages": [
              176
            ],
            "sourceURL": "https://upload.wikimedia.org/wikisource/he/e/ed/Apocrypha_Kahana_A2.pdf#page=176"
          }
        ]
      },
      {
        "verse": 19,
        "text": "גַּם חַסְרוֹת יֹפִי הֵן וְאֵין בָּהֶן חֵפֶץ כַּאֲשֶׁר בְּמַרְאֵה הַחַיּוֹת אָכֵן רָחקוּ מִתְּהִלַּת יְיָ וּמִבִּרְכָתוֹ׃",
        "sourcePages": [
          176
        ],
        "textSHA256": "bb46a72dbf796596d402d4f22d48bd5ef6b2bf7aa18792e8042753b3b6767a1f",
