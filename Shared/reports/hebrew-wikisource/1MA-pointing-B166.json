  "onlineScaffoldBefore": [
    {
      "verse": 35,
      "text": "וישלח אליו דמיטריוס המלך כדברים האלה ויענהו ויכתוב לו את האיגרת הזאת:",
      "sourcePages": [],
      "textSHA256": "684ab84574614e88c2542f8062ffaf61f45209d5baa53ade5b851057d261b6e0"
    },
    {
      "verse": 36,
      "text": "המלך דמיטריוס לשמעון הכהן הגדול ואוהב מלכים ולזקנים ולעם היהודים שלום:",
      "sourcePages": [],
      "textSHA256": "79a0f11047016672b6d44459d73092d2310b742a80ecd1b39dc5612922c77c7c"
    },
    {
      "verse": 37,
      "text": "את עטרת הזהב וענף התמר אשר שלחתם קבלנו ונכונים אנחנו לעשות לכם שלום רב ולכתוב לאשר על המסים לעשות לכם הנחות:",
      "sourcePages": [],
      "textSHA256": "aa40953adfd0818db0ee6b0b6108763abdaf08f1ce90ef1a0eaea52b437f5aa8"
    },
    {
      "verse": 38,
      "text": "ואשר קיימנו לכם קיים והמבצרים אשר בניתם לכם יהיו:",
      "sourcePages": [],
      "textSHA256": "d9799fc34bd1af0e9f51f7c92691c4149cf1cd3e102dcba9e49a283a01650cac"
    },
    {
      "verse": 39,
      "text": "ואנחנו נשא את שגיאותיכם ואת פשעיכם עד היום הזה ומס הכתר שאתם חייבים ואם שולמו מסים אחרים בירושלים לא ישולמו עוד:",
      "sourcePages": [],
      "textSHA256": "1453433bd46a7ecef3fd6159681e63841e28fc7d9301b37bcbdd4afd8a1e6b0c"
    },
    {
      "verse": 40,
      "text": "ואם יש בכם ראויים להיכתב בין האנשים אשר אתנו יכתבו והיה בנינו שלום:",
      "sourcePages": [],
      "textSHA256": "d1ad731e22cec771566a18a9a06b9e0974f6c5082bf3b03e9530389fe3dcbcec"
    },
    {
      "verse": 41,
      "text": "בשנת שבעים ומאה הוסר עול הגויים מישראל:",
      "sourcePages": [],
      "textSHA256": "96aaf0437c4c4ddeebe5c60e89b898330a68038007caca6b7fcb426e9e3ffc3c"
    },
    {
      "verse": 42,
      "text": "ויחל עם ישראל לכתוב בספרים ובשטרות בשנת אחת לשמעון הכהן הגדול ושר צבא ונשיא היהודים:",
      "sourcePages": [],
      "textSHA256": "5da1a0398db98209ab01e719f56e9a58d0bc60f1f4adcbff2a5080230d51f30a"
    },
    {
      "verse": 43,
      "text": "בימים ההם חנה [שמעון] על גזר ויסב אותה במחנות ויעש מלכודת עיר ויקריבה לעיר ויך מגדל אחד ויכבשהו:",
      "sourcePages": [],
      "textSHA256": "0023939d658af0526ad01c6a61a6d88f95024459e476ac19850e73145a6ea8ed"
    }
  ],
  "firstPointedDraftRows": [
