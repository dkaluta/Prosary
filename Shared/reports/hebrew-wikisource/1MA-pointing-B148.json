  "onlineScaffoldBefore": [
    {
      "verse": 31,
      "text": "וירושלים תהיה קדושה וחפשיה וגבולה מן המעשרות ומסים:",
      "sourcePages": [],
      "textSHA256": "9283f4651de875a605cb1a895ba0f70bacdced71146c5fb2a26bb49cdf1b7c53"
    },
    {
      "verse": 32,
      "text": "אני מניח גם את תוקף המצודה אשר בירושלים ונותן לכהן הגדול למען ישים בה אנשים אשר יבחר בהם לשמרה:",
      "sourcePages": [],
      "textSHA256": "0c3b581551e1051ae477b612195ff93ac7c151dbf5987bce7a3a8d1154acfc31"
    },
    {
      "verse": 33,
      "text": "וכל נפש היהודים אשר הובלה בשבי מארץ יהודה לכל מלכותי אני משלח חפשי חינם וכולם יניחו את מסיהם וממקניהם:",
      "sourcePages": [],
      "textSHA256": "59317e25e8f94c60c80054b596b2a96c23284588fc1b096063472c9e045e0d3e"
    },
    {
      "verse": 34,
      "text": "וכל החגים והשבתות וראשי החודשים וימי המועדים ושלושה ימים לפני החג ושלושה ימים אחר החג יהיו כולם ימי חופש והנחה לכל היהודים אשר במלכותי:",
      "sourcePages": [],
      "textSHA256": "504db435a46cf8d3fad93785d4c0114ff49a5df603d0505ff8dedde39b69e6cf"
    },
    {
      "verse": 35,
      "text": "ולא יהיה כוח לאיש לנגוש ולאלץ איש מהם לכל דבר:",
      "sourcePages": [],
      "textSHA256": "e4b7278363880b91f1105b9800658e032e10955602fe227a1985fa0c7f2e7525"
    },
    {
      "verse": 36,
      "text": "וכתבו מן היהודים בחיל המלך כשלושים אלף איש וניתן להם שכר כאשר יגיע לכל חיל המלך:",
      "sourcePages": [],
      "textSHA256": "a71c4b440271fea4f7343aff67b48ec44d242d3b44ee721053ecbf7c6e82cc41"
    },
    {
      "verse": 37,
      "text": "והועמדו מהם במבצרי המלך הגדולים ומהם יועמדו על צרכי המלכות אשר לאמונה ואשר עליהם והראשים מהם יהיו והלכו בחוקותיהם וכאשר ציווה המלך בארץ יהודה:",
      "sourcePages": [],
      "textSHA256": "a085e399d61507f4e2decebc792f2b3334564ac8a0dd5c2ae4bb28b8bf36e166"
    }
  ],
  "checkedUnits": [
    {
      "chapter": 10,
      "verse": 31,
      "text": "וִירוּשָׁלִַם תִּהְיֶה קְדוֹשָׁה וְחָפְשִׁיָּה וּגְבוּלָהּ [מִן־]הַמַּעַשְׂרוֹת וְהַמִּסִּים׃",
      "sourcePages": [
        148
      ],
      "textSHA256": "d3c4954dd9749d501424fce11733899a7dfe32b996f51510b486bc9afd116f4a"
    },
    {
      "chapter": 10,
      "verse": 32,
      "text": "אֲנִי מַנִּיחַ גַּם אֶת־תֹּקֶף הַמְּצוּדָה אֲשֶׁר בִּירוּשָׁלִָם וְנוֹתֵן לַכֹּהֵן הַגָּדוֹל לְמַעַן יָשִׂים בָּהּ אֲנָשִׁים אֲשֶׁר יִבְחַר בָּהֶם לְשָׁמְרָהּ׃",
      "sourcePages": [
        148
      ],
      "textSHA256": "49a3ef77fd4fa1e227e88ca6b2465bde9e3bbe30ea022aedbfa0503102ae05be"
    },
    {
      "chapter": 10,
      "verse": 33,
      "text": "וְכָל־נֶפֶשׁ הַיְּהוּדִים אֲשֶׁר־הוּבְלָה בַשֶּׁבִי מֵאֶרֶץ יְהוּדָה לְכָל־מַלְכוּתִי אֲנִי מְשַׁלַּח חָפְשִׁי חִנָּם וְכֻלָּם יַנִּיחוּ אֶת־מִסֵּיהֶם וּמִמִּקְנֵיהֶם׃",
      "sourcePages": [
        148
      ],
      "textSHA256": "c551cfcd8864edca18ac06313a880ead822c28ebc05cf8815d745ba3e1ab034d"
    },
    {
      "chapter": 10,
      "verse": 34,
      "text": "וְכָל־הַחַגִּים וְהַשַּׁבָּתוֹת וְרָאשֵׁי הֶחֳדָשִׁים וִימֵי הַמּוֹעֲדִים וּשְׁלֹשָׁה יָמִים לִפְנֵי הַחַג וּשְׁלֹשָׁה יָמִים אַחַר הַחַג יִהְיוּ כֻלָּם יְמֵי־חֹפֶשׁ וַהֲנָחָה לְכָל־הַיְּהוּדִים אֲשֶׁר בְּמַלְכוּתִי׃",
      "sourcePages": [
        148
      ],
      "textSHA256": "252e8b9c9871b72f1377dbad0f536a474bc33d894921fba510a8c3178a9fd771"
    },
    {
      "chapter": 10,
      "verse": 35,
      "text": "וְלֹא יִהְיֶה כֹחַ לְאִישׁ לִנְגֹשׁ וּלְאַלֵּץ אִישׁ מֵהֶם לְכָל־דָּבָר׃",
      "sourcePages": [
        148
      ],
      "textSHA256": "4a8c4244498cc80ef8fa721ef15efce6aee2d53b21ae08455e00359f23cf1fa2"
    },
    {
      "chapter": 10,
      "verse": 36,
      "text": "וְכָתְבוּ מִן־הַיְּהוּדִים בְּחֵיל־הַמֶּלֶךְ כִּשְׁלֹשִׁים אֶלֶף אִישׁ וְנִתַּן לָהֶם שָׂכָר כַּאֲשֶׁר יַגִּיעַ לְכָל־חֵיל־הַמֶּלֶךְ׃",
      "sourcePages": [
        148
      ],
      "textSHA256": "d15f0a85a4c64c3309bc06d4e73efd82f7af7b2717cf10b30621f694834d92ab"
    },
    {
      "chapter": 10,
      "verse": 37,
      "text": "וְהָעמְדוּ מֵהֶם בְּמִבְצְרֵי הַמֶּלֶךְ הַגְּדוֹלִים וּמֵהֶם יָעַמְדוּ עַל־צָרְכֵי הַמַּלְכוּת אֲשֶׁר לָאֱמוּנָה וַאֲשֶׁר עֲלֵיהֶם וְהָרָאשִׁים מֵהֶם יִהְיוּ וְהָלְכוּ בְּחֻקּוֹתֵיהֶם וְכַאֲשֶׁר צִוָּה הַמֶּלֶךְ בְּאֶרֶץ יְהוּדָה׃",
      "sourcePages": [
        148,
        149
      ],
