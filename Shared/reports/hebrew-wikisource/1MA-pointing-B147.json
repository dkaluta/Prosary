  "onlineScaffoldBefore": [
    {
      "verse": 21,
      "text": "וילבש יונתן את מעיל הקודש בחודש השביעי בשנת ששים ומאה בחג הסוכות ויאסוף חיל ויכן נשק רב:",
      "sourcePages": [],
      "textSHA256": "2fd9ee93b2360fce10f5152f334b1adbc672d8101026ac1501dd98160bced6fc"
    },
    {
      "verse": 22,
      "text": "וישמע דמיטריוס את הדברים האלה ויעצב מאוד ויאמר: מה זאת עשינו כי הקדימנו אלכסנדר להקים אהבה עם היהודים להתחזק:",
      "sourcePages": [],
      "textSHA256": "d92cf75f6f039d634f55aa69255b64ff043eec130c40c37a2a2155de52c3527c"
    },
    {
      "verse": 23,
      "text": "אכתוב גם אני אליהם דברי תנחומים וגדולות ומתנות למען יהיו אתי לעזר:",
      "sourcePages": [],
      "textSHA256": "2b99ec99020d12260cdbe49f4d81b7fc2a1c3a7f12e61eba8d6b2562d1a280c6"
    },
    {
      "verse": 24,
      "text": "וישלח אליהם כדברים האלה:",
      "sourcePages": [],
      "textSHA256": "68381cb33c1dee2068e57f935b2ddbef4cda72670308e1e7d06f459b5b64fd4c"
    },
    {
      "verse": 25,
      "text": "המלך דמיטריוס לעם היהודים שלום:",
      "sourcePages": [],
      "textSHA256": "2456e47bc0d3fbaf41a07f6f09271d51a7f7aba7b6b7de57d73eae88a91a98cf"
    },
    {
      "verse": 26,
      "text": "את אשר שמרתם אתנו את בריתותיכם ותישארו באהבתנו ולא התחברתם לאויבינו שמענו ושמחנו",
      "sourcePages": [],
      "textSHA256": "33ae9651b9492b6013c467bc85bdf7215bf27d2f193fd53085c15d3f43cf9bad"
    },
    {
      "verse": 27,
      "text": "ועתה הישארו עוד לשמור אלינו אמונה וגמלנו לכם טובות חלף הטובות אשר תעשו איתנו:",
      "sourcePages": [],
      "textSHA256": "aab30df826f3981403e1e1e4b8099803ab9727613421a637b254d39d20939731"
    },
    {
      "verse": 28,
      "text": "והנחות רבות נעשה לכם ונתנו לכם מתנות:",
      "sourcePages": [],
      "textSHA256": "a88de0e1c12b8b6e465aa5168b08b5f99954d3e7ab6ef44580a0082d84490cba"
    },
    {
      "verse": 29,
      "text": "ועתה אני מתיר אתכם ושומט לכל היהודים מן המסים וערך המלח וממסי הכתר:",
      "sourcePages": [],
      "textSHA256": "3f7b53ad69fa2e837768066781eebe51d4fda1b50b07fb9ee1573284e1591ac9"
    },
    {
      "verse": 30,
      "text": "ושלישית הזרע וחצי פרי העץ אשר ייפול לי לקחת אני מניח מן היום והלאה לקחת מארץ יהודה ומשלושת הגלילות אשר חוברו אליה מן השומרון והגליל למן היום הזה ועד עולם:",
      "sourcePages": [],
      "textSHA256": "a3ee4bb9c02a40f134afd579228010543c173343cfb0ea7eecd21c194e0ef4df"
    }
  ],
  "checkedUnits": [
    {
      "chapter": 10,
      "verse": 21,
      "text": "וַיִּלְבַּשׁ יוֹנָתָן אֶת־מְעִיל־קֹדֶשׁ בַּחֹדֶשׁ הַשְּׁבִיעִי בִּשְׁנַת שִׁשִּׁים וּמֵאָה בְּחַג הַסֻּכּוֹת וַיֶּאֱסֹף־חַיִל וַיָּכֶן נֶשֶׁק רַב׃",
      "sourcePages": [
        147
      ],
      "textSHA256": "b495a3aeb171f41c13a6a986fc5d003895c86fd29015754f6f5e47c9d861607e"
    },
    {
      "chapter": 10,
      "verse": 22,
      "text": "וַיִּשְׁמַע דְמִטְרִיוֹס אֶת־הַדְּבָרִים הָאֵלֶּה וַיִּתְעַצֵּב וַיֹּאמֶר׃ מָה־זֹאת עָשִׂינוּ כִּי הִקְדִּימָנוּ אֶלֶכְּסַנְדַּר לְהָקִים אַהֲבָה עִם־הַיְּהוּדִים לְהִתְחַזֵּק׃",
      "sourcePages": [
        147
      ],
      "textSHA256": "b9dfc05632a4e48c4d979e319ceac825080429b099d2ef3d35b566fb04e0b4c1"
    },
    {
      "chapter": 10,
      "verse": 23,
      "text": "אֶכְתֹּב גַּם־אֲנִי אֲלֵיהֶם דִּבְרֵי תַנְחוּמִים וּגְדוּלוֹת וּמַתָּנוֹת לְמַעַן יִהְיוּ אִתִּי לְעֵזֶר׃",
      "sourcePages": [
        147
      ],
      "textSHA256": "f6129170064ef0bd9d0b9d1b144ca3640b0f720e72e06cb56bfc64b4aa507fda"
    },
    {
      "chapter": 10,
      "verse": 24,
      "text": "וַיִּשְׁלַח אֲלֵיהֶם כַּדְּבָרִים הָאֵלֶּה׃",
      "sourcePages": [
        147
      ],
      "textSHA256": "7fd2458c0a5685f790a1a46826cae71c268fe51540d60e957b62d032d1634403"
    },
    {
      "chapter": 10,
      "verse": 25,
      "text": "הַמֶּלֶךְ דְמִטְרִיוֹס לְעַם־הַיְּהוּדִים שָׁלוֹם׃ אֵת אֲשֶׁר־שְׁמַרְתֶּם אִתָּנוּ אֶת־בְּרִיתוֹתֵיכֶם וַתִּשָּׁאֲרוּ בְּאַהֲבָתֵנוּ וְלֹא הִתְחַבַּרְתֶּם לְאוֹיְבֵינוּ שָׁמַעְנוּ וְשָׂמָחְנוּ׃",
      "sourcePages": [
        147
      ],
      "textSHA256": "e2a2ed76c64cb46af2865a82fa1346e7f83e2d2dde368b8aec18723da64ba339",
      "endVerse": 26
    },
    {
      "chapter": 10,
      "verse": 27,
      "text": "וְעַתָּה הִשָּׁאֲרוּ עוֹד לִשְׁמֹר אֵלֵינוּ אֱמוּנָה וְגָמַלְנוּ לָכֶם טוֹבוֹת חֶלֶף הַטּוֹבוֹת אֲשֶׁר תַּעֲשׂוּ אִתָּנוּ׃",
      "sourcePages": [
        147
      ],
      "textSHA256": "128668c82b4474d9e26460d201a49c6a52180d048c67787afad59dacd92eb974"
    },
    {
      "chapter": 10,
      "verse": 28,
      "text": "וְהַנָּחוֹת רַבּוֹת נַעֲשֶׂה לָכֶם וְנָתַנּוּ לָכֶם מַתָּנוֹת׃",
      "sourcePages": [
        147
      ],
      "textSHA256": "2e514fc3787ad56981f363efd7922112879cbcec78fae148a145a9c5e990df98"
    },
    {
      "chapter": 10,
      "verse": 29,
      "text": "וְעַתָּה אֲנִי מַתִּיר אֶתְכֶם וְשׁוֹמֵט לְכָל־הַיְּהוּדִים מִן־הַמִּסִּים וְעֵרֶךְ־הַמֶּלַח וּמִמִּסֵי הַכֶּתֶר׃",
      "sourcePages": [
        147
      ],
      "textSHA256": "1e0578e8af7caf39a741b7cd60dbab1ab703ac4bf0677e25253f2f4c2859d74b"
    },
    {
      "chapter": 10,
      "verse": 30,
      "text": "וּשְׁלִישִׁית הַזֶּרַע וַחֲצִי פְּרִי־הָעֵץ אֲשֶׁר יִפָּל־לִי לָקַחַת אֲנִי מַנִּיחַ מִן־הַיּוֹם וָהָלְאָה לָקַחַת מֵאֶרֶץ יְהוּדָה וּמִשְּׁלֹשֶׁת הַגְּלִילוֹת אֲשֶׁר־חֻבְּרוּ אֵלֶיהָ מִן־הַשֹּׁמְרוֹן וְהַגָּלִיל לְמִן־הַיּוֹם הַזֶּה וְעַד עוֹלָם׃",
      "sourcePages": [
        147,
        148
      ],
      "textSHA256": "22e314e1d90a4398220eea2db2ef15d68faedfd0a0b9fba4d160cba44cf741a8"
    }
