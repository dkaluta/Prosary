  "onlineScaffoldBefore": [
    {
      "verse": 2,
      "text": "וישמע דמיטריוס המלך ויאסוף חיל גדול מאוד ויצא לקראתו למלחמה:",
      "sourcePages": [],
      "textSHA256": "2d362ebeed5a7cc4afa9ea632e8320469163e3150aabf1ff175fa279cbb53476"
    },
    {
      "verse": 3,
      "text": "וישלח דמיטריוס אל יונתן ספרים בדברים שלום לגדל אותו:",
      "sourcePages": [],
      "textSHA256": "e25cb5006e1fc84cd572ba10c82a65a91c27b66f7f06843f4799ff860761c8fb"
    },
    {
      "verse": 4,
      "text": "כי אמר נקדים לעשות שלום אתו בטרם יעשוהו עם אלכסנדר נגדנו:",
      "sourcePages": [],
      "textSHA256": "d029df1f380038009ad398d9da5c9b352fd98b37a1fb8c208dd1ee69ae2663f8"
    },
    {
      "verse": 5,
      "text": "כי יזכור את כל הרעות שעשינו לו לאחיו ולעם:",
      "sourcePages": [],
      "textSHA256": "c3a9c1dd82cf00a9ef1f001129c49f320c3700ca2f5cd456281e6ade217788db"
    },
    {
      "verse": 6,
      "text": "ויתן לו תוקף לאסוף חיל ולכין נשק ולהיות בן בריתו ואת בני התערובות אשר במצודה אשר להשיב לו:",
      "sourcePages": [],
      "textSHA256": "52afdf28ee680e4e9fadb33f3ac58b9dd6711b0851c9bd34f3fe33c9d55f7bc2"
    },
    {
      "verse": 7,
      "text": "ויבוא יונתן ירושלים ויקרא את הספרים באזני כל העם והאנשים מן המצודה:",
      "sourcePages": [],
      "textSHA256": "938613380f7986e94a98592b402a7cf11d38f9cf5503c10263ff5f90a87ad3fc"
    },
    {
      "verse": 8,
      "text": "וייראו יראה גדולה כי שמעו כי נתן לו המלך תוקף לאסוף חיל:",
      "sourcePages": [],
      "textSHA256": "741c3a77f62bcab2ed47dc5fc364d3bfbb75601721df87caa836235fc55991b8"
    },
    {
      "verse": 9,
      "text": "וישיבו האנשים מן המצודה ליונתן את בני התערובות וימסרם להוריהם:",
      "sourcePages": [],
      "textSHA256": "9c59c39d8f047d9bd310c7ef38956043653493b37207b90dc79fe054c247d4c3"
    },
    {
      "verse": 10,
      "text": "וישב יונתן בירושלים ויחל לבנות ולחדש את העיר:",
      "sourcePages": [],
      "textSHA256": "d4f5b69a47c942efb221714494a87d0097f38e1b19e2f015048dad513c85cadf"
    },
    {
      "verse": 11,
      "text": "ויאמר לעושי המלאכת לבנות החומות והר ציון מסביב אבני מחצב למבצר ויעשו כן:",
      "sourcePages": [],
      "textSHA256": "59c6615e62933a7bdea26b31646bffacccf193fb13ac5144c5d9c36a817b1df9"
    },
    {
      "verse": 12,
      "text": "ויברחו הנכרים אשר היו במבצרים אשר בנה בקחידס:",
      "sourcePages": [],
      "textSHA256": "6af0556a7826934c30f50446088bc3f57bed46bbab4d5abed844dd7c47071c31"
    },
    {
      "verse": 13,
      "text": "וינח כל איש את מקומות וילך אל ארצו:",
      "sourcePages": [],
      "textSHA256": "fe8a89a0a0e722d9d9cd94ef7338ca710fc83c3d50f8de954659bfbb06fd0081"
    },
    {
      "verse": 14,
      "text": "רק בבית צור נשארו אחדים מן העוזבים את התורה ואת המצוות כי הייתה [להם] למנוס:",
      "sourcePages": [],
      "textSHA256": "430952827faa817941595bd2c3a3876ec4aef2f64bba5a60a4f5c51399a8c06a"
    },
    {
      "verse": 15,
      "text": "וישמע אלכסנדר המלך את כל הדברים אשר שלח דמיטריוס ליונתן ויספרו לו את המלחמות ואת הגבורות אשר עשה הוא ואחיו ואת התלאות אשר מצאום:",
      "sourcePages": [],
      "textSHA256": "7ea67a146dfd4887eae83505501cec45c6e36751b76bda709266f2e1e07025ac"
    },
    {
      "verse": 16,
      "text": "ויאמר הנמצא כזה גבר אחד ועתה נשימה אותו אוהב ובן בריתנו:",
      "sourcePages": [],
      "textSHA256": "8bfe1e1838c4c4ae6915424bd34400628c04e80c79f0e990afe7cb80565281f1"
    },
    {
      "verse": 17,
      "text": "ויכתוב ספרים וישלח אליו כדברים האלה לאמור:",
      "sourcePages": [],
      "textSHA256": "d3f10bf649e52a8db928d5927ac98289b26cf24b62b390b14534b491c2611310"
    },
    {
      "verse": 18,
      "text": "המלך אלכסנדר לאחיו יונתן שלום:",
      "sourcePages": [],
      "textSHA256": "a5d75b44cb27b018b30c141bbe9cf06f114cb17f1d8ee0f3e73fb58fcbdd55a0"
    },
    {
      "verse": 19,
      "text": "שמענו עליך כי איש גיבור חיל אתה ונאה לך להיות אוהבנו:",
      "sourcePages": [],
      "textSHA256": "23f741a99bee58a0198452ad9a50f601c422fd5cac33b6ab5e07c0a7f80f5723"
    },
    {
      "verse": 20,
      "text": "ועתה העמדנוך היום לכהן גדול לעמך ואוהב המלך תִקרֵא ׀ וישלח אליו ארגמן ועטרת זהב ׀ ולהשכיל באשר לנו ולשמור אהבה אלינו:",
      "sourcePages": [],
      "textSHA256": "1d032d48a590f3706192994e0eb0b0fa44172d20d813fa6f37be91784e55ab7c"
    }
  ],
  "checkedUnits": [
    {
      "chapter": 10,
      "verse": 2,
      "text": "וַיִּשְׁמַע דְמִטְרִיוֹס הַמֶּלֶךְ וַיֶּאֱסֹף חַיִל רַב מְאֹד וַיֵּצֵא לִקְרָאתוֹ לַמִּלְחָמָה׃",
      "sourcePages": [
        146
      ],
      "textSHA256": "ca95deefe35497f482e5bd075815f1fb87a3ae00c50af971ef8ae970900bb758"
    },
    {
      "chapter": 10,
      "verse": 3,
      "text": "וַיִּשְׁלַח דְמִטְרִיוֹס אֶל־יוֹנָתָן סְפָרִים בְּדִבְרֵי שָׁלוֹם לְגַדֵּל אוֹתוֹ׃",
      "sourcePages": [
        146
      ],
      "textSHA256": "3c1ff02b03dfb647ba36f7e5218706001f3f882d75cbf1f73b32fbfe1c7557e1"
    },
    {
      "chapter": 10,
      "verse": 4,
      "text": "כִּי אָמַר נַקְדִּים לַעֲשׂוֹת שָׁלוֹם אִתּוֹ בְּטֶרֶם יַעֲשׂוּהוּ עִם־אֶלֶכְּסַנְדַּר נֶגְדֵּנוּ׃",
      "sourcePages": [
        146
      ],
      "textSHA256": "584ab24915fc2d2bb335cf949d1f29020c8314c9388c59e758c0f17d08e2c28b"
    },
    {
      "chapter": 10,
      "verse": 5,
      "text": "כִּי יִזְכֹּר אֶת כָּל־הָרָעוֹת שֶׁעָשִׂינוּ לוֹ וּלְאֶחָיו וְלָעָם׃",
      "sourcePages": [
        146
      ],
      "textSHA256": "00744a7cb192b1d6a220124525a9b8e78dc01928d3fad5be7c6e7501b314b7d3"
    },
    {
      "chapter": 10,
      "verse": 6,
      "text": "וַיִּתֶּן־לוֹ תֹּקֶף לֶאֱסֹף־חַיִל וּלְהָכִין נֶשֶׁק וְלִהְיוֹת בֶּן־בְּרִיתוֹ וְאֶת־בְּנֵי־הַתַּעֲרוּבוֹת אֲשֶׁר בַּמְּצוּדָה אָמַר לְהָשִׁיב לוֹ׃",
      "sourcePages": [
        146
      ],
      "textSHA256": "803415da7bae6f28cba066def3c6e96239d4704e02b8c09412ceb80282bfdab8"
    },
    {
      "chapter": 10,
      "verse": 7,
      "text": "וַיָּבֹא יוֹנָתָן יְרוּשָׁלִָם וַיִּקְרָא אֶת־הַסְּפָרִים בְּאָזְנֵי כָּל־הָעָם וְהָאֲנָשִׁים מִן־הַמְּצוּדָה׃",
      "sourcePages": [
        146
      ],
      "textSHA256": "39e64c60415c7b069db78f0c60b1ac7589cb3cf433ad829f562db1b4c07e00e4"
    },
    {
      "chapter": 10,
      "verse": 8,
      "text": "וַיִּירְאוּ יִרְאָה גְדוֹלָה כִּי־שָׁמְעוּ כִּי נָתַן־לוֹ הַמֶּלֶךְ תֹּקֶף לֶאֱסֹף־חַיִל׃",
      "sourcePages": [
        146
      ],
      "textSHA256": "541cd9dca063366a068bf989ddf37f614a66919c37216c3919cafb776fd1ae6f"
    },
    {
      "chapter": 10,
      "verse": 9,
      "text": "וַיָּשִׁיבוּ הָאֲנָשִׁים מִן־הַמְּצוּדָה לְיוֹנָתָן אֶת־בְּנֵי־הַתַּעֲרוּבוֹת וַיִּמְסְרֵם לְהוֹרֵיהֶם׃",
      "sourcePages": [
        146
      ],
      "textSHA256": "49e1d962f9c87e8942e427ff49ad0ff57eeab35c78b222e0e9844adc0d82fd01"
    },
    {
      "chapter": 10,
      "verse": 10,
      "text": "וַיֵּשֶׁב יוֹנָתָן בִּירוּשָׁלִָם וַיָּחֶל לִבְנוֹת וּלְחַדֵּשׁ אֶת־הָעִיר׃",
      "sourcePages": [
        146
      ],
      "textSHA256": "6d553f33411cc46574e1c90a6dcbd117ad08a48c86b2641702f4f805e9d075bf"
    },
    {
      "chapter": 10,
      "verse": 11,
      "text": "וַיֹּאמֶר לְעוֹשֵׂי הַמְּלָאכָה לִבְנוֹת הַחֹמֹת וְהַר־צִיּוֹן מִסָּבִיב אַבְנֵי מַחְצָב לְמִבְצָר וַיַּעֲשׂוּ־כֵן׃",
      "sourcePages": [
        146
      ],
      "textSHA256": "3cb863f2bf098dd158b3e02a3a3f0a3910e8df98360b637d993f5874099f1fe6"
    },
    {
      "chapter": 10,
      "verse": 12,
      "text": "וַיִּבְרְחוּ הַנָּכְרִים אֲשֶׁר־הָיוּ בַּמְּבָצְרִים אֲשֶׁר־בָּנָה בַקְחִידֵס׃",
      "sourcePages": [
        146
      ],
      "textSHA256": "b049c9a35007bbe87a2ea9902a3e03d66dbe687c5519b9c4368634ae49483a9d"
    },
    {
      "chapter": 10,
      "verse": 13,
      "text": "וַיָּנַח כָּל־אִישׁ אֶת־מְקוֹמוֹ וַיֵּלֶךְ אֶל־אַרְצוֹ׃",
      "sourcePages": [
        146
      ],
      "textSHA256": "ab42ee0ff25ff72f4408106df13d24f9eeecfccdbb3ec86706f92520428dd26e"
    },
    {
      "chapter": 10,
      "verse": 14,
      "text": "רַק בְּבֵית־צוּר נִשְׁאֲרוּ אֲחָדִים מִן־הָעוֹזְבִים אֶת־הַתּוֹרָה וְאֶת־הַמִּצְוֹת כִּי־הָיְתָה [לָהֶם] לְמָנוֹס׃",
      "sourcePages": [
        146
      ],
      "textSHA256": "08ab066bfa11b42bfa36f24d8b13187496334def76f23d53ee0c82f98192e0b6"
    },
    {
      "chapter": 10,
      "verse": 15,
      "text": "וַיִּשְׁמַע אֶלֶכְּסַנְדַּר הַמֶּלֶךְ אֶת־כָּל־הַדְּבָרִים אֲשֶׁר־שָׁלַח דְמִטְרִיוֹס לְיוֹנָתָן וַיְסַפְּרוּ לוֹ אֶת־הַמִּלְחָמוֹת וְאֵת הַגְּבוּרוֹת אֲשֶׁר־עָשָׂה הוּא וְאֶחָיו וְאֶת הַתְּלָאוֹת אֲשֶׁר־מְצָאוּם׃",
      "sourcePages": [
        146
      ],
      "textSHA256": "996b07c43fbc1c0542d2f1325542f2ef58e035ae2c0d28c3775e2f131b3f314a"
    },
    {
      "chapter": 10,
      "verse": 16,
      "text": "וַיֹּאמֶר הֲנִמְצָא כָּזֶה גֶּבֶר אֶחָד וְעַתָּה נְשִׂימָה אוֹתוֹ אוֹהֵב וּבֶן־בְּרִיתֵנוּ׃",
      "sourcePages": [
        146
      ],
      "textSHA256": "bcb817e2f93ae063332697fb8ee0793ad4c9b1908daa30f61c463635a515e7ff"
    },
    {
      "chapter": 10,
      "verse": 17,
      "text": "וַיִּכְתֹּב סְפָרִים וַיִּשְׁלַח אֵלָיו כַּדְּבָרִים הָאֵלֶּה לֵאמֹר׃",
      "sourcePages": [
        146
      ],
      "textSHA256": "aa66c57cad6fb31ac9d7333e1463460c57d04370ba7b07606866b79fedeb4fa6"
    },
    {
      "chapter": 10,
      "verse": 18,
      "text": "הַמֶּלֶךְ אֶלֶכְּסַנְדַּר לְאָחִיו יוֹנָתָן שָׁלוֹם׃ שָׁמַעְנוּ עָלֶיךָ כִּי אִישׁ גִּבּוֹר־חַיִל אַתָּה וְנָאֶה לְךָ לִהְיוֹת אוֹהֲבֵנוּ׃",
      "sourcePages": [
        146
      ],
      "textSHA256": "1925d85340a268d5d6f74659e140e15120ca963554610601b96be412c088f457",
      "endVerse": 19
    },
    {
      "chapter": 10,
      "verse": 20,
      "text": "וְעַתָּה הֶעֱמַדְנוּךָ הַיּוֹם לְכֹהֵן גָּדוֹל לְעַמֶּךָ וְאוֹהֵב הַמֶּלֶךְ תִּקָּרֵא ׀ וַיִּשְׁלַח אֵלָיו אַרְגָּמָן וְעֲטֶרֶת זָהָב ׀ וּלְהַשְׂכִּיל בַּאֲשֶׁר לָנוּ וְלִשְׁמֹר אַהֲבָה אֵלֵינוּ׃",
      "sourcePages": [
        146,
        147
      ],
      "textSHA256": "5b10c94154d3646fe58b62515dd2efef1396d2a19b0e7d1452f4f619ea02573f"
    }
