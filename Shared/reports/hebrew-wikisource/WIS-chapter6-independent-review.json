      },
      {
        "verse": 2,
        "text": "האזינו הָרוֹדִים בָּעָם הַמִּתְנַשְּׂאִים עַל־הֲמוֹן לְאֻמִּים׃",
        "sourcePages": [
          155
        ],
        "textSHA256": "34a19582f3da93e3d573d2d5d44613186cd9d3c6db11e864b9cb7e5ee2cb8ee0"
      },
      {
        "verse": 3,
        "text": "כִּי מֵאֵת יְיָ נִתַּן לָכֶם הָעֹז וְהַמֶּמְשָׁלָה מֵאֵת עֶלְיוֹן הוּא יִבְחַן מַעֲשֵׂיכֶם וְיַחְקֹר מְזמּוֹתֵיכֶם׃",
        "sourcePages": [
          155
        ],
        "textSHA256": "c8724977b78450321080b7ec0ea9c595907db163ab847b732dd2f953a5ed49df",
        "sourceNotes": [
          {
            "id": "wis-6-3-zayin",
            "kind": "unreadablePoint",
            "anchor": "מְזמּוֹתֵיכֶם",
            "occurrence": 1,
            "letterIndex": 2,
            "mark": "vowel",
            "sourcePages": [
              155
            ],
            "sourceURL": "https://upload.wikimedia.org/wikisource/he/e/ed/Apocrypha_Kahana_A2.pdf#page=155"
          }
        ]
      },
      {
        "verse": 4,
        "text": "כִּי מְשָׁרְתֵי מַלְכוּתוֹ אַתֶּם וְלֹא שְׁפַטְתֶּם מֵישָׁרים וְתוֹרָה לֹא שְׁמַרְתֶּם וּבַעֲצַת אֱלֹהִים לֹא־הֲלַכְתֶּם׃",
        "sourcePages": [
          155
        ],
        "textSHA256": "0737b4402ab122f8991bdc17f67d4886e232a3a9bdb8f93dfb80e72ac3975857",
        "sourceNotes": [
          {
            "id": "wis-6-4-resh",
            "kind": "unreadablePoint",
            "anchor": "מֵישָׁרים",
            "occurrence": 1,
            "letterIndex": 4,
            "mark": "vowel",
            "sourcePages": [
              155
            ],
            "sourceURL": "https://upload.wikimedia.org/wikisource/he/e/ed/Apocrypha_Kahana_A2.pdf#page=155"
          }
        ]
      },
      {
        "verse": 5,
        "text": "כְּשׁוֹאָה יָבֹא עֲלֵיכֶם פִּתְאֹם כִּי מִשְׁפָּט חָרוּץ עַל־אַדִּירִים׃",
        "sourcePages": [
          155
        ],
        "textSHA256": "beaa930f5bb821148956129179fc92cf5aee133345d6db690896549964b94e7e"
      },
      {
        "verse": 6,
        "text": "הֵן לַדַּל יֵאוֹת לִסְלֹחַ בְּרַחֲמִים וְהַחֲזָקִים בְּחֹזֶק יִוָּסרוּ׃",
        "sourcePages": [
          155
        ],
        "textSHA256": "4fa255936d132b2c7a59bb2d6f6970c73b0bbac490d8bd1c1fafa4b8719a7016",
        "sourceNotes": [
          {
            "id": "wis-6-6-samekh",
            "kind": "unreadablePoint",
            "anchor": "יִוָּסרוּ",
            "occurrence": 1,
            "letterIndex": 3,
            "mark": "vowel",
            "sourcePages": [
              155
            ],
            "sourceURL": "https://upload.wikimedia.org/wikisource/he/e/ed/Apocrypha_Kahana_A2.pdf#page=155"
          }
        ]
      },
      {
        "verse": 7,
        "text": "כִּי אֲדוֹן כָּל־הָעוֹלָם לֹא יַכִּיר פָּנִים וְלֹא יִירָא מִפְּנֵי רָם כִּי קָטֹן וְגָדוֹל הוּא עָשָׂהוּ וּלְכֻלָּם יִדְאַג יָחַד׃",
        "sourcePages": [
          156
        ],
        "textSHA256": "fe2a7ec2c3107819d73f30bc562d7fc8389fbefeede57afd286a84a3aac7e61b"
      },
