  "draft": {
    "number": 19,
    "verses": [
      {
        "verse": 1,
        "text": "וְאֶת הָרְשָׁעִים רָדַף בְּאַפּוֹ בְּלִי חֶמְלָה עַד־כָּלָה בְּדַעְתּוֹ מֵרֹאשׁ אֶת־אֲשֶׁר עֲתִידִים הֵם לַעֲשׂוֹת׃",
        "sourcePages": [
          183,
          184
        ],
        "textSHA256": "ba777288ffbb80ac01e4d658cd53f2180538a2bf0a3e202cddf46661d3b58a04"
      },
      {
        "verse": 2,
        "text": "כִּי הֵם צִוּוּם לָלֶכֶת וַיִּשְׁקְדוּ לְשַׁלְּחָם בְּחִפָּזוֹן וַיֵּהָפֵךְ לְבָבָם לִרְדֹּף אַחֲרֵיהֶם׃",
        "sourcePages": [
          184
        ],
        "textSHA256": "1bc9a6db614700a40b300918d6462f1309cc99da37596573eb4493140a9a1d72"
      },
      {
        "verse": 3,
        "text": "הֵם הָיוּ בְּעֶצֶם מַכְאוֹבֵיהֶם וְעַל־קִבְרוֹת מֵתִים יְיֵלִילוּ וַתִּישַׁר בְּעֵינֵיהֶם עֲצַת אִוֶּלֶת אַחֶרֶת וְאַחֲרֵי הָאֲנָשִׁים אֲשֶׁר גֵּרְשׁוּם בְּתַחֲנוּנִים כְּאַחֲרֵי בוֹרְחִים רָדָפוּ׃",
        "sourcePages": [
          184
        ],
        "textSHA256": "62a62a2b3a30f7ea839b32791d0bbe51cb81abbbec785dba27f5b9a485f72b26"
      },
      {
        "verse": 4,
        "text": "כִּי הַמִּשְׁפָּט אֲשֶׁר נִגְזַר בְּצֶדֶק הִסָּה אוֹתָם לִנְתִיב זֶה הוּא הִשְׁכִּיחֵם אֶת־אֲשֶׁר מָצָא אוֹתָם לְמַעַן יְמַלְּאוּ סְאַת עָנְשָׁם בְּצָרוֹתֵיהֶם׃",
        "sourcePages": [
          184
        ],
        "textSHA256": "5435c813ceca0ea28bedd206ae8575ea7fb9c456f4d4d156b3f6b8759b5d0983"
      },
      {
        "verse": 5,
        "text": "וּלְמַעַן יַעֲבֹר עַמְּךָ דֶּרֶךְ פְּלָאִים וְהֵם יִמְצְאוּ מִיתָה מְשֻׁנָּה׃",
        "sourcePages": [
          184
        ],
        "textSHA256": "4c6d65512ccb36ab8140a73e6154ebcc2b5933937bfa6487b4495d73a10b41cf"
      },
      {
        "verse": 6,
        "text": "כִּי כָּל־הַיְצוּרִים לְמִינֵיהֶם נֶהֶפְכוּ מֵחָדָשׁ לְשָׁרֵת לִפְקֻדּוֹתֶיךָ בַּעֲבוּר יִשָּׁמְרוּ בָנֶיךָ מִכָּל פֶּגַע׃",
        "sourcePages": [
          184
        ],
        "textSHA256": "4f6798fa72b0d31701f5e96b4768ee12310e5187ab05376b29451997087b3622"
      },
      {
        "verse": 7,
        "text": "הֵן נִרְאָה עָנָן סוֹכֵךְ עַל־הַמַּחֲנֶה וּמְקוֹם שָׁם מַיִם לְפָנִים יַבֶּשֶׁת הוֹפִיעָה מִיַּם־סוּף דֶּרֶךְ סְלוּלָה וּמִמִּשְׁבָּרִים אַדִּירִים מִישׁוֹר מְכֻסֶּה דֶּשֶׁא׃",
        "sourcePages": [
          184
        ],
        "textSHA256": "b8b45a89bc212f14e88ec64ece71d24b3faaed3f0dfae30586d046ce662bc4fc"
      },
      {
        "verse": 8,
        "text": "בּוֹ עָבְרוּ כָּל־הָעָם בְּפָרְשְׂךָ עֲלֵיהֶם יָדְךָ וַיִּרְאוּ נִסִּים וְנִפְלָאוֹת׃",
        "sourcePages": [
          184
        ],
        "textSHA256": "b530c9bae0c253ca8d23376df40f808b86c2b3b36ad9c48ad2f1489f5041f8bf"
      },
      {
        "verse": 9,
        "text": "וַיִּשְׁמְמוּ כְּסוּסִים בַּמִּרְעֶה וְכִכְבָשִׂים יִרְקְדוּ וַיְהַלְלוּ לְךָ יְיָ גּוֹאֲלָם׃",
        "sourcePages": [
          184
        ],
        "textSHA256": "a6afcb54823c1939def8a25b17214c463014ea3df1927d68c4826282d8228977"
      },
      {
        "verse": 10,
        "text": "כִּי זָכְרוּ עוֹד אֶת־הַמְּצָאוֹת אוֹתָם בְּאֶרֶץ מְגוּרֵיהֶם אֵיךְ הָאָרֶץ הוֹצִיאָה כִּנִּים תַּחַת חַיּוֹת [הַיַּבָּשָׁה] לְמִינֵיהֶן וְתַחַת חַיּוֹת הַמַּיִם שָׁרַץ הַיְאֹר צְפַרְדְּעִים לָרֹב׃",
        "sourcePages": [
          184
        ],
        "textSHA256": "d16aec6472055db7a3c91c710e3f54465006a9a46aed85e97c22d1594c96bd3b"
      },
      {
        "verse": 11,
        "text": "אַחֲרֵי־כֵן רָאוּ גַּם מִין צִפֳּרִים חֲדָשׁוֹת כְּעוֹרֵר אוֹתָם תַּאֲוָתָם לִדְרשׁ מַאֲכָלֵי מַעֲדַנִּים׃",
        "sourcePages": [
          184,
          185
        ],
        "textSHA256": "6ca0c919fa52724672e2a13bd1b45e8f07ea487b2952e73f78cb29fb06853f70"
      },
      {
        "verse": 12,
        "text": "כִּי שְׂלָו עָלָה לָהֶם מִן־הַיָּם לְמַלֵּא שְׁאֵלָתָם׃",
        "sourcePages": [
          185
        ],
        "textSHA256": "0c7afaaac75bee98956232fa1eee7e66360d2fd3e2fb490e9d9655c336d60201"
      },
      {
        "verse": 13,
        "text": "וְעַל הַחַטָּאִים לֹא בָאוּ הַפְּגָעִים עַד־אֲשֶׁר הָרְעָמִים נָתְנוּ עֵדוּתָם בְּעֹז הֵמָּה סָבְלוּ בְּצֶדֶק בִּגְלַל עֲוֹנוֹתֵיהֶם׃",
        "sourcePages": [
          185
        ],
        "textSHA256": "cf95bfb75a5f06c6af2e28cde9041feaaf0b96f18b5ef75ce96f7bf506d71442"
      },
      {
        "verse": 14,
        "text": "יַעַן כִּי הִרְבּוּ לְהַרְאוֹת מַשְׂטֵמָה עַזָּה לַגֵּרִים [מִן־הָאֲחֵרִים] כִּי אֵלֶּה לֹא אָסְפוּ זָרִים אֲשֶׁר בָּאוּ אֲלֵיהֶם וְהֵמָּה עָשׂוּ לַעֲבָדִים אֲנָשִׁים גֵּרִים אֲשֶׁר עָשׂוּ עִמָּם חָסֶד׃",
        "sourcePages": [
          185
        ],
        "textSHA256": "5d9d55cbe594bc02321f569d30e3566eec2dd7776ad46719c89f067d312d168f"
      },
      {
        "verse": 15,
        "text": "מִבַּלְעֲדֵי זֶה שׁוֹנֶה יִהְיֶה עָנְשָׁם אֲשֶׁר אֵלֶּה יָצְאוּ בְּשִׂנְאָה נֶגֶד הַגֵּרִים׃",
        "sourcePages": [
          185
        ],
        "textSHA256": "3da87ef98559cbc5b9f358656b561494deba659c7b597b73f46fc2b38f528b6c"
      },
      {
        "verse": 16,
        "text": "וְהֵמָּה קִבְּלוּ אוֹתָם בְּהִלּוּלִים וְאַחֲרֵי־כֵן עִנּוּ אוֹתָם בַּעֲבוֹדָה קָשָׁה אַף־כִּי בְּחֻקֵּי הָאָרֶץ כְּבָר לָהֶם נִשְׁתַּוּוּ׃",
        "sourcePages": [
          185
        ],
        "textSHA256": "14cf0c1ed49239380647b281d9baffba44868418f90351ba4216aa439bce3252"
      },
      {
        "verse": 17,
        "text": "וְגַם הֵם הֻכּוּ בַּסַּנְוֵרִים כְּמוֹ אֵלֶּה לִפְנֵי פֶּתַח הַצַּדִּיק כַּאֲשֶׁר כִּסָּה אוֹתָם חשֶׁךְ וְצַלְמָוֶת וַיְבַקֵּשׁ כָּל־אִישׁ מֵהֶם אֶת־הַדֶּרֶךְ אֶל־שַׁעַר בֵּיתוֹ׃",
        "sourcePages": [
          185
        ],
        "textSHA256": "eeef583810c3cbef536bfc94682af53b27fabe733d792b170f6bcfe8a24e3685"
      },
      {
        "verse": 18,
        "text": "כִּי הַיְסוֹדוֹת אֶת־סִדְרָם הֶחֱלִיפוּ כַּאֲשֶׁר יִשְׁתַּנֶּה קֶצֶב צִלְצְלֵי הַנֵּבֶל בְּהִשְׁתַּנּוֹת מֵיתָרָיו אַף כִּי־קוֹלָם יִשָּׁאֵר תָּמִיד כָּל־עֻמַּת שֶׁהָיָה וְזֹאת יוּכַל הָאִישׁ לִשְׁפֹּט לְנָכוֹן בִּרְאוֹתוֹ אֶת־הַמַּעֲשִׂים׃",
        "sourcePages": [
          185
        ],
        "textSHA256": "061cee1b519b6b15df2644cd60ee0a31223328ff5b19c9e4dfb0f31a5ef6e7b8"
      },
      {
        "verse": 19,
