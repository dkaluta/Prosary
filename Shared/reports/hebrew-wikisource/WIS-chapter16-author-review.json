        "textSHA256": "1b2bd175e946c79c368835c7dc6f97139e98f9ef69064ad44c92e8ae1305f0e1",
        "endVerse": 24
      },
      {
        "verse": 25,
        "text": "לָכֵן הָסַב [הַלֶּחֶם] גַּם אָז לְשָׁרֵת אֶת־נְדִיבוּתְךָ הַמְחַיֶּה הַכֹּל כְּחֵפֶץ כָּל־שׁוֹאֵל׃",
        "sourcePages": [
