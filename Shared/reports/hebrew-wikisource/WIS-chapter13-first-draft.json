  "draft": {
    "number": 13,
    "verses": [
      {
        "verse": 1,
        "text": "אָכֵן הֶבֶל כָּל־בְּנֵי אָדָם מִתְּכוּנַת נַפְשָׁם אֲשֶׁר אֵין בָּהֶם דַּעַת אֱלֹהִים גַּם נִבְצַר מֵהֶם לְהַכִּיר אֶת־הַיֵּשׁ עַל־פִּי טוֹבוֹתָיו הַנִּרְאוֹת בָּעַיִן וְלֹא יָשִׂימוּ לֵב לָדַעַת אֶת הָאָמָּן עַל־פִּי פְּעֻלּוֹתָיו׃",
        "sourcePages": [
          170,
          171
        ],
        "textSHA256": "0eae1b65f9b76f6bd896b12ed8b24603dd7854e6ac3c1b3a68fb81c725dcd704"
      },
      {
        "verse": 2,
        "text": "אַךְ אֵשׁ אוֹ רוּחַ אוֹ אֲוִיר חוֹלֵף אוֹ חוּג הַכּוֹכָבִים אוֹ מַיִם אַדִּירִים אוֹ מְאוֹרוֹת הַשָּׁמַיִם חָשְׁבוּ לְאֵלִים שָׂרֵי הָעוֹלָם׃",
        "sourcePages": [
          171
        ],
        "textSHA256": "d5e2f9b1aefb788ca4632c597797898b52672efa56326b7bedfb06b9b5b95ef8"
      },
      {
        "verse": 3,
        "text": "וְאִם עַל־יִפְעַת הַדְּבָרִים הָאֵלֶּה הִתְעַנְּגוּ וְיִדְמוּ כִּי אֱלֹהִים הֵמָּה יִתְבּוֹנְנוּ־נָא כַּמָּה טוֹב מֵהֶם רִבּוֹן הַמַּעֲשִׂים אֲשֶׁר יוֹצֵר הַיֹּפִי יְסָדָם׃",
        "sourcePages": [
          171
        ],
        "textSHA256": "62370d2e7518d2b31ca3cb7f767edeabb5de4209568234ab84523cdbb879cbdc"
      },
      {
        "verse": 4,
        "text": "וְאִם עַל־כֹּחָם וּגְבוּרָתָם יִשְׁתּוֹמְמוּ מִן־הַדְּבָרִים הָאֵלֶּה יַכִּירוּ כַּמָּה יֶחֱזַק מֵהֶם בּוֹרְאָם׃",
        "sourcePages": [
          171
        ],
        "textSHA256": "c6066dc32f961e1bcb40fe87ca2bd8f4d18ed593a1e91f2b2491be5ed8eee19a"
      },
      {
        "verse": 5,
        "text": "הֲלֹא בְּגֹדֶל יִפְעַת הַיְּצוּרִים נִבָּט דִּמְיוֹן יוֹצְרָם׃",
        "sourcePages": [
          171
        ],
        "textSHA256": "9da7100ac044846578d0a8338264fa8248581fe3a3649e3582f5ab7aec57ba50"
      },
      {
        "verse": 6,
        "text": "אָמְנָם קְלוֹן הַמַּעֲשִׂים הָאֵלֶּה מִצְעָר הוּא וְיִתָּכֵן אֲשֶׁר־גַּם הֵם יִדְרְשׁוּ אֶת־אֱלֹהִים וְיַחְפְּצוּ לִמְצֹא [אוֹתוֹ] וְיִתְעוּ׃",
        "sourcePages": [
          171
        ],
        "textSHA256": "e8364a345a5ab679b552f0fe1dc3143161f2ca6a6b8e15f4895f93a637c2af7a"
      },
      {
        "verse": 7,
        "text": "בַּעֲבוּר כִּי־יָתוּרוּ וְיַחְקְרוּ בְּמִפְעֲלוֹתָיו וְיִשְׁפְּטוּ לְמַרְאֵה עֵינֵיהֶם אֲשֶׁר נָאִים הַדְּבָרִים הַנִּרְאִים׃",
        "sourcePages": [
          171
        ],
        "textSHA256": "08a4f75052e25f5766fb0ff79a73f781ab295fd9a069367d9c1b93a8c10ee39d"
      },
      {
        "verse": 8,
        "text": "אוּלָם גַּם לָהֶם לֹא יְכֻפָּר׃",
        "sourcePages": [
          171
        ],
        "textSHA256": "61d599fa481c5acfe48fecf11eb5cece20cba9cdd4ee7f4822a2e69ef58931f5"
      },
      {
        "verse": 9,
        "text": "כִּי אִם־עָמְדָה לָהֶם בִּינָתָם לְתַכֵּן אֶת־הָעוֹלָם הַזֶּה מַדּוּעַ לֹא יְמַהֲרוּ לִמְצֹא אֶת־אֲדוֹן הַמַּעֲשִׂים׃",
        "sourcePages": [
          171
        ],
        "textSHA256": "302e184f53d93d48883f155724730590a99893fa4e6602c628f222ad4b9fed44"
      },
      {
        "verse": 10,
        "text": "אָכֵן אֻמְלָלִים הֵמָּה וּמִבְטַחָם דְּבָרִים אֵין־רוּחַ חַיִּים בָּמוֹ הֵם קָרְאוּ בְּשֵׁם אֱלֹהִים לְמַעֲשֵׂי יְדֵי אָדָם זָהָב וָכֶסֶף מְלֶאכֶת מַחֲשֶׁבֶת וְתַבְנִית חַיָּה אוֹ אֶבֶן לֹא־תִצְלַח מַעֲשֵׂה יָד מִשְּׁנוֹת קֶדֶם׃",
        "sourcePages": [
          171
        ],
        "textSHA256": "6b9d789660fadc5e8b5540fa89b4d10ffd13fe651d70ca69d24ea0c95c28f6d1"
      },
      {
        "verse": 11,
        "text": "אוֹ אִם־חָרַשׁ עֵצִים יִכְרֹת בַּמַּשּׂוֹר נֵצֶר נוֹחַ לְטַלְטֵל וְיִפְצַל כָּל־קְלִפָּתוֹ מִסָּבִיב בְּהַשְׂכֵּל וּבְכִשְׁרוֹן מְלָאכָה וְיֵיטִיב עֲשׂוֹת כְּלִי לְצָרְכֵי חַיָּיו׃",
        "sourcePages": [
          171
        ],
        "textSHA256": "f2ccfe368fbb8ab48abda7255179fdbd924335b5fae82fb5ef7ce4034c65448a"
      },
      {
        "verse": 12,
        "text": "וְאֶת־הָרְסִיסִים הַנּוֹשְׁרִים בַּעֲבוֹדָתוֹ יִקַּח לְהָכִין אֹכֶל וְיִשְׂבַּע׃",
        "sourcePages": [
          171
        ],
        "textSHA256": "c61bbea75df26b181e008867f1a679ffdf6a2b21ff024024a25959b8ab135f28"
      },
      {
        "verse": 13,
        "text": "וּמִן־הַנּוֹתָר מֵהֶם אֲשֶׁר לֹא־יִצְלַח לְכָל־דָּבָר יְקַח עֵץ מְעֻקָּל מָלֵא קְשָׁרִים וְיַקְצִיעֵהוּ בְּכִשְׁרוֹן מַעֲשֶׂה וִיעַצְּבֵהוּ בְּנִסְיוֹן חָכְמָתוֹ וִיתָאֲרֵהוּ תַּבְנִית אָדָם׃",
        "sourcePages": [
          171
        ],
        "textSHA256": "7094e282c8d78b3636b631f80db8f56cb10ac53cd10bbab696c43d34d354c5f3"
      },
      {
        "verse": 14,
        "text": "אוֹ יַעֲשֵׂהוּ כִּדְמוּת חַיָּה נִבְזָה וְיִמְשָׁחֵהוּ בַּשָּׁשַׁר וּבַשָּׂרַק יַאֲדִים עוֹרוֹ וְכָל־כְּתָם בַּצֶּבַע יְכַסֶּה׃",
        "sourcePages": [
          171,
          172
        ],
        "textSHA256": "426c707c720871deb677fda4c11eea265ab59c76271ca28065c66f851d749eb5"
      },
      {
        "verse": 15,
        "text": "וְיַעֲשֶׂה־לּוֹ מִשְׁכָּן נָאֶה לִשְׁמוֹ וְיַעֲמִידֵהוּ אֶל־הַקִּיר וּבַבַּרְזֶל יְחַזְּקֵהוּ׃",
        "sourcePages": [
          172
        ],
        "textSHA256": "7b4aaf860a612fe79f3469fd6b8362d76e6f00c018094a52e28ad25f8e8efac9"
      },
      {
        "verse": 16,
        "text": "כִּי־יִדְאַג לוֹ לְבִלְתִּי־מוֹט בְּדַעְתּוֹ כִּי־קָצְרָה יָדוֹ מֵהוֹשִׁיעַ לוֹ הֲלֹא פֶּסֶל הוּא וְעֶזְרָה יִדְרֹשׁ׃",
        "sourcePages": [
          172
        ],
        "textSHA256": "4eeda3037f6b95b3affdfab9a84ba9e5a76af119c4388a78aa2a4e4c5c478b61"
      },
      {
        "verse": 17,
        "text": "בְּעַד קִנְיָנָיו יִתְפַּלֵּל בְּעַד אִשְׁתּוֹ וּבָנָיו וְלֹא יֵבוֹשׁ לְדַבֵּר אֶל־אֵין בּוֹ רוּחַ חַיִּים וְעַל הַבְּרִיאוּת יִתְחַנֵּן אֶל־הַחַלָּשׁ׃",
        "sourcePages": [
          172
        ],
        "textSHA256": "fe8ec8d38885fc494b0dbad7d11fb5e4f754e9600446db356cf4eeb0be2b6cf0"
      },
      {
        "verse": 18,
        "text": "חַיִּים יְבַקֵּשׁ מֵאֵת הַמֵּת עֶזְרָה יִשְׁאַל בְּתַחֲנוּנִים מֵחַדַּל עֵצוֹת וְהַצְלַח דַּרְכּוֹ מֵאֲשֶׁר בְּרַגְלָיו לֶכֶת בַּל־יוּכַל׃",
        "sourcePages": [
          172
        ],
        "textSHA256": "4e3b4188f13094c4ed3182f00b2d11bb9b2a2ca32665221a13051f36831f4fb3"
      },
      {
        "verse": 19,
        "text": "וּלְאֵין־כֹּחַ בְּיָדָיו יִקְרָא לָתֶת־לוֹ כֹּחַ בְּמִשְׁלַח יָדוֹ וּבְמִפְעַלְתּוֹ וְלַעֲשׂוֹת חַיִל בִּיגִיעַ כַּפָּיו׃",
        "sourcePages": [
          172
        ],
        "textSHA256": "c4c2befdb186d86064af1733430a7946b758bd2173cf634331ce4830df28bad7"
      }
    ]
