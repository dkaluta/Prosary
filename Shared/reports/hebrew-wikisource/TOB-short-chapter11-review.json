  "canonicalChapter": {
    "number": 11,
    "lastVerse": 20,
    "verses": [
      {
        "verse": 1,
        "text": "וַיֵּלֶךְ עַד־אֲשֶׁר הִקְרִיב לְנִינְוֵה׃",
        "sourcePages": [
          337
        ],
        "textSHA256": "a178374bac297c4ab1065c60fd7a2d4b9f4ba01322a1db2398cf4fa9d77d2707"
      },
      {
        "verse": 2,
        "text": "וַיֹּאמֶר רְפָאֵל אֶל־טוֹבִיָּה׃",
        "sourcePages": [
          337
        ],
        "textSHA256": "b303cd90770a1454afc171f1952e261d68f93e6879a57aeea7309227439f43c5"
      },
      {
        "verse": 3,
        "text": "הֲלֹא נֵדַע אָחִי אֵיךְ עָזַבְנוּ אֶת־אָבִיךָ׃ נָרוּצָה־נָא לִפְנֵי אִשְׁתֶּךָ וְנָכִינָה אֶת־הַבָּיִת׃",
        "sourcePages": [
          337
        ],
        "textSHA256": "236ef540ad7d00161ab8f2d2d88c7e8488295cd93ccd73695ca5fda11541d27d",
        "endVerse": 4
      },
      {
        "verse": 5,
        "text": "קַח־נָא בְּיָדְךָ אֶת־מְרֵרַת הַדָּג וַיֵּלְכוּ וְהַכֶּלֶב הָלַךְ אַחֲרֵיהֶם׃",
        "sourcePages": [
          337
        ],
        "textSHA256": "1681a9d0feef7fbbba1a244e4890a1d4f3d02147ec9c75a552fd76e39691d0eb"
      },
      {
        "verse": 6,
        "text": "וְחַנָּה יוֹשֶׁבֶת עַל־יַד הַדֶּרֶךְ מְצַפָּה לִבְנָהּ׃ וַתִּתְבּוֹנֵן אֵלָיו כְּבוֹאוֹ וַתֹּאמֶר לְאָבִיו רְאֵה בָא בִנְךָ וְהָאִישׁ אֲשֶׁר הָלַךְ עִמּוֹ׃",
        "sourcePages": [
          337
        ],
        "textSHA256": "f34536a994236f6e829ceadf13a6117648028fd2d1b355a66bef61a00178092f",
        "endVerse": 7
      },
      {
        "verse": 8,
        "text": "רְפָאֵל אָמַר יָדַעְתִּי כִּי תִפָּקַחְנָה עֵינֵי אָבִיךָ׃",
        "sourcePages": [
          337
        ],
        "textSHA256": "2cb6f30e3a21093b1e6cbc532d0eb16d5482a16e85024ece25384acab6c5cf19"
      },
      {
        "verse": 9,
        "text": "וְאַתָּה מְרַח אֶת־הַמְּרֵרָה בְּעֵינָיו וְאִם נִשָׁךְ וְהִתְגָּרֵד וְהִשְׁלִיךְ אֶת תַּבְלוּלֵי הַלָּבָן וְרָאָה אוֹתְךָ׃",
        "sourcePages": [
          337
        ],
        "textSHA256": "180eda371c8d7d265062fd0b33cf30f13e56f19c579524877feb663c93a4f49c"
      },
      {
        "verse": 10,
        "text": "וַתָּרָץ חַנָּה לִקְרָאתָם וַתִּפֹּל עַל־צַוַּאר בְּנָהּ וַתֹּאמֶר לוֹ אָמוּתָה הַפַּעַם אַחֲרֵי רְאוֹתִי אוֹתְךָ בְּנִי וַיִּבְכּוּ שְׁנֵיהֶם׃",
        "sourcePages": [
          337
        ],
        "textSHA256": "54e95bf0e4b1ec7831353bb8aa1c0f83f98e56259fc671f0d3369e806ab4bf34"
      },
      {
        "verse": 11,
        "text": "וְטוֹבִי יָצָא אֶל־הַפֶּתַח וַיִּכָּשֵׁל וַיָּרָץ בְּנוֹ לִקְרָאתוֹ׃",
        "sourcePages": [
          337
        ],
        "textSHA256": "e2228c75d626ad24364903635d03d984afde208f9877c9ca9a207ae9a7a3a72c"
      },
      {
        "verse": 12,
        "text": "וַיֶּחֱזַק בְּאָבִיו וַיָּשֶׂם אֶת־הַמְּרֵרָה עַל־עֵינֵי אָבִיו וַיֹּאמֶר חֲזַק אָבִי׃",
        "sourcePages": [
          337,
          338
        ],
        "textSHA256": "5b0fdd9c44ce595d835407996a00e6acc42ccac0168dd93e3ab08ab6c318627d"
      },
      {
        "verse": 13,
        "text": "וַיְהִי כַּאֲשֶׁר נְשָׁכוֹ עֵינָיו וַיְגָרֵד אוֹתָן וַיִּמָּחוּ תַּבְלוּלֵי הַלָּבָן מִזָּוִיּוֹת עֵינָיו׃",
        "sourcePages": [
          338
        ],
        "textSHA256": "e4502037e05187ecc8fef33f68ee19b88ef1461e5e8976f997c0be8fa9fb1b06"
      },
      {
        "verse": 14,
        "text": "וַיַּרְא אֶת־בְּנוֹ וַיִּפֹּל עַל־צַוָּארָיו וַיֵּבְךְ וַיֹּאמַר׃",
        "sourcePages": [
          338
        ],
        "textSHA256": "f6c033023f16be06a98ab3fd531c08717a36c234548a937d768ff20de62a762f"
      },
      {
        "verse": 15,
        "text": "בָּרוּךְ אַתָּה אֱלֹהִים וּבָרוּךְ שִׁמְךָ לְעוֹלָמִים וּבְרוּכִים כָּל־מַלְאָכֶיךָ הַקְּדוֹשִׁים כִּי יִסַּרְתַּנִי וַתְּרַחֲמֵנִי וְהִנֵּה אָנֹכִי רֹאֶה אֶת־טוֹבִיָּה בְּנִי׃",
        "sourcePages": [
          338
        ],
        "textSHA256": "487c483718848c3ff17057a31acb0210646d52695b86910d6f5076543e59df09"
      },
      {
        "verse": 16,
        "text": "וַיָּבֹא אֵלָיו בְּנוֹ שָׂמֵחַ וַיַּגֵּד לְאָבִיו אֶת־הַגְּדֹלוֹת אֲשֶׁר נַעֲשׂוּ לוֹ בְּמָדָי׃",
        "sourcePages": [
          338
        ],
        "textSHA256": "aa70561033e1ae7e366ffda4a92375961549fc9d411c27811e32764f605946ab"
      },
      {
        "verse": 17,
        "text": "וַיֵּצֵא טוֹבִי לִקְרַאת כַּלָּתוֹ לִפְנֵי שַׁעַר נִינְוֵה וְהוּא שָׂמֵחַ וּמְבָרֵךְ אֶת־הָאֱלֹהִים וַיִּתְמְהוּ הָרוֹאִים אוֹתוֹ הוֹלֵךְ וּמַבִּיט וַיּוֹדֶה טוֹבִי לִפְנֵיהֶם כִּי רִחַם אוֹתוֹ אֱלֹהִים׃",
        "sourcePages": [
          338
        ],
        "textSHA256": "ac92598b346b3f6484786ceeaba3eac78873ae827419003931c5d4fbeb19073c"
      },
      {
        "verse": 18,
        "text": "וַיִּגַּשׁ טוֹבִי אֶל־שָׂרָה כַּלָּתוֹ וַיְבָרְכָהּ וַיֹּאמֶר בּוֹאִי בְשָׁלוֹם בִּתִּי בָּרוּךְ אֱלֹהִים אֲשֶׁר נָחָה אוֹתָךְ אֵלֵינוּ וּ[בְרוּכִים] אָבִיךְ וְאִמֵּךְ׃",
        "sourcePages": [
          338
        ],
        "textSHA256": "d3a6b42b6c38a4ffe4debd132138d7c41d44965db4c64ba5c89c1485c416c073"
      },
      {
        "verse": 19,
        "text": "וַתְּהִי שִׂמְחָה לְכָל־אֶחָיו בְּנִינְוֵה׃ וַיִּהְיוּ אִתָּם שָׁם אֲחִיקָר וְנַסְכָּם בֶּן־אָחִיו וַיַּחֲגּוּ אֶת־חֲתֻנַּת טוֹבִיָּה בְּשִׂמְחָה שִׁבְעַת יָמִים׃",
        "sourcePages": [
          338,
          339
        ],
        "textSHA256": "3d906cb8f3f91a7f7c24dbf1d7cdbacd213a93d9820a31e31b4c5f11dc736af6",
        "endVerse": 20
      }
    ]
