    "lastVerse": 19,
    "verses": [
      {
        "verse": 1,
        "text": "וַיִּכְתֹּב טוֹבִי שִׁיר־תְּפִלָּה לֵאמֹר׃",
        "sourcePages": [
          341
        ],
        "textSHA256": "a2a2603a42ac12adbb0ea1b7b12f3781ff869be362fdd1bf38b24a37368fa0ac"
      },
      {
        "verse": 2,
        "text": "בָּרוּךְ אֱלֹהִים חֵי־עוֹלָמִים וּ[בְרוּכָה] מַלְכוּתוֹ כִּי־הוּא מְיַסֵּר וּמְרַחֵם מוֹרִיד שְׁאוֹל וַיַּעַל וְאֵין נִמְלָט מִיָּדוֹ׃",
        "sourcePages": [
          341
        ],
        "textSHA256": "67ae02458ceadaea822df1d5418e0241258e107a930106f119f26edbae942238"
      },
      {
        "verse": 3,
        "text": "הוֹדוּ לוֹ בְּנֵי יִשְׂרָאֵל לְעֵינֵי הַגּוֹיִם כִּי־הוּא הֵפִיץ אוֹתָנוּ בְּתוֹכָם׃",
        "sourcePages": [
          341
        ],
        "textSHA256": "604643f56b2ca018694697c11bb5f679075dc90bc798fc2017359e15c5a9d2ab"
      },
      {
        "verse": 4,
        "text": "שָׁם תַּגִּידוּ גְדֻלָּתוֹ וְרוֹמְמוּ אוֹתוֹ לְעֵינֵי כָל־חַי כִּי־הוּא אֲדוֹנֵינוּ וֵאלֹהֵינוּ הוּא אָבִינוּ לְעוֹלָם וָעֶד׃",
        "sourcePages": [
          341
        ],
        "textSHA256": "d5908aff652a00d2719003d9b08b4cb12a143fdee286d596c3e19a672fd3c675"
      },
      {
        "verse": 5,
        "text": "וְהוּא יְיַסְּרֵנוּ בַּעֲוֹנוֹתֵינוּ וְיָשׁוּב וִירַחֲמֵנוּ וִיקַבְּצֵנוּ מִכָּל־הַגּוֹיִם אֲשֶׁר נְפוּצֹתֶם שָׁם׃",
        "sourcePages": [
          341,
          342
        ],
        "textSHA256": "89249739affa9cb11ca47508f78949f3b170ea3e26bac9716568f2b3f234fbda"
      },
      {
        "verse": 6,
        "text": "אִם־תָּשׁוּבוּ בְּכָל־לְבַבְכֶם וּבְכָל־נַפְשְׁכֶם לַעֲשׂוֹת לְפָנָיו בֶּאֱמוּנָה וְשָׁב אֲלֵיכֶם וְלֹא יַסְתִּיר פָּנָיו מִכֶּם׃",
        "sourcePages": [
          342
        ],
        "textSHA256": "b753cdc5dd30a21eaaf074456aa2f6fab25c168aad9df2ea6a12271d26b964b8"
      },
      {
        "verse": 7,
        "text": "וּתְרְאוּ אֶת־אֲשֶׁר יַעֲשֶׂה עִמָּכֶם וְהוֹדוּ לוֹ בְּכָל־פִּיכֶם וּבָרְכוּ אֶת־אֱלֹהֵי הַצְּדָקָה וְרוֹמְמוּ אֶת־מֶלֶךְ הָעוֹלָמִים׃",
        "sourcePages": [
          342
        ],
        "textSHA256": "9c75c8db4f439b6e23796d9b7d2cbe8e1c35e94e8a510af8ec4b3fdb0a9ae393"
      },
      {
        "verse": 8,
        "text": "אֲנִי בְּאֶרֶץ שִׁבְיִי אוֹדֶה לוֹ גְבוּרָתוֹ וּגְדֻלָּתוֹ לְגוֹי חַטָּאִים שׁוּבוּ חַטָּאִים וַעֲשׂוּ צְדָקָה לְפָנָיו מִי יוֹדֵעַ אוּלַי יִרְצֶה בָּכֶם וְיַעַשׂ עִמָּכֶם חֶסֶד׃",
        "sourcePages": [
          342
        ],
        "textSHA256": "dcdd9e137cd5defc0c0397840948c32f84c1fcfcf54c0656806e35525d94d44f"
      },
      {
        "verse": 9,
        "text": "אֲרוֹמֵם אֶת־אֱלֹהַי וְנַפְשִׁי לְמֶלֶךְ הַשָּׁמַיִם תָּרֹן גְּדֻלָּתוֹ׃ יֹאמְרוּ כֻּלָּם וְיוֹדוּ לוֹ בִירוּשָׁלַם יְרוּשָׁלַם קִרְיָה קְדוֹשָׁה [הוּא] יְיַסְּרֵךְ עַל־מַעֲשֵׂי בָנַיִךְ וְיָשׁוּב וִירַחֵם עַל־בְּנֵי הַצַּדִּיקִים׃",
        "sourcePages": [
          342
        ],
        "textSHA256": "35a55a31f325bff253886a0bc0dbe9fd1188cb2fdec7bc98551a01fefb666527",
        "endVerse": 10
      },
      {
        "verse": 11,
        "text": "הוֹדִי לַיְיָ כִּי טוֹב וּבָרְכִי מֶלֶךְ עוֹלָמִים לְמַעַן יָשׁוּב יִבְנֶה בָךְ מִשְׁכָּנוֹ בְּשִׂמְחָה׃",
        "sourcePages": [
          342
        ],
        "textSHA256": "e88f117f4bdcbd7bb3ef0798531e1e15c373a0418002382da719b8006100796d"
      },
      {
        "verse": 12,
        "text": "וִישַׂמַּח בָּךְ אֶת־הַשְּׁבוּיִם וְיֶאֱהַב בָּךְ אֶת־הָעֲשׁוּקִים לְכָל־דֹּרוֹת עוֹלָם׃",
        "sourcePages": [
          342
        ],
        "textSHA256": "7b049aafc3ada966a7788337c70380a8729344601f58e1e0740667812fff9cd7"
      },
      {
        "verse": 13,
        "text": "גּוֹיִם רַבִּים מֵרָחוֹק יָבֹאוּ לְשֵׁם יְיָ אֱלֹהִים וּבִידֵיהֶם מַתָּנוֹת יִשְׂאוּ מַתָּנוֹת לְמֶלֶךְ הַשָּׁמַיִם בְּדוֹר דּוֹרִים וְיִתְּנוּ לָךְ רִנָּה׃",
        "sourcePages": [
          342
        ],
        "textSHA256": "afb798fb5e771be5a0e4cbb2e0e78d2eb0ba4ba6be5b69ea159e685c66bb437e"
      },
      {
        "verse": 14,
        "text": "אֲרוּרִים כָּל־מְשַׂנְאַיִךְ בְּרוּכִים יִהְיוּ כָּל־אוֹהֲבַיִךְ לְעוֹלָם׃",
        "sourcePages": [
          342
        ],
        "textSHA256": "e48f36ff0f7dbe556f79302a5571d174fd36e625b25b1381350cfb3b21f6df09"
      },
      {
        "verse": 15,
        "text": "שִׂמְחִי וָרֹנִּי עַל־בְּנֵי הַצַּדִּיקִים כִּי יִקָּבֵצוּ וִיבָרְכוּ אֶת־אֲדוֹן הַצַּדִּיקִים אַשְׁרֵי אוֹהֲבַיִךְ [עוֹד] יִשְׂמְחוּ בִשְׁלוֹמֵךְ׃",
        "sourcePages": [
          342,
          343
        ],
        "textSHA256": "3cddaa07eb24f7f8a4d3f40dae1cf07f80754a8db550eadc8f283b81128220ec"
      },
      {
        "verse": 16,
        "text": "אַשְׁרֵי הַנֶּעֱצָבִים עַל־כָּל־מַכּוֹתַיִךְ כִּי יִשְׂמְחוּ עָלָיִךְ בִּרְאוֹתָם אֶת־כָּל־כְּבוֹדֵךְ וְגִילוּ לְעוֹלָם בָּרְכִי נַפְשִׁי אֶת־הָאֱלֹהִים אֶת־הַמֶּלֶךְ הַגָּדוֹל׃",
        "sourcePages": [
          343
        ],
        "textSHA256": "4e275500f4c88be41aca2410d33ca98935c739e86d93096c5619c8ee71f091e4"
      },
      {
        "verse": 17,
        "text": "כִּי תִבָּנֶה יְרוּשָׁלַם סַפִּיר וּבָרֶקֶת וְחוֹמוֹתֵךְ אַבְנֵי־חֵפֶץ וּמִגְדְּלַיִךְ וּשְׁרוֹנוֹתֵיהֶם זָהָב טָהוֹר׃",
        "sourcePages": [
          343
        ],
        "textSHA256": "c0dacb235ecaaded6dc2fcd93067b87fa5d76a037cb07bf7c6312680fddf400d"
      },
      {
        "verse": 18,
        "text": "וּרְחוֹבוֹת יְרוּשָׁלַם רְצוּפוֹת שֹׁהַם וְאֶבֶן מֵאוֹפִיר׃",
        "sourcePages": [
          343
        ],
        "textSHA256": "56ad79b088c8510ec64f268a0b28c7c7e889bafc3d6f7b431514dcd5fe3ddedb"
      },
      {
        "verse": 19,
        "text": "וְכָל־חוּצוֹתֶיהָ יֹאמְרוּ הַלֲלוּיָהּ וִישַׁבְּחוּ לֵאמֹר בָּרוּךְ הָאֱלֹהִים הַמְרוֹמָם לְעוֹלָם וָעֶד׃",
        "sourcePages": [
