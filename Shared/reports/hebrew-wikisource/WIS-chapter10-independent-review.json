        "textSHA256": "f65aa55e42bd4ef1da22f2f55bddfb397307a0899775d227c76de3f758b74e3b"
      },
      {
        "verse": 17,
        "text": "[הִיא] נָתְנָה לַקְּדוֹשִׁים שְׂכַר עֲמָלָם וַתַּנְחֵם דֶּרֶךְ פְּלָאִים וַתְּהִי לָמוֹ לְמַחְסֶה יוֹמָם וּלְאוֹר כּוֹכָבִים לָיְלָה׃",
        "sourcePages": [
          165
        ],
        "textSHA256": "293e5fdbb0265db008b03dc551329ffd60fd99aaaf0fa7f06b171b4013391609"
      },
      {
        "verse": 18,
        "text": "וַתַּעֲבִירֵם בְּיַם־סוּף וַתְּנַהֲלֵם בְּמַיִם רַבִּים׃",
        "sourcePages": [
          165
        ],
        "textSHA256": "9ad8bf123acb8424c62aeb5d672c0ab355d212d895fabd99ee953d5868bd03bc"
      },
      {
        "verse": 19,
        "text": "אֶת־שׂוֹנְאֵיהֶם טִבְּעָה וּמֵעֹמֶק תְּהוֹם הֶעֱלָתַם׃",
        "sourcePages": [
          165
        ],
        "textSHA256": "d3ba1dfc6781ec1aee7963eee4a22beb8fbb22d755261d5af04dea39b936689c"
      },
      {
        "verse": 20,
        "text": "עַל־כֵּן פָּשְׁטוּ הַצַּדִּיקִים הַנֶּשֶׁק מֵעַל־הָרְשָׁעִים וַיְּזַמְּרוּ לְשִׁמְךָ הַקָּדוֹשׁ יְיָ ויְהַלָלוּ יַחְדָּו אֶת־יָדְךָ הַסּוֹככָה׃",
        "sourcePages": [
          166
        ],
        "textSHA256": "28c03ccac3336de0509b20cca7da965b495938457f110fad2ff72753b52876b2",
        "sourceNotes": [
