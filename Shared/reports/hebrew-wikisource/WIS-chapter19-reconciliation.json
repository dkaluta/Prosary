          }
        ]
      },
      {
        "verse": 7,
        "text": "הֵן נִרְאָה עָנָן סוֹכֵךְ עַל־הַמַּחֲנֶה וּמְקוֹם שָׁם מַיִם לְפָנִים יַבֶּשֶׁת הוֹפִיעָה מִיַּם־סוּף דֶּרֶךְ סְלוּלָה וּמִמִּשְׁבָּרִים אַדִּירִים מִישׁוֹר מְכסֶּה דֶּשֶׁא׃",
        "sourcePages": [
          184
        ],
        "textSHA256": "e7021a85e2cef6c6fb6c6a79a6270b53805a0913cbf00978f0d66d0e7b66c1e6",
        "sourceNotes": [
          {
            "id": "wis-19-7-word7-kaf-2-vowel",
            "kind": "unreadablePoint",
            "anchor": "מְכסֶּה",
            "occurrence": 1,
            "letterIndex": 2,
            "mark": "vowel",
            "sourcePages": [
              184
            ],
            "sourceURL": "https://upload.wikimedia.org/wikisource/he/e/ed/Apocrypha_Kahana_A2.pdf#page=184"
          }
        ]
      },
      {
        "verse": 8,
        "text": "בּוֹ עָבְרוּ כָּל־הָעָם בְּפָרְשְׂךָ עֲלֵיהֶם יָדְךָ וַיִּרְאוּ נִסִּים וְנִפְלָאוֹת׃",
        "sourcePages": [
          184
        ],
        "textSHA256": "b530c9bae0c253ca8d23376df40f808b86c2b3b36ad9c48ad2f1489f5041f8bf"
      },
      {
        "verse": 9,
        "text": "ויְשׁוֹמָמוּ כְּסוּסִים בַּמִּרְעֶה וְכִכְבָשִׂים יִרְקְדוּ ויְהַלָלוּ לְךָ יְיָ גּוֹאֲלָם׃",
        "sourcePages": [
          184
        ],
        "textSHA256": "45a7d4227e97058ded6e1efc768cf1fb2fedba4358761557665bca9665d20d46",
        "sourceNotes": [
          {
            "id": "wis-19-9-word8-vav-1-vowel",
            "kind": "unreadablePoint",
            "anchor": "ויְשׁוֹמָמוּ",
            "occurrence": 1,
            "letterIndex": 1,
            "mark": "vowel",
            "sourcePages": [
              184
            ],
            "sourceURL": "https://upload.wikimedia.org/wikisource/he/e/ed/Apocrypha_Kahana_A2.pdf#page=184"
          },
          {
            "id": "wis-19-9-word9-vav-1-vowel",
            "kind": "unreadablePoint",
            "anchor": "ויְהַלָלוּ",
            "occurrence": 1,
            "letterIndex": 1,
            "mark": "vowel",
            "sourcePages": [
              184
            ],
            "sourceURL": "https://upload.wikimedia.org/wikisource/he/e/ed/Apocrypha_Kahana_A2.pdf#page=184"
          }
        ]
      },
      {
        "verse": 10,
        "text": "כִּי זָכְרוּ עוֹד אֶת־הַמּצָאוֹת אוֹתָם בְּאֶרֶץ מְגוּרֵיהֶם אֵיךְ הָאָרֶץ הוֹצִיאָה כִּנִּים תַּחַת חַיּוֹת [הַיַּבָּשָׁה] לְמִינֵיהֶן וְתַחַת חַיּוֹת הַמַּיִם שָׁרַץ הַיְאוֹר צְפַרְדְּעִים לָרֹב׃",
        "sourcePages": [
          184
        ],
        "textSHA256": "e5520ea91e9aa8d8fad1ea0902658bfd9e0d41ab98087fbf20562c7375c58d22",
        "sourceNotes": [
          {
            "id": "wis-19-10-word10-mem-2-vowel",
            "kind": "unreadablePoint",
            "anchor": "הַמּצָאוֹת",
            "occurrence": 1,
            "letterIndex": 2,
            "mark": "vowel",
            "sourcePages": [
              184
            ],
            "sourceURL": "https://upload.wikimedia.org/wikisource/he/e/ed/Apocrypha_Kahana_A2.pdf#page=184"
          }
        ]
      },
      {
        "verse": 11,
        "text": "אַחֲרֵי־כֵן רָאוּ גַּם מִין צִפֳּרִים חֲדָשׁוֹת כְּעוֹרֵר אוֹתָם תַּאֲוָתָם לִדְרשׁ מַאֲכָלֵי מַעֲדַנִּים׃",
        "sourcePages": [
          184,
          185
        ],
        "textSHA256": "6ca0c919fa52724672e2a13bd1b45e8f07ea487b2952e73f78cb29fb06853f70"
      },
      {
        "verse": 12,
        "text": "כִּי שְׂלָו עָלָה לָהֶם מִן־הַיָּם לְמַלֵּא שְׁאֵלָתָם׃",
        "sourcePages": [
          185
        ],
        "textSHA256": "0c7afaaac75bee98956232fa1eee7e66360d2fd3e2fb490e9d9655c336d60201"
      },
      {
        "verse": 13,
        "text": "וְעַל הַחַטָּאִים לֹא בָאוּ הַפְּגָעִים עַד־אֲשֶׁר הָרְעָמִים נָתְנוּ עֵדוּתָם בְּעֹז הֵמָּה סָבְלוּ בְּצֶדֶק בִּגְלַל עוֹנוֹתֵיהֶם׃",
        "sourcePages": [
          185
        ],
        "textSHA256": "cd7d33ed2d470f8e363acece6fb7fbbba2ff9c1bc5a0a3671a35bde426a2d9fe",
        "sourceNotes": [
          {
            "id": "wis-19-13-word11-ayin-1-vowel",
            "kind": "unreadablePoint",
            "anchor": "עוֹנוֹתֵיהֶם",
            "occurrence": 1,
            "letterIndex": 1,
            "mark": "vowel",
            "sourcePages": [
              185
            ],
            "sourceURL": "https://upload.wikimedia.org/wikisource/he/e/ed/Apocrypha_Kahana_A2.pdf#page=185"
          }
        ]
      },
      {
        "verse": 14,
        "text": "יַעַן כִּי הִרְבּוּ לְהַרְאוֹת מַשְׂטֵמָה עַזָּה לַגֵּרִים [מִן־הָאֲחֵרִים] כִּי אֵלֶּה לֹא אָסְפוּ זָרִים אֲשֶׁר בָּאוּ אֲלֵיהֶם וְהֵמָּה עָשׂוּ לַעֲבָדִים אֲנָשִׁים גֵּרִים אֲשֶׁר עָשׂוּ עִמָּם חָסֶד׃",
        "sourcePages": [
          185
        ],
        "textSHA256": "5d9d55cbe594bc02321f569d30e3566eec2dd7776ad46719c89f067d312d168f"
      },
      {
        "verse": 15,
        "text": "מִבַּלְעֲדֵי זֶה שׁוֹנֶה יִהְיֶה עָנְשָׁם אֲשֶׁר אֵלֶּה יָצְאוּ בְּשִׂנְאָה נֶגֶד הַגֵּרִים׃",
        "sourcePages": [
          185
        ],
        "textSHA256": "3da87ef98559cbc5b9f358656b561494deba659c7b597b73f46fc2b38f528b6c"
      },
      {
        "verse": 16,
        "text": "וְהֵמָּה קִבְּלוּ אוֹתָם בְּהִלּוּלִים וְאַחֲרֵי־כֵן עִנּוּ אוֹתָם בַּעֲבוֹדָה קָשָׁה אַף־כִּי בְּחֻקֵּי הָאָרֶץ כְּבָר לָהֶם נִשְׁתַּוּוּ׃",
        "sourcePages": [
          185
        ],
        "textSHA256": "14cf0c1ed49239380647b281d9baffba44868418f90351ba4216aa439bce3252"
      },
      {
        "verse": 17,
        "text": "וְגַם הֵם הכּוּ בַּסַּנְוֵרִים כְּמוֹ אֵלֶּה לִפְנֵי פֶּתַח הַצַּדִּיק כַּאֲשֶׁר כִּסָּה אוֹתָם חשֶׁךְ וְצַלְמָוֶת וַיְבַקֵּשׁ כָּל־אִישׁ מֵהֶם אֶת־הַדֶּרֶךְ אֶל־שַׁעַר בֵּיתוֹ׃",
        "sourcePages": [
          185
        ],
        "textSHA256": "259855a30b2fa55bf6684b6b7fceb9e511dd3459e6805fce24355103f8c71d96",
        "sourceNotes": [
          {
            "id": "wis-19-17-word12-he-1-vowel",
            "kind": "unreadablePoint",
            "anchor": "הכּוּ",
            "occurrence": 1,
            "letterIndex": 1,
            "mark": "vowel",
            "sourcePages": [
              185
            ],
            "sourceURL": "https://upload.wikimedia.org/wikisource/he/e/ed/Apocrypha_Kahana_A2.pdf#page=185"
          }
        ]
      },
      {
        "verse": 18,
        "text": "כִּי הַיְסוֹדוֹת אֶת־סִדְרָם הֶחֱלִיפוּ כּאֲשֶׁר יִשְׁתַּנֶּה קֶצֶב צלילי הַנֵּבֶל בְּהִשְׁתַּנּוֹת מֵיתָרָיו אַף כִּי־קוֹלָם יִשָּׁאֵר תָּמִיד כָּל־עֻמַּת שֶׁהָיָה וְזֹאת יוּכַל הָאִישׁ לִשְׁפֹּט לְנָכוֹן בִּרְאוֹתוֹ אֶת־הַמַּעֲשִׂים׃",
        "sourcePages": [
          185
        ],
        "textSHA256": "ea76ba956a6135bfe4b470a68917bafdc92c4fd26768a6a01793ab3e4d3a9c9e",
        "sourceNotes": [
          {
