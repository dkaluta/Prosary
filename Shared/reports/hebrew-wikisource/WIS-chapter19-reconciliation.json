          }
        ]
      },
      {
        "verse": 5,
        "text": "וּלְמַעַן יַעֲבֹר עַמְּךָ דֶּרֶךְ פְּלָאִים וְהֵם יִמְצְאוּ מִיתָה מְשׁנּה׃",
        "sourcePages": [
          184
        ],
        "textSHA256": "49dc0b3f54012657f51e8c37088e295b70179ba615468ebf868a53edf560dbbf",
