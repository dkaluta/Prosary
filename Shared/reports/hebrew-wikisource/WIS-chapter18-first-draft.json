  "draft": {
    "number": 18,
    "verses": [
      {
        "verse": 1,
        "text": "ולחסידיך הָיָה אוֹר גָּדוֹל מְאֹד וְהֵם [הַמִּצְרִים] שָׁמְעוּ אֶת־קוֹלָם וּדְמוּתָם לֹא־רָאוּ וַיְאַשְּׁרוּם אֲשֶׁר לֹא־יִסְבְּלוּ כְּמוֹהֶם גַּם אֵלֶּה׃",
        "sourcePages": [
          181
        ],
        "textSHA256": "e22149900ea4ea27175302abdc3219fc799c344cb11136cd39b83d4029deac4e"
      },
      {
        "verse": 2,
        "text": "וַיּוֹדוּ לָהֶם כִּי לֹא־נָקְמוּ אֶת־עוֹלָתָם מִלְּפָנִים וַיְבַקְשׁוּ סְלִיחָה עַל אֲשֶׁר־הֵרֵעוּ לָמוֹ׃",
        "sourcePages": [
          181
        ],
        "textSHA256": "6563ea1f91401a72aefc748a416b7a898acfcf93a7428f4c6a1fc147eb1a738d"
      },
      {
        "verse": 3,
        "text": "וְתַחַת אֵלֶּה הֲכִינוֹתָ לָהֶם [לְיִשְׂרָאֵל] עַמּוּד אֵשׁ לַנְחוֹתָם דֶּרֶךְ בַּל־יָדָעוּ וְשֶׁמֶשׁ מַרְפֵּא לְמַסָּע כָּבוֹד׃",
        "sourcePages": [
          181
        ],
        "textSHA256": "40fa0c28453c67d3ae5d95fb12ea27fe68c8371aced9997980cbc005d4bf79cf"
      },
      {
        "verse": 4,
        "text": "הֵן בְּצֶדֶק נִמְנַע אוֹר מֵאֵלֶּה וַיֵּעָצְבוּ בַּחֹשֶׁךְ כִּי בְּמַאֲסָר כָּלְאוּ גּוֹי אֲשֶׁר עַל־יָדָם נִתַּן לָעוֹלָם אוֹר תּוֹרַת נֶצַח׃",
        "sourcePages": [
          181
        ],
        "textSHA256": "d9cf961830491b94fc8a9b8f24436abbe98b833388418eb41ec7f1a4b2962bfa"
      },
      {
        "verse": 5,
        "text": "הֵם זָמְמוּ לְהָמִית עוֹלְלֵי חֲסִידִים [וְרַק] אֶחָד מִן־הַיְלוּדִים הַמֻּשְׁלָכִים נִמְלָט וְהִנֵּה יִסַּרְתָּם וַתִּקַּח מֵהֶם בָּנִים לָרֹב וְאִבַּדְתָּ כֻּלָּם יַחַד בְּמַיִם עַזִּים׃",
        "sourcePages": [
          181
        ],
        "textSHA256": "92260a39483373bdaf839f2ea29cf262cb2d9687218359d9e18d2d2b8a802920"
      },
      {
        "verse": 6,
        "text": "הַלַּיְלָה הַהוּא בֻּשַּׂר לַאֲבוֹתֵינוּ מֵרֹאשׁ לְמַעַן יֵאָמֵן רוּחָם כִּי יָדְעוּ נְכוֹנָה אֶת־הַשְּׁבוּעוֹת וּבָהֶן הֶאֱמִינוּ׃",
        "sourcePages": [
          181,
          182
        ],
        "textSHA256": "a3c37d2fe38575c811965665915436417c4aff91095b6845ecae33f406039d18"
      },
      {
        "verse": 7,
        "text": "אָז חִכָּה עַמְּךָ לְיֵשַׁע צַדִּיקִים וּלְאָבְדַן צָרִים׃ כִּי בַּדָּבָר אֲשֶׁר שָׁפַטְתָּ קָמֵינוּ רוֹמַמְתָּנוּ וַתִּקְרָא אוֹתָנוּ אֵלֶיךָ׃",
        "sourcePages": [
          182
        ],
        "textSHA256": "1ed6c8bb20f6dace73e0a07fafd75193f0a1857c1539dea7aa3e759ad9a79636",
        "endVerse": 8
      },
      {
        "verse": 9,
        "text": "כִּי הַחֲסִידִים בְּנֵי טוֹבִים זָבְחוּ [לְךָ] בַּמִּסְתָּרִים וַיְחַקּוּ אֶת־מִצְוֹת אֱלֹהִים בְּתָם־דֵּעָה אֲשֶׁר כָּל־הַקְּדוֹשִׁים חֵלֶק כְּחֵלֶק יִקְחוּ חֶבֶל בַּטּוֹב וּבָרָע וְעוֹד אֲבוֹתֵינוּ שָׁרוּ הַלֵּל לָרִאשׁוֹנָה׃",
        "sourcePages": [
          182
        ],
        "textSHA256": "bc6bde746a60b726d377c1ecc27ea556b262432536526b154dadca4e2e9e412a"
      },
      {
        "verse": 10,
        "text": "וּלְעֻמָּתָם נִשְׁמְעָה אֶנְקַת צָרֵיהֶם מַר יִצְרָחוּ גַּם בְּנֵיהֶם נָשְׂאוּ קוֹל בְּקִינָה נוּגָה׃",
        "sourcePages": [
          182
        ],
        "textSHA256": "d9a4ed8389867b7c318477015067d6f0f35b06db29e51405a3cde664c801e8cb"
      },
      {
        "verse": 11,
        "text": "בְּעֹנֶשׁ אֶחָד נִשְׁפְּטוּ הָעֶבֶד כַּאֲדוֹנָיו וְדַלַּת הָעָם כְּמַלְכָּם סָבָלוּ׃",
        "sourcePages": [
          182
        ],
        "textSHA256": "921c90ee2ce3c12a44b40df53af1dc219cf87a51de8d3a087d4e3a3b88ffe225"
      },
      {
        "verse": 12,
        "text": "לְכֻלָּם כְּאֶחָד הָיוּ מֵתִים אֵין־מִסְפָּר חַלְלֵי מַגֵּפָה אַחַת וְלִקְבֹּר [אֶת־הַמֵּתִים] לֹא יַשְׂפִּיקוּ הַחַיִּים כִּי־מִבְחַר תּוֹלְדוֹתָם כְּרֶגַע נִשְׁמַד׃",
        "sourcePages": [
          182
        ],
        "textSHA256": "64111833fd2a847284885c1d17025c9ff4b06d8f35749b88e01007da1b561119"
      },
      {
        "verse": 13,
        "text": "וְהָאֲנָשִׁים אֲשֶׁר לֹא־הֶאֱמִינוּ בְּכָל־אֵלֶּה בִּגְלַל קְסָמֵיהֶם הוֹדוּ בְּהִנָּגֵף בְּכוֹרֵיהֶם כִּי הָעָם הַזֶּה בְּנֵי אֱלֹהִים הֵמָּה׃",
        "sourcePages": [
          182
        ],
        "textSHA256": "6a2aa80877f20868f22f0d3b36659c85e7cfc93a166dc31f2706853b9614abba"
      },
      {
        "verse": 14,
        "text": "כַּאֲשֶׁר הִשְׁלִיךְ הַס וְשֶׁקֶט בַּכֹּל וְהַלַּיְלָה הִגִּיעַ בִּמְרוּצָתוֹ לְמַחֲצִית דַּרְכּוֹ׃",
        "sourcePages": [
          182
        ],
        "textSHA256": "537f18206c498ee666d85cd3e1ed101d15219caa86cd339cb47e71dd6f7f6f43"
      },
      {
        "verse": 15,
        "text": "וְהִנֵּה יָרַד דְּבָרְךָ הַכֹּל־יָכוֹל מִן הַשָּׁמַיִם מִכִּסֵּא מַלְכוּתֶךָ כְּגִבּוֹר מִלְחָמָה אָיֹם בְּקֶרֶב הָאָרֶץ הַנְּכוֹנָה לִכְלָיָה׃",
        "sourcePages": [
          182
        ],
        "textSHA256": "03c3269a1eb2baf2a05bbb09e1c0e0910c080222343107be4787ff34c9435e3d"
      },
      {
        "verse": 16,
        "text": "וּכְחֶרֶב חַדָּה הֵבִיא אִתּוֹ פְּקֻדָּתְךָ הַנִּמְרָצָה וּבְהִתְיַצְּבוֹ מִלֵּא הַכֹּל [חֶרְדַּת] מָוֶת וּבְלֶכְתּוֹ עַל־הָאָרֶץ הַשָּׁמַיְמָה הִגִּיעַ׃",
        "sourcePages": [
          182,
          183
        ],
        "textSHA256": "0f053ef49161ae0ea351765530e2469376e38f8f79c180f64cfa07944b61246b"
      },
      {
        "verse": 17,
        "text": "אָז כְּרֶגַע הִבְעִיתוּם מַרְאֵי חֲלוֹמוֹת נוֹרָאִים וּפַחַד פִּתְאֹם נָפַל עֲלֵיהֶם׃",
        "sourcePages": [
          183
        ],
        "textSHA256": "c117b300f473648e30313aa581213427e7c7f624dd846b72ac6c3d9c1ee5b641"
      },
      {
        "verse": 18,
        "text": "זֶה מִפֹּה וְזֶה מִפֹּה כָּרַע כַּחֲצִי מֵת וַיְגַלּוּ לְעֵינֵי־כֹל סִבַּת מוֹתָם׃",
        "sourcePages": [
          183
        ],
        "textSHA256": "48c3db5d0cdbcd9087051e7873643b50266bc1c57e7ff7f883a5fd302f0a4c63"
      },
      {
        "verse": 19,
        "text": "כִּי בַּחֲלוֹמוֹת הַמַּבְהִילִים נוֹדַע לָהֶם הַדָּבָר מֵרֹאשׁ לְמַעַן יֵדְעוּ בְּמוֹתָם מַה־הָיְתָה סִבַּת צָרָתָם׃",
        "sourcePages": [
          183
        ],
        "textSHA256": "60d5b6c18a225f50cbb41ccdecddde858561a33b042a8f37cd4e78492a159428"
      },
      {
        "verse": 20,
        "text": "אָמְנָם גַּם בַּצַּדִּיקִים נָגַע הַמָּוֶת לְמַעַן נַסּוֹתָם וַתְּהִי בַּמִּדְבָּר מַגֵּפָה רַבָּה אַךְ זַעֲמְךָ לֹא אָרַךְ זְמַן רָב׃",
        "sourcePages": [
          183
        ],
        "textSHA256": "aad1a309edb1923fe908851922597118ef4871e4133ec0a990580ef3a6719b90"
      },
      {
        "verse": 21,
        "text": "כִּי מִהֵר אִישׁ תָּמִים לַעֲמֹד בַּפֶּרֶץ בְּהָבִיאוֹ אִתּוֹ כְּלֵי־קְרָב עֲבוֹדָתוֹ תְּפִלָּה וּקְטֹרֶת לְכַפָּרָה וַיִּתְיַצֵּב לִפְנֵי הָאַף וַיָּשֶׂם קֵץ לַצָּרָה וַיַּרְא כִּי הוּא עַבְדֶּךָ׃",
        "sourcePages": [
          183
        ],
        "textSHA256": "0d35705ebf799818f4c30afec7bad7ac3b3a24096199de02ba993f2954e5d31d"
      },
      {
        "verse": 22,
        "text": "וַיִּגְבַּר עַל־הַקֶּצֶף לֹא בְּעֹז הַגּוּף וְלֹא בְּכֹחַ כְּלֵי־קְרָב אַךְ בִּדְבָרוֹ יִכְבֹּשׁ אֶת־הַמַּשְׁחִית בְּהַזְכִּירוֹ אֶת־הַשְּׁבוּעָה וְאֶת־הַבְּרִית עִם־אֲבוֹתֵינוּ׃",
        "sourcePages": [
          183
        ],
        "textSHA256": "2553e5da7ae6fb99e2e43b7ed5e0f62bf1d4d5de3db319d800d002d5293208c2"
      },
      {
        "verse": 23,
        "text": "וַיְהִי כַּאֲשֶׁר נָפְלוּ חֲלָלִים וְנֶעֶרְמוּ אֵלֶּה עַל־אֵלֶּה וַיַּעֲמֹד בֵּינֵיהֶם וַיַּעֲצֹר בְּעַד הַזַּעַם וַיַּחֲסֹם אֶת־הַדֶּרֶךְ אֶל־הַחַיִּים׃",
        "sourcePages": [
          183
        ],
        "textSHA256": "e8611d58c5ea12df4083217497db3e7d3bb1d3953ff828a29d0fe8c0b4c26c19"
      },
      {
        "verse": 24,
        "text": "כִּי עַל מְעִילוֹ הַמַּגִּיעַ לְרַגְלָיו הָיָה כָּל־הָעוֹלָם וּמַהֲלַל הָאָבוֹת חָרוּת עַל־אַרְבָּעָה טוּרֵי אֶבֶן וְפָאֳרְךָ עַל־מִצְנֶפֶת רֹאשׁוֹ׃",
        "sourcePages": [
          183
        ],
        "textSHA256": "21ab32e7a0e422bf2dd9c9422e5dc4774cfd7c1913c73daa6f85af9d004d57af"
      },
      {
        "verse": 25,
        "text": "מִפְּנֵי אֵלֶּה נָסוֹג הַמַּשְׁחִית אֲחֹרָנִית וּמִפְּנֵי אֵלֶּה יָרֵא כִּי מַכַּת זַעֲמְךָ לְבַדָּהּ שָׂפְקָה׃",
        "sourcePages": [
          183
        ],
        "textSHA256": "0e44ec8913e27da01fd0a792d8c0f016a3e2631554b767b1d0babb0714355168"
      }
    ]
