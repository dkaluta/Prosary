    <string name="about_title">"Informazioni su Prosary"</string>
    <string name="about_tagline">"Un compagno per recitare il Rosario e altre devozioni cattoliche."</string>
    <string name="about_typefaces">"Caratteri tipografici"</string>
    <string name="about_typeface_frank_ruhl">" — SIL Open Font License 1.1 — preghiere in ebraico."</string>
