    <string name="about_typeface_scheherazade">" — SIL Open Font License 1.1 — Sacra Scrittura in arabo (SIL)."</string>
    <string name="about_typeface_cardo">" — SIL Open Font License 1.1 — Sacra Scrittura in latino e inglese (David J. Perry)."</string>
    <string name="about_typeface_noto_syriac">", occidentale e orientale — SIL Open Font License 1.1 — caratteri selezionabili per l’aramaico in scrittura siriaca."</string>
    <string name="about_typeface_optional_hebrew">" — SIL Open Font License 1.1 — caratteri facoltativi per le preghiere e la Sacra Scrittura in ebraico; Roboto usa Noto Sans Hebrew come alternativa su Android."</string>
    <string name="about_typeface_stam">" — GPL v2 con eccezione per l’incorporamento dei caratteri — caratteri facoltativi per la Sacra Scrittura in ebraico (progetto Culmus, Yoram Gnat)."</string>
    <string name="about_typefaces_footer">"Le preghiere possono usare il carattere di sistema con o senza grazie."</string>
    <string name="about_mystery_illustrations">"Illustrazioni dei misteri"</string>
    <string name="about_mystery_intro">"Le 20 immagini dei misteri sono dipinti classici di pubblico dominio (artista deceduto da oltre 100 anni), tratti da Wikimedia Commons."</string>
    <string-array name="about_mystery_attributions">
        <item>"*L’Annunciazione* — Beato Angelico (m. 1455)"</item>
        <item>"*La Visitazione* — Mariotto Albertinelli (m. 1515)"</item>
