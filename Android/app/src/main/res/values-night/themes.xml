<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Actual theming happens in Compose (ui/theme); this XML theme
         only needs to cover the brief window before Compose content is set. No status/navigation
         bar attributes: those window parameters are deprecated as of Android 15 —
         enableEdgeToEdge() in MainActivity owns system-bar appearance instead. -->
    <style name="Theme.Prosary" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary_dark</item>
    </style>
</resources>